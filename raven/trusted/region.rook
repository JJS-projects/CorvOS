module public

// Memory for batch jobs (the self-hosted compiler, docs/self-hosting.md): a region of RAM
// far larger than the actor arena, handed out in zeroed blocks that are never freed (a
// job runs once and ends). Safe code gets only `Block`s, whose reads and writes are checked
// against their size; it never sees an address (decision 153).
//
// The region is 128 MB at physical 64 MB (0x4000000), clear of the kernel image at 0x80000
// and below the 512 MB every supported board has, and of the part the GPU takes from the top.

import assembly: actor_arena_base
import devices: Mmio

REGION_BASE: u64 = 0x4000000
REGION_SIZE: u64 = 0x8000000

/// The word of the actor arena (zero at boot; offset 1816 is unused by mailbox.rook's tables
/// and actors.s) that holds the address of the next free byte of the region: 0 until the one
/// `Region` has been made. The `Region` value is only a handle on it, so it can be copied and
/// held (by a `List`, which grows itself) without two copies handing out the same memory.
REGION_NEXT: u64 = 1816

/// A run of zeroed bytes from a `Region`. The fields are private to this file, so a `Block`
/// can only come from a `Region` and no code can point one at other memory.
pub struct Block {
    address: u64
    length: u64

    /// How many bytes it holds.
    pub fn len() -> u64 {
        return .length
    }

    /// The byte at `index`. Panics if `index` is outside.
    pub fn get(index: u64) -> u8 {
        if index >= .length {
            panic("index outside Block")
        }
        unsafe {
            return load8(.address + index)
        }
    }

    /// Sets the byte at `index`. Panics if `index` is outside.
    pub fn set(index: u64, value: u8) {
        if index >= .length {
            panic("index outside Block")
        }
        unsafe {
            store8(.address + index, value)
        }
    }

    /// The 64-bit word `word` words in (bytes `8 * word` to `8 * word + 7`). Panics if it is
    /// not entirely inside.
    pub fn get64(word: u64) -> u64 {
        .check64(word)
        unsafe {
            return load64(.address + word * 8)
        }
    }

    /// Sets the 64-bit word `word` words in. Panics if it is not entirely inside.
    pub fn set64(word: u64, value: u64) {
        .check64(word)
        unsafe {
            store64(.address + word * 8, value)
        }
    }

    fn check64(word: u64) {
        if .length < 8 or word > (.length - 8) / 8 {
            panic("word outside Block")
        }
    }
} Block

/// The memory a batch job allocates from. There is one, made by `make_region` from the whole
/// of the peripherals; `block` takes the next piece and nothing is ever given back. A `Region`
/// is a handle on the one pool (the free address is kept in the arena, not in the value), so a
/// copy of it allocates from the same place.
pub struct Region {
    next_at: u64        // where the address of the next free byte is kept

    /// A new zeroed block of `bytes` bytes (the space is rounded up to whole words, but the
    /// block's length is `bytes`). Panics if the region has not got room.
    pub fn block(bytes: u64) -> Block {
        unsafe {
            rt_start: u64 = load64(.next_at)
            if bytes > REGION_BASE + REGION_SIZE - rt_start {
                panic("the region is full")
            }
            rt_space: u64 = (bytes + 7) / 8 * 8      // no overflow: bytes fits, and what is left is a multiple of 8
            clearing: loop rt_at: u64 in 0..rt_space / 8 {
                store64(rt_start + rt_at * 8, 0)
            }
            store64(.next_at, rt_start + rt_space)
            return Block(address: rt_start, length: bytes)
        }
    }

    /// How many bytes are left.
    pub fn left() -> u64 {
        unsafe {
            return REGION_BASE + REGION_SIZE - load64(.next_at)
        }
    }
} Region

/// The region. Only the whole of the peripherals can make it (so a driver given just its
/// registers cannot), and only once: a second one would hand out the same memory again.
pub fn make_region(peripherals: Mmio) -> Region {
    if not peripherals.is_root() {
        panic("a Region is made from the whole peripherals")
    }
    unsafe {
        rt_next_at: u64 = actor_arena_base() + REGION_NEXT
        if load64(rt_next_at) != 0 {
            panic("the Region has been made already")
        }
        store64(rt_next_at, REGION_BASE)
        return Region(next_at: rt_next_at)
    }
}

/// A growable list of `T`, in the region. It starts empty, takes room on the first `push` and
/// doubles when full (the old room is not given back: a job runs once and ends). `get` and `set`
/// check the index. Values are stored by copy, a struct or enum as its words. Its fields are
/// private, so only this file can reach the storage.
pub struct List<T> {
    region: Region
    block: Block
    count: u64
    capacity: u64

    new(region: Region) {
        .region = copy(region)
        .block = region.block(0)
        .count = 0
        .capacity = 0
    }

    /// How many values it holds.
    pub fn len() -> u64 {
        return .count
    }

    /// The value at `index`. Panics if `index` is outside.
    pub fn get(index: u64) -> T {
        if index >= .count {
            panic("index outside List")
        }
        unsafe {
            return load_element(.block.address, index)
        }
    }

    /// Replaces the value at `index`. Panics if `index` is outside.
    pub mut fn set(index: u64, item: T) {
        if index >= .count {
            panic("index outside List")
        }
        unsafe {
            store_element(.block.address, index, item)
        }
    }

    /// Adds `item` at the end.
    pub mut fn push(item: T) {
        unsafe {
            if .count == .capacity {
                rt_capacity: u64 = if .capacity == 0 { 4 } else { .capacity * 2 }
                rt_fresh: Block = .region.block(rt_capacity * words_of(item) * 8)
                moving: loop rt_at: u64 in 0..(.count) {
                    rt_moved: T = load_element(.block.address, rt_at)
                    store_element(rt_fresh.address, rt_at, rt_moved)
                }
                .block = copy(rt_fresh)
                .capacity = rt_capacity
            }
            store_element(.block.address, .count, item)
            .count = .count + 1
        }
    }

    /// Removes and returns the last value. Panics if the list is empty.
    pub mut fn pop() -> T {
        if .count == 0 {
            panic("pop from an empty List")
        }
        .count = .count - 1
        unsafe {
            return load_element(.block.address, .count)
        }
    }

    /// Empties it (the room is kept).
    pub mut fn clear() {
        .count = 0
    }
} List
