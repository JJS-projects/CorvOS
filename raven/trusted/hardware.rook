module public

// The few facts about the hardware that application code may read, and the call that
// starts the test build's program. Written in assembly (kernel/arch/aarch64/cpu.s and
// test_hooks.s). None of them takes a number as authority. The dangerous calls (the
// arena, the timer, the interrupt controller, `call_dispatch`) are in `assembly`, which
// only Raven's own code can import (decision 142).

import devices: Mmio

/// The exception level Raven is running at.
pub extern fn current_el() -> u64

/// The MMU and cache switches of SCTLR_EL1 (kernel/arch/aarch64/cpu.s): 0x1005 when all three are on.
pub extern fn mmu_state() -> u64

/// Bit n is set once core n is up (kernel/arch/aarch64/cpu.s). Raven runs on all four cores.
pub extern fn cores_online_mask() -> u64

/// Runs the test build's extra steps, chosen when the kernel is assembled
/// (kernel/test_hooks.s): calls a Rook test program's `test_main`, which is
/// handed `peripherals`, or triggers a deliberate fault. Does nothing in the
/// normal kernel.
pub extern fn run_test_hooks(peripherals: Mmio)

/// The ARM generic timer's count, and how many ticks it makes a second
/// (kernel/arch/aarch64/cpu.s). The frequency is 0 if the firmware didn't set it.
pub extern fn read_counter() -> u64
pub extern fn counter_frequency() -> u64

/// True in the test builds, where nobody watches the activity LED, so
/// kernel_main skips the waits of its LED signals (kernel/test_hooks.s).
pub extern fn quiet_build() -> bool

/// Lets the physical timer interrupt the core and unmasks IRQs (the handler time budget
/// and interrupts as messages need it). Harmless to call again.
pub extern fn irq_init()
