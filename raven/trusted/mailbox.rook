// Raven's mailboxes and scheduler, on one core: where actors live, their mailboxes, and
// the scheduler. An internal module: application code can't import it (decision 142);
// what an application may use is in `actors`. Fledgling compiles `spawn` and every send into calls to
// `raven_spawn_actor` and `raven_send` here; the scheduler runs one message at
// a time through the dispatcher Fledgling generates for each actor.
//
// Everything lives in one fixed arena (kernel/arch/aarch64/actors.s), so this
// code keeps no global variables: Raven's own tables are at the start of the
// arena. Actors are never freed (decision 119).
//
// An actor's memory, in 8-byte words, with its reference pointing at the fields:
//     [ header: 8 ][ mailbox: 16 slots of 9 ][ the actor's fields ... ]
// A slot holds a handler number and up to eight payload words: the handler's arguments,
// a struct or enum counting as its size (decision 135).

import actors: Sent
import assembly: actor_failed, actor_arena_base, actor_arena_limit, call_dispatch, call_protected, handler_table_end, handler_table_start, irq_enable_source, irq_take_pending, rook_budget_panic, timer_arm, timer_disarm
import hardware: counter_frequency

ACTOR_HEADER_WORDS: u64 = 14
ACTOR_SLOTS: u64 = 16               // messages one mailbox holds (decision 113, g)
ACTOR_MESSAGE_WORDS: u64 = 8        // payload words in a message
ACTOR_SLOT_WORDS: u64 = 9           // a handler number and the payload
ACTOR_BEFORE_FIELDS: u64 = (ACTOR_HEADER_WORDS + ACTOR_SLOTS * ACTOR_SLOT_WORDS) * 8

// Header, as byte offsets from the start of the actor's memory.
ACTOR_H_DISPATCHER: u64 = 0         // address of its dispatcher
ACTOR_H_FIRST: u64 = 8              // slot of the oldest message
ACTOR_H_COUNT: u64 = 16             // messages waiting
ACTOR_H_QUEUED: u64 = 24            // 1 if it is in the run queue
ACTOR_H_START: u64 = 32             // its start stub, which runs `new` on stored arguments (0: none)
ACTOR_H_PARENT: u64 = 40            // the actor that spawned it (0: spawned outside any actor)
ACTOR_H_ARGS_WORDS: u64 = 48        // words of `new` arguments kept for a restart
ACTOR_H_FIRST_CHILD: u64 = 56       // the actors it spawned, in order: the first ...
ACTOR_H_NEXT_SIBLING: u64 = 64      // ... and each one's next
ACTOR_H_LAST_CHILD: u64 = 72
ACTOR_H_PENDING: u64 = 80           // during a restart: children not yet matched by a `spawn`
ACTOR_H_FLAGS: u64 = 88             // see ACTOR_F_*
ACTOR_H_ARGS: u64 = 96              // address of the kept `new` arguments
ACTOR_F_IN_NEW: u64 = 1             // it was spawned by its spawner's `new`: kept across restarts
ACTOR_F_ENDED: u64 = 2              // it has ended: sends to it are refused

// Raven's tables, as byte offsets from the start of the arena.
ACTOR_S_NEXT: u64 = 0               // next free byte (0 until the first spawn)
ACTOR_S_RUNQ_FIRST: u64 = 8
ACTOR_S_RUNQ_COUNT: u64 = 16
pub ACTOR_S_DROPPED: u64 = 24           // messages dropped because a mailbox was full
ACTOR_S_CURRENT_DISPATCHER: u64 = 32  // the handler now running: its actor's dispatcher ...
ACTOR_S_CURRENT_HANDLER: u64 = 40     // ... and its number
ACTOR_S_IRQ_PENDING: u64 = 48       // bit n: peripheral interrupt 32 + n has fired (vectors.s)
ACTOR_RUNQ_OFFSET: u64 = 64         // the run queue: a ring of actor references
ACTOR_RUNQ_SLOTS: u64 = 128
ACTOR_S_RESTARTED: u64 = 1128       // the number of the handler `restarted`, kept by `watch`
ACTOR_S_STOPPED: u64 = 1136         // the number of the handler `stopped`, kept by `watch`
ACTOR_S_STOPPING: u64 = 1144        // 1 while a handler that called `stop()` is being abandoned
pub ACTOR_IRQ_ROUTES: u64 = 1152        // where each interrupt goes: 32 records of (actor, handler number)
pub ACTOR_IRQ_FIRST: u64 = 32           // the interrupts handled: peripheral IRQs 32 to 63
ACTOR_MSG_BUFFER: u64 = 1664        // the message being handled, copied out of its slot (8 words)
ACTOR_S_PROTECTED: u64 = 1088       // 1 while a protected call is running (actors.s)
ACTOR_S_CURRENT_ACTOR: u64 = 1096   // the actor whose handler or `new` is running (0: none)
ACTOR_S_IN_NEW: u64 = 1104          // 1 while that actor's `new` is running
pub ACTOR_S_LOST: u64 = 1112            // messages lost because the actor they were for failed or ended
pub ACTOR_S_RESTARTS: u64 = 1120        // actors restarted so far
ACTOR_WATCHES: u64 = 1824           // who watches whom: 14 records of (actor watched, watcher | 1 if it wants `stopped`)
ACTOR_WATCH_MAX: u64 = 14           // ends at 2048, where the actors start (decision 149)
ACTOR_FIRST_ACTOR: u64 = 2048       // actors start here

// A handler may run this long before it counts as failed (decisions 121, 133).
ACTOR_BUDGET_MS: u64 = 100
BUDGET_DEFAULT_HZ: u64 = 19200000   // the timer's rate if the firmware didn't set it (hardware.md 12)
HANDLER_RECORD_BYTES: u64 = 40      // one record of Fledgling's handler table

/// Makes room for an actor with `fields` words of fields and `args_words` words of `new`
/// arguments (copied from `args`, and kept so the actor can be restarted), then runs its
/// start stub, which runs `new`. Returns its reference. `dispatcher` is the address of the
/// actor's dispatcher and `start` of its start stub.
///
/// If the actor spawning is being restarted and this spawn is in its `new`, the actor it
/// spawned in the same position before is restarted in the same place instead of a new
/// one being made (decision 148), so references to it stay valid.
pub fn raven_spawn_actor(fields: u64, dispatcher: u64, rt_entry: u64, rt_args: u64,
                         rt_args_words: u64) -> u64 {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_parent: u64 = load64(rt_base + ACTOR_S_CURRENT_ACTOR)
        rt_was_in_new: u64 = load64(rt_base + ACTOR_S_IN_NEW)
        mut rt_actor: u64 = 0
        mut rt_reused: bool = false
        if rt_parent != 0 and rt_was_in_new != 0 {
            rt_old: u64 = load64(rt_parent - ACTOR_BEFORE_FIELDS + ACTOR_H_PENDING)
            if rt_old != 0 {
                rt_old_header: u64 = rt_old - ACTOR_BEFORE_FIELDS
                store64(rt_parent - ACTOR_BEFORE_FIELDS + ACTOR_H_PENDING,
                        load64(rt_old_header + ACTOR_H_NEXT_SIBLING))
                if load64(rt_old_header + ACTOR_H_DISPATCHER) == dispatcher {
                    rt_actor = rt_old
                    rt_reused = true
                    rerun_begin(rt_actor)
                } else {
                    end_actor(rt_old)           // a different kind of actor is spawned here now
                }
            }
        }
        if rt_actor == 0 {
            mut rt_next: u64 = load64(rt_base + ACTOR_S_NEXT)
            if rt_next == 0 {
                rt_next = rt_base + ACTOR_FIRST_ACTOR
            }
            rt_size: u64 = ACTOR_BEFORE_FIELDS + (fields + rt_args_words) * 8
            if rt_next + rt_size > actor_arena_limit() {
                panic("out of memory for actors")
            }
            store64(rt_base + ACTOR_S_NEXT, rt_next + rt_size)
            rt_actor = rt_next + ACTOR_BEFORE_FIELDS
            store64(rt_next + ACTOR_H_DISPATCHER, dispatcher)
            store64(rt_next + ACTOR_H_ARGS, rt_actor + fields * 8)
        }
        rt_header: u64 = rt_actor - ACTOR_BEFORE_FIELDS
        store64(rt_header + ACTOR_H_START, rt_entry)
        store64(rt_header + ACTOR_H_ARGS_WORDS, rt_args_words)
        store64(rt_header + ACTOR_H_PARENT, rt_parent)
        store64(rt_header + ACTOR_H_FLAGS, rt_was_in_new)       // ACTOR_F_IN_NEW is 1
        store64(rt_header + ACTOR_H_NEXT_SIBLING, 0)
        if rt_parent != 0 {
            rt_parent_header: u64 = rt_parent - ACTOR_BEFORE_FIELDS
            rt_last: u64 = load64(rt_parent_header + ACTOR_H_LAST_CHILD)
            if rt_last == 0 {
                store64(rt_parent_header + ACTOR_H_FIRST_CHILD, rt_actor)
            } else {
                store64(rt_last - ACTOR_BEFORE_FIELDS + ACTOR_H_NEXT_SIBLING, rt_actor)
            }
            store64(rt_parent_header + ACTOR_H_LAST_CHILD, rt_actor)
        }
        rt_kept: u64 = load64(rt_header + ACTOR_H_ARGS)
        copying: loop rt_w: u64 in 0..rt_args_words {
            store64(rt_kept + rt_w * 8, load64(rt_args + rt_w * 8))
        }
        if rt_entry != 0 {
            store64(rt_base + ACTOR_S_CURRENT_ACTOR, rt_actor)
            store64(rt_base + ACTOR_S_IN_NEW, 1)
            call_dispatch(rt_entry, rt_actor, 0, rt_kept)
            store64(rt_base + ACTOR_S_CURRENT_ACTOR, rt_parent)
            store64(rt_base + ACTOR_S_IN_NEW, rt_was_in_new)
        }
        rerun_end(rt_actor)
        if rt_reused {
            notify_restarted(rt_actor)         // restarted in place with its parent
        }
        return rt_actor
    }
}

/// Empties an actor's mailbox, counting what was in it as lost.
fn clear_mailbox(rt_who: u64) {
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        rt_base: u64 = actor_arena_base()
        store64(rt_base + ACTOR_S_LOST,
                load64(rt_base + ACTOR_S_LOST) + load64(rt_header + ACTOR_H_COUNT))
        store64(rt_header + ACTOR_H_COUNT, 0)
    }
}

/// An actor ends: its mailbox is emptied and sends to it are refused from now on (a `reliable`
/// send answers `Gone`), and so are those of everything it spawned. Its watchers that asked
/// for it are told `stopped`, and what it watched is forgotten. Its place stays, as a tombstone, because a
/// reference to it may still exist (decision 148).
fn end_actor(rt_who: u64) {
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        if (load64(rt_header + ACTOR_H_FLAGS) and ACTOR_F_ENDED) != 0 {
            return                              // already ended: its watchers were told
        }
        store64(rt_header + ACTOR_H_FLAGS, load64(rt_header + ACTOR_H_FLAGS) or ACTOR_F_ENDED)
        drop_watches(rt_who)
        clear_mailbox(rt_who)
        end_list(load64(rt_header + ACTOR_H_FIRST_CHILD))
        end_list(load64(rt_header + ACTOR_H_PENDING))
        store64(rt_header + ACTOR_H_FIRST_CHILD, 0)
        store64(rt_header + ACTOR_H_LAST_CHILD, 0)
        store64(rt_header + ACTOR_H_PENDING, 0)
        notify_stopped(rt_who)
    }
}

/// Ends each actor on a list of siblings, and what they spawned.
fn end_list(rt_list: u64) {
    mut rt_child: u64 = rt_list
    walking: loop rt_child != 0 {
        unsafe {
            rt_next: u64 = load64(rt_child - ACTOR_BEFORE_FIELDS + ACTOR_H_NEXT_SIBLING)
            end_actor(rt_child)
            rt_child = rt_next
        }
    }
}

/// Starts an actor's restart (and a child's, when its parent's `new` reaches the spawn
/// that makes it): the actors it spawned in a handler end; those it spawned in its `new`
/// wait, in order, to be matched by the spawns in the `new` that is about to run again;
/// its fields are cleared and its mailbox emptied.
fn rerun_begin(rt_who: u64) {
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        mut rt_child: u64 = load64(rt_header + ACTOR_H_FIRST_CHILD)
        mut rt_head: u64 = 0
        mut rt_tail: u64 = 0
        sorting: loop rt_child != 0 {
            rt_child_header: u64 = rt_child - ACTOR_BEFORE_FIELDS
            rt_after: u64 = load64(rt_child_header + ACTOR_H_NEXT_SIBLING)
            if (load64(rt_child_header + ACTOR_H_FLAGS) and ACTOR_F_IN_NEW) != 0 {
                store64(rt_child_header + ACTOR_H_NEXT_SIBLING, 0)
                if rt_head == 0 {
                    rt_head = rt_child
                } else {
                    store64(rt_tail - ACTOR_BEFORE_FIELDS + ACTOR_H_NEXT_SIBLING, rt_child)
                }
                rt_tail = rt_child
            } else {
                end_actor(rt_child)
            }
            rt_child = rt_after
        }
        store64(rt_header + ACTOR_H_PENDING, rt_head)
        store64(rt_header + ACTOR_H_FIRST_CHILD, 0)
        store64(rt_header + ACTOR_H_LAST_CHILD, 0)
        store64(rt_header + ACTOR_H_FLAGS, load64(rt_header + ACTOR_H_FLAGS) and ACTOR_F_IN_NEW)
        drop_watches(rt_who)
        clear_mailbox(rt_who)
        rt_fields_end: u64 = load64(rt_header + ACTOR_H_ARGS)
        mut rt_at: u64 = rt_who
        clearing: loop rt_at < rt_fields_end {
            store64(rt_at, 0)
            rt_at = rt_at + 8
        }
    }
}

/// Ends a restart: the actors spawned in the previous `new` that this one did not spawn
/// again end.
fn rerun_end(rt_who: u64) {
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        end_list(load64(rt_header + ACTOR_H_PENDING))
        store64(rt_header + ACTOR_H_PENDING, 0)
    }
}

/// Restarts an actor whose handler failed: its `new` runs again on the arguments it was
/// spawned with, with its fields cleared and its mailbox empty. References to it stay
/// valid. If that `new` fails too, the actor ends (a restart that fails would otherwise
/// repeat for ever).
fn restart_actor(rt_who: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        store64(rt_base + ACTOR_S_RESTARTS, load64(rt_base + ACTOR_S_RESTARTS) + 1)
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        rerun_begin(rt_who)
        rt_start: u64 = load64(rt_header + ACTOR_H_START)
        if rt_start != 0 {
            store64(rt_base + ACTOR_S_CURRENT_ACTOR, rt_who)
            store64(rt_base + ACTOR_S_IN_NEW, 1)
            timer_arm(budget_ticks())
            rt_failed: u64 = call_protected(rt_start, rt_who, 0, load64(rt_header + ACTOR_H_ARGS))
            timer_disarm()
            store64(rt_base + ACTOR_S_CURRENT_ACTOR, 0)
            store64(rt_base + ACTOR_S_IN_NEW, 0)
            if rt_failed != 0 {
                end_actor(rt_who)
                return
            }
        }
        rerun_end(rt_who)
    }
    notify_restarted(rt_who)
}

/// `watch(watched, watcher)`, which the compiler turns into a call of this: from now on
/// `watcher` is sent its handler number `number` (`restarted`) each time `watched` restarts.
/// Watching twice is the same as once. A watch ends when the watcher restarts or ends,
/// so its `new` sets it up again. The table is small (14); one more panics.
pub fn raven_watch(watched: u64, watcher: u64, number: u64, stopped_plus_one: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        store64(rt_base + ACTOR_S_RESTARTED, number)
        mut rt_tag: u64 = watcher
        if stopped_plus_one != 0 {
            store64(rt_base + ACTOR_S_STOPPED, stopped_plus_one - 1)
            rt_tag = watcher or 1               // actors are 8-byte aligned: bit 0 is free
        }
        mut rt_free: u64 = 0
        scanning: loop rt_i: u64 in 0..ACTOR_WATCH_MAX {
            rt_record: u64 = rt_base + ACTOR_WATCHES + rt_i * 16
            if load64(rt_record) == watched and watcher_of(load64(rt_record + 8)) == watcher {
                store64(rt_record + 8, load64(rt_record + 8) or rt_tag)   // `stopped` asked for now
                return
            }
            if rt_free == 0 and load64(rt_record) == 0 {
                rt_free = rt_record
            }
        }
        if rt_free == 0 {
            panic("too many watches")
        }
        store64(rt_free, watched)
        store64(rt_free + 8, rt_tag)
    }
}

/// The watcher in a watch record's second word (bit 0 says it wants `stopped`).
fn watcher_of(rt_tag: u64) -> u64 {
    return (rt_tag shr 1) shl 1
}

/// Forgets what `rt_who` watches (it restarts or ends).
fn drop_watches(rt_who: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        dropping: loop rt_i: u64 in 0..ACTOR_WATCH_MAX {
            rt_record: u64 = rt_base + ACTOR_WATCHES + rt_i * 16
            if watcher_of(load64(rt_record + 8)) == rt_who {
                store64(rt_record, 0)
                store64(rt_record + 8, 0)
            }
        }
    }
}

/// `rt_who` has restarted and its `new` has run again: tell each watcher with the message
/// `restarted`. It is lossy: one already waiting stands for this one, and a full mailbox
/// drops it.
fn notify_restarted(rt_who: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_number: u64 = load64(rt_base + ACTOR_S_RESTARTED)
        telling: loop rt_i: u64 in 0..ACTOR_WATCH_MAX {
            rt_record: u64 = rt_base + ACTOR_WATCHES + rt_i * 16
            if load64(rt_record) == rt_who {
                rt_watcher: u64 = watcher_of(load64(rt_record + 8))
                if not rt_queued(rt_watcher, rt_number) {
                    discard rt_enqueue(rt_watcher, rt_number, 0, 0)
                }
            }
        }
    }
}

/// `rt_who` has ended: tell each watcher that asked for it the message `stopped` (lossy: one
/// already waiting stands for this one), then forget the watches on it, which can never fire.
fn notify_stopped(rt_who: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_number: u64 = load64(rt_base + ACTOR_S_STOPPED)
        telling: loop rt_i: u64 in 0..ACTOR_WATCH_MAX {
            rt_record: u64 = rt_base + ACTOR_WATCHES + rt_i * 16
            if load64(rt_record) == rt_who {
                rt_tag: u64 = load64(rt_record + 8)
                rt_watcher: u64 = watcher_of(rt_tag)
                if (rt_tag and 1) != 0 and not rt_queued(rt_watcher, rt_number) {
                    discard rt_enqueue(rt_watcher, rt_number, 0, 0)
                }
                store64(rt_record, 0)
                store64(rt_record + 8, 0)
            }
        }
    }
}

/// `stop()`: the running handler's actor ends. The handler is abandoned where it stands,
/// like a failure, but nothing is reported and the actor is not restarted (decision 150).
pub fn raven_stop_self() {
    rt_base: u64 = actor_arena_base()
    unsafe {
        store64(rt_base + ACTOR_S_STOPPING, 1)
    }
    actor_failed()
}

/// `stop(target)`: `target` ends, if the caller is the actor that spawned it (code outside
/// any actor, such as `test_main`, is the spawner of what it spawns); from anyone else it is a
/// failure like any bug (decision 147). Stopping an actor that has ended does nothing; stopping
/// oneself is `stop()`.
pub fn raven_stop(target: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_caller: u64 = load64(rt_base + ACTOR_S_CURRENT_ACTOR)
        if target == rt_caller {
            raven_stop_self()
        }
        if load64(target - ACTOR_BEFORE_FIELDS + ACTOR_H_PARENT) != rt_caller {
            panic("only the actor that spawned an actor can stop it")
        }
        end_actor(target)
    }
}

/// Sends a message to `target`: puts it in the mailbox, or drops it and
/// counts the drop if the mailbox is full. Used by every send of a `lossy`
/// handler. `payload` is the address of `words` words (at most 8) to copy into it.
pub fn raven_send(target: u64, handler: u64, payload: u64, words: u64) {
    if not rt_enqueue(target, handler, payload, words) {
        unsafe {
            rt_base: u64 = actor_arena_base()
            store64(rt_base + ACTOR_S_DROPPED, load64(rt_base + ACTOR_S_DROPPED) + 1)
        }
    }
}

/// Sends a message to a `reliable` handler: the same, except that a full
/// mailbox is not a drop. The sender is told and decides what the message is
/// worth (decision 126).
pub fn raven_send_reliable(target: u64, handler: u64, payload: u64, words: u64) -> Sent {
    if rt_enqueue(target, handler, payload, words) {
        return Delivered
    }
    unsafe {
        if (load64(target - ACTOR_BEFORE_FIELDS + ACTOR_H_FLAGS) and ACTOR_F_ENDED) != 0 {
            return Gone
        }
    }
    return MailboxFull
}

/// Puts a message in `target`'s mailbox and queues the actor to run. Returns
/// false, changing nothing, if the mailbox is full.
fn rt_enqueue(target: u64, handler: u64, payload: u64, words: u64) -> bool {
    rt_header: u64 = target - ACTOR_BEFORE_FIELDS
    unsafe {
        if (load64(rt_header + ACTOR_H_FLAGS) and ACTOR_F_ENDED) != 0 {
            return false
        }
        rt_count: u64 = load64(rt_header + ACTOR_H_COUNT)
        if rt_count == ACTOR_SLOTS {
            return false
        }
        rt_first: u64 = load64(rt_header + ACTOR_H_FIRST)
        rt_slot: u64 = rt_header + ACTOR_HEADER_WORDS * 8 +
                       ((rt_first + rt_count) % ACTOR_SLOTS) * ACTOR_SLOT_WORDS * 8
        store64(rt_slot, handler)
        copying: loop rt_w: u64 in 0..words {
            store64(rt_slot + 8 + rt_w * 8, load64(payload + rt_w * 8))
        }
        store64(rt_header + ACTOR_H_COUNT, rt_count + 1)
        if load64(rt_header + ACTOR_H_QUEUED) == 0 {
            store64(rt_header + ACTOR_H_QUEUED, 1)
            run_queue_push(target)
        }
        return true
    }
}

/// Turns the interrupts that have fired into messages, and switches each source back
/// on (vectors.s switched it off). A source still asserting fires again at once, so
/// a handler can be called with nothing left to do and must cope with that.
pub fn deliver_interrupts() {
    mut rt_pending: u64 = irq_take_pending()
    mut rt_bit: u64 = 0
    delivering: loop rt_pending != 0 {
        if (rt_pending and 1) != 0 {
            deliver_interrupt(ACTOR_IRQ_FIRST + rt_bit)
        }
        rt_pending = rt_pending shr 1
        rt_bit += 1
    }
}

fn deliver_interrupt(line: u64) {
    unsafe {
        rt_slot: u64 = actor_arena_base() + ACTOR_IRQ_ROUTES + (line - ACTOR_IRQ_FIRST) * 16
        rt_target: u64 = load64(rt_slot)
        if rt_target != 0 {
            rt_number: u64 = load64(rt_slot + 8)
            if not rt_queued(rt_target, rt_number) {
                discard rt_enqueue(rt_target, rt_number, 0, 0)    // full: the source fires again
            }
        }
    }
    irq_enable_source(line)
}

/// Is a message for `handler` already waiting in `target`'s mailbox?
fn rt_queued(target: u64, handler: u64) -> bool {
    rt_header: u64 = target - ACTOR_BEFORE_FIELDS
    unsafe {
        rt_first: u64 = load64(rt_header + ACTOR_H_FIRST)
        rt_count: u64 = load64(rt_header + ACTOR_H_COUNT)
        looking: loop i: u64 in 0..rt_count {
            rt_slot: u64 = rt_header + ACTOR_HEADER_WORDS * 8 +
                           ((rt_first + i) % ACTOR_SLOTS) * ACTOR_SLOT_WORDS * 8
            if load64(rt_slot) == handler {
                return true
            }
        }
    }
    return false
}

pub fn actors_waiting() -> u64 {
    unsafe {
        return load64(actor_arena_base() + ACTOR_S_RUNQ_COUNT)
    }
}

fn run_queue_push(actor_ref: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_waiting: u64 = load64(rt_base + ACTOR_S_RUNQ_COUNT)
        if rt_waiting == ACTOR_RUNQ_SLOTS {
            panic("run queue full")
        }
        rt_front: u64 = load64(rt_base + ACTOR_S_RUNQ_FIRST)
        store64(rt_base + ACTOR_RUNQ_OFFSET + ((rt_front + rt_waiting) % ACTOR_RUNQ_SLOTS) * 8,
                actor_ref)
        store64(rt_base + ACTOR_S_RUNQ_COUNT, rt_waiting + 1)
    }
}

pub fn run_one_turn() {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_front: u64 = load64(rt_base + ACTOR_S_RUNQ_FIRST)
        rt_actor: u64 = load64(rt_base + ACTOR_RUNQ_OFFSET + rt_front * 8)
        store64(rt_base + ACTOR_S_RUNQ_FIRST, (rt_front + 1) % ACTOR_RUNQ_SLOTS)
        store64(rt_base + ACTOR_S_RUNQ_COUNT, load64(rt_base + ACTOR_S_RUNQ_COUNT) - 1)

        // Take the oldest message out of the actor's mailbox.
        rt_header: u64 = rt_actor - ACTOR_BEFORE_FIELDS
        if load64(rt_header + ACTOR_H_COUNT) == 0 {
            store64(rt_header + ACTOR_H_QUEUED, 0)      // its messages were lost in a restart
            return
        }
        rt_first: u64 = load64(rt_header + ACTOR_H_FIRST)
        rt_slot: u64 = rt_header + ACTOR_HEADER_WORDS * 8 + rt_first * ACTOR_SLOT_WORDS * 8
        rt_handler: u64 = load64(rt_slot)
        // Copy the payload out of the slot first: the handler may send to its own actor,
        // and that send can reuse this slot.
        rt_buffer: u64 = rt_base + ACTOR_MSG_BUFFER
        copying: loop rt_w: u64 in 0..ACTOR_MESSAGE_WORDS {
            store64(rt_buffer + rt_w * 8, load64(rt_slot + 8 + rt_w * 8))
        }
        rt_left: u64 = load64(rt_header + ACTOR_H_COUNT) - 1
        store64(rt_header + ACTOR_H_FIRST, (rt_first + 1) % ACTOR_SLOTS)
        store64(rt_header + ACTOR_H_COUNT, rt_left)
        if rt_left > 0 {
            run_queue_push(rt_actor)
        } else {
            store64(rt_header + ACTOR_H_QUEUED, 0)
        }
        rt_dispatcher: u64 = load64(rt_header + ACTOR_H_DISPATCHER)
        store64(rt_base + ACTOR_S_CURRENT_DISPATCHER, rt_dispatcher)
        store64(rt_base + ACTOR_S_CURRENT_HANDLER, rt_handler)
        store64(rt_base + ACTOR_S_CURRENT_ACTOR, rt_actor)
        store64(rt_base + ACTOR_S_IN_NEW, 0)
        timer_arm(budget_ticks())
        rt_failed: u64 = call_protected(rt_dispatcher, rt_actor, rt_handler, rt_buffer)
        timer_disarm()
        store64(rt_base + ACTOR_S_CURRENT_ACTOR, 0)
        if rt_failed != 0 {
            if load64(rt_base + ACTOR_S_STOPPING) != 0 {
                store64(rt_base + ACTOR_S_STOPPING, 0)
                end_actor(rt_actor)                 // it called stop()
            } else {
                restart_actor(rt_actor)
            }
        }
    }
}

/// The handler budget in ticks of the generic timer.
fn budget_ticks() -> u64 {
    mut rt_hz: u64 = counter_frequency()
    if rt_hz == 0 {
        rt_hz = BUDGET_DEFAULT_HZ
    }
    return ACTOR_BUDGET_MS * (rt_hz / 1000)
}

/// Called by the IRQ vector (kernel/arch/aarch64/vectors.s) when the budget timer
/// fires: the handler that was running has failed. Until supervision exists that is
/// reported like a panic, naming the handler, and the core halts.
pub fn raven_budget_overrun() {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_dispatcher: u64 = load64(rt_base + ACTOR_S_CURRENT_DISPATCHER)
        rt_handler: u64 = load64(rt_base + ACTOR_S_CURRENT_HANDLER)
        mut rt_record: u64 = handler_table_start()
        rt_end: u64 = handler_table_end()
        searching: loop rt_record < rt_end {
            if load64(rt_record) == rt_dispatcher and load64(rt_record + 8) == rt_handler {
                rook_budget_panic(load64(rt_record + 16), ACTOR_BUDGET_MS,
                                  load64(rt_record + 24), load64(rt_record + 32))
            }
            rt_record = rt_record + HANDLER_RECORD_BYTES
        }
    }
    panic("a handler ran past its time budget")
}
