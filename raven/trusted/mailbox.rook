// Raven's mailboxes and scheduler, on one core: where actors live, their mailboxes, and
// the scheduler. An internal module: application code can't import it (decision 142);
// what an application may use is in `actors`. Fledgling compiles `spawn` and every send into calls to
// `raven_spawn_actor` and `raven_send` here; the scheduler runs one message at
// a time through the dispatcher Fledgling generates for each actor.
//
// Everything lives in one fixed arena (kernel/arch/aarch64/actors.s), so this
// code keeps no global variables: Raven's own tables are at the start of the
// arena. Actors are never freed (decision 119).
//
// An actor's memory, in 8-byte words, with its reference pointing at the fields:
//     [ header: 8 ][ mailbox: 16 slots of 9 ][ the actor's fields ... ]
// A slot holds a handler number and up to eight payload words: the handler's arguments,
// a struct or enum counting as its size (decision 135).

import actors: Sent
import assembly: domain_map_device_of, raven_arena_address, core_wait_event, spawn_count, pool_wipe, core_id, core_pause, domain_actor_of, domain_pool_base_of, domain_pools_end, domain_pools_start, domain_set_actor_of, pending_add, pending_load, pending_sub, ring_pop, ring_push, ring_scratch, rings_waiting, spawn_next_core, domain_budget_begin, domain_budget_end, domain_wipe_data, domain_actor, domain_call_number, domain_enter, domain_pool_base, domain_report, domain_report_panic, domain_resume, domain_saved_x, domain_set_actor, domain_wipe, image_rodata_end, image_rodata_start, actor_failed, actor_arena_base, actor_arena_limit, call_dispatch, call_protected, handler_table_end, handler_table_start, irq_enable_source, irq_take_pending, rook_budget_panic, timer_arm, timer_disarm
import hardware: counter_frequency

ACTOR_HEADER_WORDS: u64 = 14
ACTOR_SLOTS: u64 = 16               // messages one mailbox holds (decision 113, g)
ACTOR_MESSAGE_WORDS: u64 = 8        // payload words in a message
ACTOR_SLOT_WORDS: u64 = 9           // a handler number and the payload
ACTOR_BEFORE_FIELDS: u64 = (ACTOR_HEADER_WORDS + ACTOR_SLOTS * ACTOR_SLOT_WORDS) * 8

// Header, as byte offsets from the start of the actor's memory.
ACTOR_H_DISPATCHER: u64 = 0         // address of its dispatcher
ACTOR_H_FIRST: u64 = 8              // slot of the oldest message
ACTOR_H_COUNT: u64 = 16             // messages waiting
ACTOR_H_QUEUED: u64 = 24            // 1 if it is in the run queue
ACTOR_H_START: u64 = 32             // its start stub, which runs `new` on stored arguments (0: none)
ACTOR_H_PARENT: u64 = 40            // the actor that spawned it (0: spawned outside any actor)
DEVICE_BASE: u64 = 0x3F000000       // the peripherals (devices.rook): an Mmio given to a domain lies inside
DEVICE_SPAN: u64 = 0x01000000
ACTOR_H_ARGS_WORDS: u64 = 48        // words of `new` arguments kept for a restart
ACTOR_H_FIRST_CHILD: u64 = 56       // the actors it spawned, in order: the first ...
ACTOR_H_NEXT_SIBLING: u64 = 64      // ... and each one's next
ACTOR_H_LAST_CHILD: u64 = 72
ACTOR_H_PENDING: u64 = 80           // during a restart: children not yet matched by a `spawn`
ACTOR_H_FLAGS: u64 = 88             // see ACTOR_F_*
ACTOR_H_ARGS: u64 = 96              // address of the kept `new` arguments
ACTOR_H_DOMAIN: u64 = 104           // the protection domain it lives in (bits 0 to 3, 0: Raven's own) and the core (bits 4
                                    // to 7); for an actor in the arena the bytes it takes, shifted left 8 (the walk that
                                    // finds actors)
ACTOR_F_IN_NEW: u64 = 1             // it was spawned by its spawner's `new`: kept across restarts
ACTOR_F_ENDED: u64 = 2              // it has ended: sends to it are refused
ACTOR_F_STARTING: u64 = 4           // its `new` has not run yet (on another core): messages wait, it is not scheduled

// Raven's tables, as byte offsets from the start of the arena.
ACTOR_S_NEXT: u64 = 0               // next free byte (0 until the first spawn)
ACTOR_S_RUNQ_FIRST: u64 = 8
ACTOR_S_RUNQ_COUNT: u64 = 16
pub ACTOR_S_DROPPED: u64 = 24           // messages dropped because a mailbox was full
ACTOR_S_CURRENT_DISPATCHER: u64 = 32  // the handler now running: its actor's dispatcher ...
ACTOR_S_CURRENT_HANDLER: u64 = 40     // ... and its number
ACTOR_S_IRQ_PENDING: u64 = 48       // bit n: peripheral interrupt 32 + n has fired (vectors.s)
ACTOR_RUNQ_OFFSET: u64 = 64         // the run queue: a ring of actor references
ACTOR_RUNQ_SLOTS: u64 = 128
ACTOR_S_RESTARTED: u64 = 1128       // the number of the handler `restarted`, kept by `watch`
ACTOR_S_STOPPED: u64 = 1136         // the number of the handler `stopped`, kept by `watch`
ACTOR_S_STOPPING: u64 = 1144        // 1 while a handler that called `stop()` is being abandoned
pub ACTOR_IRQ_ROUTES: u64 = 1152        // where each interrupt goes: 32 records of (actor, handler number)
pub ACTOR_IRQ_FIRST: u64 = 32           // the interrupts handled: peripheral IRQs 32 to 63
ACTOR_MSG_BUFFER: u64 = 1664        // the message being handled, copied out of its slot (8 words)
ACTOR_S_PROTECTED: u64 = 1088       // 1 while a protected call is running (actors.s)
ACTOR_S_CURRENT_ACTOR: u64 = 1096   // the actor whose handler or `new` is running (0: none)
ACTOR_S_IN_NEW: u64 = 1104          // 1 while that actor's `new` is running
pub ACTOR_S_LOST: u64 = 1112            // messages lost because the actor they were for failed or ended
pub ACTOR_S_RESTARTS: u64 = 1120        // actors restarted so far
ACTOR_WATCHES: u64 = 1824           // who watches whom: 14 records of (actor watched, watcher | 1 if it wants `stopped`)
ACTOR_WATCH_MAX: u64 = 14           // ends at 2048, where the actors start (decision 149)
ACTOR_FIRST_ACTOR: u64 = 2048       // actors start here

// A handler may run this long before it counts as failed (decisions 121, 133).
ACTOR_BUDGET_MS: u64 = 100
BUDGET_DEFAULT_HZ: u64 = 19200000   // the timer's rate if the firmware didn't set it (hardware.md 12)
HANDLER_RECORD_BYTES: u64 = 40      // one record of Fledgling's handler table

// Protection domains (decision 175; kernel/arch/aarch64/domain.s has the layout of a pool).
DOMAINS: u64 = 3
DOMAIN_FIELDS: u64 = 0x11000        // where an actor in a domain keeps its fields: its reference points here ...
DOMAIN_INBOX: u64 = 0x1FF000        // ... and the message it is handling is copied here
DOMAIN_POOL_BYTES: u64 = 0x200000
DOMAIN_STACK_FIRST: u64 = 0x1000    // the stack: [0x1000, 0x10000); then the control page; then the data
DOMAIN_STACK_END: u64 = 0x10000
REASON_DONE: u64 = 0                // why domain_enter returned (domain.s)
REASON_CALL: u64 = 3
REASON_BAD: u64 = 4                 // Raven's own: a request a domain may not make
REASON_REPORTED: u64 = 5            // Raven's own: it panicked and Raven has said so
// Records in the rings between cores (decision 181): 16 words. Word 0 says what it is, 1 is the actor it is for,
// 2 to 5 depend on the kind, 6 to 13 are message words, 14 the actor that was running when it was made, 15 a flag.
REC_SEND: u64 = 1                   // a message: 2 handler number, 3 words, 15 = 1: drop it if that handler is queued
REC_START: u64 = 2                  // run `new`: 2 its start stub, 3 argument words, 4 = 1: the actor is restarted in place
REC_WATCH: u64 = 3                  // watch_impl: 2 watcher, 3 handler `restarted`, 4 handler `stopped` plus one
REC_STOP: u64 = 4                   // end the actor
REC_DROP_WATCHES: u64 = 5           // a watcher ended or restarted: forget its watches
REC_PAYLOAD: u64 = 48               // byte offset of the message words in a record
SVC_SEND: u64 = 1                   // the calls (rtstubs.s)
SVC_SEND_RELIABLE: u64 = 2
SVC_PANIC: u64 = 8

/// Makes room for an actor with `fields` words of fields and `args_words` words of `new`
/// arguments (copied from `args`, and kept so the actor can be restarted), then runs its
/// start stub, which runs `new`. Returns its reference. `dispatcher` is the address of the
/// actor's dispatcher and `start` of its start stub.
///
/// If the actor spawning is being restarted and this spawn is in its `new`, the actor it
/// spawned in the same position before is restarted in the same place instead of a new
/// one being made (decision 148), so references to it stay valid.
pub fn spawn_actor_impl(fields: u64, dispatcher: u64, rt_entry: u64, rt_args: u64,
                        rt_args_words: u64) -> u64 {
    return spawn_common(fields, dispatcher, rt_entry, rt_args, rt_args_words, false, 0)
}

/// The same for an actor that lives in a protection domain of its own (`separate actor`, decision 172): the
/// next free domain is given to it, its fields are in the domain's pool and its header and mailbox in the
/// pool's control page, which only Raven reaches. Its `new` runs in the domain.
///
/// `rt_devices` has bit i set if words i and i+1 of the arguments are an `Mmio` (base, size): the compiler marks them.
/// The pages it covers are mapped into the domain before `new` runs (decision 182).
pub fn spawn_separate_impl(fields: u64, dispatcher: u64, rt_entry: u64, rt_args: u64,
                           rt_args_words: u64, rt_devices: u64) -> u64 {
    return spawn_common(fields, dispatcher, rt_entry, rt_args, rt_args_words, true, rt_devices)
}

/// Maps the registers named by the `Mmio` arguments of a `separate` actor's `new` into its domain (decision 182). The
/// compiler says which words are an `Mmio`; Raven still checks each one: whole pages, inside the peripherals.
fn grant_devices(gd_core: u64, gd_domain: u64, gd_args: u64, gd_words: u64, gd_mask: u64) {
    granting: loop gd_i: u64 in 0..gd_words {
        if ((gd_mask shr gd_i) and 1) == 1 {
            unsafe {
                if gd_i + 1 >= gd_words {
                    panic("an Mmio argument is cut short")
                }
                gd_base: u64 = load64(gd_args + gd_i * 8)
                gd_size: u64 = load64(gd_args + (gd_i + 1) * 8)
                if gd_size == 0 or gd_size > DEVICE_SPAN or gd_base < DEVICE_BASE or gd_base > DEVICE_BASE + DEVICE_SPAN - gd_size {
                    panic("an Mmio given to a separate actor is outside the peripherals")
                }
                if gd_base % 4096 != 0 or gd_size % 4096 != 0 {
                    panic("an Mmio given to a separate actor is not whole pages")
                }
                mut gd_at: u64 = gd_base
                paging: loop gd_at < gd_base + gd_size {
                    if domain_map_device_of(gd_core, gd_domain, gd_at) != 0 {
                        panic("a separate actor can have registers from one 2 MB block of the peripherals only")
                    }
                    gd_at += 4096
                }
            }
        }
    }
}

fn spawn_common(fields: u64, dispatcher: u64, rt_entry: u64, rt_args: u64,
                rt_args_words: u64, rt_separate: bool, rt_devices: u64) -> u64 {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_parent: u64 = load64(rt_base + ACTOR_S_CURRENT_ACTOR)
        rt_was_in_new: u64 = load64(rt_base + ACTOR_S_IN_NEW)
        mut rt_actor: u64 = 0
        mut rt_reused: bool = false
        if rt_parent != 0 and rt_was_in_new != 0 {
            rt_old: u64 = load64(rt_parent - ACTOR_BEFORE_FIELDS + ACTOR_H_PENDING)
            if rt_old != 0 {
                rt_old_header: u64 = rt_old - ACTOR_BEFORE_FIELDS
                store64(rt_parent - ACTOR_BEFORE_FIELDS + ACTOR_H_PENDING,
                        load64(rt_old_header + ACTOR_H_NEXT_SIBLING))
                if load64(rt_old_header + ACTOR_H_DISPATCHER) == dispatcher {
                    rt_actor = rt_old
                    rt_reused = true
                    if core_of_actor(rt_actor) == core_id() {
                        rerun_begin(rt_actor)   // (one on another core is rerun by that core, in REC_START)
                    }
                } else {
                    end_actor_anywhere(rt_old)  // a different kind of actor is spawned here now
                }
            }
        }
        if rt_actor == 0 and rt_separate {
            rt_core: u64 = spawn_next_core()    // Raven decides where it lives: 1, 2, 3, 0, 1, ... (decision 180)
            rt_domain: u64 = free_domain(rt_core)
            if (fields + rt_args_words) * 8 > DOMAIN_INBOX - DOMAIN_FIELDS {
                panic("a separate actor's fields do not fit its domain")
            }
            rt_pool: u64 = domain_pool_base_of(rt_core, rt_domain)
            pool_wipe(rt_pool)
            rt_actor = rt_pool + DOMAIN_FIELDS
            store64(rt_actor - ACTOR_BEFORE_FIELDS + ACTOR_H_DISPATCHER, dispatcher)
            store64(rt_actor - ACTOR_BEFORE_FIELDS + ACTOR_H_ARGS, rt_actor + fields * 8)
            store64(rt_actor - ACTOR_BEFORE_FIELDS + ACTOR_H_DOMAIN, rt_domain or (rt_core shl 4))
            domain_set_actor_of(rt_core, rt_domain, rt_actor)
            grant_devices(rt_core, rt_domain, rt_args, rt_args_words, rt_devices)
        }
        if rt_actor == 0 {
            mut rt_next: u64 = load64(rt_base + ACTOR_S_NEXT)
            if rt_next == 0 {
                rt_next = rt_base + ACTOR_FIRST_ACTOR
            }
            rt_size: u64 = ACTOR_BEFORE_FIELDS + (fields + rt_args_words) * 8
            if rt_next + rt_size > actor_arena_limit() {
                panic("out of memory for actors")
            }
            store64(rt_base + ACTOR_S_NEXT, rt_next + rt_size)
            rt_actor = rt_next + ACTOR_BEFORE_FIELDS
            store64(rt_next + ACTOR_H_DISPATCHER, dispatcher)
            store64(rt_next + ACTOR_H_ARGS, rt_actor + fields * 8)
            store64(rt_next + ACTOR_H_DOMAIN, rt_size shl 8)
        }
        rt_header: u64 = rt_actor - ACTOR_BEFORE_FIELDS
        store64(rt_header + ACTOR_H_START, rt_entry)
        store64(rt_header + ACTOR_H_ARGS_WORDS, rt_args_words)
        store64(rt_header + ACTOR_H_PARENT, rt_parent)
        mut rt_flags: u64 = rt_was_in_new                       // ACTOR_F_IN_NEW is 1
        if core_of_actor(rt_actor) != core_id() and not rt_reused {
            rt_flags = rt_flags or ACTOR_F_STARTING             // messages may reach it before its `new` has run
        }
        store64(rt_header + ACTOR_H_FLAGS, rt_flags)
        store64(rt_header + ACTOR_H_NEXT_SIBLING, 0)
        if rt_parent != 0 {
            rt_parent_header: u64 = rt_parent - ACTOR_BEFORE_FIELDS
            rt_last: u64 = load64(rt_parent_header + ACTOR_H_LAST_CHILD)
            if rt_last == 0 {
                store64(rt_parent_header + ACTOR_H_FIRST_CHILD, rt_actor)
            } else {
                store64(rt_last - ACTOR_BEFORE_FIELDS + ACTOR_H_NEXT_SIBLING, rt_actor)
            }
            store64(rt_parent_header + ACTOR_H_LAST_CHILD, rt_actor)
        }
        if core_of_actor(rt_actor) != core_id() {
            // It lives on another core, which runs its `new` and keeps its arguments: the record carries them.
            rt_rec: u64 = ring_scratch(0)
            store64(rt_rec, REC_START)
            store64(rt_rec + 8, rt_actor)
            store64(rt_rec + 16, rt_entry)
            store64(rt_rec + 24, rt_args_words)
            store64(rt_rec + 32, if rt_reused { 1 } else { 0 })
            copying_away: loop rt_v: u64 in 0..rt_args_words {
                store64(rt_rec + REC_PAYLOAD + rt_v * 8, load64(rt_args + rt_v * 8))
            }
            push_record(core_of_actor(rt_actor), rt_rec)
            return rt_actor
        }
        rt_kept: u64 = load64(rt_header + ACTOR_H_ARGS)
        copying: loop rt_w: u64 in 0..rt_args_words {
            store64(rt_kept + rt_w * 8, load64(rt_args + rt_w * 8))
        }
        if rt_entry != 0 {
            store64(rt_base + ACTOR_S_CURRENT_ACTOR, rt_actor)
            store64(rt_base + ACTOR_S_IN_NEW, 1)
            if domain_of(rt_actor) == 0 {
                call_dispatch(rt_entry, rt_actor, 0, rt_kept)
            } else if run_in_domain(domain_of(rt_actor), rt_entry, rt_actor, 0, rt_kept) != 0 {
                actor_failed()                  // its `new` failed: like a panic in a plain one
            }
            store64(rt_base + ACTOR_S_CURRENT_ACTOR, rt_parent)
            store64(rt_base + ACTOR_S_IN_NEW, rt_was_in_new)
        }
        rerun_end(rt_actor)
        if rt_reused {
            notify_restarted(rt_actor)         // restarted in place with its parent
        }
        return rt_actor
    }
}

/// Empties an actor's mailbox, counting what was in it as lost.
fn clear_mailbox(rt_who: u64) {
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        rt_base: u64 = actor_arena_base()
        store64(rt_base + ACTOR_S_LOST,
                load64(rt_base + ACTOR_S_LOST) + load64(rt_header + ACTOR_H_COUNT))
        pending_sub(load64(rt_header + ACTOR_H_COUNT))      // those messages are over
        store64(rt_header + ACTOR_H_COUNT, 0)
    }
}

/// An actor ends: its mailbox is emptied and sends to it are refused from now on (a `reliable`
/// send answers `Gone`), and so are those of everything it spawned. Its watchers that asked
/// for it are told `stopped`, and what it watched is forgotten. Its place stays, as a tombstone, because a
/// reference to it may still exist (decision 148).
fn end_actor(rt_who: u64) {
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        if (load64(rt_header + ACTOR_H_FLAGS) and ACTOR_F_ENDED) != 0 {
            return                              // already ended: its watchers were told
        }
        store64(rt_header + ACTOR_H_FLAGS, load64(rt_header + ACTOR_H_FLAGS) or ACTOR_F_ENDED)
        drop_watches(rt_who)
        clear_mailbox(rt_who)
        end_list(load64(rt_header + ACTOR_H_FIRST_CHILD))
        end_list(load64(rt_header + ACTOR_H_PENDING))
        store64(rt_header + ACTOR_H_FIRST_CHILD, 0)
        store64(rt_header + ACTOR_H_LAST_CHILD, 0)
        store64(rt_header + ACTOR_H_PENDING, 0)
        notify_stopped(rt_who)
    }
}

/// Ends each actor on a list of siblings, and what they spawned.
fn end_list(rt_list: u64) {
    mut rt_child: u64 = rt_list
    walking: loop rt_child != 0 {
        unsafe {
            rt_next: u64 = load64(rt_child - ACTOR_BEFORE_FIELDS + ACTOR_H_NEXT_SIBLING)
            end_actor_anywhere(rt_child)
            rt_child = rt_next
        }
    }
}

/// Starts an actor's restart (and a child's, when its parent's `new` reaches the spawn
/// that makes it): the actors it spawned in a handler end; those it spawned in its `new`
/// wait, in order, to be matched by the spawns in the `new` that is about to run again;
/// its fields are cleared and its mailbox emptied.
fn rerun_begin(rt_who: u64) {
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        mut rt_child: u64 = load64(rt_header + ACTOR_H_FIRST_CHILD)
        mut rt_head: u64 = 0
        mut rt_tail: u64 = 0
        sorting: loop rt_child != 0 {
            rt_child_header: u64 = rt_child - ACTOR_BEFORE_FIELDS
            rt_after: u64 = load64(rt_child_header + ACTOR_H_NEXT_SIBLING)
            if (load64(rt_child_header + ACTOR_H_FLAGS) and ACTOR_F_IN_NEW) != 0 {
                store64(rt_child_header + ACTOR_H_NEXT_SIBLING, 0)
                if rt_head == 0 {
                    rt_head = rt_child
                } else {
                    store64(rt_tail - ACTOR_BEFORE_FIELDS + ACTOR_H_NEXT_SIBLING, rt_child)
                }
                rt_tail = rt_child
            } else {
                end_actor_anywhere(rt_child)
            }
            rt_child = rt_after
        }
        store64(rt_header + ACTOR_H_PENDING, rt_head)
        store64(rt_header + ACTOR_H_FIRST_CHILD, 0)
        store64(rt_header + ACTOR_H_LAST_CHILD, 0)
        store64(rt_header + ACTOR_H_FLAGS, load64(rt_header + ACTOR_H_FLAGS) and ACTOR_F_IN_NEW)
        drop_watches(rt_who)
        clear_mailbox(rt_who)
        rt_fields_end: u64 = load64(rt_header + ACTOR_H_ARGS)
        mut rt_at: u64 = rt_who
        clearing: loop rt_at < rt_fields_end {
            store64(rt_at, 0)
            rt_at = rt_at + 8
        }
        if domain_of(rt_who) != 0 {
            wipe_domain(rt_who)
        }
    }
}

/// A domain restarts as a unit (decision 176): everything its memory held goes, but the arguments the actor was
/// spawned with, which are kept in its data for the `new` that is about to run again.
fn wipe_domain(rt_who: u64) {
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        rt_kept: u64 = load64(rt_header + ACTOR_H_ARGS)
        rt_words: u64 = load64(rt_header + ACTOR_H_ARGS_WORDS)
        rt_scratch: u64 = actor_arena_base() + ACTOR_MSG_BUFFER
        saving: loop rt_w: u64 in 0..rt_words {
            store64(rt_scratch + rt_w * 8, load64(rt_kept + rt_w * 8))
        }
        domain_wipe_data(domain_of(rt_who))
        restoring: loop rt_x: u64 in 0..rt_words {
            store64(rt_kept + rt_x * 8, load64(rt_scratch + rt_x * 8))
        }
    }
}

/// Ends a restart: the actors spawned in the previous `new` that this one did not spawn
/// again end.
fn rerun_end(rt_who: u64) {
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        end_list(load64(rt_header + ACTOR_H_PENDING))
        store64(rt_header + ACTOR_H_PENDING, 0)
    }
}

/// Restarts an actor whose handler failed: its `new` runs again on the arguments it was
/// spawned with, with its fields cleared and its mailbox empty. References to it stay
/// valid. If that `new` fails too, the actor ends (a restart that fails would otherwise
/// repeat for ever).
fn restart_actor(rt_who: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        store64(rt_base + ACTOR_S_RESTARTS, load64(rt_base + ACTOR_S_RESTARTS) + 1)
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        rerun_begin(rt_who)
        rt_start: u64 = load64(rt_header + ACTOR_H_START)
        if rt_start != 0 {
            store64(rt_base + ACTOR_S_CURRENT_ACTOR, rt_who)
            store64(rt_base + ACTOR_S_IN_NEW, 1)
            if domain_of(rt_who) != 0 {
                domain_budget_begin()
            }
            timer_arm(budget_ticks())
            rt_failed: u64 = invoke(rt_start, rt_who, 0, load64(rt_header + ACTOR_H_ARGS))
            timer_disarm()
            domain_budget_end()
            store64(rt_base + ACTOR_S_CURRENT_ACTOR, 0)
            store64(rt_base + ACTOR_S_IN_NEW, 0)
            if rt_failed != 0 {
                end_actor(rt_who)
                return
            }
        }
        rerun_end(rt_who)
    }
    notify_restarted(rt_who)
}

/// `watch(watched, watcher)`, which the compiler turns into a call of this: from now on
/// `watcher` is sent its handler number `number` (`restarted`) each time `watched` restarts.
/// Watching twice is the same as once. A watch ends when the watcher restarts or ends,
/// so its `new` sets it up again. The table is small (14); one more panics.
pub fn watch_impl(watched: u64, watcher: u64, number: u64, stopped_plus_one: u64) {
    unsafe {
        rt_core: u64 = core_of_actor(watched)
        if rt_core != core_id() {
            // The core of the actor watched keeps the watch, and sends `restarted` and `stopped` itself.
            rt_rec: u64 = ring_scratch(0)
            store64(rt_rec, REC_WATCH)
            store64(rt_rec + 8, watched)
            store64(rt_rec + 16, watcher)
            store64(rt_rec + 24, number)
            store64(rt_rec + 32, stopped_plus_one)
            push_record(rt_core, rt_rec)
            return
        }
    }
    watch_here(watched, watcher, number, stopped_plus_one)
}

fn watch_here(watched: u64, watcher: u64, number: u64, stopped_plus_one: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        store64(rt_base + ACTOR_S_RESTARTED, number)
        mut rt_tag: u64 = watcher
        if stopped_plus_one != 0 {
            store64(rt_base + ACTOR_S_STOPPED, stopped_plus_one - 1)
            rt_tag = watcher or 1               // actors are 8-byte aligned: bit 0 is free
        }
        mut rt_free: u64 = 0
        scanning: loop rt_i: u64 in 0..ACTOR_WATCH_MAX {
            rt_record: u64 = rt_base + ACTOR_WATCHES + rt_i * 16
            if load64(rt_record) == watched and watcher_of(load64(rt_record + 8)) == watcher {
                store64(rt_record + 8, load64(rt_record + 8) or rt_tag)   // `stopped` asked for now
                return
            }
            if rt_free == 0 and load64(rt_record) == 0 {
                rt_free = rt_record
            }
        }
        if rt_free == 0 {
            panic("too many watches")
        }
        store64(rt_free, watched)
        store64(rt_free + 8, rt_tag)
    }
}

/// The watcher in a watch record's second word (bit 0 says it wants `stopped`).
fn watcher_of(rt_tag: u64) -> u64 {
    return (rt_tag shr 1) shl 1
}

/// Forgets what `rt_who` watches (it restarts or ends).
fn drop_watches(rt_who: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        // The watches are kept by the core of the actor watched, which may be another: tell them all.
        if core_of_actor(rt_who) == core_id() and domain_of(rt_who) == 0 {
            telling: loop rt_c: u64 in 0..4 {
                if rt_c != core_id() and spawn_count() != 0 {
                    rt_rec: u64 = ring_scratch(0)
                    store64(rt_rec, REC_DROP_WATCHES)
                    store64(rt_rec + 8, rt_who)
                    push_record(rt_c, rt_rec)
                }
            }
        }
        dropping: loop rt_i: u64 in 0..ACTOR_WATCH_MAX {
            rt_record: u64 = rt_base + ACTOR_WATCHES + rt_i * 16
            if watcher_of(load64(rt_record + 8)) == rt_who {
                store64(rt_record, 0)
                store64(rt_record + 8, 0)
            }
        }
    }
}

/// `rt_who` has restarted and its `new` has run again: tell each watcher with the message
/// `restarted`. It is lossy: one already waiting stands for this one, and a full mailbox
/// drops it.
fn notify_restarted(rt_who: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_number: u64 = load64(rt_base + ACTOR_S_RESTARTED)
        telling: loop rt_i: u64 in 0..ACTOR_WATCH_MAX {
            rt_record: u64 = rt_base + ACTOR_WATCHES + rt_i * 16
            if load64(rt_record) == rt_who {
                rt_watcher: u64 = watcher_of(load64(rt_record + 8))
                discard route_message(rt_watcher, rt_number, 0, 0, true)
            }
        }
    }
}

/// `rt_who` has ended: tell each watcher that asked for it the message `stopped` (lossy: one
/// already waiting stands for this one), then forget the watches on it, which can never fire.
fn notify_stopped(rt_who: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_number: u64 = load64(rt_base + ACTOR_S_STOPPED)
        telling: loop rt_i: u64 in 0..ACTOR_WATCH_MAX {
            rt_record: u64 = rt_base + ACTOR_WATCHES + rt_i * 16
            if load64(rt_record) == rt_who {
                rt_tag: u64 = load64(rt_record + 8)
                rt_watcher: u64 = watcher_of(rt_tag)
                if (rt_tag and 1) != 0 {
                    discard route_message(rt_watcher, rt_number, 0, 0, true)
                }
                store64(rt_record, 0)
                store64(rt_record + 8, 0)
            }
        }
    }
}

/// `stop()`: the running handler's actor ends. The handler is abandoned where it stands,
/// like a failure, but nothing is reported and the actor is not restarted (decision 150).
pub fn stop_self_impl() {
    rt_base: u64 = actor_arena_base()
    unsafe {
        store64(rt_base + ACTOR_S_STOPPING, 1)
    }
    actor_failed()
}

/// `stop(target)`: `target` ends, if the caller is the actor that spawned it (code outside
/// any actor, such as `test_main`, is the spawner of what it spawns); from anyone else it is a
/// failure like any bug (decision 147). Stopping an actor that has ended does nothing; stopping
/// oneself is `stop()`.
pub fn stop_impl(target: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_caller: u64 = load64(rt_base + ACTOR_S_CURRENT_ACTOR)
        if target == rt_caller {
            stop_self_impl()
        }
        if load64(target - ACTOR_BEFORE_FIELDS + ACTOR_H_PARENT) != rt_caller {
            panic("only the actor that spawned an actor can stop it")
        }
        end_actor_anywhere(target)
    }
}

/// Sends a message to `target`: puts it in the mailbox, or drops it and
/// counts the drop if the mailbox is full. Used by every send of a `lossy`
/// handler. `payload` is the address of `words` words (at most 8) to copy into it.
pub extern fn raven_send(target: u64, handler: u64, payload: u64, words: u64)

pub fn send_impl(target: u64, handler: u64, payload: u64, words: u64) {
    if not route_message(target, handler, payload, words, false) {
        unsafe {
            rt_base: u64 = actor_arena_base()
            store64(rt_base + ACTOR_S_DROPPED, load64(rt_base + ACTOR_S_DROPPED) + 1)
        }
    }
}

/// Sends a message to a `reliable` handler: the same, except that a full
/// mailbox is not a drop. The sender is told and decides what the message is
/// worth (decision 126).
pub fn send_reliable_impl(target: u64, handler: u64, payload: u64, words: u64) -> Sent {
    if route_message(target, handler, payload, words, false) {
        return Delivered                        // (to an actor on another core: queued in the ring for it)
    }
    unsafe {
        if (load64(target - ACTOR_BEFORE_FIELDS + ACTOR_H_FLAGS) and ACTOR_F_ENDED) != 0 {
            return Gone
        }
    }
    return MailboxFull
}

/// Sends a message from this core. To an actor on this core it goes into the mailbox; to one on another core, into the
/// ring to that core, which puts it in the mailbox (REC_SEND). True if it was accepted: for another core the ring is all
/// the sender can know of, so a full mailbox there is a drop on that core's count, and a `reliable` sender is told
/// `Delivered` all the same (decision 181). With `absorb`, a message for a handler already waiting is dropped, as
/// Raven's own notifications are.
fn route_message(target: u64, handler: u64, payload: u64, words: u64, absorb: bool) -> bool {
    rt_core: u64 = core_of_actor(target)
    unsafe {
        if rt_core == core_id() {
            if absorb and rt_queued(target, handler) {
                return true
            }
            return rt_enqueue(target, handler, payload, words)
        }
        if (load64(target - ACTOR_BEFORE_FIELDS + ACTOR_H_FLAGS) and ACTOR_F_ENDED) != 0 {
            return false
        }
        rt_rec: u64 = ring_scratch(0)
        store64(rt_rec, REC_SEND)
        store64(rt_rec + 8, target)
        store64(rt_rec + 16, handler)
        store64(rt_rec + 24, words)
        store64(rt_rec + 120, if absorb { 1 } else { 0 })
        copying: loop rt_w: u64 in 0..words {
            store64(rt_rec + REC_PAYLOAD + rt_w * 8, load64(payload + rt_w * 8))
        }
        push_record(rt_core, rt_rec)
        return true
    }
}

/// Queues a record for `core`, waiting if its ring is full. The record counts as work to do until that core has handled it.
fn push_record(core: u64, rec: u64) {
    unsafe {
        pending_add(1)
        pushing: loop ring_push(core, rec) == 0 {
            core_pause()
        }
    }
}

/// Handles every record other cores have queued for this one. Called by each core's scheduler between turns.
pub fn drain_rings() {
    unsafe {
        rt_rec: u64 = ring_scratch(1)
        draining: loop rt_src: u64 in 0..4 {
            if rt_src != core_id() {
                taking: loop ring_pop(rt_src, rt_rec) != 0 {
                    handle_record(rt_rec)
                    pending_sub(1)              // the record is handled
                }
            }
        }
    }
}

fn handle_record(rt_rec: u64) {
    unsafe {
        rt_kind: u64 = load64(rt_rec)
        rt_who: u64 = load64(rt_rec + 8)
        if rt_kind == REC_SEND {
            if load64(rt_rec + 120) != 0 and rt_queued(rt_who, load64(rt_rec + 16)) {
                return
            }
            if not rt_enqueue(rt_who, load64(rt_rec + 16), rt_rec + REC_PAYLOAD, load64(rt_rec + 24)) {
                rt_base: u64 = actor_arena_base()
                store64(rt_base + ACTOR_S_DROPPED, load64(rt_base + ACTOR_S_DROPPED) + 1)
            }
        } else if rt_kind == REC_START {
            start_here(rt_who, load64(rt_rec + 16), load64(rt_rec + 24), load64(rt_rec + 32), rt_rec + REC_PAYLOAD)
        } else if rt_kind == REC_WATCH {
            watch_here(rt_who, load64(rt_rec + 16), load64(rt_rec + 24), load64(rt_rec + 32))
        } else if rt_kind == REC_STOP {
            end_actor(rt_who)
        } else if rt_kind == REC_DROP_WATCHES {
            drop_watches(rt_who)
        }
    }
}

/// Runs the `new` of an actor on this core (a `separate` actor spawned from another core, or restarted in place by the
/// restart of its spawner): it keeps its arguments for later restarts, and if its `new` fails it is restarted once and
/// ends if it fails again.
fn start_here(rt_who: u64, rt_entry: u64, rt_words: u64, rt_reuse: u64, rt_args: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        if rt_reuse != 0 {
            rerun_begin(rt_who)
        }
        rt_kept: u64 = load64(rt_header + ACTOR_H_ARGS)
        copying: loop rt_w: u64 in 0..rt_words {
            store64(rt_kept + rt_w * 8, load64(rt_args + rt_w * 8))
        }
        if rt_entry != 0 {
            store64(rt_base + ACTOR_S_CURRENT_ACTOR, rt_who)
            store64(rt_base + ACTOR_S_IN_NEW, 1)
            domain_budget_begin()
            timer_arm(budget_ticks())
            rt_failed: u64 = run_in_domain(domain_of(rt_who), rt_entry, rt_who, 0, rt_kept)
            timer_disarm()
            domain_budget_end()
            store64(rt_base + ACTOR_S_CURRENT_ACTOR, 0)
            store64(rt_base + ACTOR_S_IN_NEW, 0)
            if rt_failed != 0 {
                restart_actor(rt_who)
                finish_start(rt_who)
                return
            }
        }
        rerun_end(rt_who)
        finish_start(rt_who)
        if rt_reuse != 0 {
            notify_restarted(rt_who)
        }
    }
}

/// Its `new` is over: the actor may be scheduled, and runs what was sent to it meanwhile.
fn finish_start(rt_who: u64) {
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        store64(rt_header + ACTOR_H_FLAGS, load64(rt_header + ACTOR_H_FLAGS) and (ACTOR_F_IN_NEW or ACTOR_F_ENDED))
        if load64(rt_header + ACTOR_H_COUNT) != 0 and load64(rt_header + ACTOR_H_QUEUED) == 0 {
            store64(rt_header + ACTOR_H_QUEUED, 1)
            run_queue_push(rt_who)
        }
    }
}

/// Ends an actor wherever it lives: here, or by a record to its core.
fn end_actor_anywhere(rt_who: u64) {
    rt_core: u64 = core_of_actor(rt_who)
    if rt_core == core_id() {
        end_actor(rt_who)
        return
    }
    unsafe {
        rt_rec: u64 = ring_scratch(0)
        store64(rt_rec, REC_STOP)
        store64(rt_rec + 8, rt_who)
        push_record(rt_core, rt_rec)
    }
}

/// Puts a message in `target`'s mailbox and queues the actor to run. Returns
/// false, changing nothing, if the mailbox is full.
fn rt_enqueue(target: u64, handler: u64, payload: u64, words: u64) -> bool {
    rt_header: u64 = target - ACTOR_BEFORE_FIELDS
    unsafe {
        if (load64(rt_header + ACTOR_H_FLAGS) and ACTOR_F_ENDED) != 0 {
            return false
        }
        rt_count: u64 = load64(rt_header + ACTOR_H_COUNT)
        if rt_count == ACTOR_SLOTS {
            return false
        }
        rt_first: u64 = load64(rt_header + ACTOR_H_FIRST)
        rt_slot: u64 = rt_header + ACTOR_HEADER_WORDS * 8 +
                       ((rt_first + rt_count) % ACTOR_SLOTS) * ACTOR_SLOT_WORDS * 8
        store64(rt_slot, handler)
        copying: loop rt_w: u64 in 0..words {
            store64(rt_slot + 8 + rt_w * 8, load64(payload + rt_w * 8))
        }
        store64(rt_header + ACTOR_H_COUNT, rt_count + 1)
        pending_add(1)                          // one more message nobody has finished with
        if load64(rt_header + ACTOR_H_QUEUED) == 0 and (load64(rt_header + ACTOR_H_FLAGS) and ACTOR_F_STARTING) == 0 {
            store64(rt_header + ACTOR_H_QUEUED, 1)
            run_queue_push(target)
        }
        return true
    }
}

/// Turns the interrupts that have fired into messages, and switches each source back
/// on (vectors.s switched it off). A source still asserting fires again at once, so
/// a handler can be called with nothing left to do and must cope with that.
pub fn deliver_interrupts() {
    mut rt_pending: u64 = irq_take_pending()
    mut rt_bit: u64 = 0
    delivering: loop rt_pending != 0 {
        if (rt_pending and 1) != 0 {
            deliver_interrupt(ACTOR_IRQ_FIRST + rt_bit)
        }
        rt_pending = rt_pending shr 1
        rt_bit += 1
    }
}

fn deliver_interrupt(line: u64) {
    unsafe {
        rt_slot: u64 = actor_arena_base() + ACTOR_IRQ_ROUTES + (line - ACTOR_IRQ_FIRST) * 16
        rt_target: u64 = load64(rt_slot)
        if rt_target != 0 {
            rt_number: u64 = load64(rt_slot + 8)
            if not rt_queued(rt_target, rt_number) {
                discard rt_enqueue(rt_target, rt_number, 0, 0)    // full: the source fires again
            }
        }
    }
    irq_enable_source(line)
}

/// Is a message for `handler` already waiting in `target`'s mailbox?
fn rt_queued(target: u64, handler: u64) -> bool {
    rt_header: u64 = target - ACTOR_BEFORE_FIELDS
    unsafe {
        rt_first: u64 = load64(rt_header + ACTOR_H_FIRST)
        rt_count: u64 = load64(rt_header + ACTOR_H_COUNT)
        looking: loop i: u64 in 0..rt_count {
            rt_slot: u64 = rt_header + ACTOR_HEADER_WORDS * 8 +
                           ((rt_first + i) % ACTOR_SLOTS) * ACTOR_SLOT_WORDS * 8
            if load64(rt_slot) == handler {
                return true
            }
        }
    }
    return false
}

/// Messages, over all cores, that nobody has finished with (see rings.s).
pub fn unfinished_messages() -> u64 {
    unsafe {
        return pending_load()
    }
}

/// A short wait while another core works; this core has nothing to do.
pub fn wait_for_other_cores() {
    unsafe {
        core_pause()
    }
}

/// True on a core that sleeps in `wfe` between messages (every core but 0, which has the UART's interrupts to wait for).
pub fn this_core_waits_for_events() -> bool {
    unsafe {
        return core_id() != 0
    }
}

/// Sleeps until another core sends this one a record, unless one is waiting already.
pub fn sleep_until_event() {
    unsafe {
        if rings_waiting() == 0 {
            core_wait_event()
        }
    }
}

pub fn actors_waiting() -> u64 {
    unsafe {
        return load64(actor_arena_base() + ACTOR_S_RUNQ_COUNT)
    }
}

fn run_queue_push(actor_ref: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_waiting: u64 = load64(rt_base + ACTOR_S_RUNQ_COUNT)
        if rt_waiting == ACTOR_RUNQ_SLOTS {
            panic("run queue full")
        }
        rt_front: u64 = load64(rt_base + ACTOR_S_RUNQ_FIRST)
        store64(rt_base + ACTOR_RUNQ_OFFSET + ((rt_front + rt_waiting) % ACTOR_RUNQ_SLOTS) * 8,
                actor_ref)
        store64(rt_base + ACTOR_S_RUNQ_COUNT, rt_waiting + 1)
    }
}

pub fn run_one_turn() {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_front: u64 = load64(rt_base + ACTOR_S_RUNQ_FIRST)
        rt_actor: u64 = load64(rt_base + ACTOR_RUNQ_OFFSET + rt_front * 8)
        store64(rt_base + ACTOR_S_RUNQ_FIRST, (rt_front + 1) % ACTOR_RUNQ_SLOTS)
        store64(rt_base + ACTOR_S_RUNQ_COUNT, load64(rt_base + ACTOR_S_RUNQ_COUNT) - 1)

        // Take the oldest message out of the actor's mailbox.
        rt_header: u64 = rt_actor - ACTOR_BEFORE_FIELDS
        if load64(rt_header + ACTOR_H_COUNT) == 0 {
            store64(rt_header + ACTOR_H_QUEUED, 0)      // its messages were lost in a restart
            return
        }
        rt_first: u64 = load64(rt_header + ACTOR_H_FIRST)
        rt_slot: u64 = rt_header + ACTOR_HEADER_WORDS * 8 + rt_first * ACTOR_SLOT_WORDS * 8
        rt_handler: u64 = load64(rt_slot)
        // Copy the payload out of the slot first: the handler may send to its own actor,
        // and that send can reuse this slot.
        rt_buffer: u64 = rt_base + ACTOR_MSG_BUFFER
        copying: loop rt_w: u64 in 0..ACTOR_MESSAGE_WORDS {
            store64(rt_buffer + rt_w * 8, load64(rt_slot + 8 + rt_w * 8))
        }
        rt_left: u64 = load64(rt_header + ACTOR_H_COUNT) - 1
        store64(rt_header + ACTOR_H_FIRST, (rt_first + 1) % ACTOR_SLOTS)
        store64(rt_header + ACTOR_H_COUNT, rt_left)
        if rt_left > 0 {
            run_queue_push(rt_actor)
        } else {
            store64(rt_header + ACTOR_H_QUEUED, 0)
        }
        rt_dispatcher: u64 = load64(rt_header + ACTOR_H_DISPATCHER)
        store64(rt_base + ACTOR_S_CURRENT_DISPATCHER, rt_dispatcher)
        store64(rt_base + ACTOR_S_CURRENT_HANDLER, rt_handler)
        store64(rt_base + ACTOR_S_CURRENT_ACTOR, rt_actor)
        store64(rt_base + ACTOR_S_IN_NEW, 0)
        if domain_of(rt_actor) != 0 {
            domain_budget_begin()
        }
        timer_arm(budget_ticks())
        rt_failed: u64 = invoke(rt_dispatcher, rt_actor, rt_handler, rt_buffer)
        timer_disarm()
        domain_budget_end()
        store64(rt_base + ACTOR_S_CURRENT_ACTOR, 0)
        if rt_failed != 0 {
            if load64(rt_base + ACTOR_S_STOPPING) != 0 {
                store64(rt_base + ACTOR_S_STOPPING, 0)
                end_actor(rt_actor)                 // it called stop()
            } else {
                restart_actor(rt_actor)
            }
        }
        pending_sub(1)                          // the message is handled
    }
}

// ---- protection domains (decision 175) --------------------------------------------------------
// An actor in a domain runs at EL0 (domain.s). Raven never trusts what it finds in a domain's memory: every
// address a request names is checked to be inside the pool, in the part the domain may use, before Raven
// reads or writes it, and a target must be an actor Raven made.

/// The protection domain an actor lives in (0: Raven's own).
fn domain_of(dm_actor: u64) -> u64 {
    unsafe {
        return load64(dm_actor - ACTOR_BEFORE_FIELDS + ACTOR_H_DOMAIN) and 0xf
    }
}

/// The core an actor lives on: bits 4 to 7 of its domain word (0 for every plain actor, which lives on core 0).
fn core_of_actor(dm_actor: u64) -> u64 {
    unsafe {
        return (load64(dm_actor - ACTOR_BEFORE_FIELDS + ACTOR_H_DOMAIN) shr 4) and 0xf
    }
}

/// The first domain with no actor on core `dm_core`, 1 to 3. A domain is never given back (an ended actor stays as a
/// tombstone, like those in the arena), so a program can have three `separate` actors on a core, twelve in all, for now.
fn free_domain(dm_core: u64) -> u64 {
    mut dm_found: u64 = 0
    unsafe {
        searching: loop dm_k: u64 in 1..(DOMAINS + 1) {
            if dm_found == 0 and domain_actor_of(dm_core, dm_k) == 0 {
                dm_found = dm_k
            }
        }
    }
    if dm_found == 0 {
        panic("out of protection domains on a core")
    }
    return dm_found
}

/// Runs a handler (or an actor's start stub) of `dm_actor`: protected in Raven's domain, in its own domain at
/// EL0 otherwise. 0 if it finished, 1 if it failed (and Raven has said so).
fn invoke(dm_dispatcher: u64, dm_actor: u64, dm_handler: u64, dm_payload: u64) -> u64 {
    dm_domain: u64 = domain_of(dm_actor)
    if dm_domain == 0 {
        unsafe {
            return call_protected(dm_dispatcher, dm_actor, dm_handler, dm_payload)
        }
    }
    return run_in_domain(dm_domain, dm_dispatcher, dm_actor, dm_handler, dm_payload)
}

/// Runs the dispatcher of an actor in domain `dm_d` at EL0 on a message, and does what the domain asks
/// until it finishes or fails. A message is copied into the domain's last page first (the copy that
/// makes a send to another domain safe); a payload that is already in the pool (the arguments of `new`) is not.
fn run_in_domain(dm_d: u64, dm_dispatcher: u64, dm_actor: u64, dm_handler: u64, dm_payload: u64) -> u64 {
    dm_pool: u64 = domain_pool_base(dm_d)
    mut dm_at: u64 = dm_payload
    unsafe {
        if dm_payload < dm_pool or dm_payload >= dm_pool + DOMAIN_POOL_BYTES {
            dm_at = dm_pool + DOMAIN_INBOX
            copying: loop dm_w: u64 in 0..ACTOR_MESSAGE_WORDS {
                store64(dm_at + dm_w * 8, load64(dm_payload + dm_w * 8))
            }
        }
        mut dm_reason: u64 = domain_enter(dm_d, dm_dispatcher, dm_actor, dm_handler, dm_at)
        servicing: loop dm_reason == REASON_CALL {
            dm_reason = service_call(dm_pool)
        }
        if dm_reason == REASON_DONE {
            return 0
        }
        report_failure(dm_d, dm_reason)
    }
    return 1
}

/// Says why a domain failed, in the shape of a panic so tests can expect it (domain 0 is Raven's own).
fn report_failure(dm_d: u64, dm_reason: u64) {
    if dm_reason == REASON_REPORTED {
        return                                  // it panicked, and the panic was printed already
    }
    unsafe {
        if dm_reason == 2 {
            if dm_d == 1 {
                domain_report("domain 1 ran for over 100 ms")
            } else if dm_d == 2 {
                domain_report("domain 2 ran for over 100 ms")
            } else {
                domain_report("domain 3 ran for over 100 ms")
            }
        } else if dm_reason == REASON_BAD {
            if dm_d == 1 {
                domain_report("domain 1 made a request it may not")
            } else if dm_d == 2 {
                domain_report("domain 2 made a request it may not")
            } else {
                domain_report("domain 3 made a request it may not")
            }
        } else {
            if dm_d == 1 {
                domain_report("domain 1 faulted")
            } else if dm_d == 2 {
                domain_report("domain 2 faulted")
            } else {
                domain_report("domain 3 faulted")
            }
        }
    }
}

/// Does what the domain's last `svc` asked, and continues it: returns the next reason to stop. Anything a
/// domain may not ask for (a bad address, a target that is not an actor, `spawn`, `watch`, `stop`: not yet
/// built for a domain) is REASON_BAD, which fails the domain.
fn service_call(dm_pool: u64) -> u64 {
    dm_number: u64 = domain_call_number()
    unsafe {
        if dm_number == SVC_SEND or dm_number == SVC_SEND_RELIABLE {
            dm_target: u64 = domain_saved_x(0)
            dm_handler: u64 = domain_saved_x(1)
            dm_payload: u64 = domain_saved_x(2)
            dm_words: u64 = domain_saved_x(3)
            if dm_words > ACTOR_MESSAGE_WORDS {
                return REASON_BAD
            }
            if dm_words > 0 and not pool_readable(dm_pool, dm_payload, dm_words * 8) {
                return REASON_BAD
            }
            if not valid_actor(dm_target) or not valid_handler(dm_target, dm_handler) {
                return REASON_BAD
            }
            if dm_number == SVC_SEND {
                send_impl(dm_target, dm_handler, dm_payload, dm_words)
                return domain_resume(0)
            }
            dm_result: u64 = domain_saved_x(8)          // where a struct result goes
            if not pool_readable(dm_pool, dm_result, 8) {
                return REASON_BAD
            }
            mut dm_tag: u64 = 0
            match send_reliable_impl(dm_target, dm_handler, dm_payload, dm_words) {
                Delivered => dm_tag = 0
                MailboxFull => dm_tag = 1
                Gone => dm_tag = 2
            }
            store64(dm_result, dm_tag)
            return domain_resume(0)
        }
        if dm_number == SVC_PANIC {
            dm_message: u64 = domain_saved_x(0)
            dm_message_length: u64 = domain_saved_x(1)
            dm_file: u64 = domain_saved_x(2)
            dm_file_length: u64 = domain_saved_x(3)
            if not constant_ok(dm_message, dm_message_length) or not constant_ok(dm_file, dm_file_length) {
                return REASON_BAD
            }
            domain_report_panic(dm_message, dm_message_length, dm_file, dm_file_length, domain_saved_x(4))
            return REASON_REPORTED
        }
    }
    return REASON_BAD
}

/// May the domain with pool `dm_pool` have Raven read or write `dm_bytes` at `dm_address`? Only its stack
/// and its data: not the guard, not the control page (the actor's header and mailbox), nothing outside.
fn pool_readable(dm_pool: u64, dm_address: u64, dm_bytes: u64) -> bool {
    if dm_address < dm_pool {
        return false
    }
    dm_start: u64 = dm_address - dm_pool
    if dm_start >= DOMAIN_POOL_BYTES or dm_bytes > DOMAIN_POOL_BYTES - dm_start {
        return false
    }
    dm_end: u64 = dm_start + dm_bytes
    if dm_start >= DOMAIN_STACK_FIRST and dm_end <= DOMAIN_STACK_END {
        return true
    }
    return dm_start >= DOMAIN_FIELDS and dm_end <= DOMAIN_POOL_BYTES
}

/// Is [dm_address, dm_address + dm_length) inside the kernel's constants (a message or a file name the
/// compiler wrote)? Those are readable by every domain and hold no secrets.
fn constant_ok(dm_address: u64, dm_length: u64) -> bool {
    unsafe {
        dm_end: u64 = image_rodata_end()
        return dm_length <= 4096 and dm_address >= image_rodata_start() and dm_address <= dm_end and dm_length <= dm_end - dm_address
    }
}

/// Is `dm_target` an actor Raven made (in a domain, or in the arena)? A domain can only get a reference by
/// being given one, but Raven does not take its word for it.
fn valid_actor(dm_target: u64) -> bool {
    dm_base: u64 = raven_arena_address()        // plain actors all live in core 0's arena, whichever core asks
    unsafe {
        if dm_target >= domain_pools_start() and dm_target < domain_pools_end() {
            // in a domain's pool: a domain of some core that holds exactly this actor
            dm_index: u64 = (dm_target - domain_pools_start()) shr 21
            return domain_actor_of(dm_index / DOMAINS, dm_index % DOMAINS + 1) == dm_target
        }
        dm_next: u64 = load64(dm_base + ACTOR_S_NEXT)
        mut dm_at: u64 = dm_base + ACTOR_FIRST_ACTOR
        walking: loop dm_at < dm_next {
            if dm_at + ACTOR_BEFORE_FIELDS == dm_target {
                return true
            }
            dm_size: u64 = load64(dm_at + ACTOR_H_DOMAIN) shr 8
            if dm_size == 0 {
                return false
            }
            dm_at = dm_at + dm_size
        }
    }
    return false
}

/// Does the actor `dm_target` have a handler with number `dm_handler`? (Fledgling's table lists every one.)
fn valid_handler(dm_target: u64, dm_handler: u64) -> bool {
    unsafe {
        dm_dispatcher: u64 = load64(dm_target - ACTOR_BEFORE_FIELDS + ACTOR_H_DISPATCHER)
        mut dm_record: u64 = handler_table_start()
        dm_last: u64 = handler_table_end()
        searching: loop dm_record < dm_last {
            if load64(dm_record) == dm_dispatcher and load64(dm_record + 8) == dm_handler {
                return true
            }
            dm_record = dm_record + HANDLER_RECORD_BYTES
        }
    }
    return false
}

/// The handler budget in ticks of the generic timer.
fn budget_ticks() -> u64 {
    mut rt_hz: u64 = counter_frequency()
    if rt_hz == 0 {
        rt_hz = BUDGET_DEFAULT_HZ
    }
    return ACTOR_BUDGET_MS * (rt_hz / 1000)
}

/// Called by the IRQ vector (kernel/arch/aarch64/vectors.s) when the budget timer
/// fires: the handler that was running has failed. Until supervision exists that is
/// reported like a panic, naming the handler, and the core halts.
pub fn raven_budget_overrun() {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_dispatcher: u64 = load64(rt_base + ACTOR_S_CURRENT_DISPATCHER)
        rt_handler: u64 = load64(rt_base + ACTOR_S_CURRENT_HANDLER)
        mut rt_record: u64 = handler_table_start()
        rt_end: u64 = handler_table_end()
        searching: loop rt_record < rt_end {
            if load64(rt_record) == rt_dispatcher and load64(rt_record + 8) == rt_handler {
                rook_budget_panic(load64(rt_record + 16), ACTOR_BUDGET_MS,
                                  load64(rt_record + 24), load64(rt_record + 32))
            }
            rt_record = rt_record + HANDLER_RECORD_BYTES
        }
    }
    panic("a handler ran past its time budget")
}
