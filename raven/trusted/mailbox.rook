// Raven's mailboxes and scheduler, on one core: where actors live, their mailboxes, and
// the scheduler. An internal module: application code can't import it (decision 142);
// what an application may use is in `actors`. Fledgling compiles `spawn` and every send into calls to
// `raven_spawn_actor` and `raven_send` here; the scheduler runs one message at
// a time through the dispatcher Fledgling generates for each actor.
//
// Everything lives in one fixed arena (kernel/arch/aarch64/actors.s), so this
// code keeps no global variables: Raven's own tables are at the start of the
// arena. An actor that ends gives its memory back to a list by size (decision 197; before, nothing was freed, decision 119).
//
// An actor's memory, in 8-byte words, with its reference pointing at the fields:
//     [ header: 8 ][ mailbox: 16 slots of 9 ][ the actor's fields ... ]
// A slot holds a handler number and up to eight payload words: the handler's arguments,
// a struct or enum counting as its size (decision 135).

import actors: Sent
import assembly: atomic_increment, domain_turn_address, domain_pool_page_el1, domain_reset_pool_map, pool_wipe_range, domain_unmap_devices_of, core_block, domain_map_device_of, raven_arena_address, spawn_count, pool_wipe, core_id, core_pause, domain_actor_of, domain_pool_base_of, domain_pools_end, domain_pools_start, domain_set_actor_of, pending_add, pending_load, pending_sub, ring_pending, ring_pop, ring_push, ring_scratch, rings_waiting, spawn_next_core, domain_budget_begin, domain_budget_end, domain_wipe_data, domain_actor, domain_call_number, domain_enter, domain_pool_base, domain_report, domain_report_panic, domain_resume, domain_saved_x, domain_set_actor, domain_wipe, image_rodata_end, image_rodata_start, actor_failed, actor_arena_base, actor_arena_limit, call_dispatch, call_protected, handler_table_end, handler_table_start, irq_enable_source, irq_take_pending, rook_budget_panic, timer_arm, timer_disarm
import domain_runtime: rt_ring_messages_in, RT_S_GEN, RT_S_FINISHED, RT_FIRST_PAGE, RT_PLACES, RT_RING, RT_RING_SLOTS, RT_SLOT_BYTES, RT_STATE, RT_S_ACTOR, RT_S_CONSUMED, RT_S_DISPATCHER, RT_S_ENDED, RT_S_HELD, rt_block, rt_queue_push
import hardware: counter_frequency, read_counter

ACTOR_HEADER_WORDS: u64 = 14
ACTOR_SLOTS: u64 = 16               // messages one mailbox holds (decision 113, g)
ACTOR_MESSAGE_WORDS: u64 = 8        // payload words in a message
ACTOR_SLOT_WORDS: u64 = 9           // a handler number and the payload
ACTOR_BEFORE_FIELDS: u64 = (ACTOR_HEADER_WORDS + ACTOR_SLOTS * ACTOR_SLOT_WORDS) * 8

// Header, as byte offsets from the start of the actor's memory.
ACTOR_H_DISPATCHER: u64 = 0         // address of its dispatcher
ACTOR_H_FIRST: u64 = 8              // slot of the oldest message
ACTOR_H_COUNT: u64 = 16             // messages waiting
ACTOR_H_QUEUED: u64 = 24            // 1 if it is in the run queue
ACTOR_H_START: u64 = 32             // its start stub, which runs `new` on stored arguments (0: none)
ACTOR_H_PARENT: u64 = 40            // the actor that spawned it (0: spawned outside any actor)
RING_IRQ_SHARE: u64 = 4             // records of interrupts a ring may hold: the rest of its 32 slots are for everything else (decision 188)
RING_WAIT_MS: u64 = 5               // how long a send waits for room in a full ring before it is dropped (decision 186)
DEVICE_BASE: u64 = 0x3F000000       // the peripherals (devices.rook): an Mmio given to a domain lies inside
DEVICE_SPAN: u64 = 0x01000000
ACTOR_H_ARGS_WORDS: u64 = 48        // words of `new` arguments kept for a restart
ACTOR_H_FIRST_CHILD: u64 = 56       // the actors it spawned, in order: the first ...
ACTOR_H_NEXT_SIBLING: u64 = 64      // ... and each one's next
ACTOR_H_LAST_CHILD: u64 = 72
ACTOR_H_PENDING: u64 = 80           // during a restart: children not yet matched by a `spawn`
ACTOR_H_FLAGS: u64 = 88             // see ACTOR_F_*
ACTOR_H_ARGS: u64 = 96              // address of the kept `new` arguments
ACTOR_H_DOMAIN: u64 = 104           // the protection domain it lives in (bits 0 to 3, 0: Raven's own) and the core (bits 4
                                    // to 7); for an actor in the arena the bytes it takes (bits 8 to 31: the walk that
                                    // finds actors); its generation (bits 32 to 63, decision 197)
REF_ADDRESS_MASK: u64 = 0xFFFFFFFF  // a reference is one word: the address of the actor's fields in the low 32 bits ...
REF_GENERATION_SHIFT: u64 = 32      // ... and the generation of the actor's place in the high 32 (decision 197)
ACTOR_SIZE_MASK: u64 = 0xFFFFFF     // bits 8 to 31 of the domain word, once shifted right 8
ACTOR_F_IN_NEW: u64 = 1             // it was spawned by its spawner's `new`: kept across restarts
ACTOR_F_ENDED: u64 = 2              // it has ended: sends to it are refused
ACTOR_F_STARTING: u64 = 4           // its `new` has not run yet (on another core): messages wait, it is not scheduled
ACTOR_F_RETIRED: u64 = 16           // it has ended and its place has been given up (in a domain: core 0 has handled its end); the domain is given back when all have
ACTOR_F_PENDING: u64 = 32           // it was placed by an actor of its own domain: its `new` runs when the turn that placed it is over (decision 206)
ACTOR_F_RETIRING: u64 = 8           // it has ended but is still in the run queue: its memory is given back when that entry is taken

// Raven's tables, as byte offsets from the start of the arena.
ACTOR_S_NEXT: u64 = 0               // next free byte (0 until the first spawn)
ACTOR_S_RUNQ_FIRST: u64 = 8
ACTOR_S_RUNQ_COUNT: u64 = 16
pub ACTOR_S_DROPPED: u64 = 24           // messages dropped because a mailbox was full
ACTOR_S_CURRENT_DISPATCHER: u64 = 32  // the handler now running: its actor's dispatcher ...
ACTOR_S_CURRENT_HANDLER: u64 = 40     // ... and its number
ACTOR_S_IRQ_PENDING: u64 = 48       // bit n: peripheral interrupt 32 + n has fired (vectors.s)
ACTOR_S_RING_WAIT: u64 = 56         // ticks a send waits for room in a full ring; 0: the default, RING_WAIT_MS (a test sets it)
ACTOR_RUNQ_OFFSET: u64 = 64         // the run queue: a ring of actor references
ACTOR_RUNQ_SLOTS: u64 = 128
ACTOR_S_RESTARTED: u64 = 1128       // the number of the handler `restarted`, kept by `watch`
ACTOR_S_STOPPED: u64 = 1136         // the number of the handler `stopped`, kept by `watch`
ACTOR_S_STOPPING: u64 = 1144        // 1 while a handler that called `stop()` is being abandoned
pub ACTOR_IRQ_ROUTES: u64 = 1152        // where each interrupt goes: 32 records of (actor, handler number)
pub ACTOR_IRQ_FIRST: u64 = 32           // the interrupts handled: peripheral IRQs 32 to 63
ACTOR_MSG_BUFFER: u64 = 1664        // the message being handled, copied out of its slot (8 words)
ACTOR_S_PROTECTED: u64 = 1088       // 1 while a protected call is running (actors.s)
ACTOR_S_CURRENT_ACTOR: u64 = 1096   // the actor whose handler or `new` is running (0: none)
ACTOR_S_IN_NEW: u64 = 1104          // 1 while that actor's `new` is running
pub ACTOR_S_LOST: u64 = 1112            // messages lost because the actor they were for failed or ended
pub ACTOR_S_RESTARTS: u64 = 1120        // actors restarted so far
// Fault injection (a test sets it), in words of the core's block (assembly core_block): fail the handler that is run this many
// handlers after it was armed (0: off) ...
CORE_INJECT_NEXT: u64 = 200
CORE_INJECT_PERIOD: u64 = 208       // ... and then every this many (0: only once)
CORE_INJECT_COUNT: u64 = 216        // handlers run since it was armed
// Timers (decision 196), kept in core 0's block (assembly core_block): a count of armed timers, a sequence number, and 32
// entries of 64 bytes: the time it is due (counter ticks), the actor, the handler, the token, the order it was armed in.
// The actors that ended, their memory waiting to be used again (decision 197): in the block of the core whose arena they are in,
// a list through the first word of each block, whose size is in bits 8 to 31 of its domain word.
CORE_FREE_ACTORS: u64 = 512
// The actors of a domain (decision 201), kept in the block of the core it is on, for each domain d (1 to 3): the table of its
// places (DOMAIN_PLACES words, each the address of an actor's fields, 0: none), the next page of the pool a place may take, and the
// generation of the domain, which changes each time it is given back.
CORE_DOMAIN_TABLE: u64 = 576
CORE_DOMAIN_NEXT: u64 = 768
CORE_DOMAIN_GEN: u64 = 800
CORE_DOMAIN_SEEN: u64 = 832         // per domain, 64 bytes: a bit for each page of the pool that has ever been the first page of an actor's fields
// The generations of a domain's places (decision 209), for each domain d (1 to 3), one word: a counter that only grows. Every place
// put in the domain and every end and revocation of one takes the next value as its generation, whoever the tenant, so no
// generation is ever given twice to anything in that domain, and a reference to an actor of an earlier tenant never matches. The
// word counts the values given (the first is 0, as for an actor in the arena); when it has given the last one (PLACE_GEN_LAST, the
// largest generation a reference holds) the domain is not given out again.
CORE_PLACE_GEN: u64 = 1296          // (1024 to 1279 are the two scratch ring records of rings.s; 1288 is CORE_TIMER_SEQ)
PLACE_GEN_LAST: u64 = 0xFFFFFFFF
PLACE_GEN_NONE: u64 = 0x100000000      // what next_place_generation says when there is none left (no reference holds it)
// For tests only (decision 210), in each core's block: a bit for each core whose ring to this one `drain_rings` leaves alone, and a
// limit on turns (0: none; n > 0: this core runs n - 1 more turns, then none until it is changed). They make a schedule between
// two cores that a test needs happen every time, instead of once in ten runs.
CORE_TEST_HOLD: u64 = 1320
CORE_TEST_TURNS: u64 = 1328
CORE_TIMER_SEQ: u64 = 1288
CORE_TIMERS: u64 = 1536
TIMER_SLOTS: u64 = 32
TIMER_ENTRY: u64 = 64
TIMER_MAX_MS: u64 = 3600000         // an hour: more is a mistake, and keeps the arithmetic from overflowing
ACTOR_WATCHES: u64 = 1824           // who watches whom: 14 records of (actor watched, watcher | 1 if it wants `stopped`)
ACTOR_WATCH_MAX: u64 = 14           // ends at 2048, where the actors start (decision 149)
ACTOR_FIRST_ACTOR: u64 = 2048       // actors start here

// A handler may run this long before it counts as failed (decisions 121, 133).
ACTOR_BUDGET_MS: u64 = 100
BUDGET_DEFAULT_HZ: u64 = 19200000   // the timer's rate if the firmware didn't set it (hardware.md 12)
HANDLER_RECORD_BYTES: u64 = 40      // one record of Fledgling's handler table

// Protection domains (decision 175; kernel/arch/aarch64/domain.s has the layout of a pool).
DOMAINS: u64 = 3
DOMAIN_FIELDS: u64 = 0x11000        // where an actor in a domain keeps its fields: its reference points here ...
DOMAIN_INBOX: u64 = 0x1FF000        // ... and the message it is handling is copied here
DOMAIN_POOL_BYTES: u64 = 0x200000
DOMAIN_CONTROL: u64 = 0x10000       // the control page: the actor's header and mailbox are at its end
DOMAIN_PLACES: u64 = 8              // the actors one domain can hold in its life (decision 201)
DOMAIN_PAGE: u64 = 4096
DOMAIN_CONTROL_PAGE: u64 = 16       // the page of the control page of the first place
DOMAIN_INBOX_PAGE: u64 = 511        // the last page, where the message being handled is copied
// The page of a place's header (EL1 only), from its start: the arguments of `new` waiting while the domain restarts (DOMAIN_ARGS_SAVE
// bytes), the control block of a DMA transfer for the domain (32 bytes, 32-byte aligned, dma.rook: only the first place's page is
// used for it), then the header and mailbox, which end where the fields start (1264 bytes: from 0xB10). Decision 212.
DOMAIN_ARGS_SAVE: u64 = 2784
pub DOMAIN_DMA_BLOCK: u64 = DOMAIN_CONTROL + DOMAIN_ARGS_SAVE      // 0x10AE0: the control block of a DMA transfer, in the pool
DOMAIN_OPEN: u64 = 1                // the state of a domain that is in use (domain_actor_of says 0 for a free one) ...
DOMAIN_CLOSING: u64 = 2             // ... and one whose actors are being ended: nothing is placed in it any more ...
DOMAIN_FREEING: u64 = 3             // ... and one being given back by its own core (decision 211): not free yet, and not run
DOMAIN_CLEAN: u64 = 0x5EC0C1EA9ED0C0DE  // the first word of the control page of a pool that was wiped when its actor ended
DOMAIN_STACK_FIRST: u64 = 0x1000    // the stack: [0x1000, 0x10000); then the control page; then the data
DOMAIN_STACK_END: u64 = 0x10000
REASON_DONE: u64 = 0                // why domain_enter returned (domain.s)
REASON_CALL: u64 = 3
REASON_BAD: u64 = 4                 // Raven's own: a request a domain may not make
REASON_REPORTED: u64 = 5            // Raven's own: it panicked and Raven has said so
// Records in the rings between cores (decision 181): 16 words. Word 0 says what it is, 1 is the actor it is for,
// 2 to 5 depend on the kind, 6 to 13 are message words, 14 the actor that was running when it was made, 15 a flag.
REC_SEND: u64 = 1                   // a message: 2 handler number, 3 words, 15 = 1: drop it if that handler is queued
REC_START: u64 = 2                  // run `new`: 2 its start stub, 3 argument words, 4 = 1: the actor is restarted in place
REC_WATCH: u64 = 3                  // watch_impl: 2 watcher, 3 handler `restarted`, 4 handler `stopped` plus one
REC_STOP: u64 = 4                   // end the actor
REC_DROP_WATCHES: u64 = 5           // a watcher ended or restarted: forget its watches
REC_TIMER: u64 = 6                  // arm a timer on core 0 (decision 196): 2 handler number, 3 deadline, 4 token
REC_RETIRE: u64 = 7                 // an actor in a domain has ended (decision 197): core 0 gives its domain back
REC_FREE_DOMAIN: u64 = 8            // core 0 to a domain's own core: give domain (word 1) back now (decision 211)
REC_PAYLOAD: u64 = 48               // byte offset of the message words in a record
SVC_SEND: u64 = 1                   // the calls (rtstubs.s)
SVC_SEND_RELIABLE: u64 = 2
SVC_PANIC: u64 = 8
SVC_SPAWN_SEPARATE: u64 = 4         // raven_spawn_separate: what an actor of a domain asks to place an actor in its own domain (decision 206)
SVC_TIMER: u64 = 9                  // raven_timer_after (rtstubs.s)
SVC_SELF: u64 = 10                  // raven_self (rtstubs.s)

/// The generation of an actor's place (decision 197): it changes each time the place is given to a new actor, so a
/// reference made for the old one no longer matches.
fn generation_of(g_actor: u64) -> u64 {
    unsafe {
        return load64(g_actor - ACTOR_BEFORE_FIELDS + ACTOR_H_DOMAIN) shr REF_GENERATION_SHIFT
    }
}

/// The reference to the actor whose fields are at `r_actor`, as it is now: address and generation in one word.
fn reference_to(r_actor: u64) -> u64 {
    return r_actor or (generation_of(r_actor) shl REF_GENERATION_SHIFT)
}

/// Does the reference `r_ref` name the actor that is in its place now, and not one that was there before?
pub fn is_current(r_ref: u64) -> bool {
    unsafe {
        r_address: u64 = r_ref and REF_ADDRESS_MASK
        // an address in a domain's pool names an actor only if one was placed there (decision 201): its header is read only then
        if r_address >= domain_pools_start() and r_address < domain_pools_end() and not place_registered(r_address) {
            return false
        }
    }
    return generation_of(r_ref and REF_ADDRESS_MASK) == (r_ref shr REF_GENERATION_SHIFT)
}

/// `self`, which the compiler turns into a call of this with the address of the actor's fields (the stub `raven_self`;
/// a domain asks by `svc`, because it cannot read its own header): the actor's whole reference.
pub fn self_impl(sf_actor: u64) -> u64 {
    return reference_to(sf_actor)
}

/// The first free block of exactly `tf_size` bytes in this core's arena, taken off the list (its address, the address of its
/// header); 0 if there is none.
fn take_free_block(tf_size: u64) -> u64 {
    unsafe {
        mut tf_link: u64 = core_block(core_id()) + CORE_FREE_ACTORS    // the word that points at the block looked at
        mut tf_block: u64 = load64(tf_link)
        scanning: loop tf_block != 0 {
            if ((load64(tf_block + ACTOR_H_DOMAIN) shr 8) and ACTOR_SIZE_MASK) == tf_size {
                store64(tf_link, load64(tf_block + ACTOR_H_DISPATCHER))
                return tf_block
            }
            tf_link = tf_block + ACTOR_H_DISPATCHER
            tf_block = load64(tf_link)
        }
    }
    return 0
}

/// Gives the memory of an ended actor back: its block goes on this core's list, ready for an actor of the same size.
fn release_block(rb_actor: u64) {
    unsafe {
        rb_block: u64 = rb_actor - ACTOR_BEFORE_FIELDS
        rb_head: u64 = core_block(core_id()) + CORE_FREE_ACTORS
        store64(rb_block + ACTOR_H_DISPATCHER, load64(rb_head))
        store64(rb_head, rb_block)
    }
}

/// Takes `ul_child` out of the list of siblings whose first one is kept in the word at `ul_head`. True if it was there.
fn unlink_from(ul_head: u64, ul_child: u64) -> bool {
    unsafe {
        mut ul_link: u64 = ul_head
        mut ul_at: u64 = load64(ul_link)
        walking: loop ul_at != 0 {
            if ul_at == ul_child {
                store64(ul_link, load64(ul_at - ACTOR_BEFORE_FIELDS + ACTOR_H_NEXT_SIBLING))
                return true
            }
            ul_link = ul_at - ACTOR_BEFORE_FIELDS + ACTOR_H_NEXT_SIBLING
            ul_at = load64(ul_link)
        }
    }
    return false
}

/// Takes `ul_who` out of the lists of its parent, if it has one (decision 197). Only core 0 does this: the lists are its.
/// (A parent that ends or restarts sets the parent word of each child it ends to 0 and clears its lists itself.)
fn unlink_from_parent(ul_who: u64) {
    unsafe {
        rt_header: u64 = ul_who - ACTOR_BEFORE_FIELDS
        rt_parent: u64 = load64(rt_header + ACTOR_H_PARENT)
        if rt_parent != 0 {
            rt_parent_header: u64 = rt_parent - ACTOR_BEFORE_FIELDS
            if unlink_from(rt_parent_header + ACTOR_H_FIRST_CHILD, ul_who) {
                mut rt_last: u64 = 0
                mut rt_at: u64 = load64(rt_parent_header + ACTOR_H_FIRST_CHILD)
                finding: loop rt_at != 0 {
                    rt_last = rt_at
                    rt_at = load64(rt_at - ACTOR_BEFORE_FIELDS + ACTOR_H_NEXT_SIBLING)
                }
                store64(rt_parent_header + ACTOR_H_LAST_CHILD, rt_last)
            } else {
                discard unlink_from(rt_parent_header + ACTOR_H_PENDING, ul_who)
            }
            store64(rt_header + ACTOR_H_PARENT, 0)
        }
    }
}

/// An actor has ended and nothing of Raven's points to it any more (decision 197): its place is to be given back. If it still
/// has an entry in this core's run queue that waits until the entry is taken, so that no entry is left for an actor that is
/// not there. Then `finish_retire`.
fn retire(rt_who: u64) {
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        if load64(rt_header + ACTOR_H_QUEUED) != 0 {
            store64(rt_header + ACTOR_H_FLAGS, load64(rt_header + ACTOR_H_FLAGS) or ACTOR_F_RETIRING)
            return
        }
    }
    finish_retire(rt_who)
}

/// Gives an ended actor's place back. In the arena: a new generation (every reference made for it is stale), out of its
/// parent's list, its block on the free list. In a domain: the same things, but they are done by core 0, which owns the lists
/// and the tables (`retire_domain`): the core the actor lived on asks it with a record.
fn finish_retire(fr_who: u64) {
    if domain_of(fr_who) == 0 {
        unsafe {
            rt_header: u64 = fr_who - ACTOR_BEFORE_FIELDS
            store64(rt_header + ACTOR_H_DOMAIN, load64(rt_header + ACTOR_H_DOMAIN) + (1 shl REF_GENERATION_SHIFT))
        }
        unlink_from_parent(fr_who)
        release_block(fr_who)
        return
    }
    if core_id() == 0 {
        retire_domain(fr_who)
        return
    }
    unsafe {
        fr_rec: u64 = ring_scratch(0)
        store64(fr_rec, REC_RETIRE)
        store64(fr_rec + 8, fr_who)
        push_record(0, fr_rec)
    }
}

/// Core 0: an actor in a domain has ended (decision 201). In this order: its place gets a new generation (a stale reference is refused
/// from now on); it leaves its parent's list; and if it was the last actor of the domain that has not ended, the domain is given back.
fn retire_domain(rd_who: u64) {
    rd_core: u64 = core_of_actor(rd_who)
    rd_domain: u64 = domain_of(rd_who)
    unsafe {
        rd_header: u64 = rd_who - ACTOR_BEFORE_FIELDS
        store64(rd_header + ACTOR_H_FLAGS, load64(rd_header + ACTOR_H_FLAGS) or ACTOR_F_ENDED or ACTOR_F_RETIRED)
        rd_generation: u64 = next_place_generation(rd_core, rd_domain)
        if rd_generation != PLACE_GEN_NONE {
            set_generation(rd_header, rd_generation)
        }
        // (with none left the old generation stays: the actor is ended, which refuses every send, and the domain, used up, is
        // never given to a new tenant, decision 209)
    }
    unlink_from_parent(rd_who)
    if unretired_place_count(rd_core, rd_domain) == 0 {
        free_domain_now(rd_core, rd_domain)         // (every actor's end has been handled: none is left to read a header that is gone)
    }
}

/// Gives domain `fd_d` of core `fd_core` back (decision 197, for several actors, decision 201). Core 0 does, at once, what makes
/// every reference and handle stale: it clears the table of places (from now a reference to any of its actors is refused, whatever
/// its pages hold) and changes the domain's generation (its handle is stale), and marks it FREEING, which no spawn takes and no turn
/// runs. The rest is done by the domain's own core, between two of its turns, because that core may still have the domain in its
/// run queue and keeps its ring's numbers (decision 211, the model `give_back`): core 0 sends it a record, or does it here if the
/// domain is its own.
fn free_domain_now(fd_core: u64, fd_d: u64) {
    fd_table: u64 = place_table(fd_core, fd_d)
    unsafe {
        clearing: loop fd_i: u64 in 0..DOMAIN_PLACES {
            store64(fd_table + fd_i * 8, 0)
        }
        fd_gen: u64 = core_block(fd_core) + CORE_DOMAIN_GEN + (fd_d - 1) * 8
        store64(fd_gen, load64(fd_gen) + 1)
        domain_set_actor_of(fd_core, fd_d, DOMAIN_FREEING)
        if fd_core == core_id() {
            finish_give_back(fd_d)
            return
        }
        fd_rec: u64 = ring_scratch(0)
        store64(fd_rec, REC_FREE_DOMAIN)
        store64(fd_rec + 8, fd_d)
        push_record(fd_core, fd_rec)
    }
}

/// On the domain's own core (decision 211): gives domain `gb_d` back. In this order: what was in its ring and the hold are counted
/// as over, the peripherals are taken away and the translations dropped on every core, the pages that only EL1 reached are ordinary
/// again, the pool is wiped and marked as wiped; then the domain is free (written with a release, so a core that sees it free sees
/// the wipe too).
fn finish_give_back(gb_d: u64) {
    gb_core: u64 = core_id()
    gb_pool: u64 = domain_pool_base_of(gb_core, gb_d)
    unsafe {
        runtime_discard(gb_core, gb_d)
        domain_unmap_devices_of(gb_core, gb_d)
        domain_reset_pool_map(gb_core, gb_d)
        pool_wipe(gb_pool)
        store64(gb_pool + DOMAIN_CONTROL, DOMAIN_CLEAN)
        domain_set_actor_of(gb_core, gb_d, 0)
    }
}

// ---- several actors in a domain (decision 201) ---------------------------------------------------------------------------------
// A domain's pool is 2 MB: the guard page, the stack, then pages for its actors. Each actor (a place) takes one page that only EL1
// reaches, for its header and mailbox, right before the pages of its fields (an actor's header is just before its fields, as it is
// in the arena), so a domain cannot reach any actor's header, its own or another's. The first place has the control page, as
// before; the others make their page EL1-only when they are placed.

/// The table of the places of domain `pt_d` on core `pt_core`.
fn place_table(pt_core: u64, pt_d: u64) -> u64 {
    unsafe {
        return core_block(pt_core) + CORE_DOMAIN_TABLE + (pt_d - 1) * 64
    }
}

/// The generation of domain `dg_d` on core `dg_core`: the number of times it has been given back.
fn domain_generation(dg_core: u64, dg_d: u64) -> u64 {
    unsafe {
        return load64(core_block(dg_core) + CORE_DOMAIN_GEN + (dg_d - 1) * 8)
    }
}

/// Has domain `gu_d` of core `gu_core` given out every generation it has (decision 209)? Then it is never used again.
fn generations_used_up(gu_core: u64, gu_d: u64) -> bool {
    unsafe {
        return load64(core_block(gu_core) + CORE_PLACE_GEN + (gu_d - 1) * 8) > PLACE_GEN_LAST
    }
}

/// The next generation of domain `ng_d` of core `ng_core`, for a place put in it or one that ends or is revoked: a value no
/// reference to anything in that domain has ever had (decision 209). PLACE_GEN_NONE if there is none left. Core 0 and the domain's
/// own core both take values, so the counter is bumped atomically.
fn next_place_generation(ng_core: u64, ng_d: u64) -> u64 {
    unsafe {
        ng_value: u64 = atomic_increment(core_block(ng_core) + CORE_PLACE_GEN + (ng_d - 1) * 8) - 1
        if ng_value > PLACE_GEN_LAST {
            return PLACE_GEN_NONE
        }
        return ng_value
    }
}

/// Gives the actor whose header is at `sg_header` the generation `sg_generation` (bits 32 to 63 of its domain word).
fn set_generation(sg_header: u64, sg_generation: u64) {
    unsafe {
        store64(sg_header + ACTOR_H_DOMAIN, (load64(sg_header + ACTOR_H_DOMAIN) and REF_ADDRESS_MASK) or (sg_generation shl REF_GENERATION_SHIFT))
    }
}

/// Is `pr_address`, an address in some domain's pool, the fields of an actor placed in that domain?
fn place_registered(pr_address: u64) -> bool {
    unsafe {
        pr_index: u64 = (pr_address - domain_pools_start()) shr 21
        pr_table: u64 = place_table(pr_index / DOMAINS, pr_index % DOMAINS + 1)
        looking: loop pr_i: u64 in 0..DOMAIN_PLACES {
            if load64(pr_table + pr_i * 8) == pr_address {
                return true
            }
        }
    }
    return false
}

/// Has the actor whose fields are at `pl_place` not ended?
fn place_live(pl_place: u64) -> bool {
    unsafe {
        return (load64(pl_place - ACTOR_BEFORE_FIELDS + ACTOR_H_FLAGS) and ACTOR_F_ENDED) == 0
    }
}

/// How many places domain `pc_d` of core `pc_core` has had, ended or not, and how many of them have not ended.
fn place_count(pc_core: u64, pc_d: u64) -> u64 {
    mut pc_n: u64 = 0
    pc_table: u64 = place_table(pc_core, pc_d)
    unsafe {
        counting: loop pc_i: u64 in 0..DOMAIN_PLACES {
            if load64(pc_table + pc_i * 8) != 0 {
                pc_n += 1
            }
        }
    }
    return pc_n
}

/// How many places of the domain have not yet been given up: an actor that has not ended, or has ended and whose end core 0 has not
/// handled yet (the record is on its way). The domain is given back when there are none.
fn unretired_place_count(lc_core: u64, lc_d: u64) -> u64 {
    mut lc_n: u64 = 0
    lc_table: u64 = place_table(lc_core, lc_d)
    unsafe {
        counting: loop lc_i: u64 in 0..DOMAIN_PLACES {
            lc_at: u64 = load64(lc_table + lc_i * 8)
            if lc_at != 0 {
                if (load64(lc_at - ACTOR_BEFORE_FIELDS + ACTOR_H_FLAGS) and ACTOR_F_RETIRED) == 0 {
                    lc_n += 1
                }
            }
        }
    }
    return lc_n
}

/// A domain that was free is taken: its pool is clean (wiped when it was given back, or wiped now if nothing is known about it)
/// and empty.
fn init_domain(id_core: u64, id_d: u64) {
    id_pool: u64 = domain_pool_base_of(id_core, id_d)
    unsafe {
        if load64(id_pool + DOMAIN_CONTROL) == DOMAIN_CLEAN {
            store64(id_pool + DOMAIN_CONTROL, 0)
        } else {
            pool_wipe(id_pool)                  // never used: nothing is known about what it holds
        }
        id_table: u64 = place_table(id_core, id_d)
        clearing: loop id_i: u64 in 0..DOMAIN_PLACES {
            store64(id_table + id_i * 8, 0)
        }
        store64(core_block(id_core) + CORE_DOMAIN_NEXT + (id_d - 1) * 8, DOMAIN_CONTROL_PAGE)
    }
    unsafe {
        domain_set_actor_of(id_core, id_d, DOMAIN_OPEN)
    }
}

/// The handle of a domain: its generation, its core and its number.
fn domain_handle(dh_core: u64, dh_d: u64) -> u64 {
    return (domain_generation(dh_core, dh_d) shl 8) or (dh_core shl 4) or dh_d
}

/// `new_domain()`: an empty domain on the next core in turn, which the holder of the handle may put actors in (decision 201).
pub fn new_domain_impl() -> u64 {
    nd_core: u64 = spawn_next_core()
    nd_d: u64 = free_domain(nd_core)
    init_domain(nd_core, nd_d)
    return domain_handle(nd_core, nd_d)
}

/// The core (bits 4 to 7) and the number (bits 0 to 3) of the domain a handle names; a failure like any bug if it has ended
/// (the handle of a domain that was given back is stale, as a reference to an actor that ended is).
fn resolve_domain(rd_handle: u64) -> u64 {
    rd_d: u64 = rd_handle and 0xF
    rd_core: u64 = (rd_handle shr 4) and 0xF
    if rd_d == 0 or rd_d > DOMAINS or rd_core > 3 {
        panic("not a domain")
    }
    unsafe {
        if domain_actor_of(rd_core, rd_d) != DOMAIN_OPEN or domain_generation(rd_core, rd_d) != (rd_handle shr 8) {
            panic("that domain has ended")
        }
    }
    return (rd_core shl 4) or rd_d
}

/// Gives an actor with `tp_words` words of fields and arguments a place in domain `tp_d` of core `tp_core`: a page that only EL1
/// reaches, then the pages for its fields. Returns the address of its fields, which is its reference. Its header and mailbox page is
/// cleared here, once the domain can no longer reach it: it may hold what the domain put there while it was an ordinary page.
/// Is there room in the domain for an actor of `pf_words` words of fields and arguments: a free place and the pages? (The checks
/// `take_place` makes, for a caller that must not panic: an actor in a domain that asks for more fails its domain, not Raven.)
fn place_fits(pf_core: u64, pf_d: u64, pf_words: u64) -> bool {
    if pf_words > 4096 {
        return false
    }
    unsafe {
        pf_control: u64 = load64(core_block(pf_core) + CORE_DOMAIN_NEXT + (pf_d - 1) * 8)
        mut pf_pages: u64 = (pf_words * 8 + DOMAIN_PAGE - 1) / DOMAIN_PAGE
        if pf_pages == 0 {
            pf_pages = 1
        }
        if pf_control + 1 + pf_pages > RT_FIRST_PAGE {
            return false
        }
        pf_table: u64 = place_table(pf_core, pf_d)
        looking: loop pf_i: u64 in 0..DOMAIN_PLACES {
            if load64(pf_table + pf_i * 8) == 0 {
                return true
            }
        }
    }
    return false
}

fn take_place(tp_core: u64, tp_d: u64, tp_words: u64) -> u64 {
    tp_pool: u64 = domain_pool_base_of(tp_core, tp_d)
    unsafe {
        tp_next_at: u64 = core_block(tp_core) + CORE_DOMAIN_NEXT + (tp_d - 1) * 8
        tp_control: u64 = load64(tp_next_at)                    // the page for its header and mailbox
        mut tp_pages: u64 = (tp_words * 8 + DOMAIN_PAGE - 1) / DOMAIN_PAGE
        if tp_pages == 0 {
            tp_pages = 1
        }
        if tp_control + 1 + tp_pages > RT_FIRST_PAGE {
            panic("a separate actor's fields do not fit its domain")
        }
        tp_table: u64 = place_table(tp_core, tp_d)
        mut tp_slot: u64 = DOMAIN_PLACES
        finding: loop tp_i: u64 in 0..DOMAIN_PLACES {
            if tp_slot == DOMAIN_PLACES and load64(tp_table + tp_i * 8) == 0 {
                tp_slot = tp_i
            }
        }
        if tp_slot == DOMAIN_PLACES {
            panic("a domain holds at most 8 actors")
        }
        if tp_control != DOMAIN_CONTROL_PAGE {
            domain_pool_page_el1(tp_core, tp_d, tp_control)
        }
        pool_wipe_range(tp_pool + tp_control * DOMAIN_PAGE, DOMAIN_PAGE)
        tp_fields: u64 = tp_pool + (tp_control + 1) * DOMAIN_PAGE
        store64(tp_table + tp_slot * 8, tp_fields)
        store64(tp_next_at, tp_control + 1 + tp_pages)
        // a reference to an actor of this place stays a reference to something that was an actor, also after the place is given back
        tp_seen: u64 = core_block(tp_core) + CORE_DOMAIN_SEEN + (tp_d - 1) * 64 + ((tp_control + 1) / 64) * 8
        store64(tp_seen, load64(tp_seen) or (1 shl ((tp_control + 1) % 64)))
        return tp_fields
    }
}

/// Does [`hc_from`, `hc_to`), offsets in the pool of domain `hc_d` of core `hc_core`, touch a page that only EL1 reaches (the header
/// and mailbox of an actor)? A device told to use it, or a request that Raven reads it for a domain, must not.
pub fn range_hits_control_page(hc_core: u64, hc_d: u64, hc_from: u64, hc_to: u64) -> bool {
    hc_table: u64 = place_table(hc_core, hc_d)
    hc_pool: u64 = domain_pool_base_of(hc_core, hc_d)
    unsafe {
        looking: loop hc_i: u64 in 0..DOMAIN_PLACES {
            hc_at: u64 = load64(hc_table + hc_i * 8)
            if hc_at != 0 {
                hc_page: u64 = hc_at - hc_pool - DOMAIN_PAGE      // the offset of the page before its fields
                if hc_from < hc_page + DOMAIN_PAGE and hc_page < hc_to {
                    return true
                }
            }
        }
    }
    return false
}

// ---- the runtime inside a domain (decision 203) --------------------------------------------------------------------------------
// The mailboxes of the actors of a domain and the choice of which runs are in the domain (domain_runtime.rook, at EL0); Raven writes the
// messages for its actors into a ring in the domain's memory and runs a turn of the domain when it has work. Raven keeps, in the
// block of the core the domain is on and so out of the domain's reach: how many records it has put in the ring, how many of them it
// has seen the runtime take, and whether the domain is in its run queue. The runtime's own number of records taken is read as a
// number to be clamped, never as a place to write.
CORE_DOMAIN_RING: u64 = 3584        // for each domain d (1 to 3), 64 bytes: ...
RING_PRODUCED: u64 = 0
RING_SEEN: u64 = 8
RING_QUEUED: u64 = 16               // 1 if the domain is in this core's run queue (an entry that is an odd number: 2 * d + 1)
RING_DONE: u64 = 24                 // how many of the messages put in the ring Raven has counted as finished
RING_DEFER: u64 = 32                // 1 while a turn that failed is being restarted: the messages lost are counted as over when it is done
RING_DEFERRED: u64 = 40             // how many are waiting to be counted
RING_STARTS: u64 = 56               // how many actors placed from inside the domain are waiting for their `new` (decision 206)
RING_HOLD: u64 = 48                 // 1 while the domain has messages that Raven has not counted (those its actors sent each other, decision 204): one is in the count of unfinished messages for them all

fn ring_state(rs_core: u64, rs_d: u64) -> u64 {
    unsafe {
        return core_block(rs_core) + CORE_DOMAIN_RING + (rs_d - 1) * 64
    }
}

/// The place of the actor whose fields are at `pi_who` in domain `pi_d` of core `pi_core`, or RT_PLACES.
fn place_index(pi_core: u64, pi_d: u64, pi_who: u64) -> u64 {
    pi_table: u64 = place_table(pi_core, pi_d)
    unsafe {
        looking: loop pi_i: u64 in 0..RT_PLACES {
            if load64(pi_table + pi_i * 8) == pi_who {
                return pi_i
            }
        }
    }
    return RT_PLACES
}

/// How far has the runtime of the domain read the ring, and how many messages are over? Its own numbers, clamped to what Raven has put
/// there (it cannot have taken more than that, nor finished more than it has taken) and never going back. A message counts as
/// unfinished until it is over: also while it waits in a mailbox of the domain, so that a core that waits for the system to be idle
/// waits for it. A domain that counts too low is never idle (it harms its own turns only); too high is cut at what it was given.
fn refresh_consumed(rc_core: u64, rc_d: u64) {
    rc_state: u64 = ring_state(rc_core, rc_d)
    rc_pool: u64 = domain_pool_base_of(rc_core, rc_d)
    unsafe {
        rc_produced: u64 = load64(rc_state + RING_PRODUCED)
        rc_seen: u64 = load64(rc_state + RING_SEEN)
        mut rc_taken: u64 = load64(rc_pool + RT_STATE + RT_S_CONSUMED)
        if rc_taken > rc_produced {
            rc_taken = rc_produced
        }
        if rc_taken > rc_seen {
            store64(rc_state + RING_SEEN, rc_taken)
        } else {
            rc_taken = rc_seen
        }
        mut rc_over: u64 = load64(rc_pool + RT_STATE + RT_S_FINISHED)
        if rc_over > rc_taken {
            rc_over = rc_taken
        }
        rc_done: u64 = load64(rc_state + RING_DONE)
        if rc_over > rc_done {
            pending_sub(rc_over - rc_done)
            store64(rc_state + RING_DONE, rc_over)
        }
    }
}

/// Puts the domain in this core's run queue, unless it is in it.
fn queue_domain(qd_core: u64, qd_d: u64) {
    qd_state: u64 = ring_state(qd_core, qd_d)
    unsafe {
        if load64(qd_state + RING_QUEUED) == 0 {
            store64(qd_state + RING_QUEUED, 1)
            run_queue_push((qd_d shl 1) or 1)
        }
    }
}

/// A message for the actor of a domain, which runs on this core: a record in the ring of the domain, and the domain in the run queue.
/// False, with nothing changed, if the actor has ended or the ring is full.
fn domain_enqueue(de_target: u64, de_handler: u64, de_payload: u64, de_words: u64) -> bool {
    de_core: u64 = core_of_actor(de_target)
    de_d: u64 = domain_of(de_target)
    de_place: u64 = place_index(de_core, de_d, de_target)
    if de_place == RT_PLACES {
        return false
    }
    unsafe {
        if (load64(de_target - ACTOR_BEFORE_FIELDS + ACTOR_H_FLAGS) and ACTOR_F_ENDED) != 0 {
            return false
        }
    }
    refresh_consumed(de_core, de_d)
    de_state: u64 = ring_state(de_core, de_d)
    unsafe {
        de_produced: u64 = load64(de_state + RING_PRODUCED)
        if de_produced - load64(de_state + RING_SEEN) >= RT_RING_SLOTS {
            return false
        }
        de_slot: u64 = domain_pool_base_of(de_core, de_d) + RT_RING + (de_produced % RT_RING_SLOTS) * RT_SLOT_BYTES
        store64(de_slot, de_place)
        store64(de_slot + 8, de_handler)
        store64(de_slot + 16, de_words)
        copying: loop de_w: u64 in 0..de_words {
            store64(de_slot + 24 + de_w * 8, load64(de_payload + de_w * 8))
        }
        store64(de_state + RING_PRODUCED, de_produced + 1)
        pending_add(1)                          // one more message nobody has finished with
    }
    queue_domain(de_core, de_d)
    return true
}

/// Is a message for `dq_handler` of that actor already in the ring, not yet taken?
fn domain_queued(dq_target: u64, dq_handler: u64) -> bool {
    dq_core: u64 = core_of_actor(dq_target)
    dq_d: u64 = domain_of(dq_target)
    dq_place: u64 = place_index(dq_core, dq_d, dq_target)
    refresh_consumed(dq_core, dq_d)
    dq_state: u64 = ring_state(dq_core, dq_d)
    dq_pool: u64 = domain_pool_base_of(dq_core, dq_d)
    unsafe {
        looking: loop dq_i: u64 in load64(dq_state + RING_SEEN)..load64(dq_state + RING_PRODUCED) {
            dq_slot: u64 = dq_pool + RT_RING + (dq_i % RT_RING_SLOTS) * RT_SLOT_BYTES
            if load64(dq_slot) == dq_place and load64(dq_slot + 8) == dq_handler {
                return true
            }
        }
    }
    return false
}

/// The domain's runtime is told about an actor placed in it: its address, its dispatcher, and whether its `new` has not run yet (its
/// messages wait for that).
fn runtime_register(rr_who: u64, rr_dispatcher: u64, rr_held: bool) {
    rr_core: u64 = core_of_actor(rr_who)
    rr_d: u64 = domain_of(rr_who)
    rr_place: u64 = place_index(rr_core, rr_d, rr_who)
    rr_pool: u64 = domain_pool_base_of(rr_core, rr_d)
    unsafe {
        rr_state: u64 = rr_pool + RT_STATE
        store64(rr_state + RT_S_ACTOR + rr_place * 8, rr_who)
        store64(rr_state + RT_S_DISPATCHER + rr_place * 8, rr_dispatcher)
        store64(rr_state + RT_S_ENDED + rr_place * 8, 0)
        store64(rr_state + RT_S_GEN + rr_place * 8, generation_of(rr_who))
        store64(rr_state + RT_S_HELD + rr_place * 8, if rr_held { 1 } else { 0 })
        rr_block: u64 = rt_block(rr_pool, rr_place)
        store64(rr_block, 0)
        store64(rr_block + 8, 0)
        store64(rr_block + 16, 0)
    }
}

/// Empties the mailbox of an actor in a domain (a restart, an end): what was in it counts as lost.
fn runtime_clear(rc_who: u64) {
    rc_core: u64 = core_of_actor(rc_who)
    rc_d: u64 = domain_of(rc_who)
    rc_place: u64 = place_index(rc_core, rc_d, rc_who)
    if rc_place == RT_PLACES {
        return
    }
    unsafe {
        rc_block: u64 = rt_block(domain_pool_base_of(rc_core, rc_d), rc_place)
        mut rc_count: u64 = load64(rc_block + 8)
        if rc_count > ACTOR_SLOTS {
            rc_count = ACTOR_SLOTS                  // (the domain's own number)
        }
        rc_base: u64 = actor_arena_base()
        store64(rc_base + ACTOR_S_LOST, load64(rc_base + ACTOR_S_LOST) + rc_count)
        // only the messages that came through the ring are in Raven's count: those the fast path put there are not (RT_FAST_FLAG),
        // and counting them as finished would make a ring record that still waits look finished (decision 210)
        rc_ring: u64 = rt_ring_messages_in(domain_pool_base_of(rc_core, rc_d), rc_place)
        rc_over_at: u64 = domain_pool_base_of(rc_core, rc_d) + RT_STATE + RT_S_FINISHED
        rc_over: u64 = load64(rc_over_at)       // (the domain's own count, which it may have set to anything: decision 208)
        if rc_over <= 0xFFFFFFFFFFFFFFFF - rc_ring {
            store64(rc_over_at, rc_over + rc_ring)      // they are over (refresh_consumed clamps whatever this holds)
        }
        store64(rc_block, 0)
        store64(rc_block + 8, 0)
    }
}

/// An actor in a domain has ended: its runtime runs nothing of it any more.
fn runtime_end(re_who: u64) {
    re_core: u64 = core_of_actor(re_who)
    re_d: u64 = domain_of(re_who)
    re_place: u64 = place_index(re_core, re_d, re_who)
    if re_place == RT_PLACES {
        return
    }
    unsafe {
        store64(domain_pool_base_of(re_core, re_d) + RT_STATE + RT_S_ENDED + re_place * 8, 1)
    }
    runtime_clear(re_who)
}

/// An actor's `new` has run: its runtime may run its messages, and the domain does if it has any.
fn runtime_release(rl_who: u64) {
    rl_core: u64 = core_of_actor(rl_who)
    rl_d: u64 = domain_of(rl_who)
    rl_place: u64 = place_index(rl_core, rl_d, rl_who)
    if rl_place == RT_PLACES {
        return
    }
    rl_pool: u64 = domain_pool_base_of(rl_core, rl_d)
    unsafe {
        store64(rl_pool + RT_STATE + RT_S_HELD + rl_place * 8, 0)
        rl_block: u64 = rt_block(rl_pool, rl_place)
        if load64(rl_block + 8) != 0 {
            if load64(rl_block + 16) == 0 {
                store64(rl_block + 16, 1)
                rt_queue_push(rl_pool, rl_place)
                queue_domain(rl_core, rl_d)
            }
            // (what waits may be messages its own domain sent it while it waited for its `new`, which no count of Raven's
            // includes: the domain is held, so the system is not idle until a turn has run them, decision 210)
            hold_domain(rl_core, rl_d)
        }
    }
}

/// The domain has messages that no count of Raven's includes (decision 204): one is added to the count of unfinished messages
/// for the whole domain, unless it is held already. A turn that ends with no message left takes it away (`run_domain_entry`),
/// and so do a restart and a give-back (`runtime_discard`).
fn hold_domain(hd_core: u64, hd_d: u64) {
    hd_state: u64 = ring_state(hd_core, hd_d)
    unsafe {
        if load64(hd_state + RING_HOLD) == 0 {
            pending_add(1)
            store64(hd_state + RING_HOLD, 1)
        }
    }
}

/// The records in the ring that the runtime has not taken are gone (the domain restarts, or is given back): they are over, as
/// far as the count of unfinished messages goes, and the ring starts again.
fn runtime_discard(rd_core: u64, rd_d: u64) {
    rd_state: u64 = ring_state(rd_core, rd_d)
    unsafe {
        rd_produced: u64 = load64(rd_state + RING_PRODUCED)
        rd_done: u64 = load64(rd_state + RING_DONE)
        if rd_produced > rd_done {
            if load64(rd_state + RING_DEFER) != 0 {
                // (a failed turn: the count of unfinished messages must not reach 0 while the domain is being restarted, its `new`
                // run and its watchers told, or a core that waits for the system to be idle goes on too soon)
                store64(rd_state + RING_DEFERRED, load64(rd_state + RING_DEFERRED) + (rd_produced - rd_done))
            } else {
                pending_sub(rd_produced - rd_done)  // every message not over is over now
            }
            rd_base: u64 = actor_arena_base()
            store64(rd_base + ACTOR_S_LOST, load64(rd_base + ACTOR_S_LOST) + (rd_produced - rd_done))
        }
        if load64(rd_state + RING_HOLD) != 0 {
            store64(rd_state + RING_HOLD, 0)
            if load64(rd_state + RING_DEFER) != 0 {
                store64(rd_state + RING_DEFERRED, load64(rd_state + RING_DEFERRED) + 1)
            } else {
                pending_sub(1)
            }
        }
        store64(rd_state + RING_STARTS, 0)
        store64(rd_state + RING_PRODUCED, 0)
        store64(rd_state + RING_SEEN, 0)
        store64(rd_state + RING_DONE, 0)
    }
}

/// The domain's memory has been wiped (it restarts): the runtime's tables are written again from Raven's, the ring starts again, and
/// what was in it is lost.
fn runtime_rebuild(rb_core: u64, rb_d: u64) {
    runtime_discard(rb_core, rb_d)
    rb_table: u64 = place_table(rb_core, rb_d)
    rb_state: u64 = domain_pool_base_of(rb_core, rb_d) + RT_STATE
    unsafe {
        rebuilding: loop rb_i: u64 in 0..RT_PLACES {
            rb_who: u64 = load64(rb_table + rb_i * 8)
            if rb_who != 0 {
                rb_header: u64 = rb_who - ACTOR_BEFORE_FIELDS
                store64(rb_state + RT_S_ACTOR + rb_i * 8, rb_who)
                store64(rb_state + RT_S_DISPATCHER + rb_i * 8, load64(rb_header + ACTOR_H_DISPATCHER))
                store64(rb_state + RT_S_GEN + rb_i * 8, generation_of(rb_who))
                if (load64(rb_header + ACTOR_H_FLAGS) and ACTOR_F_PENDING) != 0 {
                    store64(rb_header + ACTOR_H_FLAGS, load64(rb_header + ACTOR_H_FLAGS) - ACTOR_F_PENDING)     // (its `new` runs in the restart)
                }
                store64(rb_state + RT_S_ENDED + rb_i * 8, if (load64(rb_header + ACTOR_H_FLAGS) and ACTOR_F_ENDED) != 0 { 1 } else { 0 })
            }
        }
    }
}

/// The first actor of a domain that has not ended, or 0.
fn first_live_place(fl_core: u64, fl_d: u64) -> u64 {
    fl_table: u64 = place_table(fl_core, fl_d)
    unsafe {
        looking: loop fl_i: u64 in 0..DOMAIN_PLACES {
            fl_at: u64 = load64(fl_table + fl_i * 8)
            if fl_at != 0 {
                if place_live(fl_at) {
                    return fl_at
                }
            }
        }
    }
    return 0
}

/// Enters the runtime of domain `rt_d` of this core for one turn and does what the domain asks until the turn ends: 0 if it ended with
/// no actor having a message, 1 if some has, 2 if it failed (and Raven has said so).
fn run_domain_turn(rt_d: u64) -> u64 {
    rt_pool: u64 = domain_pool_base(rt_d)
    rt_state: u64 = ring_state(core_id(), rt_d)
    unsafe {
        mut rt_reason: u64 = domain_enter(rt_d, domain_turn_address(), load64(rt_state + RING_PRODUCED), rt_pool, 0)
        servicing: loop rt_reason == REASON_CALL {
            rt_reason = service_call(rt_pool)
        }
        if rt_reason == REASON_DONE {
            return domain_saved_x(0) and 1
        }
        report_failure(rt_d, rt_reason)
    }
    return 2
}

/// A turn of domain `re_d`, which was in this core's run queue.
fn run_domain_entry(re_d: u64) {
    re_core: u64 = core_id()
    re_state: u64 = ring_state(re_core, re_d)
    unsafe {
        store64(re_state + RING_QUEUED, 0)
        re_state_now: u64 = domain_actor_of(re_core, re_d)
        if re_state_now != DOMAIN_OPEN and re_state_now != DOMAIN_CLOSING {
            return                              // it has been given back since, or is being given back (decision 211)
        }
        domain_budget_begin()
    }
    timer_arm(budget_ticks())
    mut re_outcome: u64 = 2
    if not inject_now() {
        re_outcome = run_domain_turn(re_d)
    }
    timer_disarm()
    domain_budget_end()
    if re_outcome == 2 {
        re_first: u64 = first_live_place(re_core, re_d)
        unsafe {
            store64(re_state + RING_DEFER, 1)
        }
        if re_first != 0 {
            discard restart_actor(re_first)     // the domain restarts as a unit
        }
        unsafe {
            store64(re_state + RING_DEFER, 0)
            pending_sub(load64(re_state + RING_DEFERRED))   // now the messages it lost are over
            store64(re_state + RING_DEFERRED, 0)
        }
        return
    }
    unsafe {
        store64(re_state + RING_DEFER, 1)           // (an actor whose `new` fails restarts the domain: as for a failed turn, the count waits)
    }
    if run_pending_starts(re_core, re_d) != 0 and re_outcome == 0 {
        // (a message sent to an actor that was still starting waits in its mailbox, which no count of Raven's knows: the domain has work
        // until it has run it, so the system is not idle: found by `domain_spawn`, which lost its second line one run in about ten)
        re_outcome = 1
    }
    unsafe {
        store64(re_state + RING_DEFER, 0)
        pending_sub(load64(re_state + RING_DEFERRED))
        store64(re_state + RING_DEFERRED, 0)
        if re_outcome == 1 and load64(re_state + RING_HOLD) == 0 {
            // (the actors of the domain have messages for each other that no count knows of: the system is not idle until they are handled)
            pending_add(1)
            store64(re_state + RING_HOLD, 1)
        }
    }
    refresh_consumed(re_core, re_d)
    unsafe {
        if re_outcome == 0 and load64(re_state + RING_HOLD) != 0 {
            store64(re_state + RING_HOLD, 0)
            pending_sub(1)
        }
        if re_outcome == 1 or load64(re_state + RING_PRODUCED) > load64(re_state + RING_SEEN) {
            queue_domain(re_core, re_d)
        }
    }
}

/// What an actor of a domain asks when it does `spawn Name(...) in d` (the call `raven_spawn_separate`, decision 206): the actor is
/// placed in the domain it is in, and its `new` runs when the turn that placed it is over (it cannot run now: the placer's handler
/// is on the domain's stack). The result is the reference to the new actor, or 0 if the request is not one a domain may make
/// (any other domain than its own, a device, a domain that is full, arguments that are not in its pool): the domain fails.
fn place_from_domain(pf_pool: u64) -> u64 {
    pf_index: u64 = (pf_pool - domain_pools_start()) shr 21
    pf_core: u64 = pf_index / 3
    pf_d: u64 = pf_index % 3 + 1
    unsafe {
        pf_fields: u64 = domain_saved_x(0)
        pf_dispatcher: u64 = domain_saved_x(1)
        pf_entry: u64 = domain_saved_x(2)
        pf_args: u64 = domain_saved_x(3)
        pf_words: u64 = domain_saved_x(4)
        pf_handle: u64 = domain_saved_x(6)
        // (every register is the domain's: bounded before any arithmetic, so no number it chooses can overflow here and panic
        // Raven, decision 208)
        if domain_saved_x(5) != 0 or pf_fields > 4096 or pf_words > DOMAIN_ARGS_SAVE / 8 {
            return 0
        }
        if pf_words > 0 and not pool_readable(pf_pool, pf_args, pf_words * 8) {
            return 0
        }
        if (pf_handle and 0xF) != pf_d or ((pf_handle shr 4) and 0xF) != pf_core or core_id() != pf_core {
            return 0                                    // the Domain it holds is not its own domain: not built (decision 206)
        }
        if domain_actor_of(pf_core, pf_d) != DOMAIN_OPEN or domain_generation(pf_core, pf_d) != (pf_handle shr 8) {
            return 0                                    // a Domain that has ended
        }
        if not place_fits(pf_core, pf_d, pf_fields + pf_words) {
            return 0
        }
        pf_generation: u64 = next_place_generation(pf_core, pf_d)
        if pf_generation == PLACE_GEN_NONE {
            return 0                                    // the domain has given out every generation (decision 209)
        }
        pf_actor: u64 = take_place(pf_core, pf_d, pf_fields + pf_words)
        pf_header: u64 = pf_actor - ACTOR_BEFORE_FIELDS
        store64(pf_header + ACTOR_H_DISPATCHER, pf_dispatcher)
        store64(pf_header + ACTOR_H_ARGS, pf_actor + pf_fields * 8)
        store64(pf_header + ACTOR_H_DOMAIN,
                pf_d or (pf_core shl 4) or (pf_generation shl REF_GENERATION_SHIFT))
        store64(pf_header + ACTOR_H_START, pf_entry)
        store64(pf_header + ACTOR_H_ARGS_WORDS, pf_words)
        store64(pf_header + ACTOR_H_PARENT, 0)
        store64(pf_header + ACTOR_H_FLAGS, ACTOR_F_STARTING or ACTOR_F_PENDING)
        store64(pf_header + ACTOR_H_NEXT_SIBLING, 0)
        pf_kept: u64 = pf_actor + pf_fields * 8
        copying: loop pf_w: u64 in 0..pf_words {
            store64(pf_kept + pf_w * 8, load64(pf_args + pf_w * 8))
        }
        runtime_register(pf_actor, pf_dispatcher, true)
        pf_state: u64 = ring_state(pf_core, pf_d)
        store64(pf_state + RING_STARTS, load64(pf_state + RING_STARTS) + 1)
        return reference_to(pf_actor)
    }
}

/// Runs the `new` of the actors that actors of domain `rs_d` placed in it during the turn that is over (decision 206).
fn run_pending_starts(rs_core: u64, rs_d: u64) -> u64 {
    rs_state: u64 = ring_state(rs_core, rs_d)
    mut rs_started: u64 = 0
    unsafe {
        if load64(rs_state + RING_STARTS) == 0 {
            return 0
        }
        store64(rs_state + RING_STARTS, 0)
        rs_table: u64 = place_table(rs_core, rs_d)
        starting: loop rs_i: u64 in 0..DOMAIN_PLACES {
            rs_who: u64 = load64(rs_table + rs_i * 8)
            if rs_who != 0 {
                rs_header: u64 = rs_who - ACTOR_BEFORE_FIELDS
                if (load64(rs_header + ACTOR_H_FLAGS) and ACTOR_F_PENDING) != 0 {
                    store64(rs_header + ACTOR_H_FLAGS, load64(rs_header + ACTOR_H_FLAGS) - ACTOR_F_PENDING)
                    start_here(rs_who, load64(rs_header + ACTOR_H_START), load64(rs_header + ACTOR_H_ARGS_WORDS), 0, load64(rs_header + ACTOR_H_ARGS))
                    rs_started += 1
                }
            }
        }
    }
    return rs_started
}

/// Makes room for an actor with `fields` words of fields and `args_words` words of `new`
/// arguments (copied from `args`, and kept so the actor can be restarted), then runs its
/// start stub, which runs `new`. Returns its reference. `dispatcher` is the address of the
/// actor's dispatcher and `start` of its start stub.
///
/// If the actor spawning is being restarted and this spawn is in its `new`, the actor it
/// spawned in the same position before is restarted in the same place instead of a new
/// one being made (decision 148), so references to it stay valid.
pub fn spawn_actor_impl(fields: u64, dispatcher: u64, rt_entry: u64, rt_args: u64,
                        rt_args_words: u64) -> u64 {
    return spawn_common(fields, dispatcher, rt_entry, rt_args, rt_args_words, false, 0, 0)
}

/// The same for an actor that lives in a protection domain of its own (`separate actor`, decision 172): the
/// next free domain is given to it, its fields are in the domain's pool and its header and mailbox in the
/// pool's control page, which only Raven reaches. Its `new` runs in the domain.
///
/// `rt_devices` has bit i set if words i and i+1 of the arguments are an `Mmio` (base, size): the compiler marks them.
/// The pages it covers are mapped into the domain before `new` runs (decision 182).
pub fn spawn_separate_impl(fields: u64, dispatcher: u64, rt_entry: u64, rt_args: u64,
                           rt_args_words: u64, rt_devices: u64, rt_domain: u64) -> u64 {
    return spawn_common(fields, dispatcher, rt_entry, rt_args, rt_args_words, true, rt_devices, rt_domain)
}

/// `new_domain()`: an empty domain, whose handle is the right to put actors in it (decision 201).
pub extern fn raven_new_domain() -> u64

/// `stop(domain)`: ends every actor in the domain and gives it back (decision 201).
pub extern fn raven_stop_domain(handle: u64)

/// The holder of a domain ends it: nothing is placed in it from now on, every actor in it ends, and the domain is given back when the
/// last of them has (at once if it has none).
/// `revoke(target)` (decision 207): every reference to the actor `rv_ref` names goes stale at once, and the caller is given a new one. Only the
/// actor that spawned it (or code outside any actor that did) may, as for `stop`. The actor runs on; what is already in its mailbox is
/// delivered (those messages were sent with a reference that was good then, and a message carries no sender to tell them from the
/// owner's); what is in a ring on its way is dropped when it arrives, as a send to any stale reference is; a timer armed with an old
/// reference finds it stale when it fires. A reference that is stale already is returned as it is.
pub fn revoke_impl(rv_ref: u64) -> u64 {
    rv_base: u64 = actor_arena_base()
    if not is_current(rv_ref) {
        return rv_ref
    }
    rv_target: u64 = rv_ref and REF_ADDRESS_MASK
    rv_header: u64 = rv_target - ACTOR_BEFORE_FIELDS
    unsafe {
        if load64(rv_header + ACTOR_H_PARENT) != load64(rv_base + ACTOR_S_CURRENT_ACTOR) {
            panic("only the actor that spawned an actor can revoke it")
        }
        rv_domain: u64 = domain_of(rv_target)
        if rv_domain == 0 {
            store64(rv_header + ACTOR_H_DOMAIN, load64(rv_header + ACTOR_H_DOMAIN) + (1 shl REF_GENERATION_SHIFT))
        } else {
            // (in a domain the new generation is the next value of the domain's counter, decision 209)
            rv_core: u64 = core_of_actor(rv_target)
            rv_generation: u64 = next_place_generation(rv_core, rv_domain)
            if rv_generation == PLACE_GEN_NONE {
                panic("this actor's domain has given out every generation: it cannot be revoked")
            }
            set_generation(rv_header, rv_generation)
            rv_place: u64 = place_index(rv_core, rv_domain, rv_target)
            if rv_place != RT_PLACES {
                store64(domain_pool_base_of(rv_core, rv_domain) + RT_STATE + RT_S_GEN + rv_place * 8, rv_generation)
            }
        }
    }
    return reference_to(rv_target)
}

pub fn stop_domain_impl(sd_handle: u64) {
    sd_packed: u64 = resolve_domain(sd_handle)
    sd_core: u64 = sd_packed shr 4
    sd_d: u64 = sd_packed and 0xF
    unsafe {
        domain_set_actor_of(sd_core, sd_d, DOMAIN_CLOSING)
    }
    if unretired_place_count(sd_core, sd_d) == 0 {
        free_domain_now(sd_core, sd_d)
        return
    }
    sd_table: u64 = place_table(sd_core, sd_d)
    unsafe {
        ending: loop sd_i: u64 in 0..DOMAIN_PLACES {
            sd_at: u64 = load64(sd_table + sd_i * 8)
            if sd_at != 0 and place_live(sd_at) {
                end_actor_anywhere(sd_at)
            }
        }
    }
}

/// Maps the registers named by the `Mmio` arguments of a `separate` actor's `new` into its domain (decision 182). The
/// compiler says which words are an `Mmio`; Raven still checks each one: whole pages, inside the peripherals.
fn grant_devices(gd_core: u64, gd_domain: u64, gd_args: u64, gd_words: u64, gd_mask: u64) {
    granting: loop gd_i: u64 in 0..gd_words {
        if ((gd_mask shr gd_i) and 1) == 1 {
            unsafe {
                if gd_i + 1 >= gd_words {
                    panic("an Mmio argument is cut short")
                }
                gd_base: u64 = load64(gd_args + gd_i * 8)
                gd_size: u64 = load64(gd_args + (gd_i + 1) * 8)
                if gd_size == 0 or gd_size > DEVICE_SPAN or gd_base < DEVICE_BASE or gd_base > DEVICE_BASE + DEVICE_SPAN - gd_size {
                    panic("an Mmio given to a separate actor is outside the peripherals")
                }
                if gd_base % 4096 != 0 or gd_size % 4096 != 0 {
                    panic("an Mmio given to a separate actor is not whole pages")
                }
                mut gd_at: u64 = gd_base
                paging: loop gd_at < gd_base + gd_size {
                    if domain_map_device_of(gd_core, gd_domain, gd_at) != 0 {
                        panic("a separate actor can have registers from one 2 MB block of the peripherals only")
                    }
                    gd_at += 4096
                }
            }
        }
    }
}

fn spawn_common(fields: u64, dispatcher: u64, rt_entry: u64, rt_args: u64,
                rt_args_words: u64, rt_separate: bool, rt_devices: u64, rt_dhandle: u64) -> u64 {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_parent: u64 = load64(rt_base + ACTOR_S_CURRENT_ACTOR)
        rt_was_in_new: u64 = load64(rt_base + ACTOR_S_IN_NEW)
        mut rt_actor: u64 = 0
        mut rt_reused: bool = false
        if rt_parent != 0 and rt_was_in_new != 0 {
            rt_old: u64 = load64(rt_parent - ACTOR_BEFORE_FIELDS + ACTOR_H_PENDING)
            if rt_old != 0 {
                rt_old_header: u64 = rt_old - ACTOR_BEFORE_FIELDS
                store64(rt_parent - ACTOR_BEFORE_FIELDS + ACTOR_H_PENDING,
                        load64(rt_old_header + ACTOR_H_NEXT_SIBLING))
                if load64(rt_old_header + ACTOR_H_DISPATCHER) == dispatcher {
                    rt_actor = rt_old
                    rt_reused = true
                    if core_of_actor(rt_actor) == core_id() {
                        rerun_begin(rt_actor)   // (one on another core is rerun by that core, in REC_START)
                    }
                } else {
                    store64(rt_old_header + ACTOR_H_PARENT, 0)
                    end_actor_anywhere(rt_old)  // a different kind of actor is spawned here now
                }
            }
        }
        if rt_actor == 0 and rt_separate {
            mut rt_core: u64 = 0
            mut rt_domain: u64 = 0
            if rt_dhandle == 0 {
                rt_core = spawn_next_core()     // Raven decides where it lives: 1, 2, 3, 0, 1, ... (decision 180)
                rt_domain = free_domain(rt_core)
                init_domain(rt_core, rt_domain)
            } else {
                rt_packed: u64 = resolve_domain(rt_dhandle)     // `spawn ... in d`: where `d` is (decision 201)
                rt_core = rt_packed shr 4
                rt_domain = rt_packed and 0xF
            }
            if rt_args_words * 8 > DOMAIN_ARGS_SAVE {
                panic("the arguments of a separate actor's new are too long")
            }
            rt_generation: u64 = next_place_generation(rt_core, rt_domain)
            if rt_generation == PLACE_GEN_NONE {
                panic("this domain has given out every generation an actor in it can have")    // (only `in d`: free_domain skips such a domain)
            }
            rt_actor = take_place(rt_core, rt_domain, fields + rt_args_words)
            // (the generation comes from the domain's counter, which no tenant shares a value of: a reference to an actor of an
            // earlier tenant of the same domain never matches one of this tenant, decision 209)
            store64(rt_actor - ACTOR_BEFORE_FIELDS + ACTOR_H_DISPATCHER, dispatcher)
            store64(rt_actor - ACTOR_BEFORE_FIELDS + ACTOR_H_ARGS, rt_actor + fields * 8)
            store64(rt_actor - ACTOR_BEFORE_FIELDS + ACTOR_H_DOMAIN,
                    rt_domain or (rt_core shl 4) or (rt_generation shl REF_GENERATION_SHIFT))
            grant_devices(rt_core, rt_domain, rt_args, rt_args_words, rt_devices)
        }
        if rt_actor == 0 {
            mut rt_next: u64 = load64(rt_base + ACTOR_S_NEXT)
            if rt_next == 0 {
                rt_next = rt_base + ACTOR_FIRST_ACTOR
            }
            rt_size: u64 = ACTOR_BEFORE_FIELDS + (fields + rt_args_words) * 8
            mut rt_generation: u64 = 0
            rt_free: u64 = take_free_block(rt_size)
            if rt_free != 0 {
                // The memory of an actor that ended, the same size: cleared, and with the generation its place has now.
                rt_generation = load64(rt_free + ACTOR_H_DOMAIN) shr REF_GENERATION_SHIFT
                rt_next = rt_free
                clearing_block: loop rt_c: u64 in 0..(rt_size / 8) {
                    store64(rt_next + rt_c * 8, 0)
                }
            } else {
                if rt_next + rt_size > actor_arena_limit() {
                    panic("out of memory for actors")
                }
                store64(rt_base + ACTOR_S_NEXT, rt_next + rt_size)
            }
            rt_actor = rt_next + ACTOR_BEFORE_FIELDS
            store64(rt_next + ACTOR_H_DISPATCHER, dispatcher)
            store64(rt_next + ACTOR_H_ARGS, rt_actor + fields * 8)
            store64(rt_next + ACTOR_H_DOMAIN, (rt_size shl 8) or (rt_generation shl REF_GENERATION_SHIFT))
        }
        rt_header: u64 = rt_actor - ACTOR_BEFORE_FIELDS
        store64(rt_header + ACTOR_H_START, rt_entry)
        store64(rt_header + ACTOR_H_ARGS_WORDS, rt_args_words)
        store64(rt_header + ACTOR_H_PARENT, rt_parent)
        mut rt_flags: u64 = rt_was_in_new                       // ACTOR_F_IN_NEW is 1
        if core_of_actor(rt_actor) != core_id() and not rt_reused {
            rt_flags = rt_flags or ACTOR_F_STARTING             // messages may reach it before its `new` has run
        }
        store64(rt_header + ACTOR_H_FLAGS, rt_flags)
        store64(rt_header + ACTOR_H_NEXT_SIBLING, 0)
        if domain_of(rt_actor) != 0 {
            runtime_register(rt_actor, dispatcher, (rt_flags and ACTOR_F_STARTING) != 0)
        }
        if rt_parent != 0 {
            rt_parent_header: u64 = rt_parent - ACTOR_BEFORE_FIELDS
            rt_last: u64 = load64(rt_parent_header + ACTOR_H_LAST_CHILD)
            if rt_last == 0 {
                store64(rt_parent_header + ACTOR_H_FIRST_CHILD, rt_actor)
            } else {
                store64(rt_last - ACTOR_BEFORE_FIELDS + ACTOR_H_NEXT_SIBLING, rt_actor)
            }
            store64(rt_parent_header + ACTOR_H_LAST_CHILD, rt_actor)
        }
        if core_of_actor(rt_actor) != core_id() {
            // It lives on another core, which runs its `new` and keeps its arguments: the record carries them.
            rt_rec: u64 = ring_scratch(0)
            store64(rt_rec, REC_START)
            store64(rt_rec + 8, rt_actor)
            store64(rt_rec + 16, rt_entry)
            store64(rt_rec + 24, rt_args_words)
            store64(rt_rec + 32, if rt_reused { 1 } else { 0 })
            copying_away: loop rt_v: u64 in 0..rt_args_words {
                store64(rt_rec + REC_PAYLOAD + rt_v * 8, load64(rt_args + rt_v * 8))
            }
            push_record(core_of_actor(rt_actor), rt_rec)
            return reference_to(rt_actor)
        }
        rt_kept: u64 = load64(rt_header + ACTOR_H_ARGS)
        copying: loop rt_w: u64 in 0..rt_args_words {
            store64(rt_kept + rt_w * 8, load64(rt_args + rt_w * 8))
        }
        if rt_entry != 0 {
            store64(rt_base + ACTOR_S_CURRENT_ACTOR, rt_actor)
            store64(rt_base + ACTOR_S_IN_NEW, 1)
            if domain_of(rt_actor) == 0 {
                call_dispatch(rt_entry, rt_actor, 0, rt_kept)
            } else if run_in_domain(domain_of(rt_actor), rt_entry, rt_actor, 0, rt_kept) != 0 {
                actor_failed()                  // its `new` failed: like a panic in a plain one
            }
            store64(rt_base + ACTOR_S_CURRENT_ACTOR, rt_parent)
            store64(rt_base + ACTOR_S_IN_NEW, rt_was_in_new)
        }
        rerun_end(rt_actor)
        if rt_reused {
            notify_restarted(rt_actor)         // restarted in place with its parent
        }
        return reference_to(rt_actor)
    }
}

/// Empties an actor's mailbox, counting what was in it as lost.
fn clear_mailbox(rt_who: u64) {
    if domain_of(rt_who) != 0 {
        runtime_clear(rt_who)
        return
    }
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        rt_base: u64 = actor_arena_base()
        store64(rt_base + ACTOR_S_LOST,
                load64(rt_base + ACTOR_S_LOST) + load64(rt_header + ACTOR_H_COUNT))
        pending_sub(load64(rt_header + ACTOR_H_COUNT))      // those messages are over
        store64(rt_header + ACTOR_H_COUNT, 0)
    }
}

/// An actor ends: its mailbox is emptied and sends to it are refused from now on (a `reliable`
/// send answers `Gone`), and so are those of everything it spawned. Its watchers that asked
/// for it are told `stopped`, and what it watched is forgotten. Its place is given back (`retire`: a new generation, so a
/// reference to it that is still held is stale, and the memory is used again).
fn end_actor(rt_who: u64) {
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        if (load64(rt_header + ACTOR_H_FLAGS) and ACTOR_F_ENDED) != 0 {
            return                              // already ended: its watchers were told
        }
        store64(rt_header + ACTOR_H_FLAGS, load64(rt_header + ACTOR_H_FLAGS) or ACTOR_F_ENDED)
        drop_watches(rt_who)
        clear_mailbox(rt_who)
        if domain_of(rt_who) != 0 {
            runtime_end(rt_who)
        }
        end_list(load64(rt_header + ACTOR_H_FIRST_CHILD))
        end_list(load64(rt_header + ACTOR_H_PENDING))
        store64(rt_header + ACTOR_H_FIRST_CHILD, 0)
        store64(rt_header + ACTOR_H_LAST_CHILD, 0)
        store64(rt_header + ACTOR_H_PENDING, 0)
        notify_stopped(rt_who)
    }
    retire(rt_who)
}

/// Ends each actor on a list of siblings, and what they spawned.
fn end_list(rt_list: u64) {
    mut rt_child: u64 = rt_list
    walking: loop rt_child != 0 {
        unsafe {
            rt_next: u64 = load64(rt_child - ACTOR_BEFORE_FIELDS + ACTOR_H_NEXT_SIBLING)
            store64(rt_child - ACTOR_BEFORE_FIELDS + ACTOR_H_PARENT, 0)     // the list is going away, not each child's place in it
            end_actor_anywhere(rt_child)
            rt_child = rt_next
        }
    }
}

/// Starts an actor's restart (and a child's, when its parent's `new` reaches the spawn
/// that makes it): the actors it spawned in a handler end; those it spawned in its `new`
/// wait, in order, to be matched by the spawns in the `new` that is about to run again;
/// its fields are cleared and its mailbox emptied.
fn rerun_prepare(rt_who: u64) {
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        mut rt_child: u64 = load64(rt_header + ACTOR_H_FIRST_CHILD)
        mut rt_head: u64 = 0
        mut rt_tail: u64 = 0
        sorting: loop rt_child != 0 {
            rt_child_header: u64 = rt_child - ACTOR_BEFORE_FIELDS
            rt_after: u64 = load64(rt_child_header + ACTOR_H_NEXT_SIBLING)
            if (load64(rt_child_header + ACTOR_H_FLAGS) and ACTOR_F_IN_NEW) != 0 {
                store64(rt_child_header + ACTOR_H_NEXT_SIBLING, 0)
                if rt_head == 0 {
                    rt_head = rt_child
                } else {
                    store64(rt_tail - ACTOR_BEFORE_FIELDS + ACTOR_H_NEXT_SIBLING, rt_child)
                }
                rt_tail = rt_child
            } else {
                store64(rt_child_header + ACTOR_H_PARENT, 0)
                end_actor_anywhere(rt_child)
            }
            rt_child = rt_after
        }
        store64(rt_header + ACTOR_H_PENDING, rt_head)
        store64(rt_header + ACTOR_H_FIRST_CHILD, 0)
        store64(rt_header + ACTOR_H_LAST_CHILD, 0)
        store64(rt_header + ACTOR_H_FLAGS, load64(rt_header + ACTOR_H_FLAGS) and ACTOR_F_IN_NEW)
        drop_watches(rt_who)
        clear_mailbox(rt_who)
        rt_fields_end: u64 = load64(rt_header + ACTOR_H_ARGS)
        mut rt_at: u64 = rt_who
        clearing: loop rt_at < rt_fields_end {
            store64(rt_at, 0)
            rt_at = rt_at + 8
        }
    }
}

/// `rerun_prepare`, and for an actor that is alone in its domain the wipe of the domain (decision 176). One of several is restarted
/// without that: the others are not, and the whole domain is wiped only when it fails (`restart_domain`).
fn rerun_begin(rt_who: u64) {
    rerun_prepare(rt_who)
    if domain_of(rt_who) != 0 and place_count(core_of_actor(rt_who), domain_of(rt_who)) == 1 {
        unsafe {
            wipe_domain(rt_who)
        }
    }
}

/// A domain restarts as a unit (decision 176): everything its memory held goes, but the arguments the actor was
/// spawned with, which are kept in its data for the `new` that is about to run again.
fn wipe_domain(rt_who: u64) {
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        rt_kept: u64 = load64(rt_header + ACTOR_H_ARGS)
        rt_words: u64 = load64(rt_header + ACTOR_H_ARGS_WORDS)
        // (the arguments wait at the start of the actor's own header page, which only EL1 reaches and the wipe leaves alone, as in
        // `restart_domain`: up to DOMAIN_ARGS_SAVE bytes. Until decision 212 they waited in an 8-word buffer of Raven's arena, and
        // more than 8 words overwrote what lies after it, among it the registers `call_protected` saves)
        rt_scratch: u64 = rt_who - DOMAIN_PAGE
        saving: loop rt_w: u64 in 0..rt_words {
            store64(rt_scratch + rt_w * 8, load64(rt_kept + rt_w * 8))
        }
        domain_wipe_data(domain_of(rt_who))
        restoring: loop rt_x: u64 in 0..rt_words {
            store64(rt_kept + rt_x * 8, load64(rt_scratch + rt_x * 8))
        }
        runtime_rebuild(core_of_actor(rt_who), domain_of(rt_who))
    }
}

/// Ends a restart: the actors spawned in the previous `new` that this one did not spawn
/// again end.
fn rerun_end(rt_who: u64) {
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        end_list(load64(rt_header + ACTOR_H_PENDING))
        store64(rt_header + ACTOR_H_PENDING, 0)
    }
}

/// Restarts an actor whose handler failed: its `new` runs again on the arguments it was
/// spawned with, with its fields cleared and its mailbox empty. References to it stay
/// valid. If that `new` fails too, the actor ends (a restart that fails would otherwise
/// repeat for ever).
fn restart_actor(rt_who: u64) -> bool {
    if domain_of(rt_who) != 0 and place_count(core_of_actor(rt_who), domain_of(rt_who)) > 1 {
        return restart_domain(rt_who)           // a domain fails and restarts as a unit, all of its actors (decision 201)
    }
    rt_base: u64 = actor_arena_base()
    unsafe {
        store64(rt_base + ACTOR_S_RESTARTS, load64(rt_base + ACTOR_S_RESTARTS) + 1)
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        rerun_begin(rt_who)
        rt_start: u64 = load64(rt_header + ACTOR_H_START)
        if rt_start != 0 {
            store64(rt_base + ACTOR_S_CURRENT_ACTOR, rt_who)
            store64(rt_base + ACTOR_S_IN_NEW, 1)
            if domain_of(rt_who) != 0 {
                domain_budget_begin()
            }
            timer_arm(budget_ticks())
            rt_failed: u64 = invoke(rt_start, rt_who, 0, load64(rt_header + ACTOR_H_ARGS))
            timer_disarm()
            domain_budget_end()
            store64(rt_base + ACTOR_S_CURRENT_ACTOR, 0)
            store64(rt_base + ACTOR_S_IN_NEW, 0)
            if rt_failed != 0 {
                end_actor(rt_who)
                return true                     // (it may be given back already: the caller must not touch it)
            }
        }
        rerun_end(rt_who)
    }
    notify_restarted(rt_who)
    return false
}

/// A domain with several actors fails and restarts as a unit (decision 201): each actor that has not ended is prepared (its children
/// end, its watches go, its mailbox is emptied, its fields cleared), the arguments of their `new` are put aside in the pages that only
/// EL1 reaches, the stack and the data are wiped (everything but those pages), the arguments are put back and each `new` runs again
/// in the order the actors were placed, so every reference stays valid. A `new` that fails ends its actor (a restart that fails would
/// repeat for ever) and the others go on. Returns whether `rd_who`, the actor whose handler failed, has ended.
fn restart_domain(rd_who: u64) -> bool {
    rd_base: u64 = actor_arena_base()
    rd_core: u64 = core_of_actor(rd_who)
    rd_d: u64 = domain_of(rd_who)
    rd_table: u64 = place_table(rd_core, rd_d)
    rd_pool: u64 = domain_pool_base_of(rd_core, rd_d)
    mut rd_ended: bool = false
    unsafe {
        store64(rd_base + ACTOR_S_RESTARTS, load64(rd_base + ACTOR_S_RESTARTS) + 1)
        preparing: loop rd_i: u64 in 0..DOMAIN_PLACES {
            rd_at: u64 = load64(rd_table + rd_i * 8)
            if rd_at != 0 and place_live(rd_at) {
                rerun_prepare(rd_at)
            }
        }
        saving: loop rd_j: u64 in 0..DOMAIN_PLACES {
            rd_at: u64 = load64(rd_table + rd_j * 8)
            if rd_at != 0 and place_live(rd_at) {
                rd_words: u64 = load64(rd_at - ACTOR_BEFORE_FIELDS + ACTOR_H_ARGS_WORDS)
                rd_kept: u64 = load64(rd_at - ACTOR_BEFORE_FIELDS + ACTOR_H_ARGS)
                copying_out: loop rd_w: u64 in 0..rd_words {
                    store64(rd_at - DOMAIN_PAGE + rd_w * 8, load64(rd_kept + rd_w * 8))
                }
            }
        }
        // the stack, then the data, page by page except the pages that only EL1 reaches
        pool_wipe_range(rd_pool + 0x1000, 0xF000)
        mut rd_from: u64 = rd_pool + DOMAIN_FIELDS
        wiping: loop rd_k: u64 in 0..DOMAIN_PLACES {
            rd_at: u64 = load64(rd_table + rd_k * 8)
            if rd_at != 0 {
                if rd_at - DOMAIN_PAGE > rd_from {
                    pool_wipe_range(rd_from, rd_at - DOMAIN_PAGE - rd_from)
                }
                rd_from = rd_at
            }
        }
        pool_wipe_range(rd_from, rd_pool + DOMAIN_POOL_BYTES - rd_from)
        restoring: loop rd_m: u64 in 0..DOMAIN_PLACES {
            rd_at: u64 = load64(rd_table + rd_m * 8)
            if rd_at != 0 and place_live(rd_at) {
                rd_words: u64 = load64(rd_at - ACTOR_BEFORE_FIELDS + ACTOR_H_ARGS_WORDS)
                rd_kept: u64 = load64(rd_at - ACTOR_BEFORE_FIELDS + ACTOR_H_ARGS)
                copying_back: loop rd_w: u64 in 0..rd_words {
                    store64(rd_kept + rd_w * 8, load64(rd_at - DOMAIN_PAGE + rd_w * 8))
                }
            }
        }
        runtime_rebuild(rd_core, rd_d)
        running: loop rd_n: u64 in 0..DOMAIN_PLACES {
            rd_at: u64 = load64(rd_table + rd_n * 8)
            if rd_at != 0 and place_live(rd_at) {
                rd_header: u64 = rd_at - ACTOR_BEFORE_FIELDS
                rd_start: u64 = load64(rd_header + ACTOR_H_START)
                mut rd_failed: u64 = 0
                if rd_start != 0 {
                    store64(rd_base + ACTOR_S_CURRENT_ACTOR, rd_at)
                    store64(rd_base + ACTOR_S_IN_NEW, 1)
                    domain_budget_begin()
                    timer_arm(budget_ticks())
                    rd_failed = invoke(rd_start, rd_at, 0, load64(rd_header + ACTOR_H_ARGS))
                    timer_disarm()
                    domain_budget_end()
                    store64(rd_base + ACTOR_S_CURRENT_ACTOR, 0)
                    store64(rd_base + ACTOR_S_IN_NEW, 0)
                }
                if rd_failed != 0 {
                    if rd_at == rd_who {
                        rd_ended = true
                    }
                    end_actor(rd_at)
                } else {
                    rerun_end(rd_at)
                    notify_restarted(rd_at)
                }
            }
        }
    }
    return rd_ended
}

/// `watch(watched, watcher)`, which the compiler turns into a call of this: from now on
/// `watcher` is sent its handler number `number` (`restarted`) each time `watched` restarts.
/// Watching twice is the same as once. A watch ends when the watcher restarts or ends,
/// so its `new` sets it up again. The table is small (14); one more panics.
pub fn watch_impl(watched_ref: u64, watcher_ref: u64, number: u64, stopped_plus_one: u64) {
    if not is_current(watched_ref) {
        return                                  // it is not there any more: nothing to watch
    }
    watched: u64 = watched_ref and REF_ADDRESS_MASK
    watcher: u64 = watcher_ref and REF_ADDRESS_MASK
    unsafe {
        rt_core: u64 = core_of_actor(watched)
        if rt_core != core_id() {
            // The core of the actor watched keeps the watch, and sends `restarted` and `stopped` itself.
            rt_rec: u64 = ring_scratch(0)
            store64(rt_rec, REC_WATCH)
            store64(rt_rec + 8, watched)
            store64(rt_rec + 16, watcher)
            store64(rt_rec + 24, number)
            store64(rt_rec + 32, stopped_plus_one)
            push_record(rt_core, rt_rec)
            return
        }
    }
    watch_here(watched, watcher, number, stopped_plus_one)
}

fn watch_here(watched: u64, watcher: u64, number: u64, stopped_plus_one: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        store64(rt_base + ACTOR_S_RESTARTED, number)
        mut rt_tag: u64 = watcher
        if stopped_plus_one != 0 {
            store64(rt_base + ACTOR_S_STOPPED, stopped_plus_one - 1)
            rt_tag = watcher or 1               // actors are 8-byte aligned: bit 0 is free
        }
        mut rt_free: u64 = 0
        scanning: loop rt_i: u64 in 0..ACTOR_WATCH_MAX {
            rt_record: u64 = rt_base + ACTOR_WATCHES + rt_i * 16
            if load64(rt_record) == watched and watcher_of(load64(rt_record + 8)) == watcher {
                store64(rt_record + 8, load64(rt_record + 8) or rt_tag)   // `stopped` asked for now
                return
            }
            if rt_free == 0 and load64(rt_record) == 0 {
                rt_free = rt_record
            }
        }
        if rt_free == 0 {
            panic("too many watches")
        }
        store64(rt_free, watched)
        store64(rt_free + 8, rt_tag)
    }
}

/// The watcher in a watch record's second word (bit 0 says it wants `stopped`).
fn watcher_of(rt_tag: u64) -> u64 {
    return (rt_tag shr 1) shl 1
}

/// Forgets what `rt_who` watches (it restarts or ends).
fn drop_watches(rt_who: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        // The watches are kept by the core of the actor watched, which may be another: tell them all.
        if core_of_actor(rt_who) == core_id() and domain_of(rt_who) == 0 {
            telling: loop rt_c: u64 in 0..4 {
                if rt_c != core_id() and spawn_count() != 0 {
                    rt_rec: u64 = ring_scratch(0)
                    store64(rt_rec, REC_DROP_WATCHES)
                    store64(rt_rec + 8, rt_who)
                    push_record(rt_c, rt_rec)
                }
            }
        }
        dropping: loop rt_i: u64 in 0..ACTOR_WATCH_MAX {
            rt_record: u64 = rt_base + ACTOR_WATCHES + rt_i * 16
            if watcher_of(load64(rt_record + 8)) == rt_who {
                store64(rt_record, 0)
                store64(rt_record + 8, 0)
            }
        }
    }
}

/// `rt_who` has restarted and its `new` has run again: tell each watcher with the message
/// `restarted`. It is lossy: one already waiting stands for this one, and a full mailbox
/// drops it.
fn notify_restarted(rt_who: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_number: u64 = load64(rt_base + ACTOR_S_RESTARTED)
        telling: loop rt_i: u64 in 0..ACTOR_WATCH_MAX {
            rt_record: u64 = rt_base + ACTOR_WATCHES + rt_i * 16
            if load64(rt_record) == rt_who {
                rt_watcher: u64 = watcher_of(load64(rt_record + 8))
                discard route_message(reference_to(rt_watcher), rt_number, 0, 0, true)
            }
        }
    }
}

/// `rt_who` has ended: tell each watcher that asked for it the message `stopped` (lossy: one
/// already waiting stands for this one), then forget the watches on it, which can never fire.
fn notify_stopped(rt_who: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_number: u64 = load64(rt_base + ACTOR_S_STOPPED)
        telling: loop rt_i: u64 in 0..ACTOR_WATCH_MAX {
            rt_record: u64 = rt_base + ACTOR_WATCHES + rt_i * 16
            if load64(rt_record) == rt_who {
                rt_tag: u64 = load64(rt_record + 8)
                rt_watcher: u64 = watcher_of(rt_tag)
                if (rt_tag and 1) != 0 {
                    discard route_message(reference_to(rt_watcher), rt_number, 0, 0, true)
                }
                store64(rt_record, 0)
                store64(rt_record + 8, 0)
            }
        }
    }
}

/// `stop()`: the running handler's actor ends. The handler is abandoned where it stands,
/// like a failure, but nothing is reported and the actor is not restarted (decision 150).
pub fn stop_self_impl() {
    rt_base: u64 = actor_arena_base()
    unsafe {
        store64(rt_base + ACTOR_S_STOPPING, 1)
    }
    actor_failed()
}

/// `stop(target)`: `target` ends, if the caller is the actor that spawned it (code outside
/// any actor, such as `test_main`, is the spawner of what it spawns); from anyone else it is a
/// failure like any bug (decision 147). Stopping an actor that has ended does nothing; stopping
/// oneself is `stop()`.
pub fn stop_impl(target_ref: u64) {
    rt_base: u64 = actor_arena_base()
    if not is_current(target_ref) {
        return                                  // it has ended already
    }
    target: u64 = target_ref and REF_ADDRESS_MASK
    unsafe {
        rt_caller: u64 = load64(rt_base + ACTOR_S_CURRENT_ACTOR)
        if target == rt_caller {
            stop_self_impl()
        }
        if load64(target - ACTOR_BEFORE_FIELDS + ACTOR_H_PARENT) != rt_caller {
            panic("only the actor that spawned an actor can stop it")
        }
        end_actor_anywhere(target)
    }
}

/// Sends a message to `target`: puts it in the mailbox, or drops it and
/// counts the drop if the mailbox is full. Used by every send of a `lossy`
/// handler. `payload` is the address of `words` words (at most 8) to copy into it.
pub extern fn raven_send(target: u64, handler: u64, payload: u64, words: u64)

pub fn send_impl(target: u64, handler: u64, payload: u64, words: u64) {
    if not route_message(target, handler, payload, words, false) {
        unsafe {
            rt_base: u64 = actor_arena_base()
            store64(rt_base + ACTOR_S_DROPPED, load64(rt_base + ACTOR_S_DROPPED) + 1)
        }
    }
}

/// Sends a message to a `reliable` handler: the same, except that a full
/// mailbox is not a drop. The sender is told and decides what the message is
/// worth (decision 126).
pub fn send_reliable_impl(target: u64, handler: u64, payload: u64, words: u64) -> Sent {
    if route_message(target, handler, payload, words, false) {
        return Delivered                        // (to an actor on another core: queued in the ring for it)
    }
    unsafe {
        if not is_current(target) or (load64((target and REF_ADDRESS_MASK) - ACTOR_BEFORE_FIELDS + ACTOR_H_FLAGS) and ACTOR_F_ENDED) != 0 {
            return Gone
        }
    }
    return MailboxFull
}

/// Sends a message from this core to the actor `rt_ref` names (a whole reference: a stale one is refused, as a send to an
/// actor that has ended is). To an actor on this core it goes into the mailbox; to one on another core, into the
/// ring to that core, which puts it in the mailbox (REC_SEND). True if it was accepted: for another core the ring is all
/// the sender can know of, so a full mailbox there is a drop on that core's count, and a `reliable` sender is told
/// `Delivered` all the same (decision 181). With `absorb`, a message for a handler already waiting is dropped, as
/// Raven's own notifications are.
fn route_message(rt_ref: u64, handler: u64, payload: u64, words: u64, absorb: bool) -> bool {
    target: u64 = rt_ref and REF_ADDRESS_MASK
    if not is_current(rt_ref) {
        return false
    }
    rt_core: u64 = core_of_actor(target)
    unsafe {
        if rt_core == core_id() {
            if absorb and rt_queued(target, handler) {
                return true
            }
            return rt_enqueue(target, handler, payload, words)
        }
        if (load64(target - ACTOR_BEFORE_FIELDS + ACTOR_H_FLAGS) and ACTOR_F_ENDED) != 0 {
            return false
        }
        rt_rec: u64 = ring_scratch(0)
        store64(rt_rec, REC_SEND)
        store64(rt_rec + 8, rt_ref)             // the whole reference: the core that gets it checks the generation too
        store64(rt_rec + 16, handler)
        store64(rt_rec + 24, words)
        store64(rt_rec + 120, if absorb { 1 } else { 0 })
        copying: loop rt_w: u64 in 0..words {
            store64(rt_rec + REC_PAYLOAD + rt_w * 8, load64(payload + rt_w * 8))
        }
        return push_record_bounded(rt_core, rt_rec)
    }
}

/// For tests: how long this core's sends wait for room in a full ring, in counter ticks (0: the default of 5 ms). A test
/// that wants to see a refusal sets it to 1 so that it does not depend on how long another core stays busy, which on a
/// loaded machine is not a time anyone can promise (decision 186).
pub fn set_ring_wait_ticks(ticks: u64) {
    unsafe {
        store64(actor_arena_base() + ACTOR_S_RING_WAIT, ticks)
    }
}

/// Queues a message record for `core` and waits for room in the ring for at most RING_WAIT_MS; false, with nothing queued,
/// if there was none by then (decision 186). A sender that waited for ever could deadlock with the core it waits for: two
/// cores flooding each other, each waiting for room in a ring only the other one empties. Giving up is a drop, which a
/// `lossy` send allows and a `reliable` sender is told as `MailboxFull`.
fn push_record_bounded(core: u64, rec: u64) -> bool {
    unsafe {
        pending_add(1)
        rt_start: u64 = read_counter()
        mut rt_limit: u64 = load64(actor_arena_base() + ACTOR_S_RING_WAIT)
        if rt_limit == 0 {
            rt_limit = RING_WAIT_MS * (counter_frequency() / 1000)
        }
        waiting: loop ring_push(core, rec) == 0 {
            if read_counter() - rt_start > rt_limit {
                pending_sub(1)
                return false
            }
            core_pause()
        }
        return true
    }
}

/// Sends the message `fired` of an interrupt to `target` (decision 183). On this core it is the mailbox, unless a `fired`
/// is waiting. To an actor on another core it is a ring record, which that core drops if a `fired` is waiting; and unlike
/// every other send it does not wait if the ring is full, it is dropped: this runs in core 0's scheduler, which must go
/// on draining its own rings, and a source that still asserts fires again (it is switched back on after this).
fn route_interrupt(rt_ref: u64, handler: u64) {
    target: u64 = rt_ref and REF_ADDRESS_MASK
    if not is_current(rt_ref) {
        return                                  // the actor it was routed to has gone
    }
    rt_core: u64 = core_of_actor(target)
    unsafe {
        if rt_core == core_id() {
            if not rt_queued(target, handler) {
                discard rt_enqueue(target, handler, 0, 0)       // full: the source fires again
            }
            return
        }
        if (load64(target - ACTOR_BEFORE_FIELDS + ACTOR_H_FLAGS) and ACTOR_F_ENDED) != 0 {
            return
        }
        if ring_pending(rt_core) >= RING_IRQ_SHARE {
            return                                              // the driver has not caught up: it will get one when it has
        }
        rt_rec: u64 = ring_scratch(0)
        store64(rt_rec, REC_SEND)
        store64(rt_rec + 8, rt_ref)
        store64(rt_rec + 16, handler)
        store64(rt_rec + 24, 0)
        store64(rt_rec + 120, 1)
        pending_add(1)
        if ring_push(rt_core, rt_rec) == 0 {
            pending_sub(1)                                      // the ring is full: nothing was queued
        }
    }
}

/// Queues a record for `core`, waiting if its ring is full. The record counts as work to do until that core has handled it.
fn push_record(core: u64, rec: u64) {
    unsafe {
        pending_add(1)
        pushing: loop ring_push(core, rec) == 0 {
            core_pause()
        }
    }
}

/// Handles every record other cores have queued for this one. Called by each core's scheduler between turns.
pub fn drain_rings() {
    unsafe {
        rt_rec: u64 = ring_scratch(1)
        rt_held: u64 = load64(core_block(core_id()) + CORE_TEST_HOLD)      // (0 except in a test, decision 210)
        draining: loop rt_src: u64 in 0..4 {
            if rt_src != core_id() and ((rt_held shr rt_src) and 1) == 0 {
                taking: loop ring_pop(rt_src, rt_rec) != 0 {
                    handle_record(rt_rec)
                    pending_sub(1)              // the record is handled
                }
            }
        }
    }
}

fn handle_record(rt_rec: u64) {
    unsafe {
        rt_kind: u64 = load64(rt_rec)
        rt_who: u64 = load64(rt_rec + 8)
        if rt_kind == REC_SEND {
            rt_target: u64 = rt_who and REF_ADDRESS_MASK
            if not is_current(rt_who) {
                rt_stale: u64 = actor_arena_base()
                store64(rt_stale + ACTOR_S_DROPPED, load64(rt_stale + ACTOR_S_DROPPED) + 1)     // for an actor that is not there any more
                return
            }
            if load64(rt_rec + 120) != 0 and rt_queued(rt_target, load64(rt_rec + 16)) {
                return
            }
            if not rt_enqueue(rt_target, load64(rt_rec + 16), rt_rec + REC_PAYLOAD, load64(rt_rec + 24)) {
                rt_base: u64 = actor_arena_base()
                store64(rt_base + ACTOR_S_DROPPED, load64(rt_base + ACTOR_S_DROPPED) + 1)
            }
        } else if rt_kind == REC_START {
            start_here(rt_who, load64(rt_rec + 16), load64(rt_rec + 24), load64(rt_rec + 32), rt_rec + REC_PAYLOAD)
        } else if rt_kind == REC_WATCH {
            watch_here(rt_who, load64(rt_rec + 16), load64(rt_rec + 24), load64(rt_rec + 32))
        } else if rt_kind == REC_STOP {
            end_actor(rt_who)
        } else if rt_kind == REC_RETIRE {
            retire_domain(rt_who)
        } else if rt_kind == REC_FREE_DOMAIN {
            finish_give_back(rt_who)
        } else if rt_kind == REC_DROP_WATCHES {
            drop_watches(rt_who)
        } else if rt_kind == REC_TIMER {
            discard timer_arm_here(load64(rt_rec + 24), rt_who, load64(rt_rec + 16), load64(rt_rec + 32))
        }
    }
}

/// Runs the `new` of an actor on this core (a `separate` actor spawned from another core, or restarted in place by the
/// restart of its spawner): it keeps its arguments for later restarts, and if its `new` fails it is restarted once and
/// ends if it fails again.
fn start_here(rt_who: u64, rt_entry: u64, rt_words: u64, rt_reuse: u64, rt_args: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        if rt_reuse != 0 {
            rerun_begin(rt_who)
        }
        rt_kept: u64 = load64(rt_header + ACTOR_H_ARGS)
        copying: loop rt_w: u64 in 0..rt_words {
            store64(rt_kept + rt_w * 8, load64(rt_args + rt_w * 8))
        }
        if rt_entry != 0 {
            store64(rt_base + ACTOR_S_CURRENT_ACTOR, rt_who)
            store64(rt_base + ACTOR_S_IN_NEW, 1)
            domain_budget_begin()
            timer_arm(budget_ticks())
            rt_failed: u64 = run_in_domain(domain_of(rt_who), rt_entry, rt_who, 0, rt_kept)
            timer_disarm()
            domain_budget_end()
            store64(rt_base + ACTOR_S_CURRENT_ACTOR, 0)
            store64(rt_base + ACTOR_S_IN_NEW, 0)
            if rt_failed != 0 {
                if not restart_actor(rt_who) {
                    finish_start(rt_who)
                }
                return
            }
        }
        rerun_end(rt_who)
        finish_start(rt_who)
        if rt_reuse != 0 {
            notify_restarted(rt_who)
        }
    }
}

/// Its `new` is over: the actor may be scheduled, and runs what was sent to it meanwhile.
fn finish_start(rt_who: u64) {
    unsafe {
        rt_header: u64 = rt_who - ACTOR_BEFORE_FIELDS
        store64(rt_header + ACTOR_H_FLAGS, load64(rt_header + ACTOR_H_FLAGS) and (ACTOR_F_IN_NEW or ACTOR_F_ENDED))
        if domain_of(rt_who) != 0 {
            runtime_release(rt_who)
        } else if load64(rt_header + ACTOR_H_COUNT) != 0 and load64(rt_header + ACTOR_H_QUEUED) == 0 {
            store64(rt_header + ACTOR_H_QUEUED, 1)
            run_queue_push(rt_who)
        }
    }
}

/// Ends an actor wherever it lives: here, or by a record to its core.
fn end_actor_anywhere(rt_who: u64) {
    rt_core: u64 = core_of_actor(rt_who)
    if rt_core == core_id() {
        end_actor(rt_who)
        return
    }
    unsafe {
        rt_rec: u64 = ring_scratch(0)
        store64(rt_rec, REC_STOP)
        store64(rt_rec + 8, rt_who)
        push_record(rt_core, rt_rec)
    }
}

/// Puts a message in `target`'s mailbox and queues the actor to run. Returns
/// false, changing nothing, if the mailbox is full.
fn rt_enqueue(target: u64, handler: u64, payload: u64, words: u64) -> bool {
    if domain_of(target) != 0 {
        return domain_enqueue(target, handler, payload, words)      // the mailbox is in the domain (decision 203)
    }
    rt_header: u64 = target - ACTOR_BEFORE_FIELDS
    unsafe {
        if (load64(rt_header + ACTOR_H_FLAGS) and ACTOR_F_ENDED) != 0 {
            return false
        }
        rt_count: u64 = load64(rt_header + ACTOR_H_COUNT)
        if rt_count == ACTOR_SLOTS {
            return false
        }
        rt_first: u64 = load64(rt_header + ACTOR_H_FIRST)
        rt_slot: u64 = rt_header + ACTOR_HEADER_WORDS * 8 +
                       ((rt_first + rt_count) % ACTOR_SLOTS) * ACTOR_SLOT_WORDS * 8
        store64(rt_slot, handler)
        copying: loop rt_w: u64 in 0..words {
            store64(rt_slot + 8 + rt_w * 8, load64(payload + rt_w * 8))
        }
        store64(rt_header + ACTOR_H_COUNT, rt_count + 1)
        pending_add(1)                          // one more message nobody has finished with
        if load64(rt_header + ACTOR_H_QUEUED) == 0 and (load64(rt_header + ACTOR_H_FLAGS) and ACTOR_F_STARTING) == 0 {
            store64(rt_header + ACTOR_H_QUEUED, 1)
            run_queue_push(target)
        }
        return true
    }
}

/// Turns the interrupts that have fired into messages, and switches each source back
/// on (vectors.s switched it off). A source still asserting fires again at once, so
/// a handler can be called with nothing left to do and must cope with that.
pub fn deliver_interrupts() {
    mut rt_pending: u64 = irq_take_pending()
    mut rt_bit: u64 = 0
    delivering: loop rt_pending != 0 {
        if (rt_pending and 1) != 0 {
            deliver_interrupt(ACTOR_IRQ_FIRST + rt_bit)
        }
        rt_pending = rt_pending shr 1
        rt_bit += 1
    }
}

fn deliver_interrupt(line: u64) {
    unsafe {
        rt_slot: u64 = actor_arena_base() + ACTOR_IRQ_ROUTES + (line - ACTOR_IRQ_FIRST) * 16
        rt_target: u64 = load64(rt_slot)
        if rt_target != 0 {
            rt_number: u64 = load64(rt_slot + 8)
            route_interrupt(rt_target, rt_number)
        }
    }
    irq_enable_source(line)
}

/// Is a message for `handler` already waiting in `target`'s mailbox?
fn rt_queued(target: u64, handler: u64) -> bool {
    if domain_of(target) != 0 {
        return domain_queued(target, handler)
    }
    rt_header: u64 = target - ACTOR_BEFORE_FIELDS
    unsafe {
        rt_first: u64 = load64(rt_header + ACTOR_H_FIRST)
        rt_count: u64 = load64(rt_header + ACTOR_H_COUNT)
        looking: loop i: u64 in 0..rt_count {
            rt_slot: u64 = rt_header + ACTOR_HEADER_WORDS * 8 +
                           ((rt_first + i) % ACTOR_SLOTS) * ACTOR_SLOT_WORDS * 8
            if load64(rt_slot) == handler {
                return true
            }
        }
    }
    return false
}

/// Messages, over all cores, that nobody has finished with (see rings.s).
pub fn unfinished_messages() -> u64 {
    unsafe {
        return pending_load()
    }
}

/// A short wait while another core works; this core has nothing to do.
pub fn wait_for_other_cores() {
    unsafe {
        core_pause()
    }
}

pub fn actors_waiting() -> u64 {
    unsafe {
        if load64(core_block(core_id()) + CORE_TEST_TURNS) == 1 {
            return 0                            // a test has stopped this core's turns (decision 210)
        }
        return load64(actor_arena_base() + ACTOR_S_RUNQ_COUNT)
    }
}

/// For tests (decision 210): core `th_core` leaves the ring from core `th_source` alone while `th_held` (its records wait there).
pub fn test_hold_ring(th_core: u64, th_source: u64, th_held: bool) {
    unsafe {
        th_at: u64 = core_block(th_core) + CORE_TEST_HOLD
        if th_held {
            store64(th_at, load64(th_at) or (1 shl th_source))
        } else {
            store64(th_at, load64(th_at) and not (1 shl th_source))
        }
    }
}

/// For tests (decision 210): core `tl_core` runs `tl_turns` - 1 more turns and then none, until this is called again (0: no limit).
pub fn test_limit_turns(tl_core: u64, tl_turns: u64) {
    unsafe {
        store64(core_block(tl_core) + CORE_TEST_TURNS, tl_turns)
    }
}

/// For tests (decision 210): how many more turns core `tc_core` may run, plus one (0: no limit). 1 once it has run them all.
pub fn test_turns_left(tc_core: u64) -> u64 {
    unsafe {
        return load64(core_block(tc_core) + CORE_TEST_TURNS)
    }
}

fn run_queue_push(actor_ref: u64) {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_waiting: u64 = load64(rt_base + ACTOR_S_RUNQ_COUNT)
        if rt_waiting == ACTOR_RUNQ_SLOTS {
            panic("run queue full")
        }
        rt_front: u64 = load64(rt_base + ACTOR_S_RUNQ_FIRST)
        store64(rt_base + ACTOR_RUNQ_OFFSET + ((rt_front + rt_waiting) % ACTOR_RUNQ_SLOTS) * 8,
                actor_ref)
        store64(rt_base + ACTOR_S_RUNQ_COUNT, rt_waiting + 1)
    }
}

pub fn run_one_turn() {
    run_turn_now()
    unsafe {
        rt_turns_at: u64 = core_block(core_id()) + CORE_TEST_TURNS
        if load64(rt_turns_at) > 1 {
            store64(rt_turns_at, load64(rt_turns_at) - 1)        // a test limits this core's turns (decision 210)
        }
    }
}

fn run_turn_now() {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_front: u64 = load64(rt_base + ACTOR_S_RUNQ_FIRST)
        rt_actor: u64 = load64(rt_base + ACTOR_RUNQ_OFFSET + rt_front * 8)
        store64(rt_base + ACTOR_S_RUNQ_FIRST, (rt_front + 1) % ACTOR_RUNQ_SLOTS)
        store64(rt_base + ACTOR_S_RUNQ_COUNT, load64(rt_base + ACTOR_S_RUNQ_COUNT) - 1)
        if (rt_actor and 1) == 1 {
            run_domain_entry(rt_actor shr 1)    // not an actor but a domain (an odd number: 2 * d + 1): its runtime takes a turn
            return
        }

        // Take the oldest message out of the actor's mailbox.
        rt_header: u64 = rt_actor - ACTOR_BEFORE_FIELDS
        if load64(rt_header + ACTOR_H_COUNT) == 0 {
            store64(rt_header + ACTOR_H_QUEUED, 0)      // its messages were lost in a restart
            if (load64(rt_header + ACTOR_H_FLAGS) and ACTOR_F_RETIRING) != 0 {
                finish_retire(rt_actor)                 // it ended while it was queued: its place is given back now
            }
            return
        }
        rt_first: u64 = load64(rt_header + ACTOR_H_FIRST)
        rt_slot: u64 = rt_header + ACTOR_HEADER_WORDS * 8 + rt_first * ACTOR_SLOT_WORDS * 8
        rt_handler: u64 = load64(rt_slot)
        // Copy the payload out of the slot first: the handler may send to its own actor,
        // and that send can reuse this slot.
        rt_buffer: u64 = rt_base + ACTOR_MSG_BUFFER
        copying: loop rt_w: u64 in 0..ACTOR_MESSAGE_WORDS {
            store64(rt_buffer + rt_w * 8, load64(rt_slot + 8 + rt_w * 8))
        }
        rt_left: u64 = load64(rt_header + ACTOR_H_COUNT) - 1
        store64(rt_header + ACTOR_H_FIRST, (rt_first + 1) % ACTOR_SLOTS)
        store64(rt_header + ACTOR_H_COUNT, rt_left)
        if rt_left > 0 {
            run_queue_push(rt_actor)
        } else {
            store64(rt_header + ACTOR_H_QUEUED, 0)
        }
        rt_dispatcher: u64 = load64(rt_header + ACTOR_H_DISPATCHER)
        store64(rt_base + ACTOR_S_CURRENT_DISPATCHER, rt_dispatcher)
        store64(rt_base + ACTOR_S_CURRENT_HANDLER, rt_handler)
        store64(rt_base + ACTOR_S_CURRENT_ACTOR, rt_actor)
        store64(rt_base + ACTOR_S_IN_NEW, 0)
        if domain_of(rt_actor) != 0 {
            domain_budget_begin()
        }
        timer_arm(budget_ticks())
        mut rt_failed: u64 = 0
        if inject_now() {
            rt_failed = 1                       // fault injection: this handler fails before it runs (decision 195)
        } else {
            rt_failed = invoke(rt_dispatcher, rt_actor, rt_handler, rt_buffer)
        }
        timer_disarm()
        domain_budget_end()
        store64(rt_base + ACTOR_S_CURRENT_ACTOR, 0)
        if rt_failed != 0 {
            if load64(rt_base + ACTOR_S_STOPPING) != 0 {
                store64(rt_base + ACTOR_S_STOPPING, 0)
                end_actor(rt_actor)                 // it called stop()
            } else {
                discard restart_actor(rt_actor)
            }
        }
        pending_sub(1)                          // the message is handled
    }
}

/// Fault injection for tests (decision 195): after `inject_failures(core, first, period)` the `first`-th handler that core
/// runs fails as if it had panicked (it is reported as "injected failure", its message is lost, the actor is restarted or
/// stopped as for any failure), and then every `period`-th handler after it (0: only that one). This is how a test fails a
/// supervised system at a chosen point, again and again, without a program that panics on purpose.
pub fn inject_failures(fi_core: u64, fi_first: u64, fi_period: u64) {
    unsafe {
        rt_there: u64 = core_block(fi_core)
        store64(rt_there + CORE_INJECT_COUNT, 0)
        store64(rt_there + CORE_INJECT_PERIOD, fi_period)
        store64(rt_there + CORE_INJECT_NEXT, fi_first)
    }
}

/// Is the handler about to run the one a test has asked to fail? Counts handlers while armed.
fn inject_now() -> bool {
    unsafe {
        rt_there: u64 = core_block(core_id())
        rt_next: u64 = load64(rt_there + CORE_INJECT_NEXT)
        if rt_next == 0 {
            return false
        }
        rt_count: u64 = load64(rt_there + CORE_INJECT_COUNT) + 1
        store64(rt_there + CORE_INJECT_COUNT, rt_count)
        if rt_count < rt_next {
            return false
        }
        rt_period: u64 = load64(rt_there + CORE_INJECT_PERIOD)
        store64(rt_there + CORE_INJECT_NEXT, if rt_period == 0 { 0 } else { rt_count + rt_period })
        domain_report("injected failure")
        return true
    }
}

// ---- timers (decision 196) --------------------------------------------------------------------------------------------
// A timer is a request that a message `tick(token)` reach an actor after a number of milliseconds. Core 0 keeps all of them
// (a request from another core travels as a record) and its scheduler turns the ones that are due into messages, in the
// order they are due (equal times: the order they were armed). An armed timer counts as a message in flight, so
// `run_until_idle` waits for it. The resolution is that of a sleeping core waking: 1 ms (decision 191).

pub extern fn raven_timer_after(target: u64, handler: u64, ms: u64, token: u64) -> u64

/// Arms a timer: `tick`-handler number `handler` of the actor `target` is sent `token` after `ms` milliseconds. 1 if it was
/// armed (from another core: if the request was queued), 0 if all 32 timers are in use.
pub fn timer_after_impl(target: u64, handler: u64, ms: u64, token: u64) -> u64 {
    mut tm_hz: u64 = counter_frequency()
    if tm_hz == 0 {
        tm_hz = BUDGET_DEFAULT_HZ
    }
    tm_deadline: u64 = read_counter() + ms * (tm_hz / 1000)
    unsafe {
        if core_id() == 0 {
            if timer_arm_here(tm_deadline, target, handler, token) {
                return 1
            }
            return 0
        }
        tm_rec: u64 = ring_scratch(0)
        store64(tm_rec, REC_TIMER)
        store64(tm_rec + 8, target)
        store64(tm_rec + 16, handler)
        store64(tm_rec + 24, tm_deadline)
        store64(tm_rec + 32, token)
        push_record(0, tm_rec)
    }
    return 1
}

/// Puts a timer in a free slot of core 0's table. False if there is none.
fn timer_arm_here(tm_deadline: u64, tm_target: u64, tm_handler: u64, tm_token: u64) -> bool {
    unsafe {
        tm_block: u64 = core_block(0)
        searching: loop tm_i: u64 in 0..TIMER_SLOTS {
            tm_entry: u64 = tm_block + CORE_TIMERS + tm_i * TIMER_ENTRY
            if load64(tm_entry + 8) == 0 {
                tm_seq: u64 = load64(tm_block + CORE_TIMER_SEQ) + 1
                store64(tm_block + CORE_TIMER_SEQ, tm_seq)
                store64(tm_entry, tm_deadline)
                store64(tm_entry + 16, tm_handler)
                store64(tm_entry + 24, tm_token)
                store64(tm_entry + 32, tm_seq)
                store64(tm_entry + 8, tm_target)        // last: a slot with a target is in use
                pending_add(1)
                return true
            }
        }
    }
    return false
}

/// Core 0's scheduler, between turns: sends `tick(token)` for every timer that is due, the earliest first.
pub fn deliver_timers() {
    if core_id() != 0 {
        return
    }
    unsafe {
        tm_block: u64 = core_block(0)
        tm_now: u64 = read_counter()
        delivering: loop true {
            mut tm_best: u64 = TIMER_SLOTS
            mut tm_best_deadline: u64 = 0
            mut tm_best_seq: u64 = 0
            looking: loop tm_i: u64 in 0..TIMER_SLOTS {
                tm_entry: u64 = tm_block + CORE_TIMERS + tm_i * TIMER_ENTRY
                if load64(tm_entry + 8) != 0 and load64(tm_entry) <= tm_now {
                    tm_deadline: u64 = load64(tm_entry)
                    tm_seq: u64 = load64(tm_entry + 32)
                    if tm_best == TIMER_SLOTS or tm_deadline < tm_best_deadline or (tm_deadline == tm_best_deadline and tm_seq < tm_best_seq) {
                        tm_best = tm_i
                        tm_best_deadline = tm_deadline
                        tm_best_seq = tm_seq
                    }
                }
            }
            if tm_best == TIMER_SLOTS {
                return
            }
            tm_entry: u64 = tm_block + CORE_TIMERS + tm_best * TIMER_ENTRY
            tm_target: u64 = load64(tm_entry + 8)
            tm_handler: u64 = load64(tm_entry + 16)
            tm_token: u64 = tm_block + CORE_TIMER_SEQ + 8       // the token goes through a word of the block that nothing else uses
            store64(tm_token, load64(tm_entry + 24))
            store64(tm_entry + 8, 0)                            // the slot is free
            if not route_message(tm_target, tm_handler, tm_token, 1, false) {
                tm_base: u64 = actor_arena_base()
                store64(tm_base + ACTOR_S_DROPPED, load64(tm_base + ACTOR_S_DROPPED) + 1)       // a lossy message: dropped and counted
            }
            pending_sub(1)                                      // the timer is over; the message has its own count
        }
    }
}

// ---- protection domains (decision 175) --------------------------------------------------------
// An actor in a domain runs at EL0 (domain.s). Raven never trusts what it finds in a domain's memory: every
// address a request names is checked to be inside the pool, in the part the domain may use, before Raven
// reads or writes it, and a target must be an actor Raven made.

/// The protection domain an actor lives in (0: Raven's own).
pub fn domain_of(dm_actor: u64) -> u64 {
    unsafe {
        return load64(dm_actor - ACTOR_BEFORE_FIELDS + ACTOR_H_DOMAIN) and 0xf
    }
}

/// The core an actor lives on: bits 4 to 7 of its domain word (0 for every plain actor, which lives on core 0).
pub fn core_of_actor(dm_actor: u64) -> u64 {
    unsafe {
        return (load64(dm_actor - ACTOR_BEFORE_FIELDS + ACTOR_H_DOMAIN) shr 4) and 0xf
    }
}

/// The first domain with no actor on core `dm_core`, 1 to 3. A domain is given back when its actor ends (`retire_domain`,
/// decision 197), so a program can have three `separate` actors alive on a core, twelve at once.
fn free_domain(dm_core: u64) -> u64 {
    mut dm_found: u64 = 0
    unsafe {
        searching: loop dm_k: u64 in 1..(DOMAINS + 1) {
            if dm_found == 0 and domain_actor_of(dm_core, dm_k) == 0 and not generations_used_up(dm_core, dm_k) {
                dm_found = dm_k
            }
        }
    }
    if dm_found == 0 {
        panic("out of protection domains on a core")
    }
    return dm_found
}

/// Runs a handler (or an actor's start stub) of `dm_actor`: protected in Raven's domain, in its own domain at
/// EL0 otherwise. 0 if it finished, 1 if it failed (and Raven has said so).
fn invoke(dm_dispatcher: u64, dm_actor: u64, dm_handler: u64, dm_payload: u64) -> u64 {
    dm_domain: u64 = domain_of(dm_actor)
    if dm_domain == 0 {
        unsafe {
            return call_protected(dm_dispatcher, dm_actor, dm_handler, dm_payload)
        }
    }
    return run_in_domain(dm_domain, dm_dispatcher, dm_actor, dm_handler, dm_payload)
}

/// Runs the dispatcher of an actor in domain `dm_d` at EL0 on a message, and does what the domain asks
/// until it finishes or fails. A message is copied into the domain's last page first (the copy that
/// makes a send to another domain safe); a payload that is already in the pool (the arguments of `new`) is not.
fn run_in_domain(dm_d: u64, dm_dispatcher: u64, dm_actor: u64, dm_handler: u64, dm_payload: u64) -> u64 {
    dm_pool: u64 = domain_pool_base(dm_d)
    mut dm_at: u64 = dm_payload
    unsafe {
        if dm_payload < dm_pool or dm_payload >= dm_pool + DOMAIN_POOL_BYTES {
            dm_at = dm_pool + DOMAIN_INBOX
            copying: loop dm_w: u64 in 0..ACTOR_MESSAGE_WORDS {
                store64(dm_at + dm_w * 8, load64(dm_payload + dm_w * 8))
            }
        }
        mut dm_reason: u64 = domain_enter(dm_d, dm_dispatcher, dm_actor, dm_handler, dm_at)
        servicing: loop dm_reason == REASON_CALL {
            dm_reason = service_call(dm_pool)
        }
        if dm_reason == REASON_DONE {
            return 0
        }
        report_failure(dm_d, dm_reason)
    }
    return 1
}

/// Says why a domain failed, in the shape of a panic so tests can expect it (domain 0 is Raven's own).
fn report_failure(dm_d: u64, dm_reason: u64) {
    if dm_reason == REASON_REPORTED {
        return                                  // it panicked, and the panic was printed already
    }
    unsafe {
        if dm_reason == 2 {
            if dm_d == 1 {
                domain_report("domain 1 ran for over 100 ms")
            } else if dm_d == 2 {
                domain_report("domain 2 ran for over 100 ms")
            } else {
                domain_report("domain 3 ran for over 100 ms")
            }
        } else if dm_reason == REASON_BAD {
            if dm_d == 1 {
                domain_report("domain 1 made a request it may not")
            } else if dm_d == 2 {
                domain_report("domain 2 made a request it may not")
            } else {
                domain_report("domain 3 made a request it may not")
            }
        } else {
            if dm_d == 1 {
                domain_report("domain 1 faulted")
            } else if dm_d == 2 {
                domain_report("domain 2 faulted")
            } else {
                domain_report("domain 3 faulted")
            }
        }
    }
}

/// Does what the domain's last `svc` asked, and continues it: returns the next reason to stop. Anything a
/// domain may not ask for (a bad address, a target that is not an actor, `spawn`, `watch`, `stop`: not yet
/// built for a domain) is REASON_BAD, which fails the domain.
fn service_call(dm_pool: u64) -> u64 {
    dm_number: u64 = domain_call_number()
    unsafe {
        if dm_number == SVC_SEND or dm_number == SVC_SEND_RELIABLE {
            dm_target: u64 = domain_saved_x(0)
            dm_handler: u64 = domain_saved_x(1)
            dm_payload: u64 = domain_saved_x(2)
            dm_words: u64 = domain_saved_x(3)
            if dm_words > ACTOR_MESSAGE_WORDS {
                return REASON_BAD
            }
            if dm_words > 0 and not pool_readable(dm_pool, dm_payload, dm_words * 8) {
                return REASON_BAD
            }
            if not valid_actor(dm_target and REF_ADDRESS_MASK) {
                return REASON_BAD
            }
            if is_current(dm_target) and not valid_handler(dm_target and REF_ADDRESS_MASK, dm_handler) {
                return REASON_BAD               // (a stale reference names no actor, so no handler: it is refused below, softly)
            }
            if dm_number == SVC_SEND {
                send_impl(dm_target, dm_handler, dm_payload, dm_words)
                return domain_resume(0)
            }
            dm_result: u64 = domain_saved_x(8)          // where a struct result goes
            if not pool_readable(dm_pool, dm_result, 8) {
                return REASON_BAD
            }
            mut dm_tag: u64 = 0
            match send_reliable_impl(dm_target, dm_handler, dm_payload, dm_words) {
                Delivered => dm_tag = 0
                MailboxFull => dm_tag = 1
                Gone => dm_tag = 2
            }
            store64(dm_result, dm_tag)
            return domain_resume(0)
        }
        if dm_number == SVC_SPAWN_SEPARATE {
            dm_placed: u64 = place_from_domain(dm_pool)
            if dm_placed == 0 {
                return REASON_BAD
            }
            return domain_resume(dm_placed)
        }
        if dm_number == SVC_TIMER {
            dm_t_target: u64 = domain_saved_x(0)
            dm_t_handler: u64 = domain_saved_x(1)
            if not valid_actor(dm_t_target and REF_ADDRESS_MASK) or domain_saved_x(2) > TIMER_MAX_MS {
                return REASON_BAD
            }
            if is_current(dm_t_target) and not valid_handler(dm_t_target and REF_ADDRESS_MASK, dm_t_handler) {
                return REASON_BAD
            }
            return domain_resume(timer_after_impl(dm_t_target, dm_t_handler, domain_saved_x(2), domain_saved_x(3)))
        }
        if dm_number == SVC_SELF {
            dm_who: u64 = domain_saved_x(0)
            if dm_who < dm_pool or dm_who >= dm_pool + DOMAIN_POOL_BYTES or not place_registered(dm_who) {
                return REASON_BAD               // a domain's `self` is one of the actors placed in it (its runtime knows which runs)
            }
            return domain_resume(self_impl(dm_who))
        }
        if dm_number == SVC_PANIC {
            dm_message: u64 = domain_saved_x(0)
            dm_message_length: u64 = domain_saved_x(1)
            dm_file: u64 = domain_saved_x(2)
            dm_file_length: u64 = domain_saved_x(3)
            if not constant_ok(dm_message, dm_message_length) or not constant_ok(dm_file, dm_file_length) {
                return REASON_BAD
            }
            domain_report_panic(dm_message, dm_message_length, dm_file, dm_file_length, domain_saved_x(4))
            return REASON_REPORTED
        }
    }
    return REASON_BAD
}

/// May the domain with pool `dm_pool` have Raven read or write `dm_bytes` at `dm_address`? Only its stack
/// and its data: not the guard, not the control page (the actor's header and mailbox), nothing outside.
fn pool_readable(dm_pool: u64, dm_address: u64, dm_bytes: u64) -> bool {
    if dm_address < dm_pool {
        return false
    }
    dm_start: u64 = dm_address - dm_pool
    if dm_start >= DOMAIN_POOL_BYTES or dm_bytes > DOMAIN_POOL_BYTES - dm_start {
        return false
    }
    dm_end: u64 = dm_start + dm_bytes
    if dm_start >= DOMAIN_STACK_FIRST and dm_end <= DOMAIN_STACK_END {
        return true
    }
    if dm_start < DOMAIN_FIELDS or dm_end > DOMAIN_POOL_BYTES {
        return false
    }
    unsafe {
        dm_index: u64 = (dm_pool - domain_pools_start()) shr 21
        // (not the pages of an actor's header and mailbox, which only Raven reaches: a request that names one is a bad request)
        return not range_hits_control_page(dm_index / DOMAINS, dm_index % DOMAINS + 1, dm_start, dm_end)
    }
}

/// Is [dm_address, dm_address + dm_length) inside the kernel's constants (a message or a file name the
/// compiler wrote)? Those are readable by every domain and hold no secrets.
fn constant_ok(dm_address: u64, dm_length: u64) -> bool {
    unsafe {
        dm_end: u64 = image_rodata_end()
        return dm_length <= 4096 and dm_address >= image_rodata_start() and dm_address <= dm_end and dm_length <= dm_end - dm_address
    }
}

/// Is `dm_target` an actor Raven made (in a domain, or in the arena)? A domain can only get a reference by
/// being given one, but Raven does not take its word for it.
fn valid_actor(dm_target: u64) -> bool {
    dm_base: u64 = raven_arena_address()        // plain actors all live in core 0's arena, whichever core asks
    unsafe {
        if dm_target >= domain_pools_start() and dm_target < domain_pools_end() {
            // in a domain's pool: a domain of some core that holds exactly this actor
            // (a place in a pool: where an actor lives, or lived and has given the domain back, wiped: a stale reference
            // to it is refused when it is used, not a request that fails the domain)
            // (an address that is, or was once, the start of an actor's fields in that domain; whether an actor is there now is
            // `is_current`'s question, so a reference to an actor that has gone is refused softly, and an address where there never was
            // one is a request that fails the domain)
            dm_index: u64 = (dm_target - domain_pools_start()) shr 21
            dm_there: u64 = domain_pool_base_of(dm_index / DOMAINS, dm_index % DOMAINS + 1)
            dm_in: u64 = dm_target - dm_there
            if dm_target % DOMAIN_PAGE != 0 or dm_in < DOMAIN_FIELDS or dm_in >= DOMAIN_INBOX {
                return false
            }
            dm_page: u64 = dm_in / DOMAIN_PAGE
            dm_seen: u64 = core_block(dm_index / DOMAINS) + CORE_DOMAIN_SEEN + (dm_index % DOMAINS) * 64 + (dm_page / 64) * 8
            return ((load64(dm_seen) shr (dm_page % 64)) and 1) == 1
        }
        dm_next: u64 = load64(dm_base + ACTOR_S_NEXT)
        mut dm_at: u64 = dm_base + ACTOR_FIRST_ACTOR
        walking: loop dm_at < dm_next {
            if dm_at + ACTOR_BEFORE_FIELDS == dm_target {
                return true
            }
            dm_size: u64 = (load64(dm_at + ACTOR_H_DOMAIN) shr 8) and ACTOR_SIZE_MASK
            if dm_size == 0 {
                return false
            }
            dm_at = dm_at + dm_size
        }
    }
    return false
}

/// Does the actor `dm_target` have a handler with number `dm_handler`? (Fledgling's table lists every one.)
fn valid_handler(dm_target: u64, dm_handler: u64) -> bool {
    unsafe {
        dm_dispatcher: u64 = load64(dm_target - ACTOR_BEFORE_FIELDS + ACTOR_H_DISPATCHER)
        mut dm_record: u64 = handler_table_start()
        dm_last: u64 = handler_table_end()
        searching: loop dm_record < dm_last {
            if load64(dm_record) == dm_dispatcher and load64(dm_record + 8) == dm_handler {
                return true
            }
            dm_record = dm_record + HANDLER_RECORD_BYTES
        }
    }
    return false
}

/// The handler budget in ticks of the generic timer.
fn budget_ticks() -> u64 {
    mut rt_hz: u64 = counter_frequency()
    if rt_hz == 0 {
        rt_hz = BUDGET_DEFAULT_HZ
    }
    return ACTOR_BUDGET_MS * (rt_hz / 1000)
}

/// Called by the IRQ vector (kernel/arch/aarch64/vectors.s) when the budget timer
/// fires: the handler that was running has failed. Until supervision exists that is
/// reported like a panic, naming the handler, and the core halts.
pub fn raven_budget_overrun() {
    rt_base: u64 = actor_arena_base()
    unsafe {
        rt_dispatcher: u64 = load64(rt_base + ACTOR_S_CURRENT_DISPATCHER)
        rt_handler: u64 = load64(rt_base + ACTOR_S_CURRENT_HANDLER)
        mut rt_record: u64 = handler_table_start()
        rt_end: u64 = handler_table_end()
        searching: loop rt_record < rt_end {
            if load64(rt_record) == rt_dispatcher and load64(rt_record + 8) == rt_handler {
                rook_budget_panic(load64(rt_record + 16), ACTOR_BUDGET_MS,
                                  load64(rt_record + 24), load64(rt_record + 32))
            }
            rt_record = rt_record + HANDLER_RECORD_BYTES
        }
    }
    panic("a handler ran past its time budget")
}
