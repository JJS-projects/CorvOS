module public

// What an application may use of Raven's actors: the result of a reliable send, the
// interrupt interface, the `Irq` capability, and the calls that run the scheduler. Nothing
// here takes a raw number as authority. The mailboxes, the arena and everything that
// can address an actor from a number are in `mailbox`, which only Raven's own code can
// import (decision 142).

import assembly: actor_arena_base, core_online_mark, idle_until_interrupt, irq_enable_source
import devices: Mmio
import hardware: irq_init
import mailbox: raven_new_domain, raven_timer_after, deliver_timers, ACTOR_IRQ_FIRST, ACTOR_IRQ_ROUTES, ACTOR_S_DROPPED, ACTOR_S_LOST, ACTOR_S_RESTARTS, actors_waiting, deliver_interrupts, drain_rings, run_one_turn, unfinished_messages, wait_for_other_cores

/// What a send to a `reliable` handler tells the sender (decisions 126 and 150).
pub enum Sent {
    Delivered
    MailboxFull         // no room now: it may fit later
    Gone                // the actor has ended: it never will (decision 150)
}

/// The number of messages dropped so far because a mailbox was full.
pub fn dropped_messages() -> u64 {
    unsafe {
        return load64(actor_arena_base() + ACTOR_S_DROPPED)
    }
}

/// The number of messages lost because the actor they were for failed or ended: they
/// were waiting in its mailbox when it was restarted (decision 148).
pub fn lost_messages() -> u64 {
    unsafe {
        return load64(actor_arena_base() + ACTOR_S_LOST)
    }
}

/// The number of times an actor has been restarted so far.
pub fn restart_count() -> u64 {
    unsafe {
        return load64(actor_arena_base() + ACTOR_S_RESTARTS)
    }
}

/// Runs actors until none has a message waiting, no interrupt is waiting to be delivered, and no other core has a
/// message left to handle or send (the count of messages nobody has finished with, over all cores, is 0). Each turn
/// delivers one message to the actor at the front of the run queue; an actor with more waiting goes to the back
/// (decision 122, d). Between turns it handles what other cores have sent to this one (decision 181).
pub fn run_until_idle() {
    scheduling: loop {
        drain_rings()
        deliver_interrupts()
        deliver_timers()
        if actors_waiting() != 0 {
            run_one_turn()
        } else if unfinished_messages() != 0 {
            wait_for_other_cores()
        } else {
            break scheduling
        }
    }
}

/// Runs actors for ever. When none has a message waiting, the core sleeps until an interrupt arrives (decision 134), or
/// another core sends it a record (its mailbox interrupt: decisions 183 and 191).
pub fn run_forever() {
    scheduling: loop true {
        drain_rings()
        deliver_interrupts()
        deliver_timers()
        if actors_waiting() != 0 {
            run_one_turn()
        } else {
            idle_until_interrupt()          // every core sleeps in `wfi`: an interrupt, a record (the mailbox interrupt) or the 1 ms timer wakes it
        }
    }
}

/// Where cores 1 to 3 start in Rook (called by the boot code, start.s): the core says it is up, lets its own
/// timer interrupt it, and runs its own Raven: its own arena, run queue and mailboxes (decision 111). Nothing runs
/// on it until a message is sent to an actor of its own (milestone 6d-2).
fn raven_secondary(core: u64) {
    unsafe {
        core_online_mark()
    }
    irq_init()
    run_forever()
}

/// What a timer becomes: a message to the handler `tick` of the actor that asked, carrying the token it gave (decision 196).
pub interface Tick {
    lossy on tick(token: u64)
}

/// The right to ask for timer messages, made only from the peripherals (`make_timer`), as an `Irq` is. Whoever holds it can
/// send `tick` to any actor it holds a reference to; the resolution is a millisecond, and 32 timers can be armed at once
/// for the whole system.
pub struct Timer {
    id: u64

    /// After `ms` milliseconds (at most an hour) the actor `to` is sent `tick(token)`, once. False if all the timers are in
    /// use, when asked on core 0, which keeps them; asked from an actor on another core it is true when the request is sent, and
    /// a request that finds every timer in use is dropped and counted in `dropped_messages()` of core 0 (decision 216). A
    /// timeout that is renewed is a new `after` with a new token; the old one's tick arrives too, with the old token, and the
    /// handler tells them apart. Periodic work is `after` again in `tick`.
    pub fn after(ms: u64, to: Tick, token: u64) -> bool {
        unsafe {
            return raven_timer_after(actor_reference(to), handler_number("tick"), ms, token) != 0
        }
    }
} Timer

/// The right to put actors in a domain (decision 201): made by `new_domain()`, used as `spawn Name(...) in d` and ended by
/// `stop(d)`. It is a value of its own: a reference to an actor in the domain is the right to send to it and no more.
pub struct Domain {
    handle: u64
}

/// An empty domain, on the next core in turn. Actors of `separate` kinds are put in it with `spawn Name(...) in d`.
pub fn new_domain() -> Domain {
    unsafe {
        return Domain(handle: raven_new_domain())
    }
}

/// A `Timer`. Only the whole peripherals can make one, like an `Irq`.
pub fn make_timer(peripherals: Mmio) -> Timer {
    if not peripherals.is_root() {
        panic("a Timer is made from the whole peripherals")
    }
    return Timer(id: 0)
}

/// What an interrupt becomes: a message to the handler `fired` of the actor that
/// routed it. It is `lossy` with no arguments, so one already queued absorbs a
/// new one (decision 113, f).
pub interface Interrupt {
    lossy on fired()
}

/// The right to receive one peripheral interrupt, made only from the peripherals
/// (`make_irq`). Whoever holds it chooses where the interrupt goes.
pub struct Irq {
    line: u64

    /// From now on interrupt `line` is delivered to `to` as the message `fired`.
    /// Routing it again replaces the route.
    pub fn route(to: Interrupt) {
        unsafe {
            rt_slot: u64 = actor_arena_base() + ACTOR_IRQ_ROUTES + (.line - ACTOR_IRQ_FIRST) * 16
            store64(rt_slot, actor_reference(to))
            store64(rt_slot + 8, handler_number("fired"))
        }
        irq_enable_source(.line)
    }
} Irq

/// An `Irq` for peripheral interrupt `line` (32 to 63; the PL011 UART is 57). Only
/// the whole peripherals can make one, so a driver that was given just its registers
/// can't give itself an interrupt.
pub fn make_irq(peripherals: Mmio, line: u64) -> Irq {
    if not peripherals.is_root() {
        panic("an Irq is made from the whole peripherals")
    }
    if line < ACTOR_IRQ_FIRST or line >= ACTOR_IRQ_FIRST + 32 {
        panic("peripheral interrupts 32 to 63 only")
    }
    return Irq(line: line)
}
