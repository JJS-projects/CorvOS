module public

// What an application may use of Raven's actors: the result of a reliable send, the
// interrupt interface, the `Irq` capability, and the calls that run the scheduler. Nothing
// here takes a raw number as authority. The mailboxes, the arena and everything that
// can address an actor from a number are in `mailbox`, which only Raven's own code can
// import (decision 142).

import assembly: actor_arena_base, idle_until_interrupt, irq_enable_source
import devices: Mmio
import mailbox: ACTOR_IRQ_FIRST, ACTOR_IRQ_ROUTES, ACTOR_S_DROPPED, ACTOR_S_LOST, ACTOR_S_RESTARTS, actors_waiting, deliver_interrupts, run_one_turn

/// What a send to a `reliable` handler tells the sender (decisions 126 and 150).
pub enum Sent {
    Delivered
    MailboxFull         // no room now: it may fit later
    Gone                // the actor has ended: it never will (decision 150)
}

/// The number of messages dropped so far because a mailbox was full.
pub fn dropped_messages() -> u64 {
    unsafe {
        return load64(actor_arena_base() + ACTOR_S_DROPPED)
    }
}

/// The number of messages lost because the actor they were for failed or ended: they
/// were waiting in its mailbox when it was restarted (decision 148).
pub fn lost_messages() -> u64 {
    unsafe {
        return load64(actor_arena_base() + ACTOR_S_LOST)
    }
}

/// The number of times an actor has been restarted so far.
pub fn restart_count() -> u64 {
    unsafe {
        return load64(actor_arena_base() + ACTOR_S_RESTARTS)
    }
}

/// Runs actors until none has a message waiting and no interrupt is waiting to be
/// delivered. Each turn delivers one message to the actor at the front of the run
/// queue; an actor with more waiting goes to the back (decision 122, d).
pub fn run_until_idle() {
    scheduling: loop {
        deliver_interrupts()
        if actors_waiting() == 0 {
            break scheduling
        }
        run_one_turn()
    }
}

/// Runs actors for ever. When none has a message waiting, the core sleeps until an
/// interrupt arrives (decision 134).
pub fn run_forever() {
    scheduling: loop true {
        deliver_interrupts()
        if actors_waiting() != 0 {
            run_one_turn()
        } else {
            idle_until_interrupt()
        }
    }
}

/// What an interrupt becomes: a message to the handler `fired` of the actor that
/// routed it. It is `lossy` with no arguments, so one already queued absorbs a
/// new one (decision 113, f).
pub interface Interrupt {
    lossy on fired()
}

/// The right to receive one peripheral interrupt, made only from the peripherals
/// (`make_irq`). Whoever holds it chooses where the interrupt goes.
pub struct Irq {
    line: u64

    /// From now on interrupt `line` is delivered to `to` as the message `fired`.
    /// Routing it again replaces the route.
    pub fn route(to: Interrupt) {
        unsafe {
            rt_slot: u64 = actor_arena_base() + ACTOR_IRQ_ROUTES + (.line - ACTOR_IRQ_FIRST) * 16
            store64(rt_slot, actor_address(to))
            store64(rt_slot + 8, handler_number("fired"))
        }
        irq_enable_source(.line)
    }
} Irq

/// An `Irq` for peripheral interrupt `line` (32 to 63; the PL011 UART is 57). Only
/// the whole peripherals can make one, so a driver that was given just its registers
/// can't give itself an interrupt.
pub fn make_irq(peripherals: Mmio, line: u64) -> Irq {
    if not peripherals.is_root() {
        panic("an Irq is made from the whole peripherals")
    }
    if line < ACTOR_IRQ_FIRST or line >= ACTOR_IRQ_FIRST + 32 {
        panic("peripheral interrupts 32 to 63 only")
    }
    return Irq(line: line)
}
