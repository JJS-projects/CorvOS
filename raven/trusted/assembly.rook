// The dangerous functions written in assembly that Rook calls: the actor arena, the jump
// into a dispatcher, the timer and the interrupt controller. Each can reach memory or
// code from a number, so this is an internal module: application code can't import it
// (decision 142). The harmless ones are in `hardware`.

import bytes: Bytes

/// Support for Raven's actors (kernel/arch/aarch64/actors.s): the memory they
/// live in, and the jump into an actor's dispatcher with a message's words.
pub extern fn actor_arena_base() -> u64
pub extern fn actor_arena_limit() -> u64
pub extern fn raven_arena_address() -> u64
pub extern fn call_dispatch(dispatcher: u64, target: u64, handler: u64, payload: u64)
pub extern fn actor_failed()
pub extern fn call_protected(dispatcher: u64, target: u64, handler: u64, payload: u64) -> u64

/// Where the MMU map (kernel/arch/aarch64/mmu.s) changes rights: the address of the first read-only
/// page of constants. For tests.
pub extern fn image_rodata_start() -> u64

/// Protection domains (kernel/arch/aarch64/domain.s, decision 174). `domain_enter` runs `entry` at EL0 in
/// domain `d` (1 to 3) with a0 to a2 in x0 to x2, and returns why it stopped: 0 the handler returned, 1 it
/// faulted, 2 the time budget ran out, 3 it asked for something with `svc` (see `domain_call_number` and
/// `domain_saved_x`; `domain_resume` continues it with an answer). The fault calls say what happened.
pub extern fn domain_enter(d: u64, entry: u64, a0: u64, a1: u64, a2: u64) -> u64
pub extern fn domain_resume(result: u64) -> u64
pub extern fn domain_timed_out() -> u64
pub extern fn domain_budget_begin()
pub extern fn domain_budget_end()
pub extern fn domain_call_number() -> u64
pub extern fn domain_saved_x(n: u64) -> u64
pub extern fn domain_fault_esr() -> u64
pub extern fn domain_fault_far() -> u64
pub extern fn domain_fault_elr() -> u64
pub extern fn domain_pool_base(d: u64) -> u64
pub extern fn domain_actor(d: u64) -> u64
pub extern fn domain_set_actor(d: u64, who: u64)
pub extern fn image_rodata_end() -> u64
pub extern fn domain_report(message: Bytes)
pub extern fn domain_report_panic(message: u64, message_length: u64, file: u64, file_length: u64, line: u64)
pub extern fn domain_tramp_address() -> u64
pub extern fn domain_wipe(d: u64)
pub extern fn domain_wipe_data(d: u64)

/// Programs for the tests of domains (kernel/test/domain_test.s; only in the Rook test kernel).
pub extern fn dt_program(n: u64) -> u64

/// Cores (kernel/arch/aarch64/start.s, cpu.s, decision 178). `cores_release` lets cores 1 to 3 go; each comes
/// up in `raven_secondary` (actors.rook) and says so with `core_online_mark`. `core_id` is the core this runs on and
/// `core_online_arena` the actor arena a core reported.
pub extern fn cores_release()
pub extern fn core_online_mark()
pub extern fn core_id() -> u64
pub extern fn core_online_arena(core: u64) -> u64
pub extern fn core_online_state(core: u64) -> u64

/// Rings between cores (kernel/arch/aarch64/rings.s, decision 181). A record is 16 words. `ring_push` queues one for
/// core `dst`, `ring_pop` takes the oldest from core `src`'s ring, `rings_waiting` tells which rings hold one. The
/// `pending_*` calls keep the count of messages nobody has finished with, over all cores; `ring_scratch` is room for
/// two records in the core's own block. `domain_*_of` reach another core's domains; `spawn_next_core` says where the
/// next `separate` actor goes.
pub extern fn ring_push(dst: u64, record: u64) -> u64
pub extern fn ring_pop(src: u64, record: u64) -> u64
pub extern fn rings_waiting() -> u64
pub extern fn pending_add(n: u64)
pub extern fn pending_sub(n: u64)
pub extern fn pending_load() -> u64
pub extern fn core_wait_event()
pub extern fn core_pause()
pub extern fn ring_scratch(i: u64) -> u64
pub extern fn domain_actor_of(core: u64, d: u64) -> u64
pub extern fn domain_set_actor_of(core: u64, d: u64, who: u64)
pub extern fn domain_pool_base_of(core: u64, d: u64) -> u64
pub extern fn pool_wipe(base: u64)
pub extern fn domain_pools_start() -> u64
pub extern fn domain_pools_end() -> u64
pub extern fn spawn_next_core() -> u64
pub extern fn spawn_count() -> u64
pub extern fn core_stack_guard(core: u64) -> u64

/// Interrupts and the handler time budget (kernel/arch/aarch64/actors.s,
/// kernel/panic.s, decisions 133 and 134). `timer_arm` interrupts after that many counter
/// ticks and `timer_disarm` cancels it; `irq_enable_source` and `irq_take_pending` work
/// the interrupt controller. `handler_table_*` bound the table Fledgling writes of every
/// handler, five words each. `rook_budget_panic` takes the addresses of two `Bytes` values.
pub extern fn timer_arm(ticks: u64)
pub extern fn timer_disarm()
pub extern fn irq_enable_source(line: u64)
pub extern fn irq_take_pending() -> u64
pub extern fn idle_until_interrupt()
pub extern fn handler_table_start() -> u64
pub extern fn handler_table_end() -> u64
pub extern fn rook_budget_panic(name: u64, budget_ms: u64, file: u64, line: u64)
