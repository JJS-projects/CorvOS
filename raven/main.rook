// Raven's kernel_main, in Rook.

import hardware: cores_online_mask, counter_frequency, current_el, irq_init, mmu_state, quiet_build, read_counter, run_test_hooks
import devices: Mmio
import led: Led
import pl011: Pl011
import time: wait_ms

// Where the devices Raven uses sit within the peripherals.
UART0_OFFSET: u64 = 0x201000
GPIO_OFFSET: u64 = 0x200000
REGISTER_PAGE: u64 = 0x1000

// Signs of life on the activity LED, for a first boot without a serial adapter:
// one flash = Raven's Rook code is running, two = the console is set up,
// solid on = boot complete.
FLASH_MS: u64 = 150
PAUSE_MS: u64 = 600

/// Brings up the console and reports how the kernel started. `peripherals`
/// covers every device register: it is the root of all device authority, and
/// each device is handed only its own part.
pub fn kernel_main(entry_el: u64, peripherals: Mmio) {
    // The test builds don't wait: nobody is watching their LED.
    watched: bool = not quiet_build()
    led: Led = Led(gpio: peripherals.part(GPIO_OFFSET, REGISTER_PAGE))
    led.init()
    if watched {
        led.blink(1, FLASH_MS)
        wait_ms(PAUSE_MS)
    }
    console: Pl011 = Pl011(regs: peripherals.part(UART0_OFFSET, REGISTER_PAGE))
    console.init(peripherals.part(GPIO_OFFSET, REGISTER_PAGE))
    if watched {
        led.blink(2, FLASH_MS)
        wait_ms(PAUSE_MS)
    }
    console.write("Raven: hello from CorvOS\n")
    console.write("Raven: firmware entered at EL")
    console.write_dec(entry_el)
    console.write("\n")
    console.write("Raven: running at EL")
    console.write_dec(current_el())
    console.write("\n")
    if mmu_state() == 0x1005 {          // M, C and I: mmu.s switched the MMU and both caches on
        console.write("Raven: MMU and caches on\n")
    } else {
        console.write("Raven: MMU or caches OFF\n")
    }
    // The other cores were released at the start; give them up to a second to come up.
    mut hz: u64 = counter_frequency()
    if hz == 0 {
        hz = 19200000                   // the firmware did not say (hardware.md 12)
    }
    deadline: u64 = read_counter() + hz
    waiting: loop cores_online_mask() != 15 and read_counter() < deadline {
    }
    mut up: u64 = 0
    mut mask: u64 = cores_online_mask()
    counting: loop mask != 0 {
        up += mask and 1
        mask = mask shr 1
    }
    console.write("Raven: ")
    console.write_dec(up)
    console.write(" cores online\n")
    irq_init()                          // the handler time budget needs the timer interrupt
    run_test_hooks(peripherals)
    console.write("Raven: boot complete, idling\n")
    led.turn_on()
}
