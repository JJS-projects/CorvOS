// The self-hosted checker, declarations half: a port of the part of bootstrap/fledgling/checker.py that
// runs before constants and function bodies (`Checker.program` up to `implements`), step 5d-3b. It
// reads the tree of a program after the generics pass (compiler/lib/generics.rook) and either fails with
// the message and place Fledgling gives, or has the tables that part of the checker builds: the types
// (with sizes), fields, variants, signatures, handler numbers, imports. They are compared with Fledgling
// as the text `--dump-declarations` (docs/self-hosting.md).
//
// Types, fields, variants and signatures are rows of tables (lists), and refer to each other by number
// (row 0 of each table means "none"). Names have one meaning wherever they are seen (principle 4), so a
// type is found by its name.

import bytes: Bytes
import option: Option
import parser: Node
import program: SourceFile
import region: List, Region
import text: Text
import textmap: TextMap

pub CHK_NONE: u64 = 0
pub CHK_INT: u64 = 1
pub CHK_BOOL: u64 = 2
pub CHK_UNIT: u64 = 3
pub CHK_STRUCT: u64 = 4
pub CHK_ENUM: u64 = 5
pub CHK_ACTOR: u64 = 6
pub CHK_INTERFACE: u64 = 7

pub CHK_ROLE_FN: u64 = 1            // what a signature is: a function, a method, `new`, a handler
pub CHK_ROLE_METHOD: u64 = 2
pub CHK_ROLE_NEW: u64 = 3
pub CHK_ROLE_HANDLER: u64 = 4

pub CHK_FIELD_MUT: u64 = 1          // flags of an actor's field
pub CHK_FIELD_VAL: u64 = 2
pub CHK_FIELD_ISO: u64 = 4

pub CHK_MESSAGE_PARAMS: u64 = 4     // a handler takes at most 4 parameters
pub CHK_MESSAGE_WORDS: u64 = 8      // and a message carries at most 8 words (decision 135)
pub CHK_NEW_PARAMS: u64 = 7
pub CHK_NEW_WORDS: u64 = 16         // words of `new` arguments Raven keeps to restart an actor

// ---- numbers of a constant ------------------------------------------------------------------
//
// A constant is computed as Fledgling computes it, with unbounded integers, then checked against the
// type (`fit`). Every value that is kept fits its type, so one 64-bit magnitude and a sign are enough;
// a result beyond 64 bits is `big`, which fits no type.

pub CHK_MAX_U64: u64 = 18446744073709551615

pub struct Num {
    pub neg: bool
    pub mag: u64
    pub big: bool
}

pub fn chk_num(neg: bool, mag: u64) -> Num {
    return Num(neg: neg and mag != 0, mag: mag, big: false)
}

fn chk_num_big() -> Num {
    return Num(neg: false, mag: 0, big: true)
}

fn chk_num_eq(a: Num, b: Num) -> bool {
    return a.neg == b.neg and a.mag == b.mag
}

fn chk_num_less(a: Num, b: Num) -> bool {
    if a.neg != b.neg {
        return a.neg
    }
    if a.neg {
        return b.mag < a.mag
    }
    return a.mag < b.mag
}

fn chk_num_negate(a: Num) -> Num {
    return chk_num(not a.neg, a.mag)
}

fn chk_num_add(a: Num, b: Num) -> Num {
    if a.big or b.big {
        return chk_num_big()
    }
    if a.neg == b.neg {
        if a.mag > CHK_MAX_U64 - b.mag {
            return chk_num_big()
        }
        return chk_num(a.neg, a.mag + b.mag)
    }
    if a.mag >= b.mag {
        return chk_num(a.neg, a.mag - b.mag)
    }
    return chk_num(b.neg, b.mag - a.mag)
}

fn chk_num_mul(a: Num, b: Num) -> Num {
    if a.big or b.big {
        return chk_num_big()
    }
    if a.mag == 0 or b.mag == 0 {
        return chk_num(false, 0)
    }
    if a.mag > CHK_MAX_U64 / b.mag {
        return chk_num_big()
    }
    return chk_num(a.neg != b.neg, a.mag * b.mag)
}

/// Division rounding toward zero (`b` is not 0).
fn chk_num_div(a: Num, b: Num) -> Num {
    return chk_num(a.neg != b.neg, a.mag / b.mag)
}

/// `a - b * trunc_div(a, b)`: the sign of `a`.
fn chk_num_rem(a: Num, b: Num) -> Num {
    return chk_num(a.neg, a.mag % b.mag)
}

/// The 64 bits of two's complement of `a`.
pub fn chk_num_bits(a: Num) -> u64 {
    if a.neg {
        return (a.mag xor CHK_MAX_U64) + 1
    }
    return a.mag
}

/// The number whose 64 bits of two's complement are `bits`, read as signed or not.
fn chk_num_from_bits(bits: u64, signed: bool) -> Num {
    if signed and bits >= 9223372036854775808 {
        return chk_num(true, (bits xor CHK_MAX_U64) + 1)
    }
    return chk_num(false, bits)
}

/// `1 shl count - 1` for count in 0..64, and all 64 bits for 64.
fn chk_low_mask(count: u64) -> u64 {
    if count >= 64 {
        return CHK_MAX_U64
    }
    return (1 shl count) - 1
}

pub CHK_NOTE_SLOT: u64 = 0          // what the checker records on a node (docs/self-hosting.md): the keys, in the
pub CHK_NOTE_END_SLOT: u64 = 1      // order the dump writes them. A key with a sign (lo, hi, const) has the sign
pub CHK_NOTE_SUBJECT_SLOT: u64 = 2  // in the word after its value.
pub CHK_NOTE_SELF_SLOT: u64 = 3
pub CHK_NOTE_RESULT_SLOT: u64 = 4
pub CHK_NOTE_TEMP: u64 = 5
pub CHK_NOTE_ARGS_SLOT: u64 = 6
pub CHK_NOTE_ARGS_WORDS: u64 = 7
pub CHK_NOTE_PAYLOAD: u64 = 8
pub CHK_NOTE_PAYLOAD_WORDS: u64 = 9
pub CHK_NOTE_HANDLER_INDEX: u64 = 10
pub CHK_NOTE_WORDS: u64 = 11
pub CHK_NOTE_NUMBER: u64 = 12
pub CHK_NOTE_STOPPED: u64 = 13
pub CHK_NOTE_LO: u64 = 14
pub CHK_NOTE_HI: u64 = 16
pub CHK_NOTE_CONST: u64 = 18
pub CHK_NOTE_NSLOTS: u64 = 20
pub CHK_NOTE_TYPE: u64 = 21
pub CHK_NOTE_CONST_STR: u64 = 22    // the node of the text a name stands for
pub CHK_NOTE_VARIANT: u64 = 23      // row of the variants, plus one
pub CHK_NOTE_STRUCT: u64 = 24       // row of the types
pub CHK_NOTE_FLAGS: u64 = 25        // 1 scalar, 2 send
pub CHK_NOTE_SLOTS: u64 = 27          // a variant pattern: where its bindings start in `slot_rows` (plus one)
pub CHK_NOTE_SLOTS_COUNT: u64 = 28
pub CHK_NOTE_LKIND: u64 = 29          // a variable's name: what kind it is (CHK_LOCAL_*); the code generator reads it
pub CHK_NOTE_SIG: u64 = 30            // a method call, send or struct `new`: the signature row it calls
pub CHK_NOTE_FILE: u64 = 26         // a method, `new` or handler: the file of its type (the checker sets `file` on them)
pub CHK_LOCAL_VALUE: u64 = 1        // what a variable is: a number, a lent struct, or a struct the function owns
pub CHK_LOCAL_REF: u64 = 2
pub CHK_LOCAL_REGION: u64 = 3
pub CHK_NOTE_STRIDE: u64 = 32       // words of a row of notes: the mask of the keys set, then a word a key

pub struct LocalInfo {
    pub name: Text
    pub ty: u64
    pub mutable: bool
    pub slot: u64
    pub kind: u64
    pub owned: bool             // an `iso` parameter: not a borrow, so it can be consumed
    pub is_val: bool            // a `val` parameter: read-only data that can be passed on
    pub uid: u64                // a number no other variable of the function has
}

pub struct ConstInfo {
    pub name: Text
    pub ty: u64
    pub decl: u64               // the Const node
    pub value: Num              // a number, bool (0 or 1); 0 for text
    pub text_node: u64          // the Str node of a text constant, else 0
}


pub struct TypeInfo {
    pub kind: u64
    pub name: Text
    pub decl: u64               // the node that declares it (0 for a built-in type)
    pub words: u64              // size in words, once known
    pub sized: bool
    pub new_sig: u64            // a struct's or actor's `new` (row of the signatures), or 0
}

/// A field of a struct, an actor or a variant (`owner` is a row of the types, or of the variants).
pub struct FieldInfo {
    pub owner: u64
    pub in_variant: bool
    pub name: Text
    pub ty: u64
    pub public: bool
    pub flags: u64
}

pub struct VariantInfo {
    pub enum_id: u64
    pub name: Text
    pub tag: u64
}

pub struct SigInfo {
    pub decl: u64
    pub owner: u64              // the struct, enum, actor or interface (0 for a function)
    pub role: u64
    pub ret: u64
    pub mutating: bool
    pub number: u64             // a handler's number in messages
    pub handler: Text           // "lossy" or "reliable" for a handler
}

pub struct ParamInfo {
    pub sig: u64
    pub ty: u64
    pub is_mut: bool
    pub modifier: u64           // as written before the type: 1 `mut`, 2 `val`, 3 `iso`, 0 none
}

pub struct ImplInfo {
    pub actor_id: u64
    pub iface_id: u64
}

pub struct Checker {
    region: Region
    nodes: List<Node>
    files: List<SourceFile>
    root: u64
    generics: TextMap<u64>              // the templates: name -> node, in the order found
    pub types: List<TypeInfo>
    pub fields: List<FieldInfo>
    pub variants: List<VariantInfo>
    pub sigs: List<SigInfo>
    pub params: List<ParamInfo>
    pub impls: List<ImplInfo>
    pub type_names: TextMap<u64>        // every type that can be written, by name
    pub struct_ids: List<u64>           // in the order they are declared
    pub enum_ids: List<u64>
    pub actor_ids: List<u64>
    pub interface_ids: List<u64>
    pub fns: TextMap<u64>               // function name -> signature
    declared: TextMap<u64>              // names of functions, constants, structs, enums, actors, interfaces
    variant_names: TextMap<u64>         // variant name -> row of the variants
    generic_variants: TextMap<u64>      // variant of a generic enum -> that enum's template
    generic_types: TextMap<u64>         // the templates declared so far
    methods: TextMap<u64>               // "Owner.name" -> signature (methods, handlers)
    builtins: TextMap<u64>
    pub handler_numbers: TextMap<u64>
    pub imports: List<TextMap<u64>>     // by file number: name -> the file number it is imported from
    pub import_order: List<u64>         // the files that have imports, in the order of their first
    exports: List<TextMap<u64>>         // by file number: name -> the declaring node
    pub unit: u64
    pub bool_type: u64
    pub u8_type: u64
    pub u64_type: u64
    in_fn: bool                         // checking a function body (else a constant)
    locals: List<LocalInfo>             // the variables in scope, innermost last
    scope_marks: List<u64>              // where each open scope starts in `locals`
    loops: List<Text>                   // the labels of the enclosing loops
    nslots: u64
    cur_sig: u64                        // the signature of the function being checked
    recv: u64                           // the type a method belongs to (0 outside a method)
    recv_mut: bool
    in_new: bool
    assigned: TextMap<u64>              // fields `new` has set so far
    moved: List<u64>                    // what is consumed now: (key, consume node) pairs, in order
    field_keys: List<Text>              // the actor fields that were consumed, by name
    uid_names: List<Text>               // the name of each variable of the function, by number minus one
    entry_moved: List<List<u64>>        // per enclosing loop: what was consumed at its start
    entry_outside: List<List<u64>>      // ... and the variables that existed then
    break_depths: List<u64>             // the loop each `break` so far leaves
    break_states: List<List<u64>>       // ... and what was consumed there
    lock_roots: List<Text>              // variables a `match` is lending a part of
    lock_names: List<Text>              // ... and the binding that holds the loan
    unsafe_depth: u64
    pub slot_rows: List<u64>                // bindings of variant patterns: slot, offset, is-aggregate
    note_rows: List<u64>                // by node: 0, or the row of `notes` holding what was recorded on it
    notes: List<u64>
    const_names: TextMap<u64>           // constant name -> row of const_rows
    pub const_rows: List<ConstInfo>     // in the order checked
    file: u64                           // the file of the code being checked
    pub failed: bool
    building: bool                      // the first error is being written
    pub error: Text
    pub error_line: u64
    pub error_col: u64
    pub error_file: u64

    new(region: Region, nodes: List<Node>, files: List<SourceFile>, root: u64, generics: TextMap<u64>) {
        .region = copy(region)
        .nodes = copy(nodes)
        .files = copy(files)
        .root = root
        .generics = copy(generics)
        .types = List(region: region)
        .fields = List(region: region)
        .variants = List(region: region)
        .sigs = List(region: region)
        .params = List(region: region)
        .impls = List(region: region)
        .type_names = TextMap(region: region)
        .struct_ids = List(region: region)
        .enum_ids = List(region: region)
        .actor_ids = List(region: region)
        .interface_ids = List(region: region)
        .fns = TextMap(region: region)
        .declared = TextMap(region: region)
        .variant_names = TextMap(region: region)
        .generic_variants = TextMap(region: region)
        .generic_types = TextMap(region: region)
        .methods = TextMap(region: region)
        .builtins = TextMap(region: region)
        .handler_numbers = TextMap(region: region)
        .imports = List(region: region)
        .import_order = List(region: region)
        .exports = List(region: region)
        .unit = 0
        .bool_type = 0
        .u8_type = 0
        .u64_type = 0
        .in_fn = false
        .locals = List(region: region)
        .scope_marks = List(region: region)
        .loops = List(region: region)
        .nslots = 0
        .cur_sig = 0
        .recv = 0
        .recv_mut = false
        .in_new = false
        .assigned = TextMap(region: region)
        .moved = List(region: region)
        .field_keys = List(region: region)
        .uid_names = List(region: region)
        .entry_moved = List(region: region)
        .entry_outside = List(region: region)
        .break_depths = List(region: region)
        .break_states = List(region: region)
        .lock_roots = List(region: region)
        .lock_names = List(region: region)
        .unsafe_depth = 0
        .slot_rows = List(region: region)
        .note_rows = List(region: region)
        .notes = List(region: region)
        .const_names = TextMap(region: region)
        .const_rows = List(region: region)
        .file = 0
        .failed = false
        .building = false
        .error = Text(region: region)
        .error_line = 0
        .error_col = 0
        .error_file = 0
        .start()
    }

    // ---- text ----------------------------------------------------------

    pub fn empty() -> Text {
        return Text(region: .region)
    }

    fn quoted(words: Bytes) -> Text {
        mut t: Text = Text(region: .region)
        t.append(words)
        return t
    }

    /// The word after the last space (the whole text if there is no space).
    pub fn last_word(t: Text) -> Text {
        mut from: u64 = 0
        looking: loop k: u64 in 0..t.len() {
            if t.at(k) == ' ' {
                from = k + 1
            }
        }
        mut word: Text = .empty()
        copying: loop k: u64 in from..t.len() {
            word.push(t.at(k))
        }
        return word
    }

    /// Is `word` one of the words of `t` (separated by spaces)?
    pub fn has_word(t: Text, word: Bytes) -> bool {
        mut start: u64 = 0
        scanning: loop k: u64 in 0..(t.len() + 1) {
            if k == t.len() or t.at(k) == ' ' {
                if k - start == word.len() {
                    mut same: bool = true
                    comparing: loop j: u64 in 0..word.len() {
                        if t.at(start + j) != word.at(j) {
                            same = false
                        }
                    }
                    if same {
                        return true
                    }
                }
                start = k + 1
            }
        }
        return false
    }

    /// The text after the last `/` of a path.
    pub fn basename(path: Text) -> Text {
        mut from: u64 = 0
        looking: loop k: u64 in 0..path.len() {
            if path.at(k) == '/' {
                from = k + 1
            }
        }
        mut name: Text = .empty()
        copying: loop k: u64 in from..path.len() {
            name.push(path.at(k))
        }
        return name
    }

    /// A module is a file, named by the file's name without `.rook`.
    fn module_of(file: u64) -> Text {
        base: Text = .basename(.files.get(file - 1).path)
        mut dot: u64 = base.len()
        looking: loop k: u64 in 0..base.len() {
            if base.at(k) == '.' and k > 0 {
                dot = k
            }
        }
        mut name: Text = .empty()
        copying: loop k: u64 in 0..dot {
            name.push(base.at(k))
        }
        return name
    }

    // ---- errors --------------------------------------------------------

    /// Starts the first error at (line, col) in `file`; later calls to `say` add to it.
    mut fn fail_at(line: u64, col: u64, file: u64) {
        if .failed {
            .building = false
            return
        }
        .failed = true
        .building = true
        .error_line = line
        .error_col = col
        .error_file = file
    }

    mut fn fail_node(n: u64) {
        node: Node = .nodes.get(n)
        .fail_at(node.line, node.col, node.file)
    }

    mut fn say(words: Bytes) {
        if .building {
            .error.append(words)
        }
    }

    mut fn say_text(t: Text) {
        if .building {
            .error.append_text(t)
        }
    }

    /// Adds `t` between backticks.
    mut fn say_name(t: Text) {
        .say("`")
        .say_text(t)
        .say("`")
    }

    mut fn say_byte(b: u8) {
        if .building {
            .error.push(b)
        }
    }

    mut fn say_number(n: u64) {
        if .building {
            .error.append_dec(n)
        }
    }

    // ---- names ---------------------------------------------------------

    /// `Point`-like: a capital, then letters and digits, with a lowercase letter somewhere.
    fn is_camel(name: Text) -> bool {
        if name.len() == 0 or name.at(0) < 'A' or name.at(0) > 'Z' {
            return false
        }
        mut lower: bool = false
        scanning: loop k: u64 in 0..name.len() {
            b: u8 = name.at(k)
            if b >= 'a' and b <= 'z' {
                lower = true
            } else if not ((b >= 'A' and b <= 'Z') or (b >= '0' and b <= '9')) {
                return false
            }
        }
        return lower
    }

    /// `snake_case`: lowercase words and digits joined by single underscores, starting with a letter.
    fn is_snake(name: Text) -> bool {
        if name.len() == 0 or name.at(0) < 'a' or name.at(0) > 'z' {
            return false
        }
        if name.at(name.len() - 1) == '_' {
            return false
        }
        scanning: loop k: u64 in 0..name.len() {
            b: u8 = name.at(k)
            if b == '_' {
                if name.at(k - 1) == '_' {
                    return false
                }
            } else if not ((b >= 'a' and b <= 'z') or (b >= '0' and b <= '9')) {
                return false
            }
        }
        return true
    }

    /// `GetThing` -> `get_thing`: an underscore before each capital that follows a lowercase letter or
    /// digit, all lowercase, underscores run together, none at either end; `name` if nothing is left.
    fn to_snake(name: Text) -> Text {
        mut spaced: Text = .empty()
        scanning: loop k: u64 in 0..name.len() {
            b: u8 = name.at(k)
            if k > 0 and b >= 'A' and b <= 'Z' {
                before: u8 = name.at(k - 1)
                if (before >= 'a' and before <= 'z') or (before >= '0' and before <= '9') {
                    spaced.push('_')
                }
            }
            spaced.push(if b >= 'A' and b <= 'Z' { b + 32 } else { b })
        }
        mut result: Text = .empty()
        collapsing: loop k: u64 in 0..spaced.len() {
            b: u8 = spaced.at(k)
            if b == '_' {
                if result.len() > 0 and result.at(result.len() - 1) != '_' {
                    result.push('_')
                }
            } else {
                result.push(b)
            }
        }
        if result.len() > 0 and result.at(result.len() - 1) == '_' {
            mut trimmed: Text = .empty()
            copying: loop k: u64 in 0..(result.len() - 1) {
                trimmed.push(result.at(k))
            }
            result = copy(trimmed)
        }
        if result.len() == 0 {
            return .quoted("name")
        }
        return result
    }

    mut fn require_camel(name: Text, what: Bytes, at: u64) {
        if not .is_camel(name) {
            .fail_node(at)
            .say(what)
            .say(" names are CamelCase, like `Point`: ")
            .say_name(name)
        }
    }

    mut fn require_snake(name: Text, what: Bytes, at: u64) {
        if not .is_snake(name) {
            .fail_node(at)
            .say(what)
            .say(" names are snake_case, like ")
            .say_name(.to_snake(name))
            .say(": ")
            .say_name(name)
        }
    }

    // ---- the tree ------------------------------------------------------

    pub fn kid(n: u64, k: u64) -> u64 {
        return .nodes.get(n).kids.get(k)
    }

    pub fn kind_is(n: u64, kind: Bytes) -> bool {
        return .nodes.get(n).kind.same_as(kind)
    }

    pub fn name_of(n: u64) -> Text {
        return .last_word(.nodes.get(n).text)
    }

    fn is_public(n: u64) -> bool {
        return .has_word(.nodes.get(n).text, "pub")
    }

    pub fn file_of(n: u64) -> u64 {
        return .nodes.get(n).file
    }

    fn trusted_file(file: u64) -> bool {
        return .files.get(file - 1).trusted
    }

    // ---- types ---------------------------------------------------------

    mut fn add_type(kind: u64, name: Text, decl: u64) -> u64 {
        .types.push(TypeInfo(kind: kind, name: copy(name), decl: decl, words: 0, sized: false, new_sig: 0))
        return .types.len() - 1
    }

    mut fn start() {
        discard .add_type(CHK_NONE, .quoted("?"), 0)
        discard .add_signature_row(0, 0, 0, 0, false, .empty())
        .builtin_types()
        .unit = .add_type(CHK_UNIT, .quoted("()"), 0)
        .fill_builtins("load8 load16 load32 load64 store8 store16 store32 store64 panic watch stop actor_address")
        .fill_builtins("handler_number store_element load_element words_of")
        .imports.push(TextMap(region: .region))
        .exports.push(TextMap(region: .region))
        filling: loop k: u64 in 0..(.files.len()) {
            .imports.push(TextMap(region: .region))
            .exports.push(TextMap(region: .region))
        }
    }

    mut fn builtin_types() {
        .named_type("u8")
        .named_type("u16")
        .named_type("u32")
        .named_type("u64")
        .named_type("i8")
        .named_type("i16")
        .named_type("i32")
        .named_type("i64")
        id: u64 = .add_type(CHK_BOOL, .quoted("bool"), 0)
        .type_names.put(.quoted("bool"), id)
        .bool_type = id
        .u8_type = .named_int("u8")
        .u64_type = .named_int("u64")
    }

    mut fn named_type(name: Bytes) {
        id: u64 = .add_type(CHK_INT, .quoted(name), 0)
        .type_names.put(.quoted(name), id)
    }

    mut fn fill_builtins(names: Bytes) {
        mut word: Text = .empty()
        splitting: loop k: u64 in 0..(names.len() + 1) {
            if k == names.len() or names.at(k) == ' ' {
                if word.len() > 0 {
                    .builtins.put(copy(word), 1)
                    word = .empty()
                }
            } else {
                word.push(names.at(k))
            }
        }
    }

    pub fn is_aggregate(ty: u64) -> bool {
        kind: u64 = .types.get(ty).kind
        return kind == CHK_STRUCT or kind == CHK_ENUM
    }

    fn is_actor(ty: u64) -> bool {
        kind: u64 = .types.get(ty).kind
        return kind == CHK_ACTOR or kind == CHK_INTERFACE
    }

    /// Size in words: an aggregate's size once known, else 1.
    pub fn words_of_type(ty: u64) -> u64 {
        if .is_aggregate(ty) {
            return .types.get(ty).words
        }
        return 1
    }

    mut fn add_signature_row(decl: u64, owner: u64, role: u64, ret: u64, mutating: bool, handler: Text) -> u64 {
        .sigs.push(SigInfo(decl: decl, owner: owner, role: role, ret: ret, mutating: mutating, number: 0,
                           handler: copy(handler)))
        return .sigs.len() - 1
    }

    /// The type named by the reference `ref` (a `Type` node), or 0 after an error.
    mut fn resolve_type(ref: u64) -> u64 {
        node: Node = .nodes.get(ref)
        name: Text = .last_word(node.text)
        mut ty: u64 = 0
        match .type_names.find(name) {
            Some(value: id) => ty = id
            None => ty = 0
        }
        if ty != 0 and (.is_aggregate(ty) or .is_actor(ty)) {
            .require_visible(.types.get(ty).decl, .types.get(ty).name, ref, node.visible_in)
        }
        if ty == 0 {
            .fail_node(ref)
            match .variant_names.find(name) {
                Some(value: row) => {
                    .say_name(name)
                    .say(" is a variant of ")
                    .say_name(.types.get(.variants.get(row).enum_id).name)
                    .say(", not a type")
                }
                None => {
                    .say("unknown type ")
                    .say_name(name)
                }
            }
        }
        return ty
    }

    /// Without `pub`, an item can only be used in its own file (decision 49). `file` is the file whose
    /// imports count, if not the one being checked (0: this one).
    mut fn require_visible(decl: u64, name: Text, at: u64, file_given: u64) {
        file: u64 = if file_given != 0 { file_given } else { .file }
        declaration: Node = .nodes.get(decl)
        mut shown: Text = copy(name)
        if declaration.generic_base.len() > 0 {
            shown = copy(declaration.generic_base)
        }
        if declaration.file != file and not .is_public(decl) {
            .fail_node(at)
            .say_name(shown)
            .say(" is private to ")
            .say_text(.basename(.files.get(declaration.file - 1).path))
            .say("; mark it `pub` to use it in another file")
            return
        }
        if declaration.file != file {
            mut imported_from: u64 = 0
            match .imports.get(file).find(shown) {
                Some(value: from_file) => imported_from = from_file
                None => imported_from = 0
            }
            if imported_from != declaration.file {
                modname: Text = .module_of(declaration.file)
                .fail_node(at)
                .say_name(shown)
                .say(" is defined in module ")
                .say_name(modname)
                .say(": write `import ")
                .say_text(modname)
                .say(": ")
                .say_text(shown)
                .say("` at the top of this file")
            }
        }
    }

    mut fn declare_unique(name: Text, at: u64) {
        if .builtins.contains(name) {
            .fail_node(at)
            .say_name(name)
            .say(" is built in; choose another name")
            return
        }
        match .variant_names.find(name) {
            Some(value: row) => {
                .fail_node(at)
                .say_name(name)
                .say(" is already a variant of ")
                .say_name(.types.get(.variants.get(row).enum_id).name)
                return
            }
            None => { }
        }
        match .generic_variants.find(name) {
            Some(value: template) => {
                .fail_node(at)
                .say_name(name)
                .say(" is already a variant of ")
                .say_name(.name_of(template))
                return
            }
            None => { }
        }
        if .generic_types.contains(name) or .declared.contains(name) {
            .fail_node(at)
            .say_name(name)
            .say(" is already defined")
        }
    }

    // ---- imports -------------------------------------------------------

    /// The root's items, then the generic templates (which the checker also needs to know).
    mut fn all_items() -> List<u64> {
        mut items: List<u64> = List(region: .region)
        top: List<u64> = copy(.nodes.get(.root).kids)
        adding: loop k: u64 in 0..(top.len()) {
            items.push(top.get(k))
        }
        templates: loop k: u64 in 0..(.generics.len()) {
            items.push(.generics.value_at(k))
        }
        return items
    }

    /// Works out which names each file imports, and checks each import line.
    mut fn register_imports() {
        items: List<u64> = .all_items()
        mut module_first: TextMap<u64> = TextMap(region: .region)     // module name -> its first file
        mut module_count: TextMap<u64> = TextMap(region: .region)     // ... and how many files have it
        mut seen: List<u64> = List(region: .region)                    // files whose module is counted
        mut public_files: List<u64> = List(region: .region)
        filling: loop k: u64 in 0..(.files.len() + 1) {
            seen.push(0)
            public_files.push(0)
        }
        scanning: loop k: u64 in 0..(items.len()) {
            item: u64 = items.get(k)
            node: Node = .nodes.get(item)
            file: u64 = node.file
            if seen.get(file) == 0 {
                seen.set(file, 1)
                modname: Text = .module_of(file)
                match module_count.find(modname) {
                    Some(value: count) => module_count.put(modname, count + 1)
                    None => {
                        module_first.put(modname, file)
                        module_count.put(modname, 1)
                    }
                }
            }
            if node.kind.same_as("Module") {
                if not .trusted_file(file) {
                    .fail_node(item)
                    .say("`module public` is for files in a trusted directory: other files are open to everyone already")
                    return
                }
                public_files.set(file, 1)
            }
            if node.kind.same_as("Fn") or node.kind.same_as("Struct") or node.kind.same_as("Enum") or
                    node.kind.same_as("Actor") or node.kind.same_as("Interface") or node.kind.same_as("Const") {
                mut table: TextMap<u64> = .exports.get(file)
                table.put(.last_word(node.text), item)
                .exports.set(file, table)
            }
        }
        mut variant_set: TextMap<u64> = TextMap(region: .region)
        collecting: loop k: u64 in 0..(items.len()) {
            item: u64 = items.get(k)
            if .kind_is(item, "Enum") {
                group: Node = .nodes.get(.kid(item, 1))
                inner: loop j: u64 in 0..(group.kids.len()) {
                    variant_set.put(.name_of(group.kids.get(j)), 1)
                }
            }
        }
        top: List<u64> = copy(.nodes.get(.root).kids)
        importing: loop k: u64 in 0..(top.len()) {
            item: u64 = top.get(k)
            if not .kind_is(item, "Import") {
                continue importing
            }
            node: Node = .nodes.get(item)
            module_node: u64 = node.kids.get(0)
            modname: Text = copy(.nodes.get(module_node).text)
            mut count: u64 = 0
            match module_count.find(modname) {
                Some(value: found) => count = found
                None => count = 0
            }
            if count == 0 {
                .fail_node(module_node)
                .say("unknown module ")
                .say_name(modname)
                .say(": a module is a file, named without `.rook`")
                return
            }
            if count > 1 {
                .fail_node(module_node)
                .say_name(modname)
                .say(" names more than one file, so it can't be imported")
                return
            }
            mut target: u64 = 0
            match module_first.find(modname) {
                Some(value: first) => target = first
                None => target = 0
            }
            if target == node.file {
                .fail_node(module_node)
                .say("a file doesn't import itself")
                return
            }
            if .trusted_file(target) and public_files.get(target) == 0 and not .trusted_file(node.file) {
                .fail_node(module_node)
                .say_name(modname)
                .say(" is an internal module of Raven, so application code can't import it (a trusted module opens itself with `module public`)")
                return
            }
            mut table: TextMap<u64> = .imports.get(node.file)
            if table.len() == 0 {
                .import_order.push(node.file)
            }
            mut fresh: bool = true
            names: loop j: u64 in 1..(node.kids.len()) {
                name_node: u64 = node.kids.get(j)
                name: Text = copy(.nodes.get(name_node).text)
                mut found_at: u64 = 0
                match .exports.get(target).find(name) {
                    Some(value: declared_at) => found_at = declared_at
                    None => found_at = 0
                }
                if found_at == 0 {
                    .fail_node(name_node)
                    .say("module ")
                    .say_name(modname)
                    .say(" has no ")
                    .say_name(name)
                    if variant_set.contains(name) {
                        .say("; it is a variant, so import its enum")
                    }
                    return
                }
                if not .is_public(found_at) {
                    .fail_node(name_node)
                    .say_name(name)
                    .say(" is private to ")
                    .say_text(.basename(.files.get(target - 1).path))
                    .say("; mark it `pub` to import it")
                    return
                }
                if table.contains(name) {
                    .fail_node(name_node)
                    .say_name(name)
                    .say(" is already imported")
                    return
                }
                table.put(name, target)
            }
            .imports.set(node.file, table)
        }
    }

    // ---- declarations --------------------------------------------------

    /// `mut`, `val` or `iso` before the name of a type reference: 1, 2, 3, or 0 for none.
    fn type_mod(ref: u64) -> u64 {
        text: Text = copy(.nodes.get(ref).text)
        if .has_word(text, "mut") {
            return 1
        }
        if .has_word(text, "val") {
            return 2
        }
        if .has_word(text, "iso") {
            return 3
        }
        return 0
    }

    /// The rows of the fields owned by `owner` (a type, or a variant if `in_variant`).
    pub fn fields_of(owner: u64, in_variant: bool) -> List<u64> {
        mut rows: List<u64> = List(region: .region)
        scanning: loop k: u64 in 0..(.fields.len()) {
            f: FieldInfo = .fields.get(k)
            if f.owner == owner and f.in_variant == in_variant {
                rows.push(k)
            }
        }
        return rows
    }

    /// Checks the `Field` nodes in `group` and adds them to the fields of `owner`.
    mut fn field_list(group: u64, owner: u64, in_variant: bool, owner_name: Text) {
        kids: List<u64> = copy(.nodes.get(group).kids)
        mut seen: TextMap<u64> = TextMap(region: .region)
        listing: loop k: u64 in 0..(kids.len()) {
            f: u64 = kids.get(k)
            name: Text = .name_of(f)
            .require_snake(name, "field", f)
            if .failed {
                return
            }
            if seen.contains(name) {
                .fail_node(f)
                .say_name(owner_name)
                .say(" already has a field ")
                .say_name(name)
                return
            }
            seen.put(name, 1)
            ty: u64 = .resolve_type(.kid(f, 0))
            if .failed {
                return
            }
            .fields.push(FieldInfo(owner: owner, in_variant: in_variant, name: copy(name), ty: ty,
                                   public: .is_public(f), flags: 0))
        }
    }

    /// Size in words. A struct or enum can't contain itself by value.
    mut fn size(ty: u64, path: List<u64>) -> u64 {
        info: TypeInfo = .types.get(ty)
        if info.kind != CHK_STRUCT and info.kind != CHK_ENUM {
            return 1
        }
        if info.sized {
            return info.words
        }
        inside: loop k: u64 in 0..(path.len()) {
            if path.get(k) == ty {
                .fail_node(info.decl)
                .say_name(info.name)
                .say(" contains itself, so it would have no fixed size")
                return 0
            }
        }
        mut deeper: List<u64> = List(region: .region)
        copying: loop k: u64 in 0..(path.len()) {
            deeper.push(path.get(k))
        }
        deeper.push(ty)
        mut total: u64 = 0
        if info.kind == CHK_STRUCT {
            rows: List<u64> = .fields_of(ty, false)
            adding: loop k: u64 in 0..(rows.len()) {
                total += .size(.fields.get(rows.get(k)).ty, deeper)
                if .failed {
                    return 0
                }
            }
        } else {
            mut largest: u64 = 0
            counting: loop v: u64 in 0..(.variants.len()) {
                if .variants.get(v).enum_id == ty {
                    mut sum: u64 = 0
                    rows: List<u64> = .fields_of(v, true)
                    adding: loop k: u64 in 0..(rows.len()) {
                        sum += .size(.fields.get(rows.get(k)).ty, deeper)
                        if .failed {
                            return 0
                        }
                    }
                    if sum > largest {
                        largest = sum
                    }
                }
            }
            total = 1 + largest
        }
        mut sized: TypeInfo = .types.get(ty)
        sized.words = total
        sized.sized = true
        .types.set(ty, sized)
        return total
    }

    /// Adds the signature of `decl` (a function or method) and its parameters; returns its row, or 0
    /// after an error.
    mut fn signature(decl: u64, owner: u64, role: u64) -> u64 {
        group: Node = .nodes.get(.kid(decl, 0))
        mut tys: List<u64> = List(region: .region)
        mut muts: List<u64> = List(region: .region)
        mut mods: List<u64> = List(region: .region)
        listing: loop k: u64 in 0..(group.kids.len()) {
            p: u64 = group.kids.get(k)
            .require_snake(.name_of(p), "parameter", p)
            type_node: u64 = .kid(p, 0)
            ty: u64 = .resolve_type(type_node)
            if .failed {
                return 0
            }
            if .type_mod(type_node) == 3 and not .is_aggregate(ty) {
                .fail_node(type_node)
                .say("`iso` is for structs and enums; ")
                .say_text(.types.get(ty).name)
                .say(" is already a plain value")
                return 0
            }
            tys.push(ty)
            muts.push(if .type_mod(type_node) == 1 { 1 } else { 0 })
            mods.push(.type_mod(type_node))
        }
        limit: u64 = if owner != 0 { 7 } else { 8 }
        if tys.len() > limit {
            .fail_node(decl)
            .say("Fledgling supports at most ")
            .say_number(limit)
            .say(" parameters here")
            return 0
        }
        mut ret: u64 = .unit
        if .kid(decl, 1) != 0 {
            ret = .resolve_type(.kid(decl, 1))
            if .failed {
                return 0
            }
        }
        text: Text = copy(.nodes.get(decl).text)
        row: u64 = .add_signature_row(decl, owner, role, ret, .has_word(text, "mut"), .handler_word(text))
        pushing: loop k: u64 in 0..(tys.len()) {
            .params.push(ParamInfo(sig: row, ty: tys.get(k), is_mut: muts.get(k) == 1, modifier: mods.get(k)))
        }
        return row
    }

    /// "lossy" or "reliable" if the text of a declaration has it, else "".
    fn handler_word(text: Text) -> Text {
        if .has_word(text, "lossy") {
            return .quoted("lossy")
        }
        if .has_word(text, "reliable") {
            return .quoted("reliable")
        }
        return .empty()
    }

    /// The signature of a handler or of an actor's `new`. `what` names it in messages.
    mut fn actor_signature(owner: u64, decl: u64, limit: u64, is_new: bool, what: Text, role: u64) -> u64 {
        group: Node = .nodes.get(.kid(decl, 0))
        mut tys: List<u64> = List(region: .region)
        mut mods: List<u64> = List(region: .region)
        listing: loop k: u64 in 0..(group.kids.len()) {
            p: u64 = group.kids.get(k)
            .require_snake(.name_of(p), "parameter", p)
            type_node: u64 = .kid(p, 0)
            modifier: u64 = .type_mod(type_node)
            if modifier == 1 {
                .fail_node(p)
                .say("a message can't carry a borrow: a `mut` parameter is lent to a call, not sent")
                return 0
            }
            ty: u64 = .resolve_type(type_node)
            if .failed {
                return 0
            }
            if modifier == 2 and not .is_aggregate(ty) {
                .fail_node(type_node)
                .say("`val` is for structs and enums; ")
                .say_text(.types.get(ty).name)
                .say(" is already a plain value")
                return 0
            }
            if modifier == 3 and not .is_aggregate(ty) {
                .fail_node(type_node)
                .say("`iso` is for structs and enums; ")
                .say_text(.types.get(ty).name)
                .say(" is already a plain value")
                return 0
            }
            if .has_word(.nodes.get(.types.get(owner).decl).text, "separate") and .is_aggregate(ty) {
                .fail_node(type_node)
                .say_text(what)
                .say(" of a `separate` actor takes numbers, bools, chars and actor references for now: ")
                .say_text(.types.get(ty).name)
                .say(" would have to be copied between domains")
                return 0
            }
            if is_new and (modifier == 2 or modifier == 3) {
                tys.push(ty)                        // data handed to the new actor
                mods.push(modifier)
                continue listing
            }
            if .is_aggregate(ty) and modifier != 2 and modifier != 3 {
                .fail_node(type_node)
                if is_new {
                    .say("`new` takes a struct or enum as owned or read-only data: write `iso ")
                } else {
                    .say("a message carries a struct or enum owned or read-only: write `iso ")
                }
                .say_text(.types.get(ty).name)
                .say("` or `val ")
                .say_text(.types.get(ty).name)
                .say("`")
                return 0
            }
            tys.push(ty)
            mods.push(modifier)
        }
        if tys.len() > limit {
            .fail_node(decl)
            .say_text(what)
            .say(" takes at most ")
            .say_number(limit)
            .say(" parameters for now")
            return 0
        }
        mut carried: u64 = 0
        summing: loop k: u64 in 0..(tys.len()) {
            carried += .words_of_type(tys.get(k))
        }
        if is_new and carried > CHK_NEW_WORDS {
            .fail_node(decl)
            .say("`new` would take ")
            .say_number(carried)
            .say(" words of arguments, and Raven keeps at most ")
            .say_number(CHK_NEW_WORDS)
            .say(" for a restart")
            return 0
        }
        if not is_new and carried > CHK_MESSAGE_WORDS {
            .fail_node(decl)
            .say_text(what)
            .say(" would carry ")
            .say_number(carried)
            .say(" words, and a message carries at most ")
            .say_number(CHK_MESSAGE_WORDS)
            .say(" (larger data waits for the pool that comes with `freeze`)")
            return 0
        }
        text: Text = copy(.nodes.get(decl).text)
        row: u64 = .add_signature_row(decl, owner, role, .unit, false, .handler_word(text))
        pushing: loop k: u64 in 0..(tys.len()) {
            .params.push(ParamInfo(sig: row, ty: tys.get(k), is_mut: false, modifier: mods.get(k)))
        }
        return row
    }

    /// The key of a method or handler in `methods`: "Owner.name".
    pub fn method_key(owner: u64, name: Text) -> Text {
        mut key: Text = .empty()
        key.append_text(.types.get(owner).name)
        key.push('.')
        key.append_text(name)
        return key
    }

    mut fn actor_fields(act: u64) {
        decl: u64 = .types.get(act).decl
        group: Node = .nodes.get(.kid(decl, 1))
        actor_name: Text = copy(.types.get(act).name)
        mut seen: TextMap<u64> = TextMap(region: .region)
        listing: loop k: u64 in 0..(group.kids.len()) {
            f: u64 = group.kids.get(k)
            name: Text = .name_of(f)
            .require_snake(name, "field", f)
            if .failed {
                return
            }
            if seen.contains(name) {
                .fail_node(f)
                .say_name(actor_name)
                .say(" already has a field ")
                .say_name(name)
                return
            }
            seen.put(name, 1)
            if .is_public(f) {
                .fail_node(f)
                .say("an actor's fields are private: other actors reach it with messages")
                return
            }
            type_node: u64 = .kid(f, 0)
            modifier: u64 = .type_mod(type_node)
            ty: u64 = .resolve_type(type_node)
            if .failed {
                return
            }
            tyname: Text = copy(.types.get(ty).name)
            if modifier == 2 and not .is_aggregate(ty) {
                .fail_node(type_node)
                .say("`val` is for structs and enums; ")
                .say_text(tyname)
                .say(" is already a plain value")
                return
            }
            if modifier == 3 and not .is_aggregate(ty) {
                .fail_node(type_node)
                .say("`iso` is for structs and enums; ")
                .say_text(tyname)
                .say(" is already a plain value")
                return
            }
            mutable: bool = .has_word(.nodes.get(f).text, "mut")
            if modifier == 2 and mutable {
                .fail_node(f)
                .say("a `val` field is read-only, so it can't be `mut`")
                return
            }
            if .is_aggregate(ty) and modifier != 2 and modifier != 3 {
                .fail_node(type_node)
                .say("an actor's field holds a number, a bool, a reference, owned data written `iso ")
                .say_text(tyname)
                .say("`, or read-only data written `val ")
                .say_text(tyname)
                .say("`, not a bare ")
                .say_text(tyname)
                return
            }
            mut flags: u64 = 0
            if modifier == 2 {
                flags += CHK_FIELD_VAL
            }
            if modifier == 3 {
                flags += CHK_FIELD_ISO
            }
            if mutable {
                flags += CHK_FIELD_MUT
            }
            .fields.push(FieldInfo(owner: act, in_variant: false, name: copy(name), ty: ty, public: false,
                                   flags: flags))
        }
        if group.kids.len() > 0 and .kid(decl, 2) == 0 {
            .fail_node(decl)
            .say_name(actor_name)
            .say(" has fields, so it needs a `new` that sets them")
        }
    }

    mut fn actor_signatures(act: u64) {
        decl: u64 = .types.get(act).decl
        if .kid(decl, 2) != 0 {
            made: u64 = .actor_signature(act, .kid(decl, 2), CHK_NEW_PARAMS, true, .quoted("`new`"), CHK_ROLE_NEW)
            if .failed {
                return
            }
            mut info: TypeInfo = .types.get(act)
            info.new_sig = made
            .types.set(act, info)
        }
        handlers: Node = .nodes.get(.kid(decl, 3))
        listing: loop k: u64 in 0..(handlers.kids.len()) {
            h: u64 = handlers.kids.get(k)
            name: Text = .name_of(h)
            .require_snake(name, "handler", h)
            if .failed {
                return
            }
            rows: List<u64> = .fields_of(act, false)
            clash: loop j: u64 in 0..(rows.len()) {
                if .fields.get(rows.get(j)).name.equals(name) {
                    .fail_node(h)
                    .say_name(name)
                    .say(" is already a field of ")
                    .say_name(.types.get(act).name)
                    return
                }
            }
            key: Text = .method_key(act, name)
            if .methods.contains(key) {
                .fail_node(h)
                .say_name(.types.get(act).name)
                .say(" already has a handler ")
                .say_name(name)
                return
            }
            mut what: Text = .quoted("handler `")
            what.append_text(name)
            what.push('`')
            made: u64 = .actor_signature(act, h, CHK_MESSAGE_PARAMS, false, what, CHK_ROLE_HANDLER)
            if .failed {
                return
            }
            .methods.put(key, made)
        }
    }

    mut fn interface_signatures(iface: u64) {
        decl: u64 = .types.get(iface).decl
        handlers: Node = .nodes.get(.kid(decl, 0))
        listing: loop k: u64 in 0..(handlers.kids.len()) {
            h: u64 = handlers.kids.get(k)
            name: Text = .name_of(h)
            .require_snake(name, "handler", h)
            if .failed {
                return
            }
            key: Text = .method_key(iface, name)
            if .methods.contains(key) {
                .fail_node(h)
                .say_name(.types.get(iface).name)
                .say(" already has a handler ")
                .say_name(name)
                return
            }
            mut what: Text = .quoted("handler `")
            what.append_text(name)
            what.push('`')
            made: u64 = .actor_signature(iface, h, CHK_MESSAGE_PARAMS, false, what, CHK_ROLE_HANDLER)
            if .failed {
                return
            }
            .methods.put(key, made)
        }
    }

    /// A handler's number in a message is chosen by its name, program-wide (decision 128).
    mut fn number_handlers() {
        top: List<u64> = copy(.nodes.get(.root).kids)
        scanning: loop k: u64 in 0..(top.len()) {
            item: u64 = top.get(k)
            if .kind_is(item, "Actor") or .kind_is(item, "Interface") {
                group: Node = .nodes.get(if .kind_is(item, "Actor") { .kid(item, 3) } else { .kid(item, 0) })
                inner: loop j: u64 in 0..(group.kids.len()) {
                    name: Text = .name_of(group.kids.get(j))
                    if not .handler_numbers.contains(name) {
                        .handler_numbers.put(name, .handler_numbers.len())
                    }
                }
            }
        }
        numbering: loop row: u64 in 0..(.sigs.len()) {
            sig: SigInfo = .sigs.get(row)
            if sig.role == CHK_ROLE_HANDLER {
                mut numbered: SigInfo = .sigs.get(row)
                match .handler_numbers.find(.name_of(sig.decl)) {
                    Some(value: number) => numbered.number = number
                    None => numbered.number = 0
                }
                .sigs.set(row, numbered)
            }
        }
    }

    /// The parameters of signature `row` as a list of (type, mut) rows of `params`.
    pub fn params_of(row: u64) -> List<u64> {
        mut rows: List<u64> = List(region: .region)
        scanning: loop k: u64 in 0..(.params.len()) {
            if .params.get(k).sig == row {
                rows.push(k)
            }
        }
        return rows
    }

    /// `actor Name: Interface` promises every handler of the interface, with the same modifier and
    /// parameter types.
    mut fn implements(act: u64) {
        decl: u64 = .types.get(act).decl
        group: Node = .nodes.get(.kid(decl, 0))
        listing: loop k: u64 in 0..(group.kids.len()) {
            at: u64 = group.kids.get(k)
            name: Text = copy(.nodes.get(at).text)
            mut iface: u64 = 0
            match .type_names.find(name) {
                Some(value: found) => iface = found
                None => iface = 0
            }
            if iface == 0 or .types.get(iface).kind != CHK_INTERFACE {
                .fail_node(at)
                if iface != 0 and .types.get(iface).kind != CHK_INTERFACE {
                    .say_name(name)
                    .say(" is not an interface")
                } else {
                    .say("unknown interface ")
                    .say_name(name)
                }
                return
            }
            .require_visible(.types.get(iface).decl, .types.get(iface).name, at, 0)
            if .failed {
                return
            }
            already: loop j: u64 in 0..(.impls.len()) {
                if .impls.get(j).actor_id == act and .impls.get(j).iface_id == iface {
                    .fail_node(at)
                    .say_name(.types.get(act).name)
                    .say(" already implements ")
                    .say_name(name)
                    return
                }
            }
            promised: loop row: u64 in 0..(.sigs.len()) {
                want: SigInfo = .sigs.get(row)
                if want.owner != iface or want.role != CHK_ROLE_HANDLER {
                    continue promised
                }
                hname: Text = .name_of(want.decl)
                mut have_row: u64 = 0
                match .methods.find(.method_key(act, hname)) {
                    Some(value: found_row) => have_row = found_row
                    None => have_row = 0
                }
                if have_row == 0 {
                    .fail_node(at)
                    .say_name(.types.get(act).name)
                    .say(" implements ")
                    .say_name(name)
                    .say(", so it needs a handler ")
                    .say_name(hname)
                    return
                }
                have: SigInfo = .sigs.get(have_row)
                if not have.handler.equals(want.handler) {
                    .fail_node(have.decl)
                    .say_name(name)
                    .say(" declares ")
                    .say_name(hname)
                    .say(" as ")
                    .say_name(want.handler)
                    .say(", so ")
                    .say_name(.types.get(act).name)
                    .say(" must too")
                    return
                }
                have_params: List<u64> = .params_of(have_row)
                want_params: List<u64> = .params_of(row)
                mut same: bool = have_params.len() == want_params.len()
                if same {
                    comparing: loop j: u64 in 0..(have_params.len()) {
                        if .params.get(have_params.get(j)).ty != .params.get(want_params.get(j)).ty {
                            same = false
                        }
                        have_mod: u64 = .type_mod(.kid(.kid(.kid(have.decl, 0), j), 0))
                        want_mod: u64 = .type_mod(.kid(.kid(.kid(want.decl, 0), j), 0))
                        if (have_mod == 3) != (want_mod == 3) or (have_mod == 2) != (want_mod == 2) {
                            same = false
                        }
                    }
                }
                if not same {
                    .fail_node(have.decl)
                    .say("`")
                    .say_text(.types.get(act).name)
                    .say(".")
                    .say_text(hname)
                    .say("` must take the same parameter types as `")
                    .say_text(name)
                    .say(".")
                    .say_text(hname)
                    .say("`, each `iso` or `val` the same way")
                    return
                }
            }
            .impls.push(ImplInfo(actor_id: act, iface_id: iface))
        }
    }

    /// Checks every declaration, up to (not including) constants and function bodies.
    pub mut fn run() {
        .register_imports()
        if .failed {
            return
        }
        // Generic templates: only their names are known here; each instance is a type of its own.
        templates: loop k: u64 in 0..(.generics.len()) {
            tpl: u64 = .generics.value_at(k)
            name: Text = .name_of(tpl)
            .require_camel(name, "type", tpl)
            .declare_unique(name, tpl)
            if .failed {
                return
            }
            .generic_types.put(name, tpl)
            if .kind_is(tpl, "Enum") {
                group: Node = .nodes.get(.kid(tpl, 1))
                inner: loop j: u64 in 0..(group.kids.len()) {
                    vd: u64 = group.kids.get(j)
                    vname: Text = .name_of(vd)
                    .require_camel(vname, "variant", vd)
                    .declare_unique(vname, vd)
                    if .failed {
                        return
                    }
                    .generic_variants.put(vname, tpl)
                }
            }
        }
        items: List<u64> = copy(.nodes.get(.root).kids)
        // Type and variant names first, so types can refer to each other in any order.
        names: loop k: u64 in 0..(items.len()) {
            item: u64 = items.get(k)
            if not (.kind_is(item, "Struct") or .kind_is(item, "Enum")) {
                continue names
            }
            instance: bool = .nodes.get(item).generic_base.len() > 0
            name: Text = .name_of(item)
            if not instance {
                .require_camel(name, "type", item)
                .declare_unique(name, item)
                if .failed {
                    return
                }
            }
            if .kind_is(item, "Struct") {
                id: u64 = .add_type(CHK_STRUCT, name, item)
                .type_names.put(name, id)
                .declared.put(name, 1)
                .struct_ids.push(id)
            } else {
                id: u64 = .add_type(CHK_ENUM, name, item)
                .type_names.put(name, id)
                .declared.put(name, 1)
                .enum_ids.push(id)
                group: Node = .nodes.get(.kid(item, 1))
                if group.kids.len() == 0 {
                    .fail_node(item)
                    .say_name(name)
                    .say(" has no variants")
                    return
                }
                tags: loop tag: u64 in 0..(group.kids.len()) {
                    vd: u64 = group.kids.get(tag)
                    vname: Text = .name_of(vd)
                    if not instance {
                        .require_camel(vname, "variant", vd)
                        .declare_unique(vname, vd)
                        if .failed {
                            return
                        }
                        .variant_names.put(vname, .variants.len())
                    }
                    .variants.push(VariantInfo(enum_id: id, name: copy(vname), tag: tag))
                }
            }
        }
        kinds: loop k: u64 in 0..(items.len()) {
            item: u64 = items.get(k)
            if .kind_is(item, "Actor") {
                name: Text = .name_of(item)
                .require_camel(name, "actor", item)
                .declare_unique(name, item)
                if .failed {
                    return
                }
                id: u64 = .add_type(CHK_ACTOR, name, item)
                .type_names.put(name, id)
                .declared.put(name, 1)
                .actor_ids.push(id)
                .set_note(item, CHK_NOTE_TYPE, id)
            } else if .kind_is(item, "Interface") {
                name: Text = .name_of(item)
                .require_camel(name, "interface", item)
                .declare_unique(name, item)
                if .failed {
                    return
                }
                id: u64 = .add_type(CHK_INTERFACE, name, item)
                .type_names.put(name, id)
                .declared.put(name, 1)
                .interface_ids.push(id)
                .set_note(item, CHK_NOTE_TYPE, id)
            }
        }
        structs: loop k: u64 in 0..(.struct_ids.len()) {
            st: u64 = .struct_ids.get(k)
            decl: u64 = .types.get(st).decl
            .file = .file_of(decl)
            .field_list(.kid(decl, 1), st, false, copy(.types.get(st).name))
            if .failed {
                return
            }
            if .nodes.get(.kid(decl, 1)).kids.len() == 0 {
                .fail_node(decl)
                .say_name(.types.get(st).name)
                .say(" has no fields")
                return
            }
        }
        enums: loop k: u64 in 0..(.enum_ids.len()) {
            en: u64 = .enum_ids.get(k)
            decl: u64 = .types.get(en).decl
            .file = .file_of(decl)
            group: Node = .nodes.get(.kid(decl, 1))
            mut row: u64 = 0
            finding: loop v: u64 in 0..(.variants.len()) {
                if .variants.get(v).enum_id == en {
                    row = v
                    break finding
                }
            }
            variants: loop j: u64 in 0..(group.kids.len()) {
                vd: u64 = group.kids.get(j)
                if .kid(vd, 0) != 0 {
                    .field_list(.kid(vd, 0), row + j, true, copy(.variants.get(row + j).name))
                    if .failed {
                        return
                    }
                }
            }
        }
        sizes: loop k: u64 in 0..(.struct_ids.len() + .enum_ids.len()) {
            ty: u64 = if k < .struct_ids.len() { .struct_ids.get(k) } else { .enum_ids.get(k - .struct_ids.len()) }
            no_path: List<u64> = List(region: .region)
            discard .size(ty, no_path)
            if .failed {
                return
            }
        }
        actors: loop k: u64 in 0..(.actor_ids.len()) {
            act: u64 = .actor_ids.get(k)
            .file = .file_of(.types.get(act).decl)
            .actor_fields(act)
            if .failed {
                return
            }
        }
        // Signatures next, so functions and methods can call each other in any order.
        functions: loop k: u64 in 0..(items.len()) {
            item: u64 = items.get(k)
            if not .kind_is(item, "Fn") {
                continue functions
            }
            .file = .file_of(item)
            name: Text = .name_of(item)
            .require_snake(name, "function", item)
            if .failed {
                return
            }
            if .kid(item, 2) == 0 and not .trusted_file(.file) {
                .fail_node(item)
                .say("`extern fn` can call any code, so it is only allowed in files under a trusted directory, such as raven/trusted/")
                return
            }
            .declare_unique(name, item)
            if .failed {
                return
            }
            made: u64 = .signature(item, 0, CHK_ROLE_FN)
            if .failed {
                return
            }
            .declared.put(name, 1)
            .fns.put(name, made)
        }
        aggregates: loop k: u64 in 0..(.struct_ids.len() + .enum_ids.len()) {
            ty: u64 = if k < .struct_ids.len() { .struct_ids.get(k) } else { .enum_ids.get(k - .struct_ids.len()) }
            decl: u64 = .types.get(ty).decl
            .file = .file_of(decl)
            methods: Node = .nodes.get(.kid(decl, 2))
            owner_fields: List<u64> = .fields_of(ty, false)
            listing: loop j: u64 in 0..(methods.kids.len()) {
                m: u64 = methods.kids.get(j)
                name: Text = .name_of(m)
                .require_snake(name, "method", m)
                if .failed {
                    return
                }
                mut clash: bool = false
                if .types.get(ty).kind == CHK_STRUCT {
                    comparing: loop i: u64 in 0..(owner_fields.len()) {
                        if .fields.get(owner_fields.get(i)).name.equals(name) {
                            clash = true
                        }
                    }
                }
                if clash {
                    .fail_node(m)
                    .say_name(name)
                    .say(" is already a field of ")
                    .say_name(.types.get(ty).name)
                    return
                }
                key: Text = .method_key(ty, name)
                if .methods.contains(key) {
                    .fail_node(m)
                    .say_name(.types.get(ty).name)
                    .say(" already has a method ")
                    .say_name(name)
                    return
                }
                if name.same_as("new") {
                    made: u64 = .signature(m, ty, CHK_ROLE_NEW)
                    if .failed {
                        return
                    }
                    mut info: TypeInfo = .types.get(ty)
                    info.new_sig = made
                    .types.set(ty, info)
                } else {
                    made: u64 = .signature(m, ty, CHK_ROLE_METHOD)
                    if .failed {
                        return
                    }
                    .methods.put(key, made)
                }
            }
        }
        interfaces: loop k: u64 in 0..(.interface_ids.len()) {
            iface: u64 = .interface_ids.get(k)
            .file = .file_of(.types.get(iface).decl)
            .interface_signatures(iface)
            if .failed {
                return
            }
        }
        signing: loop k: u64 in 0..(.actor_ids.len()) {
            act: u64 = .actor_ids.get(k)
            .file = .file_of(.types.get(act).decl)
            .actor_signatures(act)
            if .failed {
                return
            }
        }
        .number_handlers()
        promising: loop k: u64 in 0..(.actor_ids.len()) {
            act: u64 = .actor_ids.get(k)
            .file = .file_of(.types.get(act).decl)
            .implements(act)
            if .failed {
                return
            }
        }
    }


    // ---- what the checker records on a node (decision 165) --------------------------------------
    //
    // Side tables, not fields of the nodes: `note_rows` says, for a node, which row of `notes` holds what
    // was recorded on it. A row is a mask of the keys that are set, then one word per key.

    mut fn set_note(n: u64, key: u64, value: u64) {
        grow: loop .note_rows.len() <= n {
            .note_rows.push(0)
        }
        mut row: u64 = .note_rows.get(n)
        if row == 0 {
            row = .notes.len() / CHK_NOTE_STRIDE + 1
            fill: loop k: u64 in 0..CHK_NOTE_STRIDE {
                .notes.push(0)
            }
            .note_rows.set(n, row)
        }
        base: u64 = (row - 1) * CHK_NOTE_STRIDE
        .notes.set(base, .notes.get(base) or (1 shl key))
        .notes.set(base + 1 + key, value)
    }

    pub fn note_has(n: u64, key: u64) -> bool {
        if n >= .note_rows.len() {
            return false
        }
        row: u64 = .note_rows.get(n)
        if row == 0 {
            return false
        }
        return (.notes.get((row - 1) * CHK_NOTE_STRIDE) and (1 shl key)) != 0
    }

    pub fn note_get(n: u64, key: u64) -> u64 {
        return .notes.get((.note_rows.get(n) - 1) * CHK_NOTE_STRIDE + 1 + key)
    }

    /// Records the value of a constant (a number, or a bool as 0 or 1) on a node.
    mut fn set_note_value(n: u64, key: u64, v: Num) {
        .set_note(n, key, v.mag)
        .set_note(n, key + 1, if v.neg { 1 } else { 0 })
    }

    fn note_value(n: u64, key: u64) -> Num {
        return chk_num(.note_get(n, key + 1) == 1, .note_get(n, key))
    }

    // ---- integer types ---------------------------------------------------------------------------

    pub fn is_int(ty: u64) -> bool {
        return .types.get(ty).kind == CHK_INT
    }

    pub fn int_bits(ty: u64) -> u64 {
        name: Text = copy(.types.get(ty).name)
        if name.len() == 2 {
            return (name.at(1) - '0') as u64
        }
        return (name.at(1) - '0') as u64 * 10 + (name.at(2) - '0') as u64
    }

    pub fn int_signed(ty: u64) -> bool {
        return .types.get(ty).name.at(0) == 'i'
    }

    fn int_min(ty: u64) -> Num {
        if .int_signed(ty) {
            return chk_num(true, 1 shl (.int_bits(ty) - 1))
        }
        return chk_num(false, 0)
    }

    fn int_max(ty: u64) -> Num {
        if .int_signed(ty) {
            return chk_num(false, chk_low_mask(.int_bits(ty) - 1))
        }
        return chk_num(false, chk_low_mask(.int_bits(ty)))
    }

    fn fits(ty: u64, v: Num) -> bool {
        return not v.big and not chk_num_less(v, .int_min(ty)) and not chk_num_less(.int_max(ty), v)
    }

    /// Keeps the low bits of `v` that `ty` has (what `as` and `wrap` do to a constant).
    fn wrap_to(ty: u64, v: Num) -> Num {
        bits: u64 = .int_bits(ty)
        mask: u64 = chk_low_mask(bits)
        mut kept: u64 = chk_num_bits(v) and mask
        if .int_signed(ty) and bits < 64 and kept >= (1 shl (bits - 1)) {
            kept = kept or (mask xor CHK_MAX_U64)
        }
        return chk_num_from_bits(kept, .int_signed(ty))
    }

    /// Can every value of `src` be represented in `dst`?
    fn lossless(src: u64, dst: u64) -> bool {
        if src == .bool_type {
            return .is_int(dst)
        }
        if not .is_int(src) or not .is_int(dst) {
            return false
        }
        return not chk_num_less(.int_min(src), .int_min(dst)) and not chk_num_less(.int_max(dst), .int_max(src))
    }

    mut fn say_type(ty: u64) {
        .say_text(.types.get(ty).name)
    }

    mut fn say_num(v: Num) {
        if v.neg {
            .say("-")
        }
        .say_number(v.mag)
    }

    fn named_int(name: Bytes) -> u64 {
        match .type_names.find(.quoted(name)) {
            Some(value: id) => return id
            None => return 0
        }
    }

    /// The value written in an `Int` or `Char` node.
    pub fn literal_value(e: u64) -> Num {
        text: Text = copy(.nodes.get(e).text)
        mut neg: bool = false
        mut mag: u64 = 0
        reading: loop k: u64 in 0..text.len() {
            b: u8 = text.at(k)
            if b == '-' {
                neg = true
            } else {
                mag = mag * 10 + (b - '0') as u64
            }
        }
        return chk_num(neg, mag)
    }

    fn untyped_literal(e: u64) -> bool {
        return .kind_is(e, "Int") or .kind_is(e, "Char")
    }

    // ---- constants -------------------------------------------------------------------------------

    /// The checker gives the file of its type to each method, `new` and handler (Fledgling sets `file` on
    /// them), which the dump shows as a `File` line below them.
    mut fn mark_member_files() {
        structs: loop k: u64 in 0..(.struct_ids.len()) {
            decl: u64 = .types.get(.struct_ids.get(k)).decl
            .mark_group(.kid(decl, 2), .file_of(decl))
        }
        enums: loop k: u64 in 0..(.enum_ids.len()) {
            decl: u64 = .types.get(.enum_ids.get(k)).decl
            file: u64 = .file_of(decl)
            .mark_group(.kid(decl, 2), file)
        }
        actors: loop k: u64 in 0..(.actor_ids.len()) {
            decl: u64 = .types.get(.actor_ids.get(k)).decl
            if .kid(decl, 2) != 0 {
                .set_note(.kid(decl, 2), CHK_NOTE_FILE, .file_of(decl))
            }
            .mark_group(.kid(decl, 3), .file_of(decl))
        }
        interfaces: loop k: u64 in 0..(.interface_ids.len()) {
            decl: u64 = .types.get(.interface_ids.get(k)).decl
            .mark_group(.kid(decl, 0), .file_of(decl))
        }
    }

    mut fn mark_group(group: u64, file: u64) {
        members: List<u64> = copy(.nodes.get(group).kids)
        marking: loop j: u64 in 0..(members.len()) {
            .set_note(members.get(j), CHK_NOTE_FILE, file)
        }
    }

    fn is_screaming(name: Text) -> bool {
        if name.len() == 0 or name.at(0) < 'A' or name.at(0) > 'Z' {
            return false
        }
        scanning: loop k: u64 in 1..name.len() {
            b: u8 = name.at(k)
            upper: bool = (b >= 'A' and b <= 'Z') or (b >= '0' and b <= '9')
            if b == '_' {
                if k + 1 == name.len() {
                    return false
                }
                next: u8 = name.at(k + 1)
                if not ((next >= 'A' and next <= 'Z') or (next >= '0' and next <= '9')) {
                    return false
                }
            } else if not upper {
                return false
            }
        }
        return true
    }

    /// Checks the top-level constants in order, each may use the ones before it (the step of
    /// `Checker.program` after the declarations).
    pub mut fn constants() {
        if .failed {
            return
        }
        .mark_member_files()
        items: List<u64> = copy(.nodes.get(.root).kids)
        scanning: loop k: u64 in 0..(items.len()) {
            item: u64 = items.get(k)
            if not .kind_is(item, "Const") {
                continue scanning
            }
            name: Text = .name_of(item)
            if not .is_screaming(name) {
                .fail_node(item)
                .say("top-level constants are SCREAMING_CASE, like ")
                snake: Text = .to_snake(name)
                .say("`")
                upper: loop j: u64 in 0..snake.len() {
                    b: u8 = snake.at(j)
                    .say_byte(if b >= 'a' and b <= 'z' { b - 32 } else { b })
                }
                .say("`")
                .say(": ")
                .say_name(name)
                return
            }
            .file = .file_of(item)
            .declare_unique(name, item)
            if .failed {
                return
            }
            ty: u64 = .resolve_type(.kid(item, 0))
            if .failed {
                return
            }
            .in_fn = false
            value: u64 = .kid(item, 1)
            discard .expr(value, ty, 0)
            if .failed {
                return
            }
            mut result: Num = chk_num(false, 0)
            mut text_node: u64 = 0
            if .is_aggregate(ty) {
                if not .kind_is(value, "Str") {
                    .fail_node(value)
                    .say("constants must be numbers, bools or text")
                    return
                }
                text_node = value
            } else {
                result = .const_eval(value)
                if .failed {
                    return
                }
            }
            .const_names.put(name, .const_rows.len())
            .const_rows.push(ConstInfo(name: copy(name), ty: ty, decl: item, value: copy(result), text_node: text_node))
            .declared.put(name, 1)
        }
    }

    // ---- expressions -----------------------------------------------------------------------------

    /// Checks `e`, records its type and returns it (0 after an error). If `expected` is not 0 the
    /// expression must have that type. A `hint` only guides the types of literals inside `e`; a mismatch
    /// is reported by the caller.
    mut fn expr(e: u64, expected: u64, hint: u64) -> u64 {
        guide: u64 = if expected != 0 { expected } else { hint }
        ty: u64 = .infer(e, guide)
        if .failed {
            return 0
        }
        .set_note(e, CHK_NOTE_TYPE, ty)
        if expected != 0 and ty != expected {
            .fail_node(e)
            .say("expected ")
            .say_type(expected)
            .say(", found ")
            .say_type(ty)
            if .types.get(expected).kind == CHK_INTERFACE and .types.get(ty).kind == CHK_ACTOR {
                .say(": hand out only what the interface allows with `narrow(..., ")
                .say_type(expected)
                .say(")`")
            }
            return 0
        }
        return ty
    }

    /// An error in a constant: what `Checker` says about code that is not allowed there.
    mut fn constant_error(e: u64, message: Bytes) -> u64 {
        .fail_node(e)
        .say(message)
        return 0
    }

    mut fn infer(e: u64, expected: u64) -> u64 {
        node: Node = .nodes.get(e)
        if .kind_is(e, "Int") or .kind_is(e, "Char") {
            mut ty: u64 = .u64_type
            if .is_int(expected) {
                ty = expected
            } else if .kind_is(e, "Char") {
                ty = .u8_type
            }
            v: Num = .literal_value(e)
            if not .fits(ty, v) {
                .fail_node(e)
                .say("literal ")
                .say_num(v)
                .say(" is out of range for ")
                .say_type(ty)
                .say(" (")
                .say_num(.int_min(ty))
                .say(" to ")
                .say_num(.int_max(ty))
                .say(")")
                return 0
            }
            return ty
        }
        if .kind_is(e, "Bool") {
            return .bool_type
        }
        if .kind_is(e, "Str") {
            return .bytes_type(e)
        }
        if .kind_is(e, "Name") {
            return .infer_name(e, expected)
        }
        if .kind_is(e, "Unary") {
            operand: u64 = .kid(e, 0)
            if node.text.same_as("-") {
                ty: u64 = .expr(operand, 0, if .is_int(expected) { expected } else { 0 })
                if .failed {
                    return 0
                }
                if not (.is_int(ty) and .int_signed(ty)) {
                    .fail_node(e)
                    .say("can't negate a value of type ")
                    .say_type(ty)
                    return 0
                }
                return ty
            }
            ty: u64 = .expr(operand, 0, if expected == .bool_type or .is_int(expected) { expected } else { 0 })
            if .failed {
                return 0
            }
            if ty != .bool_type and not .is_int(ty) {
                .fail_node(e)
                .say("`not` needs a bool or an integer, found ")
                .say_type(ty)
                return 0
            }
            return ty
        }
        if .kind_is(e, "IfExpr") {
            discard .expr(.kid(e, 0), .bool_type, 0)
            if .failed {
                return 0
            }
            return .same_type_pair(.kid(e, 1), .kid(e, 2), expected, "both branches of `if`")
        }
        if .kind_is(e, "Binary") {
            return .binary(e, expected)
        }
        if .kind_is(e, "Cast") {
            return .cast(e)
        }
        if .kind_is(e, "Call") {
            return .infer_call(e, expected)
        }
        if .kind_is(e, "Access") {
            return .infer_access(e)
        }
        if .kind_is(e, "MethodCall") {
            return .infer_method_call(e)
        }
        if .kind_is(e, "StructLit") {
            return .infer_struct_literal(e, expected)
        }
        if .kind_is(e, "Consume") {
            return .infer_consume(e)
        }
        if .kind_is(e, "Copy") {
            return .infer_copy(e)
        }
        if .kind_is(e, "SelfValue") {
            return .infer_self_value(e)
        }
        if .kind_is(e, "SelfRef") {
            return .infer_self_ref(e)
        }
        if .kind_is(e, "Narrow") {
            return .infer_narrow(e)
        }
        if .kind_is(e, "Spawn") {
            return .infer_spawn(e)
        }
        if .kind_is(e, "MatchExpr") {
            return .infer_match_expr(e, expected)
        }
        if .kind_is(e, "MutArg") {
            return .constant_error(e, "`mut` only marks an argument passed to a `mut` parameter")
        }
        return .unported(e)
    }

    /// A construct this step of the self-hosted checker does not check yet (docs/self-hosting.md): the
    /// error says so, and no test or program of the repository reaches it.
    mut fn unported(e: u64) -> u64 {
        .fail_node(e)
        .say("not checked yet: ")
        .say_text(.nodes.get(e).kind)
        return 0
    }

    mut fn infer_name(e: u64, expected: u64) -> u64 {
        name: Text = copy(.nodes.get(e).text)
        if .in_fn and .lookup(name) != 0 {
            local: LocalInfo = .locals.get(.lookup(name) - 1)
            .require_not_consumed(2 * local.uid, name, e)
            if .failed {
                return 0
            }
            .set_note(e, CHK_NOTE_SLOT, local.slot)
            .set_note(e, CHK_NOTE_LKIND, local.kind)
            return local.ty
        }
        match .const_names.find(name) {
            Some(value: row) => {
                info: ConstInfo = .const_rows.get(row)
                .require_visible(info.decl, name, e, 0)
                if .failed {
                    return 0
                }
                if info.text_node != 0 {
                    .set_note(e, CHK_NOTE_CONST_STR, info.text_node)
                } else {
                    .set_note_value(e, CHK_NOTE_CONST, info.value)
                }
                return info.ty
            }
            None => { }
        }
        mut variant: u64 = 0
        match .variant_names.find(name) {
            Some(value: row) => variant = row + 1
            None => { }
        }
        if variant == 0 and .generic_variants.contains(name) {
            variant = .generic_variant(name, expected, e)
            if .failed {
                return 0
            }
        }
        if variant != 0 {
            enum_id: u64 = .variants.get(variant - 1).enum_id
            .require_visible(.types.get(enum_id).decl, .types.get(enum_id).name, e, 0)
            if .failed {
                return 0
            }
            owned: List<u64> = .fields_of(variant - 1, true)
            if owned.len() > 0 {
                .fail_node(e)
                .say_name(name)
                .say(" has fields: write `")
                .say_text(name)
                .say("(")
                shown: loop j: u64 in 0..(owned.len()) {
                    if j > 0 {
                        .say(", ")
                    }
                    .say_text(.fields.get(owned.get(j)).name)
                    .say(": ...")
                }
                .say(")`")
                return 0
            }
            if not .in_fn {
                return .constant_error(e, "constants must be numbers or bools")
            }
            .set_note(e, CHK_NOTE_VARIANT, variant)
            .set_note(e, CHK_NOTE_TEMP, .alloc(.words_of_type(enum_id)))
            return enum_id
        }
        if .fns.contains(name) {
            .fail_node(e)
            .say_name(name)
            .say(" is a function; call it with `")
            .say_text(name)
            .say("(...)`")
            return 0
        }
        match .type_names.find(name) {
            Some(value: id) => {
                kind: u64 = .types.get(id).kind
                if kind == CHK_STRUCT or kind == CHK_ENUM or kind == CHK_ACTOR {
                    .fail_node(e)
                    .say_name(name)
                    .say(" is a type, not a value")
                    return 0
                }
            }
            None => { }
        }
        .fail_node(e)
        .say("unknown name ")
        .say_name(name)
        return 0
    }

    /// The row (plus one) of the variant `name` of a generic enum, in the instance a value being built
    /// goes to: the type of the place it goes to decides it (decision 154).
    mut fn generic_variant(name: Text, expected: u64, at: u64) -> u64 {
        mut template: u64 = 0
        match .generic_variants.find(name) {
            Some(value: found) => template = found
            None => { }
        }
        instance: u64 = .generic_instance(.name_of(template), expected, at)
        if .failed {
            return 0
        }
        scanning: loop k: u64 in 0..(.variants.len()) {
            if .variants.get(k).enum_id == instance and .variants.get(k).name.equals(name) {
                return k + 1
            }
        }
        return 0
    }

    /// Which instance of the generic `base` a value being built is: the type of the place it goes to.
    mut fn generic_instance(base: Text, expected: u64, at: u64) -> u64 {
        if expected != 0 and .is_aggregate(expected) and .nodes.get(.types.get(expected).decl).generic_base.equals(base) {
            return expected
        }
        if expected != 0 and (.is_aggregate(expected) or .is_int(expected) or expected == .bool_type) {
            .fail_node(at)
            .say("expected ")
            .say_type(expected)
            .say(", found a value of the generic type ")
            .say_name(base)
            return 0
        }
        .fail_node(at)
        .say_name(base)
        .say(" is generic: say which type this is by writing the type where the value goes, as in `x: ")
        .say_text(base)
        .say("<...> = ...`")
        return 0
    }

    /// The type of text in quotes: the program's `Bytes` struct.
    mut fn bytes_type(at: u64) -> u64 {
        mut st: u64 = 0
        match .type_names.find(.quoted("Bytes")) {
            Some(value: id) => {
                if .types.get(id).kind == CHK_STRUCT {
                    st = id
                }
            }
            None => { }
        }
        if st == 0 {
            .fail_node(at)
            .say("text in quotes is a `Bytes`, which this program doesn't include (it is declared in raven/trusted/bytes.rook)")
            return 0
        }
        owned: List<u64> = .fields_of(st, false)
        mut exact: bool = owned.len() == 2
        if exact {
            first: FieldInfo = .fields.get(owned.get(0))
            second: FieldInfo = .fields.get(owned.get(1))
            exact = first.name.same_as("address") and first.ty == .u64_type and second.name.same_as("length") and
                second.ty == .u64_type
        }
        if not exact {
            .fail_node(.types.get(st).decl)
            .say("`Bytes` must have exactly the fields `address: u64` and `length: u64`, in that order")
            return 0
        }
        return st
    }

    mut fn infer_call(e: u64, expected: u64) -> u64 {
        if .in_fn {
            return .infer_call_in_fn(e, expected)
        }
        callee: Text = copy(.nodes.get(e).text)
        if .builtins.contains(callee) {
            return .constant_error(e, "constants can't call functions")
        }
        if not .fns.contains(callee) {
            .fail_node(e)
            .say("unknown function ")
            .say_name(callee)
            return 0
        }
        return .constant_error(e, "constants can't call functions")
    }

    mut fn infer_struct_literal(e: u64, expected: u64) -> u64 {
        name: Text = copy(.nodes.get(e).text)
        mut variant: u64 = 0
        match .variant_names.find(name) {
            Some(value: row) => variant = row + 1
            None => { }
        }
        if variant == 0 and .generic_variants.contains(name) {
            variant = .generic_variant(name, expected, e)
            if .failed {
                return 0
            }
        }
        mut st: u64 = 0
        if variant != 0 {
            st = .variants.get(variant - 1).enum_id
        } else {
            match .type_names.find(name) {
                Some(value: id) => {
                    if .types.get(id).kind == CHK_STRUCT {
                        st = id
                    }
                }
                None => { }
            }
        }
        if st == 0 and .generic_types.contains(name) {
            st = .generic_instance(name, expected, e)
            if .failed {
                return 0
            }
        }
        if st != 0 {
            .require_visible(.types.get(st).decl, .types.get(st).name, e, 0)
            if .failed {
                return 0
            }
            if variant == 0 and .types.get(st).new_sig != 0 {
                if not .in_fn {
                    return .constant_error(e, "constants must be numbers or bools")
                }
                return .build_with_new(e, st)
            }
            if variant == 0 and .file_of(.types.get(st).decl) != .file {
                owned: List<u64> = .fields_of(st, false)
                mut public_count: u64 = 0
                counting: loop j: u64 in 0..(owned.len()) {
                    if .fields.get(owned.get(j)).public {
                        public_count += 1
                    }
                }
                if public_count < owned.len() {
                    .fail_node(e)
                    .say_name(.types.get(st).name)
                    .say(" has private fields, so it can only be built in ")
                    .say_text(.basename(.files.get(.file_of(.types.get(st).decl) - 1).path))
                    return 0
                }
            }
        }
        if st == 0 {
            match .type_names.find(name) {
                Some(value: id) => {
                    if .types.get(id).kind == CHK_ENUM {
                        .fail_node(e)
                        .say_name(name)
                        .say(" is an enum: build a value with one of its variants, such as `")
                        first: loop k: u64 in 0..(.variants.len()) {
                            if .variants.get(k).enum_id == id {
                                .say_text(.variants.get(k).name)
                                break first
                            }
                        }
                        .say("`")
                        return 0
                    }
                }
                None => { }
            }
            .fail_node(e)
            .say("unknown type ")
            .say_name(name)
            return 0
        }
        if not .in_fn {
            return .constant_error(e, "constants must be numbers or bools")
        }
        return .finish_struct_literal(e, st, variant)
    }

    /// Checks two expressions that must share a type. The one that isn't a bare literal is checked
    /// first, so the literal can take its type.
    mut fn same_type_pair(a: u64, b: u64, hint: u64, what: Bytes) -> u64 {
        mut aty: u64 = 0
        mut bty: u64 = 0
        if .untyped_literal(a) and not .untyped_literal(b) {
            bty = .expr(b, 0, hint)
            if .failed {
                return 0
            }
            aty = .expr(a, 0, if .is_int(bty) { bty } else { hint })
        } else {
            aty = .expr(a, 0, hint)
            if .failed {
                return 0
            }
            bty = .expr(b, 0, aty)
        }
        if .failed {
            return 0
        }
        if aty != bty {
            .fail_node(b)
            .say(what)
            .say(" must have the same type, found ")
            .say_type(aty)
            .say(" and ")
            .say_type(bty)
            return 0
        }
        return aty
    }

    pub fn op_is(e: u64, op: Bytes) -> bool {
        return .nodes.get(e).text.same_as(op)
    }

    fn is_shift(e: u64) -> bool {
        return .op_is(e, "shl") or .op_is(e, "shr")
    }

    fn is_arith(e: u64) -> bool {
        return .op_is(e, "+") or .op_is(e, "-") or .op_is(e, "*") or .op_is(e, "/") or .op_is(e, "%")
    }

    fn is_logic(e: u64) -> bool {
        return .op_is(e, "and") or .op_is(e, "or") or .op_is(e, "xor")
    }

    pub fn is_equality(e: u64) -> bool {
        return .op_is(e, "==") or .op_is(e, "!=")
    }

    mut fn say_op(e: u64) {
        .say_name(.nodes.get(e).text)
    }

    mut fn binary(e: u64, expected: u64) -> u64 {
        left: u64 = .kid(e, 0)
        right: u64 = .kid(e, 1)
        if .is_shift(e) {
            lty: u64 = .expr(left, 0, if .is_int(expected) { expected } else { 0 })
            if .failed {
                return 0
            }
            if not .is_int(lty) {
                .fail_node(left)
                .say_op(e)
                .say(" needs an integer on the left, found ")
                .say_type(lty)
                return 0
            }
            rty: u64 = .expr(right, 0, 0)
            if .failed {
                return 0
            }
            if not .is_int(rty) {
                .fail_node(right)
                .say("shift amount must be an integer, found ")
                .say_type(rty)
                return 0
            }
            return lty
        }
        // Both operands share a type. Check the side that isn't a bare literal first, so the literal
        // can take its type.
        mut hint: u64 = 0
        if .is_arith(e) {
            hint = if .is_int(expected) { expected } else { 0 }
        } else if .is_logic(e) {
            hint = if expected == .bool_type or .is_int(expected) { expected } else { 0 }
        }
        mut lty: u64 = 0
        mut rty: u64 = 0
        if .untyped_literal(left) and not .untyped_literal(right) {
            rty = .expr(right, 0, hint)
            if .failed {
                return 0
            }
            lty = .expr(left, 0, if .is_int(rty) { rty } else { hint })
        } else {
            lty = .expr(left, 0, hint)
            if .failed {
                return 0
            }
            rty = .expr(right, 0, lty)
        }
        if .failed {
            return 0
        }
        if lty != rty {
            .fail_node(e)
            .say_op(e)
            .say(" needs both sides to have the same type, found ")
            .say_type(lty)
            .say(" and ")
            .say_type(rty)
            return 0
        }
        if .is_arith(e) {
            if not .is_int(lty) {
                .fail_node(e)
                .say_op(e)
                .say(" needs integers, found ")
                .say_type(lty)
                return 0
            }
            return lty
        }
        if .is_logic(e) {
            if lty != .bool_type and not .is_int(lty) {
                .fail_node(e)
                .say_op(e)
                .say(" needs bools or integers, found ")
                .say_type(lty)
                return 0
            }
            return lty
        }
        if .is_equality(e) {
            if .types.get(lty).kind == CHK_ENUM {
                .fail_node(e)
                .say_op(e)
                .say(" doesn't compare enums; use `match`, or write a method such as `equals` in ")
                .say_name(.types.get(lty).name)
                return 0
            }
            if .is_aggregate(lty) {
                .fail_node(e)
                .say_op(e)
                .say(" doesn't compare structs; write a method such as `equals` in ")
                .say_name(.types.get(lty).name)
                return 0
            }
            if not .is_int(lty) and lty != .bool_type {
                .fail_node(e)
                .say("can't compare values of type ")
                .say_type(lty)
                return 0
            }
            return .bool_type
        }
        // ordering: < <= > >=
        if not .is_int(lty) {
            .fail_node(e)
            .say_op(e)
            .say(" needs integers, found ")
            .say_type(lty)
            return 0
        }
        return .bool_type
    }

    mut fn cast(e: u64) -> u64 {
        target: u64 = .resolve_type(.kid(e, 1))
        if .failed {
            return 0
        }
        if not .is_int(target) {
            .fail_node(.kid(e, 1))
            .say("can only convert to integer types, not ")
            .say_type(target)
            return 0
        }
        is_as: bool = .nodes.get(e).text.same_as("as")
        // A bare literal takes the target type directly: `5 as u8` is a u8 literal.
        src: u64 = .expr(.kid(e, 0), 0, if is_as and .untyped_literal(.kid(e, 0)) { target } else { 0 })
        if .failed {
            return 0
        }
        if not .is_int(src) and src != .bool_type {
            .fail_node(e)
            .say("can't convert ")
            .say_type(src)
            .say(" to ")
            .say_type(target)
            return 0
        }
        if is_as and not .lossless(src, target) {
            .fail_node(e)
            .say("`as` can't convert ")
            .say_type(src)
            .say(" to ")
            .say_type(target)
            .say(": some values would be lost; use `wrap ")
            .say_type(target)
            .say("` to keep the low bits on purpose")
            return 0
        }
        if not is_as and .lossless(src, target) {
            .fail_node(e)
            .say("`wrap` can't lose anything converting ")
            .say_type(src)
            .say(" to ")
            .say_type(target)
            .say("; use `as`")
            return 0
        }
        return target
    }

    // ---- computing a constant --------------------------------------------------------------------

    /// The value of a checked constant expression, with the overflow rules of running code (but
    /// reported at compile time).
    mut fn const_eval(e: u64) -> Num {
        if .kind_is(e, "Int") or .kind_is(e, "Char") {
            return .literal_value(e)
        }
        if .kind_is(e, "Bool") {
            return chk_num(false, if .nodes.get(e).text.same_as("true") { 1 } else { 0 })
        }
        if .kind_is(e, "Name") {
            if .note_has(e, CHK_NOTE_CONST) {
                return .note_value(e, CHK_NOTE_CONST)
            }
            return chk_num(false, 0)
        }
        if .kind_is(e, "Cast") {
            v: Num = .const_eval(.kid(e, 0))
            if .failed {
                return chk_num(false, 0)
            }
            return .wrap_to(.note_get(e, CHK_NOTE_TYPE), v)
        }
        if .kind_is(e, "Unary") {
            v: Num = .const_eval(.kid(e, 0))
            if .failed {
                return chk_num(false, 0)
            }
            ty: u64 = .note_get(e, CHK_NOTE_TYPE)
            if .op_is(e, "-") {
                return .fit(chk_num_negate(v), e)
            }
            if ty == .bool_type {
                return chk_num_add(chk_num(false, 1), chk_num_negate(v))
            }
            // wrap(~v, ty): the bits of v flipped, then the low bits of the type
            return .wrap_to(ty, chk_num_from_bits(chk_num_bits(v) xor CHK_MAX_U64, true))
        }
        if .kind_is(e, "IfExpr") {
            cond: Num = .const_eval(.kid(e, 0))
            if .failed {
                return chk_num(false, 0)
            }
            if cond.mag != 0 {
                return .const_eval(.kid(e, 1))
            }
            return .const_eval(.kid(e, 2))
        }
        if .kind_is(e, "Binary") {
            return .const_binary(e)
        }
        .fail_node(e)
        .say("constants must be computed from literals and other constants")
        return chk_num(false, 0)
    }

    mut fn fit(v: Num, e: u64) -> Num {
        ty: u64 = .note_get(e, CHK_NOTE_TYPE)
        if not .fits(ty, v) {
            .fail_node(e)
            .say("constant overflows ")
            .say_type(ty)
            return chk_num(false, 0)
        }
        return copy(v)
    }

    mut fn const_binary(e: u64) -> Num {
        a: Num = .const_eval(.kid(e, 0))
        if .failed {
            return chk_num(false, 0)
        }
        b: Num = .const_eval(.kid(e, 1))
        if .failed {
            return chk_num(false, 0)
        }
        ty: u64 = .note_get(e, CHK_NOTE_TYPE)
        if (.op_is(e, "/") or .op_is(e, "%")) and b.mag == 0 {
            .fail_node(e)
            .say("division by zero in constant")
            return chk_num(false, 0)
        }
        if .op_is(e, "+") {
            return .fit(chk_num_add(a, b), e)
        }
        if .op_is(e, "-") {
            return .fit(chk_num_add(a, chk_num_negate(b)), e)
        }
        if .op_is(e, "*") {
            return .fit(chk_num_mul(a, b), e)
        }
        if .op_is(e, "/") {
            return .fit(chk_num_div(a, b), e)
        }
        if .op_is(e, "%") {
            return chk_num_rem(a, b)
        }
        if .op_is(e, "and") or .op_is(e, "or") or .op_is(e, "xor") {
            x: u64 = chk_num_bits(a)
            y: u64 = chk_num_bits(b)
            mut r: u64 = x xor y
            if .op_is(e, "and") {
                r = x and y
            } else if .op_is(e, "or") {
                r = x or y
            }
            return chk_num_from_bits(r, .int_signed(ty) and ty != .bool_type)
        }
        if .is_shift(e) {
            bits: u64 = .int_bits(ty)
            if b.neg or b.mag >= bits {
                .fail_node(e)
                .say("shift amount ")
                .say_num(b)
                .say(" is too large for ")
                .say_type(ty)
                return chk_num(false, 0)
            }
            if .op_is(e, "shr") {
                if a.neg {
                    // floor division by 2^b of a negative number
                    shifted: u64 = (a.mag - 1) shr b.mag
                    return chk_num(true, shifted + 1)
                }
                return chk_num(false, a.mag shr b.mag)
            }
            result: Num = .wrap_to(ty, chk_num_from_bits((chk_num_bits(a) and chk_low_mask(64 - b.mag)) shl b.mag, true))
            mut back: Num = chk_num(false, 0)
            if result.neg {
                back = chk_num(true, ((result.mag - 1) shr b.mag) + 1)
            } else {
                back = chk_num(false, result.mag shr b.mag)
            }
            if not chk_num_eq(back, a) {
                .fail_node(e)
                .say("`shl` would lose set bits of ")
                .say_type(ty)
                return chk_num(false, 0)
            }
            return result
        }
        // comparisons
        mut holds: bool = false
        if .op_is(e, "==") {
            holds = chk_num_eq(a, b)
        } else if .op_is(e, "!=") {
            holds = not chk_num_eq(a, b)
        } else if .op_is(e, "<") {
            holds = chk_num_less(a, b)
        } else if .op_is(e, "<=") {
            holds = not chk_num_less(b, a)
        } else if .op_is(e, ">") {
            holds = chk_num_less(b, a)
        } else {
            holds = not chk_num_less(a, b)
        }
        return chk_num(false, if holds { 1 } else { 0 })
    }

    // ---- function bodies (5d-3c-1) ---------------------------------------------------------------

    /// Fledgling's code generator refuses a `separate` actor until Raven runs domains (milestone 6b): so does
    /// the program that writes the assembly, before it writes a line. Sets the error like any other.
    pub mut fn refuse_separate() {
        if .failed {
            return
        }
        items: List<u64> = copy(.nodes.get(.root).kids)
        scanning: loop k: u64 in 0..(items.len()) {
            item: u64 = items.get(k)
            if .kind_is(item, "Actor") and .has_word(.nodes.get(item).text, "separate") {
                .fail_node(item)
                .say("`separate actor ")
                .say_text(.name_of(item))
                .say("` needs a protection domain of its own, which Raven does not run yet (milestone 6b): remove `separate` for now")
                return
            }
        }
    }

    /// Checks the bodies the switches ask for, in Fledgling's order: functions, then the `new` and methods of
    /// structs and enums. (`only_file` is the one file whose items are checked, or 0 for all.)
    pub mut fn bodies(only_file: u64) {
        if .failed {
            return
        }
        items: List<u64> = copy(.nodes.get(.root).kids)
        fns: loop k: u64 in 0..(items.len()) {
            item: u64 = items.get(k)
            if .kind_is(item, "Fn") and .kid(item, 2) != 0 and (only_file == 0 or .file_of(item) == only_file) {
                .function(.fn_sig(.name_of(item)))
                if .failed {
                    return
                }
            }
        }
        aggregates: loop pass: u64 in 0..2 {
            ids: List<u64> = .aggregate_ids(pass)
            owners: loop k: u64 in 0..(ids.len()) {
                owner: u64 = ids.get(k)
                if only_file != 0 and .file_of(.types.get(owner).decl) != only_file {
                    continue owners
                }
                if .types.get(owner).new_sig != 0 {
                    .function(.types.get(owner).new_sig)
                }
                rows: loop row: u64 in 1..(.sigs.len()) {
                    if .sigs.get(row).owner == owner and .sigs.get(row).role == CHK_ROLE_METHOD {
                        .function(row)
                        if .failed {
                            return
                        }
                    }
                }
                if .failed {
                    return
                }
            }
        }
        actors: loop k: u64 in 0..(.actor_ids.len()) {
            owner: u64 = .actor_ids.get(k)
            if only_file != 0 and .file_of(.types.get(owner).decl) != only_file {
                continue actors
            }
            if .types.get(owner).new_sig != 0 {
                .function(.types.get(owner).new_sig)
            }
            handlers: loop row: u64 in 1..(.sigs.len()) {
                if .sigs.get(row).owner == owner and .sigs.get(row).role == CHK_ROLE_HANDLER {
                    .function(row)
                    if .failed {
                        return
                    }
                }
            }
            if .failed {
                return
            }
        }
    }

    fn fn_sig(name: Text) -> u64 {
        match .fns.find(name) {
            Some(value: row) => return row
            None => return 0
        }
    }

    /// The struct ids (pass 0) or the enum ids (pass 1).
    fn aggregate_ids(pass: u64) -> List<u64> {
        if pass == 0 {
            return copy(.struct_ids)
        }
        return copy(.enum_ids)
    }

    mut fn alloc(n: u64) -> u64 {
        slot: u64 = .nslots
        .nslots += n
        return slot
    }

    /// The row (plus one) of the innermost variable called `name`, or 0.
    fn lookup(name: Text) -> u64 {
        mut k: u64 = .locals.len()
        searching: loop k > 0 {
            k -= 1
            if .locals.get(k).name.equals(name) {
                return k + 1
            }
        }
        return 0
    }

    /// Declares a variable in the innermost scope; returns its slot. `at` is the node that names it (0 for
    /// the hidden ones): no shadowing (principle 4), a name means one thing wherever it is visible.
    mut fn new_local(name: Text, ty: u64, mutable: bool, kind: u64, at: u64, owned: bool, is_val: bool) -> u64 {
        if at != 0 {
            if .lookup(name) != 0 {
                .fail_node(at)
                .say_name(name)
                .say(" is already declared here; choose a different name")
                return 0
            }
            if .fns.contains(name) {
                .fail_node(at)
                .say_name(name)
                .say(" is already the name of a function")
                return 0
            }
            if .builtins.contains(name) {
                .fail_node(at)
                .say_name(name)
                .say(" is built in; choose another name")
                return 0
            }
        }
        slot: u64 = .alloc(if kind == CHK_LOCAL_REGION { .words_of_type(ty) } else { 1 })
        .uid_names.push(copy(name))
        .locals.push(LocalInfo(name: copy(name), ty: ty, mutable: mutable, slot: slot, kind: kind, owned: owned,
                               is_val: is_val, uid: .uid_names.len()))
        return slot
    }

    mut fn enter_scope() {
        .scope_marks.push(.locals.len())
    }

    mut fn leave_scope() {
        mark: u64 = .scope_marks.pop()
        popping: loop .locals.len() > mark {
            discard .locals.pop()
        }
    }

    /// The type of the field `name` of the struct, enum or actor `owner`, or 0.
    fn field_type(owner: u64, name: Text) -> u64 {
        rows: List<u64> = .fields_of(owner, false)
        scanning: loop j: u64 in 0..(rows.len()) {
            if .fields.get(rows.get(j)).name.equals(name) {
                return .fields.get(rows.get(j)).ty
            }
        }
        return 0
    }

    fn variant_field_type(variant: u64, name: Text) -> u64 {
        rows: List<u64> = .fields_of(variant, true)
        scanning: loop j: u64 in 0..(rows.len()) {
            if .fields.get(rows.get(j)).name.equals(name) {
                return .fields.get(rows.get(j)).ty
            }
        }
        return 0
    }

    /// Checks one function, method or `new` (the signature row `sig`).
    mut fn function(sig: u64) {
        info: SigInfo = .sigs.get(sig)
        decl: u64 = info.decl
        .cur_sig = sig
        .in_fn = true
        .locals = List(region: .region)
        .scope_marks = List(region: .region)
        .loops = List(region: .region)
        .nslots = 0
        .recv = info.owner
        .recv_mut = info.mutating
        .in_new = info.role == CHK_ROLE_NEW
        .assigned = TextMap(region: .region)
        .moved = List(region: .region)
        .field_keys = List(region: .region)
        .uid_names = List(region: .region)
        .entry_moved = List(region: .region)
        .entry_outside = List(region: .region)
        .break_depths = List(region: .region)
        .break_states = List(region: .region)
        .lock_roots = List(region: .region)
        .lock_names = List(region: .region)
        .unsafe_depth = 0
        .file = .file_of(decl)
        .enter_scope()
        if info.owner != 0 {
            .set_note(decl, CHK_NOTE_SELF_SLOT, .alloc(1))
        }
        if .is_aggregate(info.ret) {
            .set_note(decl, CHK_NOTE_RESULT_SLOT, .alloc(1))
        }
        params: Node = .nodes.get(.kid(decl, 0))
        rows: List<u64> = .params_of(sig)
        binding: loop k: u64 in 0..(params.kids.len()) {
            p: u64 = params.kids.get(k)
            pinfo: ParamInfo = .params.get(rows.get(k))
            name: Text = .name_of(p)
            if .lookup(name) != 0 {
                .fail_node(p)
                .say("duplicate parameter ")
                .say_name(name)
                return
            }
            .set_note(p, CHK_NOTE_TYPE, pinfo.ty)
            kind: u64 = if pinfo.is_mut or .is_aggregate(pinfo.ty) { CHK_LOCAL_REF } else { CHK_LOCAL_VALUE }
            slot: u64 = .new_local(name, pinfo.ty, pinfo.is_mut, kind, p, pinfo.modifier == 3, pinfo.modifier == 2)
            if .failed {
                return
            }
            .set_note(p, CHK_NOTE_SLOT, slot)
        }
        returns: bool = .block(.kid(decl, 2))
        if .failed {
            return
        }
        if not .block_diverges(.kid(decl, 2)) {
            .require_fields_back()
            if .failed {
                return
            }
        }
        if info.ret != .unit and not returns {
            .fail_node(decl)
            .say_name(.name_of(decl))
            .say(" must return a ")
            .say_type(info.ret)
            .say(" on every path")
            return
        }
        .set_note(decl, CHK_NOTE_NSLOTS, .nslots)
        if info.role == CHK_ROLE_HANDLER {
            .set_note(decl, CHK_NOTE_NUMBER, info.number)
        }
        if .in_new {
            names: List<u64> = .fields_of(info.owner, false)
            all: loop j: u64 in 0..(names.len()) {
                if not .assigned.contains(.fields.get(names.get(j)).name) {
                    .fail_node(decl)
                    .say("`new` must set every field: `.")
                    .say_text(.fields.get(names.get(j)).name)
                    .say("` is never set")
                    return
                }
            }
        }
        .in_new = false
        .recv = 0
        .cur_sig = 0
        .in_fn = false
    }

    // ---- statements ------------------------------------------------------------------------------
    // Each returns true if it always returns (control never falls through).

    mut fn block(b: u64) -> bool {
        .enter_scope()
        mut returns: bool = false
        stmts: List<u64> = copy(.nodes.get(b).kids)
        walking: loop k: u64 in 0..(stmts.len()) {
            if .stmt(stmts.get(k)) {
                returns = true
            }
            if .failed {
                return false
            }
        }
        .leave_scope()
        return returns
    }

    /// Does control never continue past statement `st`: it returns, breaks, continues or panics?
    fn diverges(st: u64) -> bool {
        if .kind_is(st, "Return") or .kind_is(st, "Break") or .kind_is(st, "Continue") {
            return true
        }
        if .kind_is(st, "ExprStmt") {
            call: u64 = .kid(st, 0)
            return .kind_is(call, "Call") and .nodes.get(call).text.same_as("panic")
        }
        if .kind_is(st, "Block") {
            return .block_diverges(st)
        }
        if .kind_is(st, "If") {
            return .kid(st, 2) != 0 and .block_diverges(.kid(st, 1)) and .diverges(.kid(st, 2))
        }
        if .kind_is(st, "Match") {
            arms: Node = .nodes.get(.kid(st, 1))
            scanning: loop k: u64 in 0..(arms.kids.len()) {
                if not .diverges(.kid(arms.kids.get(k), 1)) {
                    return false
                }
            }
            return true
        }
        if .kind_is(st, "Unsafe") {
            return .block_diverges(.kid(st, 0))
        }
        return false
    }

    fn block_diverges(b: u64) -> bool {
        stmts: List<u64> = copy(.nodes.get(b).kids)
        scanning: loop k: u64 in 0..(stmts.len()) {
            if .diverges(stmts.get(k)) {
                return true
            }
        }
        return false
    }

    /// Does anything inside `n`, at any depth, `break label`?
    fn breaks_to(n: u64, label: Text) -> bool {
        node: Node = .nodes.get(n)
        if node.kind.same_as("Break") and node.text.equals(label) {
            return true
        }
        scanning: loop k: u64 in 0..(node.kids.len()) {
            if .breaks_to(node.kids.get(k), label) {
                return true
            }
        }
        return false
    }

    /// The text of `t` between backticks.
    fn quote_text(t: Text) -> Text {
        mut out: Text = .empty()
        out.push('`')
        out.append_text(t)
        out.push('`')
        return out
    }

    mut fn stmt(s: u64) -> bool {
        node: Node = .nodes.get(s)
        if node.kind.same_as("Decl") {
            name: Text = .name_of(s)
            .require_snake(name, "variable", s)
            if .failed {
                return false
            }
            ty: u64 = .resolve_type(.kid(s, 0))
            if .failed {
                return false
            }
            discard .expr(.kid(s, 1), ty, 0)
            if .failed {
                return false
            }
            if .is_aggregate(ty) {
                .require_fresh(.kid(s, 1), .quote_text(name))
                if .failed {
                    return false
                }
            }
            kind: u64 = if .is_aggregate(ty) { CHK_LOCAL_REGION } else { CHK_LOCAL_VALUE }
            slot: u64 = .new_local(name, ty, .has_word(node.text, "mut"), kind, s, false, false)
            if .failed {
                return false
            }
            .set_note(s, CHK_NOTE_SLOT, slot)
            return false
        }
        if node.kind.same_as("Assign") {
            return .assign(s)
        }
        if node.kind.same_as("ExprStmt") {
            e: u64 = .kid(s, 0)
            if node.text.same_as("discard") {
                ty: u64 = .expr(e, 0, 0)
                if .failed {
                    return false
                }
                if ty == .unit {
                    .fail_node(e)
                    .say("nothing to discard: the call returns no value")
                }
                return false
            }
            if not (.kind_is(e, "Call") or .kind_is(e, "MethodCall")) {
                .fail_node(s)
                .say("this expression's value is unused")
                return false
            }
            if .kind_is(e, "Call") and .nodes.get(e).text.same_as("panic") {
                discard .expr(e, 0, 0)
                return true             // a panic never returns
            }
            ty: u64 = .expr(e, 0, 0)
            if .failed {
                return false
            }
            if ty != .unit {
                .fail_node(s)
                .say("the result of ")
                .say_name(.nodes.get(e).text)
                .say(" is unused; write `discard ")
                .say_text(.nodes.get(e).text)
                .say("(...)` to ignore it on purpose")
            }
            return false
        }
        if node.kind.same_as("If") {
            discard .expr(.kid(s, 0), .bool_type, 0)
            if .failed {
                return false
            }
            before: List<u64> = .state_clone(.moved)
            then_returns: bool = .block(.kid(s, 1))
            if .failed {
                return false
            }
            mut ends: List<List<u64>> = List(region: .region)
            if not .block_diverges(.kid(s, 1)) {
                ends.push(.moved)
            }
            .moved = .state_clone(before)
            if .kid(s, 2) == 0 {
                ends.push(.moved)
                .moved = .merge_states(ends, before)
                return false
            }
            mut else_returns: bool = false
            if .kind_is(.kid(s, 2), "If") {
                else_returns = .stmt(.kid(s, 2))
            } else {
                else_returns = .block(.kid(s, 2))
            }
            if .failed {
                return false
            }
            if not .diverges(.kid(s, 2)) {
                ends.push(.moved)
            }
            .moved = .merge_states(ends, before)
            return then_returns and else_returns
        }
        if node.kind.same_as("Loop") {
            label: Text = copy(node.text)
            .require_snake(label, "loop label", s)
            if .failed {
                return false
            }
            if .kid(s, 0) != 0 {
                discard .expr(.kid(s, 0), .bool_type, 0)
                if .failed {
                    return false
                }
            }
            .loops.push(copy(label))
            .enter_loop()
            discard .block(.kid(s, 1))
            if .failed {
                return false
            }
            .leave_loop(.kid(s, 1))
            discard .loops.pop()
            if .failed {
                return false
            }
            // `loop { }` (or `loop true`) that nothing breaks out of never falls through.
            cond: u64 = .kid(s, 0)
            forever: bool = cond == 0 or (.kind_is(cond, "Bool") and .nodes.get(cond).text.same_as("true"))
            return forever and not .breaks_to(.kid(s, 1), label)
        }
        if node.kind.same_as("ForRange") {
            return .for_range(s)
        }
        if node.kind.same_as("Unsafe") {
            if not .trusted_file(.file) {
                .fail_node(s)
                .say("`unsafe` is only allowed in files under a trusted directory, such as raven/trusted/")
                return false
            }
            if .unsafe_depth > 0 {
                .fail_node(s)
                .say("this is already inside `unsafe { }`")
                return false
            }
            .unsafe_depth += 1
            returns: bool = .block(.kid(s, 0))
            .unsafe_depth -= 1
            return returns
        }
        if node.kind.same_as("Break") or node.kind.same_as("Continue") {
            label: Text = copy(node.text)
            mut found: bool = false
            looking: loop k: u64 in 0..(.loops.len()) {
                if .loops.get(k).equals(label) {
                    found = true
                }
            }
            if not found {
                word: Bytes = if node.kind.same_as("Break") { "break" } else { "continue" }
                .fail_node(s)
                if .loops.len() == 0 {
                    .say_name_bytes(word)
                    .say(" outside a loop")
                } else {
                    .say("`")
                    .say(word)
                    .say(" ")
                    .say_text(label)
                    .say("`: no enclosing loop is named ")
                    .say_name(label)
                }
                return false
            }
            at: u64 = .loop_index(label)
            if node.kind.same_as("Break") {
                .break_depths.push(at)
                .break_states.push(.state_clone(.moved))
            } else {
                .require_loop_ready(at)
            }
            return false
        }
        if node.kind.same_as("Return") {
            return .return_stmt(s)
        }
        if node.kind.same_as("Match") {
            return .match_stmt(s)
        }
        discard .unported(s)
        return false
    }

    /// The place of the loop called `label` among the enclosing ones.
    fn loop_index(label: Text) -> u64 {
        scanning: loop k: u64 in 0..(.loops.len()) {
            if .loops.get(k).equals(label) {
                return k
            }
        }
        return 0
    }

    mut fn say_name_bytes(words: Bytes) {
        .say("`")
        .say(words)
        .say("`")
    }

    mut fn return_stmt(s: u64) -> bool {
        ret: u64 = .sigs.get(.cur_sig).ret
        value: u64 = .kid(s, 0)
        if value == 0 {
            if ret != .unit {
                .fail_node(s)
                .say("missing return value of type ")
                .say_type(ret)
                return true
            }
            .require_fields_back()
            return true
        }
        if ret == .unit {
            .fail_node(value)
            .say_name(.name_of(.sigs.get(.cur_sig).decl))
            .say(" has no return type, so `return` takes no value")
            return false
        }
        discard .expr(value, ret, 0)
        if .failed {
            return false
        }
        if .is_aggregate(ret) {
            mut owned_local: bool = false
            if .kind_is(value, "Name") {
                row: u64 = .lookup(.nodes.get(value).text)
                if row != 0 {
                    local: LocalInfo = .locals.get(row - 1)
                    owned_local = local.kind == CHK_LOCAL_REGION or local.owned
                }
            }
            if not owned_local {
                .require_fresh(value, .text_of("the result"))
                if .failed {
                    return false
                }
            }
        }
        .require_fields_back()
        return true
    }

    pub fn text_of(words: Bytes) -> Text {
        mut out: Text = .empty()
        out.append(words)
        return out
    }

    mut fn for_range(s: u64) -> bool {
        node: Node = .nodes.get(s)
        // text: LABEL VAR
        label: Text = .first_word(node.text)
        var_name: Text = .last_word(node.text)
        .require_snake(label, "loop label", s)
        .require_snake(var_name, "loop variable", s)
        if .failed {
            return false
        }
        ty: u64 = .resolve_type(.kid(s, 0))
        if .failed {
            return false
        }
        if not .is_int(ty) {
            .fail_node(.kid(s, 1))
            .say("a range needs integers, found ")
            .say_type(ty)
            return false
        }
        discard .expr(.kid(s, 1), ty, 0)
        discard .expr(.kid(s, 2), ty, 0)
        if .failed {
            return false
        }
        .set_note(s, CHK_NOTE_TYPE, ty)
        .enter_scope()
        end_slot: u64 = .new_local(.text_of(" end"), ty, false, CHK_LOCAL_VALUE, 0, false, false)
        .set_note(s, CHK_NOTE_END_SLOT, end_slot)
        slot: u64 = .new_local(var_name, ty, false, CHK_LOCAL_VALUE, s, false, false)
        if .failed {
            return false
        }
        .set_note(s, CHK_NOTE_SLOT, slot)
        .loops.push(copy(label))
        .enter_loop()
        discard .block(.kid(s, 3))
        if .failed {
            return false
        }
        .leave_loop(.kid(s, 3))
        discard .loops.pop()
        .leave_scope()
        return false
    }

    pub fn first_word(t: Text) -> Text {
        mut out: Text = .empty()
        scanning: loop k: u64 in 0..t.len() {
            if t.at(k) == ' ' {
                return out
            }
            out.push(t.at(k))
        }
        return out
    }

    // ---- assignment, places and fresh values ---------------------------------------------------------

    /// `a op= b` becomes `a = a op b`: a copy of the checked target (with what was recorded on it).
    mut fn copy_checked(n: u64) -> u64 {
        if n == 0 {
            return 0
        }
        node: Node = .nodes.get(n)
        mut kids: List<u64> = List(region: .region)
        copying: loop k: u64 in 0..(node.kids.len()) {
            kids.push(.copy_checked(node.kids.get(k)))
        }
        .nodes.push(Node(kind: copy(node.kind), text: copy(node.text), line: node.line, col: node.col,
                         parens: node.parens, kids: copy(kids), file: node.file, visible_in: node.visible_in,
                         generic_base: copy(node.generic_base)))
        made: u64 = .nodes.len() - 1
        keys: loop key: u64 in 0..CHK_NOTE_STRIDE - 1 {
            if .note_has(n, key) {
                .set_note(made, key, .note_get(n, key))
            }
        }
        return made
    }

    mut fn assign(s: u64) -> bool {
        node: Node = .nodes.get(s)
        target: u64 = .kid(s, 0)
        if .in_new and .kind_is(target, "Access") and .kid(target, 0) == 0 {
            return .assign_in_new(s)
        }
        if .kind_is(target, "Name") and .lookup(.nodes.get(target).text) == 0 {
            .fail_node(target)
            if .const_names.contains(.nodes.get(target).text) {
                .say("can't assign to constant ")
            } else {
                .say("unknown variable ")
            }
            .say_name(.nodes.get(target).text)
            return false
        }
        // Assigning to a consumed place gives it a value again, so it is not a use.
        key: u64 = .moved_key(target)
        was: u64 = if key != 0 { .state_find(.moved, key) } else { 0 }
        mut was_at: u64 = 0
        if was != 0 {
            was_at = .moved.get(2 * (was - 1) + 1)
            .moved = .state_without(.moved, key)
        }
        target_ty: u64 = .expr(target, 0, 0)
        if .failed {
            return false
        }
        if was != 0 {
            .moved = .state_with(.moved, key, was_at)
        }
        .require_mutable(target, s, .text_of("assign to"))
        if .failed {
            return false
        }
        if not node.text.same_as("=") {
            if not .is_int(target_ty) {
                .fail_node(s)
                .say_name(node.text)
                .say(" needs an integer, found ")
                .say_type(target_ty)
                return false
            }
            // `a += b` is `a = a + b`
            mut op: Text = .empty()
            ops: loop k: u64 in 0..(node.text.len() - 1) {
                op.push(node.text.at(k))
            }
            copied: u64 = .copy_checked(target)
            .nodes.push(Node(kind: .text_of("Binary"), text: copy(op), line: node.line, col: node.col, parens: false,
                             kids: .pair(copied, .kid(s, 1)), file: node.file, visible_in: 0,
                             generic_base: .empty()))
            combined: u64 = .nodes.len() - 1
            rewritten: Node = .nodes.get(s)
            mut kids: List<u64> = copy(rewritten.kids)
            kids.set(1, combined)
            .nodes.set(s, Node(kind: copy(rewritten.kind), text: .text_of("="), line: rewritten.line,
                               col: rewritten.col, parens: rewritten.parens, kids: copy(kids),
                               file: rewritten.file, visible_in: rewritten.visible_in,
                               generic_base: copy(rewritten.generic_base)))
        }
        discard .expr(.kid(s, 1), target_ty, 0)
        if .failed {
            return false
        }
        if .is_aggregate(target_ty) {
            .require_fresh(.kid(s, 1), .describe_place(target))
            if .failed {
                return false
            }
        }
        if key != 0 {
            .moved = .state_without(.moved, key)
        }
        return false
    }

    fn pair(a: u64, b: u64) -> List<u64> {
        mut out: List<u64> = List(region: .region)
        out.push(a)
        out.push(b)
        return out
    }

    /// `.field = value` in a `new`: every field is set once, at the top level of the body, so none is left
    /// unset or read before it is set.
    mut fn assign_in_new(s: u64) -> bool {
        owner: u64 = .recv
        target: u64 = .kid(s, 0)
        name: Text = copy(.nodes.get(target).text)
        fty: u64 = .field_type(owner, name)
        if fty == 0 {
            .fail_node(target)
            .say_name(.types.get(owner).name)
            .say(" has no field ")
            .say_name(name)
            return false
        }
        if not .nodes.get(s).text.same_as("=") {
            .fail_node(s)
            .say("`new` sets each field once, with `=`")
            return false
        }
        if .assigned.contains(name) {
            .fail_node(s)
            .say("`.")
            .say_text(name)
            .say("` is already set: `new` sets each field once")
            return false
        }
        if .scope_marks.len() != 2 {
            .fail_node(s)
            .say("`new` sets each field at the top level of its body, not inside an `if`, a loop or a `match`")
            return false
        }
        .set_note(target, CHK_NOTE_STRUCT, owner)
        .set_note(target, CHK_NOTE_TYPE, fty)
        discard .expr(.kid(s, 1), fty, 0)
        if .failed {
            return false
        }
        if .types.get(owner).kind == CHK_ACTOR and .field_flag(owner, name, CHK_FIELD_ISO) {
            .require_fresh(.kid(s, 1), .quote_text(.dotted(name)))
        }
        .assigned.put(name, 1)
        return false
    }

    fn dotted(name: Text) -> Text {
        mut out: Text = .empty()
        out.push('.')
        out.append_text(name)
        return out
    }

    fn field_flag(owner: u64, name: Text, flag: u64) -> bool {
        rows: List<u64> = .fields_of(owner, false)
        scanning: loop j: u64 in 0..(rows.len()) {
            f: FieldInfo = .fields.get(rows.get(j))
            if f.name.equals(name) {
                return (f.flags and flag) != 0
            }
        }
        return false
    }

    /// Is `e` a new struct or enum value that nothing else holds?
    fn is_fresh(e: u64) -> bool {
        node: Node = .nodes.get(e)
        if node.kind.same_as("StructLit") or node.kind.same_as("Call") or node.kind.same_as("MethodCall") or
           node.kind.same_as("Copy") or node.kind.same_as("Consume") or node.kind.same_as("Str") {
            return true
        }
        if node.kind.same_as("Name") {
            return .note_has(e, CHK_NOTE_VARIANT) or .note_has(e, CHK_NOTE_CONST_STR)
        }
        if node.kind.same_as("IfExpr") {
            return .is_fresh(.kid(e, 1)) and .is_fresh(.kid(e, 2))
        }
        if node.kind.same_as("MatchExpr") {
            arms: Node = .nodes.get(.kid(e, 1))
            scanning: loop k: u64 in 0..(arms.kids.len()) {
                body: u64 = .kid(arms.kids.get(k), 1)
                if not (.kind_is(body, "Return") or .kind_is(body, "Break") or .kind_is(body, "Continue")) {
                    if not .is_fresh(body) {
                        return false
                    }
                }
            }
            return true
        }
        return false
    }

    /// Could `consume(e)` be written? An owned variable, or a `mut iso` field.
    fn movable(e: u64) -> bool {
        if .kind_is(e, "Name") {
            row: u64 = .lookup(.nodes.get(e).text)
            if row == 0 {
                return false
            }
            local: LocalInfo = .locals.get(row - 1)
            return .is_aggregate(local.ty) and (local.kind == CHK_LOCAL_REGION or local.owned)
        }
        if .kind_is(e, "Access") and .kid(e, 0) == 0 and .recv != 0 and .types.get(.recv).kind == CHK_ACTOR {
            name: Text = copy(.nodes.get(e).text)
            return .field_flag(.recv, name, CHK_FIELD_ISO) and .field_flag(.recv, name, CHK_FIELD_MUT)
        }
        return false
    }

    /// The source text of a place: `p`, `p.a.b`, `.x`, `.`; "value" for anything else.
    fn source_text(e: u64) -> Text {
        mut out: Text = .empty()
        if .kind_is(e, "Name") {
            out.append_text(.nodes.get(e).text)
        } else if .kind_is(e, "Access") {
            if .kid(e, 0) != 0 {
                out.append_text(.source_text(.kid(e, 0)))
            }
            out.push('.')
            out.append_text(.nodes.get(e).text)
        } else if .kind_is(e, "SelfValue") {
            out.push('.')
        } else {
            out.append("value")
        }
        return out
    }

    fn is_place(e: u64) -> bool {
        return .kind_is(e, "Name") or .kind_is(e, "Access") or .kind_is(e, "SelfValue")
    }

    /// The text `describe_place` gives: the place in backticks, else "this value".
    fn describe_place(e: u64) -> Text {
        if not .is_place(e) {
            return .text_of("this value")
        }
        return .quote_text(.source_text(e))
    }

    /// A struct value can be stored only if nothing else holds it.
    mut fn require_fresh(e: u64, what: Text) {
        if .is_fresh(e) {
            return
        }
        place: Text = .describe_place(e)
        .fail_node(e)
        .say_text(what)
        .say(" would be a copy of ")
        .say_text(place)
        .say("; write `copy(")
        .say_text(.source_text(e))
        .say(")` to copy it")
        if .movable(e) {
            .say(", or `consume(")
            .say_text(.source_text(e))
            .say(")` to give it away")
        }
    }

    mut fn require_mutable(place: u64, at: u64, action: Text) {
        node: Node = .nodes.get(place)
        root: Text = .root_name(place)
        if root.len() > 0 {
            .require_unlocked(root, action, .source_text(place), at)
            if .failed {
                return
            }
        }
        if node.kind.same_as("SelfValue") {
            if not .recv_mut {
                .fail_node(at)
                .say("can't ")
                .say_text(action)
                .say(" `.`: only a `mut fn` can change its own value")
            }
            return
        }
        if node.kind.same_as("Name") {
            row: u64 = .lookup(node.text)
            if row == 0 {
                .fail_node(at)
                .say("can't ")
                .say_text(action)
                .say(" ")
                .say_name(node.text)
                return
            }
            local: LocalInfo = .locals.get(row - 1)
            if not local.mutable {
                .fail_node(at)
                .say("can't ")
                .say_text(action)
                .say(" ")
                .say_name(node.text)
                if local.is_val {
                    .say(": it is `val`, read-only data")
                } else if local.owned {
                    .say(": an `iso` parameter is read-only; copy it into a `mut` variable to change it")
                } else if local.kind == CHK_LOCAL_REF {
                    .say(": it is lent read-only; take it as `mut ")
                    .say_type(local.ty)
                    .say("` to change it")
                } else {
                    .say(": declare it with `mut` to make it mutable")
                }
            }
            return
        }
        if node.kind.same_as("Access") {
            if node.kids.get(0) == 0 {
                if .types.get(.recv).kind == CHK_ACTOR {
                    if not .field_flag(.recv, node.text, CHK_FIELD_MUT) {
                        .fail_node(at)
                        .say("can't ")
                        .say_text(action)
                        .say(" `.")
                        .say_text(node.text)
                        .say("`: ")
                        if .field_flag(.recv, node.text, CHK_FIELD_VAL) {
                            .say("it is `val`, read-only data")
                        } else {
                            .say("the field isn't `mut`")
                        }
                    }
                    return
                }
                if not .recv_mut {
                    .fail_node(at)
                    .say("can't ")
                    .say_text(action)
                    .say(" `.")
                    .say_text(node.text)
                    .say("`: only a `mut fn` can change its struct")
                }
                return
            }
            .require_mutable(node.kids.get(0), at, action)
            return
        }
        .fail_node(at)
        .say("can only ")
        .say_text(action)
        .say(" a variable or a field")
    }

    // ---- calls, struct values, fields and methods -------------------------------------------------

    /// `given` (names) must name every field once, in declared order (every parameter of the struct's
    /// `new`, if `of_new`). `wanted` and `given` are lists of names; `at` the node of the whole value, and
    /// `given_at` the nodes of the given names.
    mut fn named_fields(owner: Text, wanted: List<Text>, given: List<Text>, given_at: List<u64>, at: u64, of_new: bool) {
        checking: loop k: u64 in 0..(given.len()) {
            mut found: bool = false
            inner: loop j: u64 in 0..(wanted.len()) {
                if wanted.get(j).equals(given.get(k)) {
                    found = true
                }
            }
            if not found {
                .fail_node(given_at.get(k))
                if of_new {
                    .say("`new` of ")
                    .say_name(owner)
                    .say(" has no parameter ")
                } else {
                    .say_name(owner)
                    .say(" has no field ")
                }
                .say_name(given.get(k))
                return
            }
        }
        mut same: bool = given.len() == wanted.len()
        if same {
            comparing: loop k: u64 in 0..(given.len()) {
                if not given.get(k).equals(wanted.get(k)) {
                    same = false
                }
            }
        }
        if same {
            return
        }
        missing: loop j: u64 in 0..(wanted.len()) {
            mut present: bool = false
            seen: loop k: u64 in 0..(given.len()) {
                if given.get(k).equals(wanted.get(j)) {
                    present = true
                }
            }
            if not present {
                .fail_node(at)
                .say("`")
                .say_text(owner)
                .say("(...)` is missing ")
                .say_name(wanted.get(j))
                return
            }
        }
        .fail_node(at)
        .say("write the ")
        .say(if of_new { "parameter" } else { "field" })
        .say("s of ")
        .say(if of_new { "`new` of " } else { "" })
        .say_name(owner)
        .say(" once each, in the order they are declared: ")
        listing: loop j: u64 in 0..(wanted.len()) {
            if j > 0 {
                .say(", ")
            }
            .say_text(wanted.get(j))
        }
    }

    /// The names of the fields of a struct, enum variant or actor, in order.
    fn field_names(owner: u64, in_variant: bool) -> List<Text> {
        rows: List<u64> = .fields_of(owner, in_variant)
        mut out: List<Text> = List(region: .region)
        scanning: loop j: u64 in 0..(rows.len()) {
            out.push(copy(.fields.get(rows.get(j)).name))
        }
        return out
    }

    /// Checks the arguments `args` (nodes) against the parameters of the signature `sig`.
    mut fn check_args(callee: Text, sig: u64, args: List<u64>, at: u64, receiver: u64, implicit_self: bool, receiver_mut: bool) {
        rows: List<u64> = .params_of(sig)
        if args.len() != rows.len() {
            .fail_node(at)
            .say_text(callee)
            .say(" takes ")
            .say_number(rows.len())
            .say(" argument(s), but ")
            .say_number(args.len())
            .say(" given")
            return
        }
        handler: bool = .sigs.get(sig).handler.len() > 0
        // the structs lent by reference in this call: variable, lent as `mut`, node
        mut lent_roots: List<Text> = List(region: .region)
        mut lent_mut: List<bool> = List(region: .region)
        mut lent_at: List<u64> = List(region: .region)
        if implicit_self {
            lent_roots.push(.text_of("self"))
            lent_mut.push(receiver_mut)
            lent_at.push(at)
        } else if receiver != 0 and .root_name(receiver).len() > 0 {
            lent_roots.push(.root_name(receiver))
            lent_mut.push(receiver_mut)
            lent_at.push(receiver)
        }
        checking: loop k: u64 in 0..(args.len()) {
            arg: u64 = args.get(k)
            p: ParamInfo = .params.get(rows.get(k))
            takes: bool = p.modifier == 3
            if p.modifier == 2 and handler {
                discard .expr(arg, p.ty, 0)
                if .failed {
                    return
                }
                if not .is_val_source(arg) {
                    .fail_node(arg)
                    .say_text(callee)
                    .say(" takes read-only data: pass a `val` field, a `val` parameter or text in quotes (a value from `freeze` arrives in step 4c)")
                    return
                }
                continue checking
            }
            if .kind_is(arg, "Consume") and not takes {
                .fail_node(arg)
                .say_text(callee)
                .say(" only borrows this argument, so there is nothing to give away: pass it as it is")
                return
            }
            if takes {
                discard .expr(arg, p.ty, 0)
                if .failed {
                    return
                }
                mut what: Text = .text_of("giving it to ")
                what.append_text(callee)
                .require_fresh(arg, what)
                if .failed {
                    return
                }
                continue checking
            }
            if p.is_mut {
                if not .kind_is(arg, "MutArg") {
                    .fail_node(arg)
                    .say_text(callee)
                    .say(" can change this argument, so write `mut` before it")
                    return
                }
                discard .expr(.kid(arg, 0), p.ty, 0)
                if .failed {
                    return
                }
                .set_note(arg, CHK_NOTE_TYPE, p.ty)
                .require_mutable(.kid(arg, 0), arg, .text_of("lend as `mut`"))
                if .failed {
                    return
                }
                lent_roots.push(.root_name(.kid(arg, 0)))
                lent_mut.push(true)
                lent_at.push(arg)
            } else {
                if .kind_is(arg, "MutArg") {
                    .fail_node(arg)
                    .say_text(callee)
                    .say(" doesn't change this argument, so it isn't marked `mut`")
                    return
                }
                discard .expr(arg, p.ty, 0)
                if .failed {
                    return
                }
                if .is_aggregate(p.ty) and .root_name(arg).len() > 0 {
                    lent_roots.push(.root_name(arg))
                    lent_mut.push(false)
                    lent_at.push(arg)
                }
            }
        }
        // A value lent as `mut` can't be lent again in the same call. Numbers are copied when passed,
        // so they can't alias.
        pairs: loop i: u64 in 0..(lent_roots.len()) {
            earlier: loop j: u64 in 0..i {
                if lent_roots.get(i).equals(lent_roots.get(j)) and (lent_mut.get(i) or lent_mut.get(j)) {
                    .fail_node(lent_at.get(i))
                    .say_name(lent_roots.get(i))
                    .say(" is lent as `mut` in this call, so it can't be lent again here")
                    return
                }
            }
        }
    }

    /// Is `e` read-only data that a `val` parameter may be given: text in quotes, a `val` parameter, or a
    /// `val` field of the actor?
    fn is_val_source(e: u64) -> bool {
        if .kind_is(e, "Str") {
            return true
        }
        if .kind_is(e, "Name") {
            if .note_has(e, CHK_NOTE_CONST_STR) {
                return true
            }
            row: u64 = .lookup(.nodes.get(e).text)
            return row != 0 and .locals.get(row - 1).is_val
        }
        if .kind_is(e, "Access") and .kid(e, 0) == 0 and .recv != 0 and .types.get(.recv).kind == CHK_ACTOR {
            return .field_flag(.recv, .nodes.get(e).text, CHK_FIELD_VAL)
        }
        return false
    }

    /// The nodes after the first `from` kids of `n`.
    pub fn kids_from(n: u64, from: u64) -> List<u64> {
        mut out: List<u64> = List(region: .region)
        all: List<u64> = copy(.nodes.get(n).kids)
        scanning: loop k: u64 in from..(all.len()) {
            out.push(all.get(k))
        }
        return out
    }

    mut fn infer_call_in_fn(e: u64, expected: u64) -> u64 {
        callee: Text = copy(.nodes.get(e).text)
        if .builtins.contains(callee) {
            return .builtin(e, expected)
        }
        sig: u64 = .fn_sig(callee)
        if sig == 0 {
            .fail_node(e)
            if .lookup(callee) != 0 {
                .say_name(callee)
                .say(" is a variable, not a function")
            } else {
                .say("unknown function ")
                .say_name(callee)
            }
            return 0
        }
        .require_visible(.sigs.get(sig).decl, callee, e, 0)
        if .failed {
            return 0
        }
        .check_args(.quote_text(callee), sig, copy(.nodes.get(e).kids), e, 0, false, false)
        if .failed {
            return 0
        }
        ret: u64 = .sigs.get(sig).ret
        if .is_aggregate(ret) {
            .set_note(e, CHK_NOTE_TEMP, .alloc(.words_of_type(ret)))
        }
        return ret
    }

    // ---- built-ins ---------------------------------------------------------------------------------

    mut fn builtin(e: u64, expected: u64) -> u64 {
        name: Text = copy(.nodes.get(e).text)
        args: List<u64> = copy(.nodes.get(e).kids)
        checking: loop k: u64 in 0..(args.len()) {
            if .kind_is(args.get(k), "MutArg") {
                .fail_node(args.get(k))
                .say_name(name)
                .say(" doesn't change its arguments, so they aren't marked `mut`")
                return 0
            }
        }
        if name.same_as("panic") {
            if args.len() != 1 {
                .fail_node(e)
                .say("`panic` takes one argument: a message")
                return 0
            }
            bytes: u64 = .bytes_type(e)
            if .failed {
                return 0
            }
            discard .expr(args.get(0), bytes, 0)
            return .unit
        }
        if name.same_as("watch") {
            return .watch_call(e)
        }
        if name.same_as("stop") {
            return .stop_call(e)
        }
        if .unsafe_depth == 0 {
            .fail_node(e)
            .say_name(name)
            .say(" touches memory the compiler can't check, so it is only allowed ")
            if .trusted_file(.file) {
                .say("inside `unsafe { }`")
            } else {
                .say("in files under a trusted directory, inside `unsafe { }`")
            }
            return 0
        }
        if name.same_as("words_of") {
            if args.len() != 1 or not (.kind_is(args.get(0), "Name") or .kind_is(args.get(0), "Access")) {
                .fail_node(e)
                .say("`words_of` takes one argument: a variable or a field, only for its type")
                return 0
            }
            ty: u64 = .expr(args.get(0), 0, 0)
            if .failed {
                return 0
            }
            .set_note(e, CHK_NOTE_WORDS, .words_of_type(ty))
            return .u64_type
        }
        if name.same_as("store_element") {
            if args.len() != 3 {
                .fail_node(e)
                .say("`store_element` takes three arguments: an address, an index and the value")
                return 0
            }
            discard .expr(args.get(0), .u64_type, 0)
            discard .expr(args.get(1), .u64_type, 0)
            ty: u64 = .expr(args.get(2), 0, 0)
            if .failed {
                return 0
            }
            .set_note(e, CHK_NOTE_WORDS, .words_of_type(ty))
            return .unit
        }
        if name.same_as("load_element") {
            if args.len() != 2 {
                .fail_node(e)
                .say("`load_element` takes two arguments: an address and an index")
                return 0
            }
            if expected == 0 {
                .fail_node(e)
                .say("`load_element` loads whatever type the place it goes to has: write `x: Type = load_element(...)`")
                return 0
            }
            discard .expr(args.get(0), .u64_type, 0)
            discard .expr(args.get(1), .u64_type, 0)
            if .failed {
                return 0
            }
            .set_note(e, CHK_NOTE_WORDS, .words_of_type(expected))
            if .is_aggregate(expected) {
                .set_note(e, CHK_NOTE_TEMP, .alloc(.words_of_type(expected)))
            }
            return expected
        }
        if name.same_as("actor_address") {
            if args.len() != 1 {
                .fail_node(e)
                .say("`actor_address` takes one argument: a reference")
                return 0
            }
            ty: u64 = .expr(args.get(0), 0, 0)
            if .failed {
                return 0
            }
            if not .is_actor(ty) {
                .fail_node(args.get(0))
                .say("`actor_address` takes an actor or interface reference, not ")
                .say_type(ty)
                return 0
            }
            return .u64_type
        }
        if name.same_as("handler_number") {
            if args.len() != 1 or not .kind_is(args.get(0), "Str") {
                .fail_node(e)
                .say("`handler_number` takes one argument: a handler's name in quotes")
                return 0
            }
            handler: Text = .decoded(args.get(0))
            match .handler_numbers.find(handler) {
                Some(value: number) => .set_note(e, CHK_NOTE_NUMBER, number)
                None => {
                    .fail_node(args.get(0))
                    .say("no actor or interface has a handler ")
                    .say_name(handler)
                    return 0
                }
            }
            bytes: u64 = .bytes_type(e)
            if .failed {
                return 0
            }
            .set_note(args.get(0), CHK_NOTE_TYPE, bytes)
            return .u64_type
        }
        // load8..load64 take an address; store8..store64 an address and a value
        width: Text = .last_digits(name)
        ty: u64 = .named_int(if width.same_as("8") { "u8" } else if width.same_as("16") { "u16" } else if width.same_as("32") { "u32" } else { "u64" })
        if name.at(0) == 'l' {
            if args.len() != 1 {
                .fail_node(e)
                .say_name(name)
                .say(" takes one argument: an address")
                return 0
            }
            discard .expr(args.get(0), .u64_type, 0)
            return ty
        }
        if args.len() != 2 {
            .fail_node(e)
            .say_name(name)
            .say(" takes two arguments: an address and a value")
            return 0
        }
        discard .expr(args.get(0), .u64_type, 0)
        discard .expr(args.get(1), ty, 0)
        return .unit
    }

    fn last_digits(t: Text) -> Text {
        mut out: Text = .empty()
        scanning: loop k: u64 in 0..t.len() {
            if t.at(k) >= '0' and t.at(k) <= '9' {
                out.push(t.at(k))
            }
        }
        return out
    }

    /// The bytes of a `Str` node (`x` and hex) as text.
    pub fn decoded(n: u64) -> Text {
        hex: Text = copy(.nodes.get(n).text)
        mut out: Text = .empty()
        pairs: loop k: u64 in 0..((hex.len() - 1) / 2) {
            out.push(.hex_value(hex.at(1 + 2 * k)) * 16 + .hex_value(hex.at(2 + 2 * k)))
        }
        return out
    }

    pub fn hex_value(b: u8) -> u8 {
        if b >= 'a' {
            return b - 'a' + 10
        }
        return b - '0'
    }

    // ---- fields, methods, messages -------------------------------------------------------------

    /// The struct type that `e.field` or `e.method()` acts on (0 after an error).
    mut fn struct_of(e: u64) -> u64 {
        what: Text = copy(.nodes.get(e).text)
        if .kid(e, 0) == 0 {
            if .recv == 0 {
                .fail_node(e)
                .say("`.")
                .say_text(what)
                .say("` only works inside a struct's methods")
                return 0
            }
            return .recv
        }
        ty: u64 = .expr(.kid(e, 0), 0, 0)
        if .failed {
            return 0
        }
        if .is_actor(ty) {
            return ty
        }
        if not .is_aggregate(ty) {
            .fail_node(e)
            .say_type(ty)
            .say(" has no field or method ")
            .say_name(what)
            return 0
        }
        return ty
    }

    fn decl_file_of(ty: u64) -> u64 {
        return .file_of(.types.get(ty).decl)
    }

    fn has_method(owner: u64, name: Text) -> bool {
        return .methods.contains(.method_key(owner, name))
    }

    fn method_sig(owner: u64, name: Text) -> u64 {
        match .methods.find(.method_key(owner, name)) {
            Some(value: row) => return row
            None => return 0
        }
    }

    mut fn infer_access(e: u64) -> u64 {
        st: u64 = .struct_of(e)
        if .failed {
            return 0
        }
        name: Text = copy(.nodes.get(e).text)
        kind: u64 = .types.get(st).kind
        if kind == CHK_ACTOR or kind == CHK_INTERFACE {
            if .kid(e, 0) != 0 {
                .fail_node(e)
                .say("an actor's fields are private: send ")
                .say_name(.types.get(st).name)
                .say(" a message instead")
                return 0
            }
            fty: u64 = .field_type(st, name)
            if fty == 0 {
                .fail_node(e)
                .say_name(.types.get(st).name)
                .say(" has no field ")
                .say_name(name)
                return 0
            }
            if .in_new and not .assigned.contains(name) {
                .fail_node(e)
                .say("`.")
                .say_text(name)
                .say("` is read before `new` sets it")
                return 0
            }
            .require_not_consumed(.field_key(name), .dotted(name), e)
            if .failed {
                return 0
            }
            .set_note(e, CHK_NOTE_STRUCT, st)
            return fty
        }
        if kind == CHK_ENUM {
            .fail_node(e)
            .say_name(.types.get(st).name)
            .say(" is an enum: read its fields with `match`")
            return 0
        }
        .set_note(e, CHK_NOTE_STRUCT, st)
        fty: u64 = .field_type(st, name)
        if fty == 0 {
            .fail_node(e)
            .say_name(.types.get(st).name)
            .say(" has no field ")
            .say_name(name)
            if .has_method(st, name) {
                .say(" (it's a method: call it with `(...)`)")
            }
            return 0
        }
        if .in_new and .kid(e, 0) == 0 and not .assigned.contains(name) {
            .fail_node(e)
            .say("`.")
            .say_text(name)
            .say("` is read before `new` sets it")
            return 0
        }
        if .decl_file_of(st) != .file {
            rows: List<u64> = .fields_of(st, false)
            mut public: bool = false
            scanning: loop j: u64 in 0..(rows.len()) {
                f: FieldInfo = .fields.get(rows.get(j))
                if f.name.equals(name) and f.public {
                    public = true
                }
            }
            if not public {
                .fail_node(e)
                .say_name(name)
                .say(" is private to ")
                .say_text(.basename(.files.get(.decl_file_of(st) - 1).path))
                .say("; mark the field `pub` to use it in another file")
                return 0
            }
        }
        return fty
    }

    mut fn infer_method_call(e: u64) -> u64 {
        st: u64 = .struct_of(e)
        if .failed {
            return 0
        }
        name: Text = copy(.nodes.get(e).text)
        if .is_actor(st) {
            return .send(e, st)
        }
        sig: u64 = .method_sig(st, name)
        if sig == 0 {
            .fail_node(e)
            .say_name(.types.get(st).name)
            .say(" has no method ")
            .say_name(name)
            return 0
        }
        if .in_new and .kid(e, 0) == 0 and .assigned.len() < .fields_of(.recv, false).len() {
            .fail_node(e)
            .say("`new` can't call a method on its own struct until every field is set")
            return 0
        }
        if .decl_file_of(st) != .file and not .is_public(.sigs.get(sig).decl) {
            .fail_node(e)
            .say_name(name)
            .say(" is private to ")
            .say_text(.basename(.files.get(.decl_file_of(st) - 1).path))
            .say("; mark the method `pub` to use it in another file")
            return 0
        }
        if .sigs.get(sig).mutating {
            if .kid(e, 0) == 0 {
                if not .recv_mut {
                    .fail_node(e)
                    .say("`.")
                    .say_text(name)
                    .say("()` changes its value, so it can only be called from a `mut fn`")
                    return 0
                }
                mut action: Text = .text_of("call `mut fn ")
                action.append_text(name)
                action.append("` on")
                .require_unlocked(.text_of("self"), action, .text_of("."), e)
                if .failed {
                    return 0
                }
            } else {
                mut action: Text = .text_of("call `mut fn ")
                action.append_text(name)
                action.append("` on")
                .require_mutable(.kid(e, 0), e, action)
                if .failed {
                    return 0
                }
            }
        }
        .set_note(e, CHK_NOTE_SIG, sig)
        mut callee: Text = copy(.types.get(st).name)
        callee.push('.')
        callee.append_text(name)
        .check_args(.quote_text(callee), sig, .kids_from(e, 1), e, .kid(e, 0), .kid(e, 0) == 0, .sigs.get(sig).mutating)
        if .failed {
            return 0
        }
        ret: u64 = .sigs.get(sig).ret
        if .is_aggregate(ret) {
            .set_note(e, CHK_NOTE_TEMP, .alloc(.words_of_type(ret)))
        }
        return ret
    }

    /// `ref.handler(args)`: a message to an actor. A send to a `lossy` handler returns nothing; a send to
    /// a `reliable` one returns Raven's `Sent`.
    mut fn send(e: u64, target: u64) -> u64 {
        name: Text = copy(.nodes.get(e).text)
        if .kid(e, 0) == 0 {
            .fail_node(e)
            .say("to send a message to yourself, write `self.")
            .say_text(name)
            .say("(...)`")
            return 0
        }
        sig: u64 = .method_sig(target, name)
        if sig == 0 {
            .fail_node(e)
            .say_name(.types.get(target).name)
            .say(" has no handler ")
            .say_name(name)
            return 0
        }
        if .decl_file_of(target) != .file and not .is_public(.sigs.get(sig).decl) {
            .fail_node(e)
            .say_name(name)
            .say(" is private to ")
            .say_text(.basename(.files.get(.decl_file_of(target) - 1).path))
            .say("; mark the handler `pub` to send it from another file")
            return 0
        }
        .set_note(e, CHK_NOTE_FLAGS, 2)
        .set_note(e, CHK_NOTE_HANDLER_INDEX, .sigs.get(sig).number)
        .set_note(e, CHK_NOTE_SIG, sig)
        mut callee: Text = copy(.types.get(target).name)
        callee.push('.')
        callee.append_text(name)
        .check_args(.quote_text(callee), sig, .kids_from(e, 1), e, 0, false, false)
        if .failed {
            return 0
        }
        rows: List<u64> = .params_of(sig)
        mut payload_words: u64 = 0
        summing: loop k: u64 in 0..(rows.len()) {
            payload_words += .words_of_type(.params.get(rows.get(k)).ty)
        }
        .set_note(e, CHK_NOTE_PAYLOAD_WORDS, payload_words)
        .set_note(e, CHK_NOTE_PAYLOAD, .alloc(if payload_words > 1 { payload_words } else { 1 }))
        if not .sigs.get(sig).handler.same_as("reliable") {
            return .unit
        }
        sent: u64 = .named_aggregate("Sent", CHK_ENUM)
        if sent == 0 {
            .fail_node(e)
            .say("a send to a `reliable` handler returns Raven's enum `Sent`, which this program doesn't declare")
            return 0
        }
        .set_note(e, CHK_NOTE_TEMP, .alloc(.words_of_type(sent)))
        return sent
    }

    fn named_aggregate(name: Bytes, kind: u64) -> u64 {
        match .type_names.find(.quoted(name)) {
            Some(value: id) => {
                if .types.get(id).kind == kind {
                    return id
                }
                return 0
            }
            None => return 0
        }
    }

    // ---- copy, consume, self, narrow, spawn, watch, stop -------------------------------------------

    mut fn infer_copy(e: u64) -> u64 {
        ty: u64 = .expr(.kid(e, 0), 0, 0)
        if .failed {
            return 0
        }
        if not .is_aggregate(ty) {
            if .recv != 0 and .is_aggregate(.recv) and .nodes.get(.types.get(.recv).decl).generic_base.len() > 0 {
                // In a generic type the same source serves a number and a struct, so copying a number is
                // allowed there and does nothing (decision 154).
                .set_note(e, CHK_NOTE_FLAGS, 1)
                return ty
            }
            .fail_node(.kid(e, 0))
            .say_type(ty)
            .say(" values are always copied; `copy(...)` is for structs and enums")
            return 0
        }
        .set_note(e, CHK_NOTE_TEMP, .alloc(.words_of_type(ty)))
        return ty
    }

    mut fn infer_consume(e: u64) -> u64 {
        if not .in_fn {
            return .constant_error(e, "constants can't consume")
        }
        place: u64 = .kid(e, 0)
        if .in_new {
            return .constant_error(e, "`new` gives every field its first value; there is nothing to consume yet")
        }
        pnode: Node = .nodes.get(place)
        if pnode.kind.same_as("Name") and .lookup(pnode.text) != 0 {
            local: LocalInfo = .locals.get(.lookup(pnode.text) - 1)
            if not .is_aggregate(local.ty) {
                .fail_node(place)
                .say_type(local.ty)
                .say(" values are always copied; `consume(...)` is for structs and enums")
                return 0
            }
            if local.kind != CHK_LOCAL_REGION and not local.owned {
                .fail_node(place)
                .say_name(pnode.text)
                .say(" is only lent to this function, so it isn't yours to consume; the parameter would have to be `iso`")
                return 0
            }
        } else if pnode.kind.same_as("Access") and pnode.kids.get(0) == 0 and .recv != 0 and
                  .types.get(.recv).kind == CHK_ACTOR {
            fty: u64 = .field_type(.recv, pnode.text)
            if fty == 0 {
                .fail_node(place)
                .say_name(.types.get(.recv).name)
                .say(" has no field ")
                .say_name(pnode.text)
                return 0
            }
            if .field_flag(.recv, pnode.text, CHK_FIELD_VAL) {
                .fail_node(place)
                .say("`.")
                .say_text(pnode.text)
                .say("` is `val`: read-only data is never consumed")
                return 0
            }
            if not .is_aggregate(fty) {
                .fail_node(place)
                .say_type(fty)
                .say(" values are always copied; `consume(...)` is for structs and enums")
                return 0
            }
            if not .field_flag(.recv, pnode.text, CHK_FIELD_MUT) {
                .fail_node(place)
                .say("can't consume `.")
                .say_text(pnode.text)
                .say("`: the field isn't `mut`")
                return 0
            }
        } else {
            return .constant_error(e, "`consume` gives away a whole variable or an actor's `mut iso` field, nothing else")
        }
        ty: u64 = .expr(place, 0, 0)
        if .failed {
            return 0
        }
        .require_unlocked(.root_name(place), .text_of("consume"), .source_text(place), e)
        if .failed {
            return 0
        }
        .moved = .state_with(.moved, .moved_key(place), e)
        return ty
    }

    mut fn infer_self_value(e: u64) -> u64 {
        if .recv == 0 {
            return .constant_error(e, "`.` on its own is a method's own value, so it only works inside methods")
        }
        if .types.get(.recv).kind == CHK_ACTOR {
            return .constant_error(e, "`.` on its own is a struct's own value: an actor refers to itself as `self`")
        }
        return .recv
    }

    mut fn infer_self_ref(e: u64) -> u64 {
        if .recv == 0 or .types.get(.recv).kind != CHK_ACTOR {
            return .constant_error(e, "`self` is the actor itself, so it only works inside an actor")
        }
        if .in_new and .assigned.len() < .fields_of(.recv, false).len() {
            return .constant_error(e, "`self` can't be used in `new` until every field is set")
        }
        return .recv
    }

    mut fn infer_narrow(e: u64) -> u64 {
        if not .in_fn {
            return .constant_error(e, "constants can't narrow references")
        }
        iface_node: u64 = .kid(e, 1)
        name: Text = copy(.nodes.get(iface_node).text)
        iface: u64 = .named_aggregate_text(name, CHK_INTERFACE)
        if iface == 0 {
            .fail_node(iface_node)
            match .type_names.find(name) {
                Some(value: id) => {
                    kind: u64 = .types.get(id).kind
                    if kind == CHK_ACTOR or kind == CHK_STRUCT or kind == CHK_ENUM {
                        .say_name(name)
                        .say(" is not an interface")
                        return 0
                    }
                }
                None => { }
            }
            .say("unknown interface ")
            .say_name(name)
            return 0
        }
        .require_visible(.types.get(iface).decl, name, iface_node, 0)
        if .failed {
            return 0
        }
        src: u64 = .expr(.kid(e, 0), 0, 0)
        if .failed {
            return 0
        }
        if not .is_actor(src) {
            .fail_node(.kid(e, 0))
            .say("`narrow` works on actor references, not ")
            .say_type(src)
            return 0
        }
        if .types.get(src).kind == CHK_INTERFACE {
            .fail_node(.kid(e, 0))
            .say("this is already a `")
            .say_type(src)
            .say("` reference: it can't be narrowed again")
            return 0
        }
        mut implemented: bool = false
        scanning: loop k: u64 in 0..(.impls.len()) {
            if .impls.get(k).actor_id == src and .impls.get(k).iface_id == iface {
                implemented = true
            }
        }
        if not implemented {
            .fail_node(.kid(e, 0))
            .say_name(.types.get(src).name)
            .say(" doesn't implement ")
            .say_name(.types.get(iface).name)
            .say(": declare it as `actor ")
            .say_type(src)
            .say(": ")
            .say_type(iface)
            .say("`")
            return 0
        }
        return iface
    }

    fn named_aggregate_text(name: Text, kind: u64) -> u64 {
        match .type_names.find(name) {
            Some(value: id) => {
                if .types.get(id).kind == kind {
                    return id
                }
                return 0
            }
            None => return 0
        }
    }

    mut fn infer_spawn(e: u64) -> u64 {
        if not .in_fn {
            return .constant_error(e, "constants can't spawn actors")
        }
        name: Text = copy(.nodes.get(e).text)
        act: u64 = .named_aggregate_text(name, CHK_ACTOR)
        if act == 0 {
            .fail_node(e)
            if .named_aggregate_text(name, CHK_INTERFACE) != 0 {
                .say_name(name)
                .say(" is an interface: `spawn` creates actors that implement it")
            } else if .named_aggregate_text(name, CHK_STRUCT) != 0 or .named_aggregate_text(name, CHK_ENUM) != 0 {
                .say_name(name)
                .say(" is not an actor: `spawn` creates actors")
            } else {
                .say("unknown actor ")
                .say_name(name)
            }
            return 0
        }
        .require_visible(.types.get(act).decl, name, e, 0)
        if .failed {
            return 0
        }
        sig: u64 = .types.get(act).new_sig
        mut rows: List<u64> = List(region: .region)
        if sig != 0 {
            rows = .params_of(sig)
            .check_args(.quote_text(.spawn_callee(name)), sig, copy(.nodes.get(e).kids), e, 0, false, false)
        } else if .nodes.get(e).kids.len() != 0 {
            .fail_node(e)
            .say_text(.spawn_callee(name))
            .say(" takes 0 argument(s), but ")
            .say_number(.nodes.get(e).kids.len())
            .say(" given")
        }
        if .failed {
            return 0
        }
        mut words: u64 = 0
        summing: loop k: u64 in 0..(rows.len()) {
            words += .words_of_type(.params.get(rows.get(k)).ty)
        }
        .set_note(e, CHK_NOTE_ARGS_WORDS, words)
        .set_note(e, CHK_NOTE_ARGS_SLOT, .alloc(if words > 1 { words } else { 1 }))
        return act
    }

    fn spawn_callee(name: Text) -> Text {
        mut out: Text = .text_of("spawn ")
        out.append_text(name)
        return out
    }

    /// `watch(actor, narrow(self, Restarts))`: when `actor` restarts, Raven sends the interface's
    /// `restarted()` (decision 149).
    mut fn watch_call(e: u64) -> u64 {
        args: List<u64> = copy(.nodes.get(e).kids)
        if args.len() != 2 {
            .fail_node(e)
            .say("write `watch(actor, narrow(self, Restarts))`: the actor to watch, and who to tell")
            return 0
        }
        target: u64 = .expr(args.get(0), 0, 0)
        if .failed {
            return 0
        }
        if not .is_actor(target) {
            .fail_node(args.get(0))
            .say("`watch` takes an actor reference to watch, not ")
            .say_type(target)
            return 0
        }
        who: u64 = .expr(args.get(1), 0, 0)
        if .failed {
            return 0
        }
        if not .is_actor(who) or .types.get(who).kind != CHK_INTERFACE {
            .fail_node(args.get(1))
            .say("`watch` tells an interface reference: write `narrow(self, Restarts)`")
            return 0
        }
        sig: u64 = .method_sig(who, .text_of("restarted"))
        if sig == 0 {
            .fail_node(args.get(1))
            .say_name(.types.get(who).name)
            .say(" has no handler `restarted`, so it can't be told when an actor restarts")
            return 0
        }
        if not .sigs.get(sig).handler.same_as("lossy") or .params_of(sig).len() > 0 {
            .fail_node(args.get(1))
            .say("`restarted` must be `lossy on restarted()`, with no arguments: one already waiting stands for a second restart")
            return 0
        }
        .set_note(e, CHK_NOTE_NUMBER, .handler_number_of("restarted"))
        mut stopped: u64 = 0
        ends: u64 = .method_sig(who, .text_of("stopped"))
        if ends != 0 {
            if not .sigs.get(ends).handler.same_as("lossy") or .params_of(ends).len() > 0 {
                .fail_node(args.get(1))
                .say("`stopped` must be `lossy on stopped()`, with no arguments: one already waiting stands for a second notice")
                return 0
            }
            stopped = .handler_number_of("stopped") + 1
        }
        .set_note(e, CHK_NOTE_STOPPED, stopped)
        return .unit
    }

    fn handler_number_of(name: Bytes) -> u64 {
        match .handler_numbers.find(.quoted(name)) {
            Some(value: number) => return number
            None => return 0
        }
    }

    mut fn stop_call(e: u64) -> u64 {
        args: List<u64> = copy(.nodes.get(e).kids)
        if args.len() > 1 {
            .fail_node(e)
            .say("write `stop()` to end this actor, or `stop(actor)` to end one you spawned")
            return 0
        }
        if args.len() == 0 {
            if .recv == 0 or .types.get(.recv).kind != CHK_ACTOR or .in_new {
                .fail_node(e)
                .say("`stop()` ends the actor it is in, so it only works in one of its handlers (not in `new`)")
                return 0
            }
            return .unit
        }
        ty: u64 = .expr(args.get(0), 0, 0)
        if .failed {
            return 0
        }
        if not .is_actor(ty) {
            .fail_node(args.get(0))
            .say("`stop` takes an actor reference, not ")
            .say_type(ty)
            return 0
        }
        return .unit
    }

    // ---- struct values and variants ------------------------------------------------------------

    /// The offset in words of the field `name` among the fields `rows`, and (for a variant) after the tag.
    pub fn field_offset(rows: List<u64>, name: Text) -> u64 {
        mut at: u64 = 0
        scanning: loop j: u64 in 0..(rows.len()) {
            f: FieldInfo = .fields.get(rows.get(j))
            if f.name.equals(name) {
                return at
            }
            at += .words_of_type(f.ty)
        }
        return at
    }

    /// Checks the fields given in `lit` (`FieldInit` nodes) against the fields `rows` of a struct or variant.
    mut fn struct_fields(lit: u64, name: Text, rows: List<u64>) {
        inits: List<u64> = copy(.nodes.get(lit).kids)
        mut given: List<Text> = List(region: .region)
        mut given_at: List<u64> = List(region: .region)
        listing: loop k: u64 in 0..(inits.len()) {
            given.push(copy(.nodes.get(inits.get(k)).text))
            given_at.push(inits.get(k))
        }
        mut wanted: List<Text> = List(region: .region)
        names: loop j: u64 in 0..(rows.len()) {
            wanted.push(copy(.fields.get(rows.get(j)).name))
        }
        .named_fields(name, wanted, given, given_at, lit, false)
        if .failed {
            return
        }
        values: loop k: u64 in 0..(inits.len()) {
            fty: u64 = .fields.get(rows.get(k)).ty
            value: u64 = .kid(inits.get(k), 0)
            discard .expr(value, fty, 0)
            if .failed {
                return
            }
            if .is_aggregate(fty) {
                mut what: Text = .text_of("field ")
                what.append_text(.quote_text(given.get(k)))
                .require_fresh(value, what)
                if .failed {
                    return
                }
            }
        }
    }

    /// `Name(a: 1, b: 2)` for a struct that has a `new`: the arguments are those of `new`, and it runs on a
    /// fresh zeroed value (decision 155).
    mut fn build_with_new(e: u64, st: u64) -> u64 {
        sig: u64 = .types.get(st).new_sig
        decl: u64 = .sigs.get(sig).decl
        group: Node = .nodes.get(.kid(decl, 0))
        mut wanted: List<Text> = List(region: .region)
        names: loop j: u64 in 0..(group.kids.len()) {
            wanted.push(.name_of(group.kids.get(j)))
        }
        inits: List<u64> = copy(.nodes.get(e).kids)
        mut given: List<Text> = List(region: .region)
        mut given_at: List<u64> = List(region: .region)
        mut values: List<u64> = List(region: .region)
        listing: loop k: u64 in 0..(inits.len()) {
            given.push(copy(.nodes.get(inits.get(k)).text))
            given_at.push(inits.get(k))
            values.push(.kid(inits.get(k), 0))
        }
        .named_fields(copy(.nodes.get(e).text), wanted, given, given_at, e, true)
        if .failed {
            return 0
        }
        .set_note(e, CHK_NOTE_SIG, sig)
        mut callee: Text = copy(.types.get(st).name)
        callee.append("'s `new`")
        mut shown: Text = .text_of("`")
        shown.append_text(callee)
        .check_args(shown, sig, values, e, 0, false, false)
        if .failed {
            return 0
        }
        .set_note(e, CHK_NOTE_TEMP, .alloc(.words_of_type(st)))
        return st
    }

    mut fn finish_struct_literal(e: u64, st: u64, variant: u64) -> u64 {
        name: Text = copy(.nodes.get(e).text)
        mut rows: List<u64> = .fields_of(st, false)
        if variant != 0 {
            rows = .fields_of(variant - 1, true)
            if rows.len() == 0 {
                .fail_node(e)
                .say_name(name)
                .say(" has no fields: write ")
                .say_name(name)
                return 0
            }
        }
        .struct_fields(e, name, rows)
        if .failed {
            return 0
        }
        if variant != 0 {
            .set_note(e, CHK_NOTE_VARIANT, variant)
        }
        .set_note(e, CHK_NOTE_TEMP, .alloc(.words_of_type(st)))
        return st
    }

    // ---- match -------------------------------------------------------------------------------------

    /// Checks the patterns (not the bodies) of a match, and that every value of the subject's type is
    /// matched exactly once. `arms` is the `Arms` node.
    mut fn match_patterns(m: u64) {
        ty: u64 = .expr(.kid(m, 0), 0, 0)
        if .failed {
            return
        }
        .set_note(m, CHK_NOTE_SUBJECT_SLOT, .alloc(1))
        if .types.get(ty).kind == CHK_ENUM {
            .enum_patterns(m, ty)
        } else if .is_int(ty) or ty == .bool_type {
            .value_patterns(m, ty)
        } else {
            if ty == .unit {
                .fail_node(.kid(m, 0))
                .say("there is nothing to match: this call returns no value")
                return
            }
            .fail_node(.kid(m, 0))
            .say("can't match a ")
            .say_type(ty)
            .say(": `match` works on enums, integers and bools")
        }
    }

    /// The variant row (plus one) called `name` of the enum `ty`: of an instance of a generic, among its own
    /// variants; else among the program's.
    fn variant_in(ty: u64, name: Text) -> u64 {
        if .nodes.get(.types.get(ty).decl).generic_base.len() > 0 {
            scanning: loop k: u64 in 0..(.variants.len()) {
                if .variants.get(k).enum_id == ty and .variants.get(k).name.equals(name) {
                    return k + 1
                }
            }
            return 0
        }
        match .variant_names.find(name) {
            Some(value: row) => return row + 1
            None => return 0
        }
    }

    mut fn enum_patterns(m: u64, ty: u64) {
        arms: List<u64> = copy(.nodes.get(.kid(m, 1)).kids)
        mut seen: TextMap<u64> = TextMap(region: .region)
        walking: loop a: u64 in 0..(arms.len()) {
            arm: u64 = arms.get(a)
            if .kid(arm, 0) == 0 {
                .fail_node(arm)
                .say("a `match` on an enum lists every variant of ")
                .say_name(.types.get(ty).name)
                .say("; `else` isn't allowed")
                return
            }
            pats: List<u64> = copy(.nodes.get(.kid(arm, 0)).kids)
            inner: loop i: u64 in 0..(pats.len()) {
                p: u64 = pats.get(i)
                mut name: Text = copy(.nodes.get(p).text)
                bare: bool = .kind_is(p, "PatternValue")
                if bare {
                    v: u64 = .kid(p, 0)
                    if .kid(p, 1) != 0 or not .kind_is(v, "Name") {
                        .fail_node(p)
                        .say("expected a variant of ")
                        .say_name(.types.get(ty).name)
                        return
                    }
                    name = copy(.nodes.get(v).text)
                }
                variant: u64 = .variant_in(ty, name)
                if variant == 0 {
                    .fail_node(p)
                    .say_name(.types.get(ty).name)
                    .say(" has no variant ")
                    .say_name(name)
                    return
                }
                owner: u64 = .variants.get(variant - 1).enum_id
                .require_visible(.types.get(owner).decl, .types.get(owner).name, p, 0)
                if .failed {
                    return
                }
                if owner != ty {
                    .fail_node(p)
                    .say_name(name)
                    .say(" is a variant of ")
                    .say_name(.types.get(owner).name)
                    .say(", not ")
                    .say_name(.types.get(ty).name)
                    return
                }
                if seen.contains(name) {
                    .fail_node(p)
                    .say_name(name)
                    .say(" is already matched")
                    return
                }
                seen.put(name, 1)
                .set_note(p, CHK_NOTE_VARIANT, variant)
                rows: List<u64> = .fields_of(variant - 1, true)
                if bare {
                    if rows.len() > 0 {
                        .fail_node(p)
                        .say_name(name)
                        .say(" has fields: bind each one, as in `")
                        .say_text(name)
                        .say("(")
                        shown: loop j: u64 in 0..(rows.len()) {
                            if j > 0 {
                                .say(", ")
                            }
                            .say_text(.fields.get(rows.get(j)).name)
                            .say(": _")
                        }
                        .say(")`")
                        return
                    }
                } else if rows.len() == 0 {
                    .fail_node(p)
                    .say_name(name)
                    .say(" has no fields: write ")
                    .say_name(name)
                    return
                } else {
                    binds: List<u64> = copy(.nodes.get(p).kids)
                    mut given: List<Text> = List(region: .region)
                    mut given_at: List<u64> = List(region: .region)
                    listing: loop b: u64 in 0..(binds.len()) {
                        given.push(.first_word(.nodes.get(binds.get(b)).text))
                        given_at.push(binds.get(b))
                    }
                    .named_fields(name, .field_names(variant - 1, true), given, given_at, p, false)
                    if .failed {
                        return
                    }
                }
            }
            if pats.len() > 1 {
                inner2: loop i: u64 in 0..(pats.len()) {
                    binds: List<u64> = copy(.nodes.get(pats.get(i)).kids)
                    each: loop b: u64 in 0..(binds.len()) {
                        if .kind_is(pats.get(i), "PatternVariant") and not .last_word(.nodes.get(binds.get(b)).text).same_as("_") {
                            .fail_node(arm)
                            .say("an arm with several variants can't bind names: use `_`, or give each variant its own arm")
                            return
                        }
                    }
                }
            }
        }
        all: loop k: u64 in 0..(.variants.len()) {
            if .variants.get(k).enum_id == ty and not seen.contains(.variants.get(k).name) {
                mut missing: u64 = 0
                counting: loop j: u64 in k..(.variants.len()) {
                    if .variants.get(j).enum_id == ty and not seen.contains(.variants.get(j).name) {
                        missing += 1
                    }
                }
                .fail_node(m)
                .say("this `match` is missing ")
                .say_name(.variants.get(k).name)
                if missing > 1 {
                    .say(" (and ")
                    .say_number(missing - 1)
                    .say(" more)")
                }
                return
            }
        }
    }

    mut fn value_patterns(m: u64, ty: u64) {
        arms: List<u64> = copy(.nodes.get(.kid(m, 1)).kids)
        is_bool: bool = ty == .bool_type
        lowest: Num = if is_bool { chk_num(false, 0) } else { .int_min(ty) }
        highest: Num = if is_bool { chk_num(false, 1) } else { .int_max(ty) }
        mut taken_lo: List<Num> = List(region: .region)
        mut taken_hi: List<Num> = List(region: .region)
        mut else_arm: u64 = 0
        walking: loop a: u64 in 0..(arms.len()) {
            arm: u64 = arms.get(a)
            if .kid(arm, 0) == 0 {
                if a != arms.len() - 1 {
                    .fail_node(arm)
                    .say("`else` must be the last arm")
                    return
                }
                else_arm = arm
                continue walking
            }
            pats: List<u64> = copy(.nodes.get(.kid(arm, 0)).kids)
            inner: loop i: u64 in 0..(pats.len()) {
                p: u64 = pats.get(i)
                if .kind_is(p, "PatternVariant") {
                    .fail_node(p)
                    .say_name(.nodes.get(p).text)
                    .say(" is an enum variant, but this `match` is on ")
                    .say_type(ty)
                    return
                }
                lo: Num = .pattern_value(.kid(p, 0), ty)
                if .failed {
                    return
                }
                .set_note_value(p, CHK_NOTE_LO, lo)
                mut hi: Num = chk_num_add(lo, chk_num(false, 1))
                if .kid(p, 1) != 0 {
                    if is_bool {
                        .fail_node(p)
                        .say("a range needs integers")
                        return
                    }
                    hi = .pattern_value(.kid(p, 1), ty)
                    if .failed {
                        return
                    }
                    if not chk_num_less(lo, hi) {
                        .fail_node(p)
                        .say("this range is empty: its end must be greater than its start")
                        return
                    }
                }
                .set_note_value(p, CHK_NOTE_HI, hi)
                overlap: loop j: u64 in 0..(taken_lo.len()) {
                    if chk_num_less(lo, taken_hi.get(j)) and chk_num_less(taken_lo.get(j), hi) {
                        .fail_node(p)
                        .say("this pattern overlaps an earlier one")
                        return
                    }
                }
                taken_lo.push(copy(lo))
                taken_hi.push(copy(hi))
            }
        }
        // The first value no arm matches, if any: walk the taken ranges in order of their start.
        mut gap: Num = copy(lowest)
        mut used: List<bool> = List(region: .region)
        zeroing: loop j: u64 in 0..(taken_lo.len()) {
            used.push(false)
        }
        sweeping: loop round: u64 in 0..(taken_lo.len()) {
            mut best: u64 = taken_lo.len()
            picking: loop j: u64 in 0..(taken_lo.len()) {
                if not used.get(j) and (best == taken_lo.len() or chk_num_less(taken_lo.get(j), taken_lo.get(best))) {
                    best = j
                }
            }
            used.set(best, true)
            if chk_num_less(gap, taken_lo.get(best)) {
                break sweeping
            }
            if chk_num_less(gap, taken_hi.get(best)) {
                gap = copy(taken_hi.get(best))
            }
        }
        if chk_num_less(highest, gap) {
            if else_arm != 0 {
                .fail_node(else_arm)
                .say("every ")
                .say_type(ty)
                .say(" value is already matched, so `else` would never run")
            }
        } else if else_arm == 0 {
            .fail_node(m)
            if is_bool {
                .say("this `match` is missing `")
                .say(if gap.mag != 0 { "true" } else { "false" })
                .say("`")
            } else {
                .say("this `match` doesn't cover every ")
                .say_type(ty)
                .say(" value (such as ")
                .say_num(gap)
                .say("); add `else =>` for the rest")
            }
        }
    }

    /// A pattern's value: a literal or a constant, computed now.
    mut fn pattern_value(e: u64, ty: u64) -> Num {
        if .kind_is(e, "Name") and .lookup(.nodes.get(e).text) != 0 {
            .fail_node(e)
            .say("a pattern is a literal or a constant, and ")
            .say_name(.nodes.get(e).text)
            .say(" is a variable")
            return chk_num(false, 0)
        }
        discard .expr(e, ty, 0)
        if .failed {
            return chk_num(false, 0)
        }
        return .const_eval(e)
    }

    /// Declares an arm's bindings in a new scope.
    mut fn enter_arm(m: u64, arm: u64) -> Text {
        .enter_scope()
        mut lends: Text = .empty()
        if .kid(arm, 0) == 0 {
            return .empty()
        }
        pats: List<u64> = copy(.nodes.get(.kid(arm, 0)).kids)
        walking: loop i: u64 in 0..(pats.len()) {
            p: u64 = pats.get(i)
            if not .note_has(p, CHK_NOTE_VARIANT) or not .kind_is(p, "PatternVariant") {
                continue walking
            }
            variant: u64 = .note_get(p, CHK_NOTE_VARIANT)
            binds: List<u64> = copy(.nodes.get(p).kids)
            start: u64 = .slot_rows.len()
            binding: loop b: u64 in 0..(binds.len()) {
                node: u64 = binds.get(b)
                name: Text = .last_word(.nodes.get(node).text)
                if name.same_as("_") {
                    continue binding
                }
                .require_snake(name, "variable", node)
                if .failed {
                    return .empty()
                }
                field: Text = .first_word(.nodes.get(node).text)
                rows: List<u64> = .fields_of(variant - 1, true)
                fty: u64 = .variant_field_type(variant - 1, field)
                offset: u64 = .field_offset(rows, field) + 1
                agg: bool = .is_aggregate(fty)
                slot: u64 = .new_local(name, fty, false, if agg { CHK_LOCAL_REF } else { CHK_LOCAL_VALUE }, node, false, false)
                if .failed {
                    return .empty()
                }
                if agg and lends.len() == 0 {
                    lends = copy(name)
                }
                .slot_rows.push(slot)
                .slot_rows.push(offset)
                .slot_rows.push(if agg { 1 } else { 0 })
            }
            if .slot_rows.len() > start {
                .set_note(p, CHK_NOTE_SLOTS, start + 1)
                .set_note(p, CHK_NOTE_SLOTS_COUNT, (.slot_rows.len() - start) / 3)
            }
        }
        root: Text = .root_name(.kid(m, 0))
        if lends.len() > 0 and root.len() > 0 and .lock_find(root) == 0 {
            .lock_roots.push(copy(root))
            .lock_names.push(copy(lends))
            return root
        }
        return .empty()
    }

    mut fn exit_arm(held: Text) {
        .leave_scope()
        if held.len() > 0 {
            .unlock(held)
        }
    }

    mut fn match_stmt(s: u64) -> bool {
        .match_patterns(s)
        if .failed {
            return false
        }
        mut always_returns: bool = true
        arms: List<u64> = copy(.nodes.get(.kid(s, 1)).kids)
        before: List<u64> = .state_clone(.moved)
        mut ends: List<List<u64>> = List(region: .region)
        walking: loop a: u64 in 0..(arms.len()) {
            arm: u64 = arms.get(a)
            .moved = .state_clone(before)
            held: Text = .enter_arm(s, arm)
            if .failed {
                return false
            }
            body: u64 = .kid(arm, 1)
            mut returns: bool = false
            if .kind_is(body, "Block") {
                returns = .block(body)
            } else {
                returns = .stmt(body)
            }
            if .failed {
                return false
            }
            .exit_arm(held)
            if not .diverges(body) {
                ends.push(.moved)
            }
            always_returns = always_returns and returns
        }
        .moved = .merge_states(ends, before)
        // Every value is matched by some arm, so if each arm returns, so does the match.
        return always_returns
    }

    mut fn infer_match_expr(e: u64, expected: u64) -> u64 {
        if not .in_fn {
            return .constant_error(e, "constants can't use `match`")
        }
        .match_patterns(e)
        if .failed {
            return 0
        }
        arms: List<u64> = copy(.nodes.get(.kid(e, 1)).kids)
        mut any_value: bool = false
        scanning: loop a: u64 in 0..(arms.len()) {
            if not .is_leaving(.kid(arms.get(a), 1)) {
                any_value = true
            }
        }
        if not any_value {
            .fail_node(e)
            .say("every arm leaves, so this `match` has no value")
            return 0
        }
        // Arms that aren't bare literals first, so the literals can take their type.
        mut ty: u64 = 0
        pass: loop round: u64 in 0..2 {
            ordered: loop a: u64 in 0..(arms.len()) {
                arm: u64 = arms.get(a)
                body: u64 = .kid(arm, 1)
                literal: bool = not .is_leaving(body) and .untyped_literal(body)
                if (round == 0 and literal) or (round == 1 and not literal) {
                    continue ordered
                }
                held: Text = .enter_arm(e, arm)
                if .failed {
                    return 0
                }
                if .is_leaving(body) {
                    discard .stmt(body)             // return, break or continue
                } else {
                    aty: u64 = .expr(body, 0, if ty != 0 { ty } else { expected })
                    if .failed {
                        return 0
                    }
                    if ty == 0 {
                        ty = aty
                    } else if aty != ty {
                        .fail_node(body)
                        .say("every arm of a `match` must have the same type, found ")
                        .say_type(ty)
                        .say(" and ")
                        .say_type(aty)
                        return 0
                    }
                }
                if .failed {
                    return 0
                }
                .exit_arm(held)
            }
        }
        return ty
    }

    fn is_leaving(body: u64) -> bool {
        return .kind_is(body, "Return") or .kind_is(body, "Break") or .kind_is(body, "Continue")
    }

    // ---- ownership: consumed places, locks and loops (5d-3d) ----------------------------------------
    //
    // A state of what is consumed is a list of (key, node) pairs in the order they were consumed (a
    // dictionary in Fledgling): the key is twice a variable's number, or twice a field's number plus one;
    // the node is the `consume` that did it.

    fn state_find(state: List<u64>, key: u64) -> u64 {
        scanning: loop k: u64 in 0..(state.len() / 2) {
            if state.get(2 * k) == key {
                return k + 1
            }
        }
        return 0
    }

    fn state_clone(state: List<u64>) -> List<u64> {
        mut out: List<u64> = List(region: .region)
        copying: loop k: u64 in 0..(state.len()) {
            out.push(state.get(k))
        }
        return out
    }

    fn state_without(state: List<u64>, key: u64) -> List<u64> {
        mut out: List<u64> = List(region: .region)
        copying: loop k: u64 in 0..(state.len() / 2) {
            if state.get(2 * k) != key {
                out.push(state.get(2 * k))
                out.push(state.get(2 * k + 1))
            }
        }
        return out
    }

    /// `state` with `key` consumed at `at` (a key already there keeps its place and takes the new node).
    fn state_with(state: List<u64>, key: u64, at: u64) -> List<u64> {
        mut out: List<u64> = .state_clone(state)
        found: u64 = .state_find(out, key)
        if found != 0 {
            out.set(2 * (found - 1) + 1, at)
        } else {
            out.push(key)
            out.push(at)
        }
        return out
    }

    /// The consumed places after paths join: consumed on any of them. With no path left (all returned or
    /// broke out), nothing after matters, so `before` stands.
    fn merge_states(states: List<List<u64>>, before: List<u64>) -> List<u64> {
        if states.len() == 0 {
            return .state_clone(before)
        }
        mut merged: List<u64> = List(region: .region)
        joining: loop i: u64 in 0..(states.len()) {
            state: List<u64> = states.get(i)
            adding: loop k: u64 in 0..(state.len() / 2) {
                merged = .state_with(merged, state.get(2 * k), state.get(2 * k + 1))
            }
        }
        return merged
    }

    /// The key `consume` would record for `place`: a variable's, a field's; 0 for anything else.
    mut fn moved_key(place: u64) -> u64 {
        if .kind_is(place, "Name") {
            row: u64 = .lookup(.nodes.get(place).text)
            if row != 0 {
                return 2 * .locals.get(row - 1).uid
            }
            return 0
        }
        if .kind_is(place, "Access") and .kid(place, 0) == 0 and .recv != 0 and .types.get(.recv).kind == CHK_ACTOR {
            return .field_key(.nodes.get(place).text)
        }
        return 0
    }

    /// The key of the field `name` of the actor: twice its number in `field_keys`, plus one (1 is never a variable's).
    mut fn field_key(name: Text) -> u64 {
        scanning: loop k: u64 in 0..(.field_keys.len()) {
            if .field_keys.get(k).equals(name) {
                return 2 * k + 3
            }
        }
        .field_keys.push(copy(name))
        return 2 * (.field_keys.len() - 1) + 3
    }

    fn key_name(key: u64) -> Text {
        if key % 2 == 1 {
            return .dotted(.field_keys.get((key - 3) / 2))
        }
        return copy(.uid_names.get(key / 2 - 1))
    }

    mut fn require_not_consumed(key: u64, name: Text, at: u64) {
        found: u64 = .state_find(.moved, key)
        if found != 0 {
            consumed: Node = .nodes.get(.moved.get(2 * (found - 1) + 1))
            .fail_node(at)
            .say_name(name)
            .say(" was consumed at ")
            .say_number(consumed.line)
            .say(":")
            .say_number(consumed.col)
            .say(", so it has no value here; assign it again first")
        }
    }

    /// An actor's `iso` field a handler consumed must have a value again before the handler ends.
    mut fn require_fields_back() {
        scanning: loop k: u64 in 0..(.moved.len() / 2) {
            key: u64 = .moved.get(2 * k)
            if key % 2 == 1 {
                .fail_node(.moved.get(2 * k + 1))
                .say_name(.key_name(key))
                .say(" is consumed here and not assigned again before the handler ends")
                return
            }
        }
    }

    mut fn enter_loop() {
        mut outside: List<u64> = List(region: .region)
        scanning: loop k: u64 in 0..(.locals.len()) {
            outside.push(.locals.get(k).uid)
        }
        .entry_moved.push(.state_clone(.moved))
        .entry_outside.push(outside)
    }

    /// What the next turn of loop number `depth` would use must still have its value.
    mut fn require_loop_ready(depth: u64) {
        before: List<u64> = .entry_moved.get(depth)
        outside: List<u64> = .entry_outside.get(depth)
        scanning: loop k: u64 in 0..(.moved.len() / 2) {
            key: u64 = .moved.get(2 * k)
            if .state_find(before, key) != 0 {
                continue scanning
            }
            mut counts: bool = key % 2 == 1
            if not counts {
                inside: loop j: u64 in 0..(outside.len()) {
                    if outside.get(j) == key / 2 {
                        counts = true
                    }
                }
            }
            if counts {
                .fail_node(.moved.get(2 * k + 1))
                .say_name(.key_name(key))
                .say(" is consumed here, inside a loop, but the next turn needs it: assign it again before the end of the loop")
                return
            }
        }
    }

    mut fn leave_loop(body: u64) {
        depth: u64 = .entry_moved.len() - 1
        before: List<u64> = .entry_moved.get(depth)
        if not .block_diverges(body) {
            .require_loop_ready(depth)
            if .failed {
                return
            }
        }
        // the states at the `break`s of this loop, in the order they were met; the others stay
        mut ordered: List<List<u64>> = List(region: .region)
        mut kept_depths: List<u64> = List(region: .region)
        mut kept_states: List<List<u64>> = List(region: .region)
        sorting: loop k: u64 in 0..(.break_depths.len()) {
            if .break_depths.get(k) == depth {
                ordered.push(.break_states.get(k))
            } else {
                kept_depths.push(.break_depths.get(k))
                kept_states.push(.break_states.get(k))
            }
        }
        .break_depths = copy(kept_depths)
        .break_states = copy(kept_states)
        discard .entry_moved.pop()
        discard .entry_outside.pop()
        ordered.push(.state_clone(before))
        .moved = .merge_states(ordered, before)
    }

    // ---- locks: a `match` lends a part of its subject ---------------------------------------------

    /// The variable a place starts from (`p` in `p.a.b`), or "self" for `.x` and `.`; "" for anything else.
    fn root_name(e: u64) -> Text {
        mut cur: u64 = e
        walking: loop .kind_is(cur, "Access") {
            if .kid(cur, 0) == 0 {
                return .text_of("self")
            }
            cur = .kid(cur, 0)
        }
        if .kind_is(cur, "SelfValue") {
            return .text_of("self")
        }
        if .kind_is(cur, "Name") and not .note_has(cur, CHK_NOTE_VARIANT) and not .note_has(cur, CHK_NOTE_CONST_STR) {
            return copy(.nodes.get(cur).text)
        }
        return .empty()
    }

    fn lock_find(root: Text) -> u64 {
        scanning: loop k: u64 in 0..(.lock_roots.len()) {
            if .lock_roots.get(k).equals(root) {
                return k + 1
            }
        }
        return 0
    }

    mut fn require_unlocked(root: Text, action: Text, text: Text, at: u64) {
        found: u64 = .lock_find(root)
        if root.len() > 0 and found != 0 {
            .fail_node(at)
            .say("can't ")
            .say_text(action)
            .say(" ")
            .say_name(text)
            .say(" while ")
            .say_name(.lock_names.get(found - 1))
            .say(" is lent from it by this `match`")
        }
    }

    mut fn unlock(root: Text) {
        found: u64 = .lock_find(root)
        mut roots: List<Text> = List(region: .region)
        mut names: List<Text> = List(region: .region)
        copying: loop k: u64 in 0..(.lock_roots.len()) {
            if k + 1 != found {
                roots.push(copy(.lock_roots.get(k)))
                names.push(copy(.lock_names.get(k)))
            }
        }
        .lock_roots = copy(roots)
        .lock_names = copy(names)
    }

    // ---- for the dump --------------------------------------------------

    pub fn node_at(n: u64) -> Node {
        return .nodes.get(n)
    }

    pub fn node_text(n: u64) -> Text {
        return copy(.nodes.get(n).text)
    }

    pub fn file_path(file: u64) -> Text {
        return copy(.files.get(file - 1).path)
    }

    pub fn root_node() -> u64 {
        return .root
    }

    pub fn node_count() -> u64 {
        return .nodes.len()
    }

    pub fn nodes_name(n: u64) -> Text {
        return .name_of(n)
    }

    pub fn size_of(ty: u64) -> u64 {
        return .words_of_type(ty)
    }

    pub fn template_count() -> u64 {
        return .generic_types.len()
    }

    pub fn template_name(k: u64) -> Text {
        return .name_of(.generic_types.value_at(k))
    }

    pub fn generic_variant_count() -> u64 {
        return .generic_variants.len()
    }

    pub fn generic_variant_name(k: u64) -> Text {
        return .generic_variants.key_at(k)
    }

    pub fn generic_variant_of(k: u64) -> Text {
        return .name_of(.generic_variants.value_at(k))
    }
}
