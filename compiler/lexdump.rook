// Stage 5d-1 of the self-hosted compiler: the lexer, run hosted (docs/self-hosting.md). It reads
// a Rook source file from the UART (ended by the byte 4), lexes it with compiler/lib/lexer.rook and
// prints the tokens in the format of `python3 -m fledgling FILE --dump-tokens`, one per line:
//     LINE:COL KIND [TEXT] [VALUE]
// where a number or character has its value in decimal and a string its bytes as `x` and hex. If
// the lexer fails, the one line is `error LINE:COL: MESSAGE`.

import devices: Mmio
import lexer: Lexer, Token
import pl011: Pl011
import region: Region, make_region
import text: Text

END_OF_INPUT: u8 = 4

fn put_text(console: Pl011, t: Text) {
    printing: loop i: u64 in 0..t.len() {
        console.put(t.at(i))
    }
}

fn put_hex(console: Pl011, b: u8) {
    digits: u8 = b / 16
    low: u8 = b % 16
    console.put(if digits < 10 { '0' + digits } else { 'a' + (digits - 10) })
    console.put(if low < 10 { '0' + low } else { 'a' + (low - 10) })
}

fn put_token(console: Pl011, t: Token) {
    console.write_dec(t.line)
    console.put(':')
    console.write_dec(t.col)
    console.put(' ')
    put_text(console, t.kind)
    if t.text.len() > 0 {
        console.put(' ')
        put_text(console, t.text)
    }
    if t.kind.same_as("int") or t.kind.same_as("char") {
        console.put(' ')
        console.write_dec(t.value)
    }
    if t.kind.same_as("str") {
        console.write(" x")
        hexing: loop i: u64 in 0..t.bytes.len() {
            put_hex(console, t.bytes.at(i))
        }
    }
    console.put('\n')
}

fn test_main(peripherals: Mmio) {
    console: Pl011 = Pl011(regs: peripherals.part(0x201000, 0x1000))
    region: Region = make_region(peripherals)
    console.write("Hosted: begin\n")
    mut source: Text = Text(region: region)
    reading: loop {
        if console.has_byte() {
            b: u8 = console.take()
            if b == END_OF_INPUT {
                break reading
            }
            source.push(b)
        }
    }
    mut lexer: Lexer = Lexer(region: region, source: source)
    lexer.run()
    if lexer.failed {
        console.write("error ")
        console.write_dec(lexer.error_line)
        console.put(':')
        console.write_dec(lexer.error_col)
        console.write(": ")
        put_text(console, lexer.error)
        console.put('\n')
    } else {
        printing: loop i: u64 in 0..(lexer.tokens.len()) {
            put_token(console, lexer.tokens.get(i))
        }
    }
    console.write("Hosted: end\n")
}
