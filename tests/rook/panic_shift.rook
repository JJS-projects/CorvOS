// Shifting by the width of the type or more panics.
// expect: 9223372036854775808
// expect-panic: shift amount too large at panic_shift.rook:13

extern fn print_u64(x: u64)
extern fn print_i64(x: i64)

fn test_main() {
    one: u64 = 1
    mut s: u64 = 63
    print_u64(one shl s)
    s += 1
    print_u64(one shl s)
}
