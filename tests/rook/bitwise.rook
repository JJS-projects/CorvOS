// Bitwise operators, shifts (logical and arithmetic) and `!`.
// expect: 8
// expect: 14
// expect: 6
// expect: 245
// expect: 4294967040
// expect: 160
// expect: 21
// expect: -2
// expect: -1
// expect: 1
// expect: 9223372036854775808

extern fn print_u64(x: U64)
extern fn print_i64(x: I64)

fn test_main() {
    let a: U8 = 12
    let b: U8 = 10
    print_u64((a & b) as U64)
    print_u64((a | b) as U64)
    print_u64((a ^ b) as U64)
    let c: U8 = 10
    print_u64((!c) as U64)
    let d: U32 = 255
    print_u64((!d) as U64)
    let e: U8 = 0xAA
    print_u64((e << 4) as U64)
    print_u64((e >> 3) as U64)
    let f: I32 = -8
    print_i64((f >> 2) as I64)
    print_i64((f >> 31) as I64)
    let h: I64 = -2
    print_i64(!h)
    let g: U64 = 1
    print_u64(g << 63)
}
