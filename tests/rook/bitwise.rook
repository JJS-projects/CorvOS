// On integers, `and`, `or`, `xor` and `not` work bit by bit; `shl` and `shr`
// shift (logical for unsigned, arithmetic for signed). `shl` never silently loses
// set bits: mask them off first to drop them on purpose.
// expect: 8
// expect: 14
// expect: 6
// expect: 245
// expect: 4294967040
// expect: 160
// expect: 21
// expect: -2
// expect: -1
// expect: 1
// expect: 9223372036854775808
// expect: 240
// expect: 49152

PINS: u32 = (1 shl 14) or (1 shl 15)

fn test_main() {
    a: u8 = 12
    b: u8 = 10
    print_u64((a and b) as u64)
    print_u64((a or b) as u64)
    print_u64((a xor b) as u64)
    c: u8 = 10
    print_u64((not c) as u64)
    d: u32 = 255
    print_u64((not d) as u64)
    e: u8 = 0xAA
    print_u64(((e and 0x0F) shl 4) as u64)
    print_u64((e shr 3) as u64)
    f: i32 = -8
    print_i64((f shr 2) as i64)
    print_i64((f shr 31) as i64)
    h: i64 = -2
    print_i64(not h)
    g: u64 = 1
    print_u64(g shl 63)
    flags: u32 = 0xFF
    print_u64((flags and not 0x0F) as u64)
    print_u64(PINS as u64)
}
