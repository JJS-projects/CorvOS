// QEMU reports a program that misuses a device, and the test fails unless it
// expects the report. Here the UART has no registers at offset 0x100.
// expect: 0
// expect-qemu-log: pl011_write: Bad offset 0x100
// expect-qemu-log: pl011_read: Bad offset 0x100

fn test_main(peripherals: Mmio) {
    uart: Mmio = peripherals.part(0x201000, 0x1000)
    uart.write32(0x100, 1)
    print_u64(uart.read32(0x100) as u64)
}
