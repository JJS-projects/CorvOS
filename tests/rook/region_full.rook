// A block that does not fit panics, and does not use any of the region.
//
// Worked out: 128 MB is 134217728 bytes; a block of 134217729 does not fit.
// expect-panic: the region is full at region.rook:*

import devices: Mmio
import print: print_u64
import region: Block, Region, make_region

fn test_main(peripherals: Mmio) {
    mut region: Region = make_region(peripherals)
    block: Block = region.block(134217729)
    print_u64(block.len())
}
