// Structs are lent, not copied: a `mut` parameter changes the caller's value,
// and `.copy()` makes an independent value. Numbers can be lent as `mut` too.
// expect: 101
// expect: 1
// expect: 2
// expect: 51
// expect: 7

extern fn print_u64(x: u64)

struct Counter {
    count: u64
    step: u64
}

fn advance(c: mut Counter) {
    c.count += c.step
}

fn total(c: Counter) -> u64 {
    return c.count + c.step
}

fn increment(n: mut u64) {
    n += 1
}

fn test_main() {
    mut a: Counter = Counter(count: 1, step: 100)
    advance(mut a)
    print_u64(a.count)
    mut b: Counter = Counter(count: 1, step: 1)
    c: Counter = b.copy()
    advance(mut b)
    print_u64(c.count)
    print_u64(b.count)
    mut n: u64 = 50
    increment(mut n)
    print_u64(n)
    print_u64(total(Counter(count: 3, step: 4)))
}
