// A byte index at the end of a block is outside it (the first panic stops the program).
//
// Worked out: a block of 4 bytes has indexes 0 to 3; reading index 4 panics.
// expect: 0
// expect-panic: index outside Block at region.rook:*

import devices: Mmio
import print: print_u64
import region: Block, Region, make_region

fn test_main(peripherals: Mmio) {
    mut region: Region = make_region(peripherals)
    block: Block = region.block(4)
    print_u64(block.get(3) as u64)
    print_u64(block.get(4) as u64)
}
