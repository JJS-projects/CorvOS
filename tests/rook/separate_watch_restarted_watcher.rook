// A watcher that restarts forgets its old watch on an actor of another core, so the watched actor tells it once, not once
// for every life it has had (decision 181 listed the broadcast that does this as untested).
// `Settings` (a plain actor on core 0) watches `Console` (a `separate` actor on core 1) in its `new`.
// Worked out (each step ends with run_until_idle):
//  1. console crash: the watch fires, Settings prints 99 (1st expect-failure).
//  2. settings crash: it restarts (2nd expect-failure) and its `new` watches the console again. Its old watch is dropped on
//     every core by REC_DROP_WATCHES; if it were not, the console would hold two.
//  3. console crash again (3rd expect-failure): Settings prints 99 once. With a stale second watch it would print 99 twice.
// expect-failure: console crash at separate_watch_restarted_watcher.rook:50
// expect-failure: settings crash at separate_watch_restarted_watcher.rook:38
// expect-failure: console crash at separate_watch_restarted_watcher.rook:50
// expect: 99
// expect: 99

import actors: run_until_idle
import print: print_u64

interface Lifecycle {
    lossy on restarted()
    lossy on stopped()
}

actor Settings: Lifecycle {
    console: Console

    new(console: Console) {
        .console = console
        watch(console, narrow(self, Lifecycle))
    }

    lossy on restarted() {
        print_u64(99)
    }

    lossy on stopped() { }

    pub lossy on crash() {
        panic("settings crash")
    }
}

separate actor Console {
    mut unused: u64

    new() {
        .unused = 0
    }

    pub lossy on crash() {
        panic("console crash")
    }
}

fn test_main() {
    console: Console = spawn Console()
    settings: Settings = spawn Settings(console)
    run_until_idle()
    console.crash()
    run_until_idle()
    settings.crash()
    run_until_idle()
    console.crash()
    run_until_idle()
}
