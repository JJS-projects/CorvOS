// The raspi3ap machine has 512 MB of RAM, like the Zero 2 W, and the MMU map ends there: the next address has
// no translation, so the CPU faults and Raven reports the address.
// machines: raspi3ap
// expect-fault: FAR_EL1:  0x0000000030000000

fn test_main() {
    unsafe {
        store32(0x30000000, 42)
    }
}
