// An actor in a domain can place actors only in its own domain for now: a `Domain` that names another is refused and fails the domain (decisions 175 and 206).
// Worked out: Counter is in domain d1 and holds a copy of d2, another domain. make() spawns a Helper in d2; Raven answers a domain's
// request for another domain with "made a request it may not"; the actor is restarted and reports its start value, 3.
// expect-failure: domain 1 made a request it may not
// expect: 3

import actors: Domain, new_domain, run_until_idle
import print: print_u64

actor Printer {
    lossy on show(n: u64) {
        print_u64(n)
    }
}

separate actor Helper {
    mut n: u64

    new() {
        .n = 0
    }
}

separate actor Counter {
    mut total: u64
    other: val Domain

    new(start: u64, other: val Domain) {
        .total = start
        .other = other
    }

    lossy on make() {
        discard spawn Helper() in .other
    }

    lossy on report(to: Printer) {
        to.show(.total)
    }
}

fn test_main() {
    printer: Printer = spawn Printer()
    d1: Domain = new_domain()
    d2: Domain = new_domain()
    counter: Counter = spawn Counter(3, copy(d2)) in d1
    counter.make()
    run_until_idle()
    counter.report(printer)
    run_until_idle()
}
