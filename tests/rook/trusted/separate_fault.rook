// A `separate` actor that touches Raven's memory faults, and is restarted like any actor that fails.
// Worked out: the counter starts at 100; add(5) makes 105. poke() stores into the actor arena (Raven's memory, which a domain
// does not map): a data abort, so domain 1 faulted. Raven restarts the actor: its `new` runs again, so the total is 100 again,
// not 105. After run_until_idle (so that the restart is over) a report prints 100.
// (A first version sent add(1) and a report behind poke() and expected the restart to empty the mailbox of them. The actor is
// on another core, so whether they reached its mailbox before the restart or after it depended on timing: about 2 runs in 40
// printed 101 or 100 twice. A message that arrives after the restart is delivered, as it should be; the loss of queued
// messages in a restart is tested for actors on the same core in restart_basic.)
// expect-failure: domain 1 faulted
// expect: 100

import actors: run_until_idle
import assembly: raven_arena_address
import print: print_u64

actor Printer {
    lossy on show(n: u64) {
        print_u64(n)
    }
}

separate actor Counter {
    mut total: u64

    new(start: u64) {
        .total = start
    }

    lossy on add(n: u64) {
        .total += n
    }

    lossy on poke() {
        unsafe {
            store64(raven_arena_address(), 1)
        }
    }

    lossy on report(to: Printer) {
        to.show(.total)
    }
}

fn test_main() {
    printer: Printer = spawn Printer()
    counter: Counter = spawn Counter(100)
    counter.add(5)
    counter.poke()
    run_until_idle()
    counter.report(printer)
    run_until_idle()
}
