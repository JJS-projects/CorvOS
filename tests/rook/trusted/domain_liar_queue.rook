// Raven queues a place in a domain's run queue itself when an actor placed there starts (`runtime_release`), and the queue's start is
// a word the domain can write: Raven reduces it before adding to it, so a domain that lies about it fails itself, not Raven
// (decision 208).
// Worked out: the Pool, in domain d, writes 2^64 - 1 over its runtime's queue start, then places a Worker and sends it `say`; the
// Worker is waiting for its `new`, so the message waits in its mailbox. When the turn is over Raven runs the Worker's `new` and queues
// it: before decision 208 the sum of start and count overflowed in Raven ("integer overflow at domain_runtime.rook", from EL1) and the
// core stopped. Now Raven queues it, and the runtime in the domain, which reads the lie as it is, fails at EL0 on its next turn (the
// failure below); the domain restarts as a unit. An Honest actor in another domain still says 5, and the Pool, restarted, says 3.
// expect-failure: integer overflow at domain_runtime.rook:*
// expect: 5
// expect: 3

import actors: Domain, new_domain, run_until_idle
import domain_runtime: RT_STATE, RT_S_RQ_FIRST
import print: print_u64

actor Printer {
    lossy on show(n: u64) {
        print_u64(n)
    }
}

separate actor Worker {
    n: u64

    new(n: u64) {
        .n = n
    }

    pub lossy on say(to: Printer) {
        to.show(.n)
    }
}

separate actor Pool {
    d: val Domain

    new(d: val Domain) {
        .d = d
    }

    pub lossy on grow(printer: Printer) {
        unsafe {
            store64(actor_address(self) - 0x11000 + RT_STATE + RT_S_RQ_FIRST, 18446744073709551615)
        }
        w: Worker = spawn Worker(7) in .d
        w.say(printer)
    }

    pub lossy on say(to: Printer) {
        to.show(3)
    }
}

separate actor Honest {
    n: u64

    new(n: u64) {
        .n = n
    }

    pub lossy on say(to: Printer) {
        to.show(.n)
    }
}

fn test_main() {
    printer: Printer = spawn Printer()
    d: Domain = new_domain()
    pool: Pool = spawn Pool(copy(d)) in d
    honest: Honest = spawn Honest(5)
    pool.grow(printer)
    run_until_idle()
    honest.say(printer)
    run_until_idle()
    pool.say(printer)
    run_until_idle()
}
