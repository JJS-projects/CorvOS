// A `separate` actor cannot read another domain's memory, and the other domain is not disturbed (milestone 6c).
// Worked out: Raven puts the first `separate` actor on core 1 and the second on core 2 (decision 180), each in its
// core's domain 1. `a` plants 4242 in its data, 256 KB past its fields (so at pool (core 1, domain 1) + 0x11000 + 0x40000);
// `b` is asked to read that address: core 2's page tables have no entry for core 1's pool, so it faults ("domain 1
// faulted": the domain's number on its core) and is restarted. `a` still has the secret (a prints 4242) and Raven, which
// sees all memory, reads the same 4242.
// expect-failure: domain 1 faulted
// expect: 4242
// expect: 4242

import actors: run_until_idle
import assembly: domain_pool_base_of
import print: print_u64

actor Printer {
    lossy on show(n: u64) {
        print_u64(n)
    }
}

separate actor Holder {
    mut unused: u64

    new() {
        .unused = 0
    }

    lossy on plant(value: u64) {
        unsafe {
            store64(actor_address(self) + 0x40000, value)
        }
    }

    lossy on peek(address: u64, to: Printer) {
        unsafe {
            to.show(load64(address))
        }
    }
}

fn test_main() {
    printer: Printer = spawn Printer()
    a: Holder = spawn Holder()
    b: Holder = spawn Holder()
    secret: u64 = domain_pool_base_of(1, 1) + 0x11000 + 0x40000
    a.plant(4242)
    run_until_idle()
    b.peek(secret, printer)
    run_until_idle()
    a.peek(secret, printer)
    run_until_idle()
    unsafe {
        print_u64(load64(secret))
    }
}
