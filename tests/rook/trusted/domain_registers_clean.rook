// Raven's registers do not leak into a domain: every register but the arguments starts at zero.
// Worked out: dt_registers tells Raven x5, x20 and x29 in three requests (CALL 3 each); Raven's x29 is its frame
// pointer, which is not 0, so a 0 shows the register was cleared. The last resume returns (0).
// expect: 3
// expect: 0
// expect: 3
// expect: 0
// expect: 3
// expect: 0
// expect: 0

import assembly: domain_enter, domain_resume, domain_saved_x, dt_program
import print: print_u64

fn test_main() {
    unsafe {
        print_u64(domain_enter(1, dt_program(10), 0, 0, 0))
        print_u64(domain_saved_x(0))
        print_u64(domain_resume(0))
        print_u64(domain_saved_x(0))
        print_u64(domain_resume(0))
        print_u64(domain_saved_x(0))
        print_u64(domain_resume(0))
    }
}
