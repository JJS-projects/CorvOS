// A domain cannot touch the page where Raven keeps its saved registers (it is in the domain's table, because the
// exception vectors need it, but for EL1 only).
// Worked out: the store is a data abort from a lower EL (class 0x24 = 36); the page is mapped, with no access for
// EL0, so it is a permission fault at level 3: low 7 bits of ESR_EL1 = WnR (0x40) + DFSC 0xF = 0x4F = 79.
// expect: 1
// expect: 36
// expect: 79

import assembly: domain_enter, domain_fault_esr, domain_tramp_address, dt_program
import print: print_u64

fn test_main() {
    unsafe {
        print_u64(domain_enter(1, dt_program(3), domain_tramp_address(), 99, 0))
        print_u64(domain_fault_esr() shr 26)
        print_u64(domain_fault_esr() and 0x7f)
    }
}
