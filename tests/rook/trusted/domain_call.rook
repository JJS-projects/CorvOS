// A domain asks Raven for something with `svc #7` and is continued with domain_resume.
// Worked out: dt_add adds its three arguments, 5 + 6 + 7 = 18, and does `svc #7`: the call comes back with 3 (CALL),
// the svc number is 7 and the domain's x0 is 18; resumed, the program returns, which comes back as 0 (DONE).
// expect: 3
// expect: 7
// expect: 18
// expect: 0

import assembly: domain_call_number, domain_enter, domain_resume, domain_saved_x, dt_program
import print: print_u64

fn test_main() {
    unsafe {
        print_u64(domain_enter(1, dt_program(1), 5, 6, 7))
        print_u64(domain_call_number())
        print_u64(domain_saved_x(0))
        print_u64(domain_resume(0))
    }
}
