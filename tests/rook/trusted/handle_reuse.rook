// An actor's place is used again by the next actor of the same size, with a new generation (decision 197): a reference made
// for the actor that ended is stale, and nothing that is done with it reaches the new one.
// Worked out: a (Probe 1) is stopped, b (Probe 2) is spawned and gets the same place (print 1: the same address) but not the
// same reference (0). a.ping() is a lossy send to a stale reference: dropped, nothing printed; stop(a) does nothing (b lives);
// b.ping() prints 2. b's `self` is the reference it was spawned with, generation and all (4: the call into Raven adds the
// generation of b's place, not 0). a.poke() is a reliable send to it: Gone (9); the same by number: Gone (9). b.poke() is delivered (0 from `gone`, then the handler's 3).
// expect: 1
// expect: 0
// expect: 2
// expect: 4
// expect: 9
// expect: 9
// expect: 0
// expect: 3

import actors: Sent, run_until_idle
import mailbox: send_reliable_impl
import print: print_u64

actor Probe {
    n: u64

    new(n: u64) {
        .n = n
    }

    pub lossy on ping() {
        print_u64(.n)
    }

    pub lossy on me(expected: u64) {
        unsafe {
            if actor_reference(self) == expected {
                print_u64(4)
            } else {
                print_u64(0)
            }
        }
    }

    pub reliable on poke() {
        print_u64(3)
    }
}

fn gone(result: Sent) {
    match result {
        Delivered => print_u64(0)
        MailboxFull => print_u64(1)
        Gone => print_u64(9)
    }
}

fn test_main() {
    a: Probe = spawn Probe(1)
    mut old: u64 = 0
    unsafe {
        old = actor_reference(a)
    }
    stop(a)
    b: Probe = spawn Probe(2)
    unsafe {
        if actor_address(a) == actor_address(b) {
            print_u64(1)
        } else {
            print_u64(0)
        }
        if old == actor_reference(b) {
            print_u64(1)
        } else {
            print_u64(0)
        }
    }
    a.ping()
    stop(a)
    run_until_idle()
    b.ping()
    run_until_idle()
    unsafe {
        b.me(actor_reference(b))
    }
    run_until_idle()
    gone(a.poke())
    unsafe {
        gone(send_reliable_impl(old, handler_number("poke"), 0, 0))
    }
    gone(b.poke())
    run_until_idle()
}
