// An actor whose `new` has not run yet accepts messages but its handlers do not run until it has (decision 181, and decision 203
// for how it is done now): a message from another core can arrive before the start record does, and the handler must not run on
// fields `new` has yet to set. The runtime of the domain keeps a word for each actor that says its `new` is still to run (Raven sets
// it when it places an actor that another core starts, and clears it when the start has run); this test sets and clears it by hand.
// Worked out: three `separate` actors fill cores 1, 2 and 3, so the probe is the fourth, on core 0, whose memory this test reaches.
// Its first field is `hits`. With the word set, one hit() is accepted and the domain takes a turn (`run_one_turn`): the message goes to
// the actor's mailbox and nothing runs: hits is 0. With the word cleared, a second hit() puts the domain in the run queue again:
// actors_waiting() is 1. When the system settles both hits have run: 2.
// expect: 0
// expect: 1
// expect: 2

import actors: run_until_idle
import assembly: domain_pool_base_of
import domain_runtime: RT_STATE, RT_S_HELD
import mailbox: actors_waiting, run_one_turn
import print: print_u64

actor Printer {
    lossy on show(n: u64) {
        print_u64(n)
    }
}

separate actor Idle {
    mut unused: u64

    new() {
        .unused = 0
    }
}

separate actor Probe {
    mut hits: u64

    new() {
        .hits = 0
    }

    lossy on hit() {
        .hits += 1
    }

    lossy on report(to: Printer) {
        to.show(.hits)
    }
}

fn test_main() {
    printer: Printer = spawn Printer()
    a: Idle = spawn Idle()
    b: Idle = spawn Idle()
    c: Idle = spawn Idle()
    probe: Probe = spawn Probe()
    unsafe {
        who: u64 = actor_address(probe)
        held: u64 = domain_pool_base_of(0, load64(who - 1264 + 104) and 0xf) + RT_STATE + RT_S_HELD
        store64(held, 1)
        probe.hit()
        run_one_turn()
        print_u64(load64(who))
        store64(held, 0)
        probe.hit()
        print_u64(actors_waiting())
    }
    run_until_idle()
    unsafe {
        print_u64(load64(actor_address(probe)))
    }
}
