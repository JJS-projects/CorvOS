// A handler that runs past its time budget (100 ms) has failed. That is reported like a
// panic, naming the handler and the line where it is declared, and the handler is abandoned
// and the actor restarted. This one is slow, not endless: it waits 300 ms.
// expect-failure: Slow.crawl ran for over 100 ms at actors_overrun.rook:17
// expect: 1
// expect: 1

import actors: run_until_idle
import print: print_u64
import time: wait_ms

actor Slow {
    pub lossy on quick() {
        print_u64(1)
    }

    pub lossy on crawl() {
        wait_ms(300)
        print_u64(2)                    // never reached
    }
}

fn test_main() {
    slow: Slow = spawn Slow()
    slow.quick()
    slow.crawl()
    run_until_idle()
    slow.quick()                        // the actor answers again, after its restart
    run_until_idle()
}
