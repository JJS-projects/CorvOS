// `watch` takes the actor to watch and who to tell.
// error: 14:9: write `watch(actor, narrow(self, Restarts))`: the actor to watch, and who to tell

interface Restarts {
    lossy on restarted()
}

actor Watcher: Restarts {
    new() { }

    lossy on restarted() { }

    pub lossy on go(other: Watcher) {
        watch(other)
    }
}
