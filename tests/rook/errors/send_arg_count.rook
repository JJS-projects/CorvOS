// A send passes the handler's arguments.
// error: 19:7: `Counter.add` takes 1 argument(s), but 2 given

actor Counter {
    mut count: u64
    other: u64

    new(start: u64) {
        .count = start
        .other = 0
    }

    pub lossy on add(n: u64) {
        .count += n
    }
}

fn f(c: Counter) {
    c.add(1, 2)
}
