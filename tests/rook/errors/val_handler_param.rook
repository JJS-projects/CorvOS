// A message can't carry `val` data yet.
// error: 14:30: a message can't carry `val` data yet: that waits for the ownership rules (decision 114); only `new` takes it

struct Window {
    start: u64
    size: u64

    mut fn grow() {
        .size += 1
    }
}

actor Holder {
    pub lossy on look(w: val Window) {
    }
}
