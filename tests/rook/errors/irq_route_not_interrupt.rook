// `route` takes an `Interrupt`, which an actor must implement and `narrow` to.
// error: 12:15: expected Interrupt, found Thing: hand out only what the interface allows with `narrow(..., Interrupt)`

import actors: Irq

actor Thing {
    pub lossy on tick() {
    }
}

fn f(irq: Irq, t: Thing) {
    irq.route(t)
}
