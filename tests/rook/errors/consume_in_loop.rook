// Consumed in a loop, the next turn would use it again.
// error: 12:25: `r` is consumed here, inside a loop, but the next turn needs it: assign it again before the end of the loop

struct Reading {
    temp: i32
    seq: u32
}

fn f() {
    r: Reading = Reading(temp: 1, seq: 1)
    again: loop i: u64 in 0..3 {
        gone: Reading = consume(r)
    }
}
