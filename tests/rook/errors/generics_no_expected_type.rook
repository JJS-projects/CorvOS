// A generic value needs to know which type it is: the place it goes to says so.
// error: 19:11: `Option` is generic: say which type this is by writing the type where the value goes, as in `x: Option<...> = ...`

enum Option<T> {
    Some(value: T)
    None
}

struct Pair<A, B> {
    first: A
    second: B
}

struct Local {
    n: u64
}

fn f() {
    match Some(value: 3) {
        Some(value: v) => { }
        None => { }
    }
}
