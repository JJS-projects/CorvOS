// A generic value needs to know which type it is: the place it goes to says so.
// error: 19:11: `Choice` is generic: say which type this is by writing the type where the value goes, as in `x: Choice<...> = ...`

enum Choice<T> {
    Pick(value: T)
    Nada
}

struct Pair<A, B> {
    first: A
    second: B
}

struct Local {
    n: u64
}

fn f() {
    match Pick(value: 3) {
        Pick(value: v) => { }
        Nada => { }
    }
}
