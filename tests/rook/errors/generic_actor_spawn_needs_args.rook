// A generic actor is spawned with its type arguments.
// alone
// error: 22:30: `Limit` needs type arguments: write `Limit<T>` with the types

interface Sink<T> {
    lossy on put(item: T)
}

actor Limit<T>: Sink<T> {
    target: Sink<T>

    new(target: Sink<T>) {
        .target = target
    }

    lossy on put(item: T) {
        .target.put(item)
    }
}

fn make(next: Sink<u8>) {
    boxed: Sink<u8> = narrow(spawn Limit(next), Sink<u8>)
}
