// The field of an instance has the type argument written: Option<u64> holds a u64.
// error: 19:34: expected u64, found bool

enum Option<T> {
    Some(value: T)
    None
}

struct Pair<A, B> {
    first: A
    second: B
}

struct Local {
    n: u64
}

fn f() {
    o: Option<u64> = Some(value: true)
}
