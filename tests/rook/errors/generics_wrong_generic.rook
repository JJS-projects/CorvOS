// A value of one generic can't go where an instance of another is wanted.
// error: 15:26: expected Pair<u64,bool>, found a value of the generic type `Option`

enum Option<T> {
    Some(value: T)
    None
}

struct Pair<A, B> {
    first: A
    second: B
}

fn f() {
    p: Pair<u64, bool> = Some(value: 1)
}
