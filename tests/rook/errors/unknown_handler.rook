// Sending a message the actor has no handler for.
// error: 19:7: `Counter` has no handler `nope`

actor Counter {
    mut count: u64
    other: u64

    new(start: u64) {
        .count = start
        .other = 0
    }

    pub lossy on add(n: u64) {
        .count += n
    }
}

fn f(c: Counter) {
    c.nope(1)
}
