// `new` takes a struct as read-only data, written `val`.
// error: 14:12: `new` takes a struct or enum as owned or read-only data: write `iso Window` or `val Window`

struct Window {
    start: u64
    size: u64

    mut fn grow() {
        .size += 1
    }
}

actor Holder {
    new(w: Window) {
    }
}
