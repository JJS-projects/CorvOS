// A value lent as `mut` can't be lent again in the same call.
// error: 15:21: `a` is lent as `mut` in this call, so it can't be lent again here

struct Point {
    x: u64
    y: u64
}

fn add_into(target: mut Point, source: Point) {
    target.x += source.x
}

fn f() {
    mut a: Point = Point(x: 1, y: 2)
    add_into(mut a, a)
}
