// Each variant is matched once.
// error: 14:9: `Idle` is already matched

enum State {
    Idle
    Busy(job: u64, since: u64)
    Failed(code: u32)
}

fn f(s: State) -> u64 {
    return match s {
        Idle => 0
        Busy(job: j, since: _) => j
        Idle => 2
        Failed(code: _) => 3
    }
}
