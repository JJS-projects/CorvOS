// A consumed variable that is not `mut` stays empty: it can't be assigned again.
// error: 12:7: can't assign to `r`: declare it with `mut` to make it mutable

struct Reading {
    temp: i32
    seq: u32
}

fn f() {
    r: Reading = Reading(temp: 1, seq: 1)
    gone: Reading = consume(r)
    r = Reading(temp: 2, seq: 2)
}
