// && and || short-circuit: the right side runs only when needed.
// expect: true
// expect: 1
// expect: false
// expect: 2
// expect: false
// expect: true
// expect: true
// expect: false

extern fn print_u64(x: U64)
extern fn print_bool(b: Bool)

fn noisy(id: U64, result: Bool): Bool {
    print_u64(id)
    return result
}

fn test_main() {
    print_bool(true || noisy(99, false))
    print_bool(noisy(1, false) && noisy(98, true))
    print_bool(noisy(2, true) && false)
    let x: I32 = -5
    print_bool(x < 0 && x > -10)
    print_bool(!(x == 5))
    print_bool(true != true)
}
