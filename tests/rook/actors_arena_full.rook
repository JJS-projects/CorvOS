// Actors live in a fixed arena. Running out is a panic that says so, not a
// silent overwrite of someone else's memory. (The line is the panic in
// raven/trusted/actors.rook: update it if that file's lines above it move.)
// expect: 1
// expect-panic: out of memory for actors at actors.rook:55

actor Small {
    id: u64

    new(id: u64) {
        .id = id
    }
}

fn test_main() {
    print_u64(1)
    spawning: loop i: u64 in 0..200 {
        discard spawn Small(i)
    }
}
