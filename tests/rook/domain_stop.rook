// `stop(d)` ends every actor in a domain and gives it back (decision 201), and a domain whose last actor has ended is given back too.
// Worked out: a and b are in d. A reliable send to each is Delivered (0) and handled (prints 1 and 2). After stop(d) a send to each is
// Gone (9). The domain is gone: `spawn ... in d` fails (expect-failure, in a plain actor that tries it). A second domain e holds one
// actor; when that actor is stopped by the actor that spawned it, e is given back as well, and the handle `e` is stale: the same
// failure.
// expect: 0
// expect: 0
// expect: 1
// expect: 2
// expect: 9
// expect: 9
// expect-failure: that domain has ended at mailbox.rook:*
// expect-failure: that domain has ended at mailbox.rook:*

import actors: Domain, Sent, new_domain, run_until_idle
import print: print_u64

actor Printer {
    lossy on show(n: u64) {
        print_u64(n)
    }
}

actor Placer {
    d: val Domain
    printer: Printer

    new(d: val Domain, printer: Printer) {
        .d = d
        .printer = printer
    }

    pub lossy on place() {
        w: Worker = spawn Worker(7, .printer) in .d
    }
}

separate actor Worker {
    n: u64
    printer: Printer

    new(n: u64, printer: Printer) {
        .n = n
        .printer = printer
    }

    pub reliable on ping() {
        .printer.show(.n)
    }
}

fn answer(result: Sent) {
    match result {
        Delivered => print_u64(0)
        MailboxFull => print_u64(8)
        Gone => print_u64(9)
    }
}

fn test_main() {
    printer: Printer = spawn Printer()
    d: Domain = new_domain()
    placer: Placer = spawn Placer(copy(d), printer)
    a: Worker = spawn Worker(1, printer) in d
    b: Worker = spawn Worker(2, printer) in d
    answer(a.ping())
    answer(b.ping())
    run_until_idle()
    stop(d)
    run_until_idle()
    answer(a.ping())
    answer(b.ping())
    run_until_idle()
    placer.place()
    run_until_idle()
    e: Domain = new_domain()
    c: Worker = spawn Worker(3, printer) in e
    placer_e: Placer = spawn Placer(copy(e), printer)
    stop(c)
    run_until_idle()
    placer_e.place()
    run_until_idle()
}
