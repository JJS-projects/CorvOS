// A struct travels in a message: the sender copies it (`copy`), gives it away
// (`consume`) or builds a new one, and the receiver's parameter is `iso`. The
// recorder keeps a running total of the temperatures and of the sequence numbers.
//
// Worked out: the sensor and recorder take turns one message at a time. In the order the
// recorder gets them: ticks 3 and 4 (a copy each: temp 3 seq 1, temp 4 seq 2), the flush
// (the latest, temp 4 seq 2, given away) and the reset (a new one, temp 10 seq 0).
// Totals after each: temp 3, 7, 11, 21; seq 1, 3, 5, 5.
// expect: 3
// expect: 1
// expect: 7
// expect: 3
// expect: 11
// expect: 5
// expect: 21
// expect: 5

struct Reading {
    temp: i32
    seq: u32
}

actor Recorder {
    mut total: i64
    mut seqs: u64

    new() {
        .total = 0
        .seqs = 0
    }

    pub lossy on add(r: iso Reading) {
        .total += r.temp as i64
        .seqs += r.seq as u64
        print_i64(.total)
        print_u64(.seqs)
    }
}

actor Sensor {
    recorder: Recorder
    mut latest: iso Reading

    new(recorder: Recorder) {
        .recorder = recorder
        .latest = Reading(temp: 0, seq: 0)
    }

    pub lossy on tick(temp: i32) {
        .latest = Reading(temp: temp, seq: .latest.seq + 1)
        .recorder.add(copy(.latest))                // I keep mine: the copy is written
    }

    pub lossy on flush() {
        .recorder.add(consume(.latest))             // I give mine away
        .latest = Reading(temp: 0, seq: 0)
    }

    pub lossy on reset(temp: i32) {
        .recorder.add(Reading(temp: temp, seq: 0))  // a new value needs no word
    }
}

fn test_main() {
    recorder: Recorder = spawn Recorder()
    sensor: Sensor = spawn Sensor(recorder)
    sensor.tick(3)
    sensor.tick(4)
    sensor.flush()
    sensor.reset(10)
    run_until_idle()
}
