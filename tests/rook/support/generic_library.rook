// Generic types for the tests of generics across files (tests/rook/generics_files.rook): a
// template lives here, and its instances are made for the types the test writes.

pub struct SupportBox<T> {
    pub value: T

    pub fn peek() -> T {
        return copy(.value)
    }
}

/// A box whose field is private: only this file can build one.
pub struct SupportSealed<T> {
    secret: T
}

pub enum SupportChoice<T> {
    SupportLeft(value: T)
    SupportRight
}

/// A stack's top and depth, built only by `new` (its fields are private).
pub struct SupportStack<T> {
    top: T
    depth: u64

    new(first: T) {
        .top = copy(first)
        .depth = 1
    }

    pub mut fn push(item: T) {
        .top = copy(item)
        .depth = .depth + 1
    }

    pub fn peek() -> T {
        return copy(.top)
    }

    pub fn size() -> u64 {
        return .depth
    }
}

/// Holds a `SupportBox<T>`: a user of this type need not import `SupportBox` (the names a
/// generic's text uses are checked in its own file, not in the file that writes `SupportHolder<T>`).
pub struct SupportHolder<T> {
    pub inner: SupportBox<T>

    new(first: T) {
        .inner = SupportBox(value: copy(first))
    }
}
