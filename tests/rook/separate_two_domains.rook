// Two `separate` actors are two domains: each keeps its own total.
// Worked out: a starts at 1, b at 10; a.add(1) makes 2, b.add(2) makes 12. The run queue is round robin: a runs add,
// b runs add, a runs report (the printer gets show(2)), b runs report (show(12)); the printer then prints 2, 12.
// expect: 2
// expect: 12

import actors: run_until_idle
import print: print_u64

actor Printer {
    lossy on show(n: u64) {
        print_u64(n)
    }
}

separate actor Counter {
    mut total: u64

    new(start: u64) {
        .total = start
    }

    lossy on add(n: u64) {
        .total += n
    }

    lossy on report(to: Printer) {
        to.show(.total)
    }
}

fn test_main() {
    printer: Printer = spawn Printer()
    a: Counter = spawn Counter(1)
    b: Counter = spawn Counter(10)
    a.add(1)
    b.add(2)
    a.report(printer)
    b.report(printer)
    run_until_idle()
}
