// Two `separate` actors are two domains: each keeps its own total.
// Worked out: a starts at 1, b at 10; a.add(1) makes 2, b.add(2) makes 12. They are on different cores (a on core 1,
// b on core 2, decision 180), so what they send is not ordered between them: each report is made after the system has
// settled (run_until_idle), and the printer prints 2, then 12.
// expect: 2
// expect: 12

import actors: run_until_idle
import print: print_u64

actor Printer {
    lossy on show(n: u64) {
        print_u64(n)
    }
}

separate actor Counter {
    mut total: u64

    new(start: u64) {
        .total = start
    }

    lossy on add(n: u64) {
        .total += n
    }

    lossy on report(to: Printer) {
        to.show(.total)
    }
}

fn test_main() {
    printer: Printer = spawn Printer()
    a: Counter = spawn Counter(1)
    b: Counter = spawn Counter(10)
    a.add(1)
    b.add(2)
    run_until_idle()
    a.report(printer)
    run_until_idle()
    b.report(printer)
    run_until_idle()
}
