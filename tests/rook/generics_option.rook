// A generic enum: `Choice<T>` is a separate enum for each type it is written with.
//
// Worked out: `a` holds Pick(7): the match binds 7 and adds 1 (8). `b` is Nada: the match takes the
// Nada arm and prints 0. `c` is an Choice<bool> holding Pick(true): the match prints 1. The
// function `bump` takes an Choice<u64> and returns its value plus the fallback 100 when Nada: 107, 100.
// expect: 8
// expect: 0
// expect: 1
// expect: 107
// expect: 100

import print: print_u64

enum Choice<T> {
    Pick(value: T)
    Nada
}

fn bump(o: Choice<u64>) -> u64 {
    match o {
        Pick(value: v) => return v + 100
        Nada => return 100
    }
}

fn test_main() {
    a: Choice<u64> = Pick(value: 7)
    b: Choice<u64> = Nada
    c: Choice<bool> = Pick(value: true)
    match a {
        Pick(value: v) => print_u64(v + 1)
        Nada => print_u64(0)
    }
    match b {
        Pick(value: v) => print_u64(v)
        Nada => print_u64(0)
    }
    match c {
        Pick(value: v) => print_u64(if v { 1 } else { 2 })
        Nada => print_u64(3)
    }
    print_u64(bump(a))
    print_u64(bump(b))
}
