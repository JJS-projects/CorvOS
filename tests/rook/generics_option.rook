// A generic enum: `Option<T>` is a separate enum for each type it is written with.
//
// Worked out: `a` holds Some(7): the match binds 7 and adds 1 (8). `b` is None: the match takes the
// None arm and prints 0. `c` is an Option<bool> holding Some(true): the match prints 1. The
// function `bump` takes an Option<u64> and returns its value plus the fallback 100 when None: 107, 100.
// expect: 8
// expect: 0
// expect: 1
// expect: 107
// expect: 100

import print: print_u64

enum Option<T> {
    Some(value: T)
    None
}

fn bump(o: Option<u64>) -> u64 {
    match o {
        Some(value: v) => return v + 100
        None => return 100
    }
}

fn test_main() {
    a: Option<u64> = Some(value: 7)
    b: Option<u64> = None
    c: Option<bool> = Some(value: true)
    match a {
        Some(value: v) => print_u64(v + 1)
        None => print_u64(0)
    }
    match b {
        Some(value: v) => print_u64(v)
        None => print_u64(0)
    }
    match c {
        Some(value: v) => print_u64(if v { 1 } else { 2 })
        None => print_u64(3)
    }
    print_u64(bump(a))
    print_u64(bump(b))
}
