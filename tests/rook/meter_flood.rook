// A quota in the capability: a sender that holds only the `ByteSink` side of a `Metered` cannot send more than its budget,
// however fast it sends (decision 198).
// Worked out: the Metered lets 5 bytes through and refills one an hour (so none in this test). test_main sends 1000 bytes at once.
// The proxy's mailbox holds 16: the other 984 are dropped there (lossy, counted). Of the 16, the first 5 reach the Tally and 11
// are refused; the owner is told once when the first is refused, not 11 times. Tally prints the bytes it got (5) and how many
// times it was told the budget was out (1).
// expect: 5
// expect: 1

import actors: run_until_idle
import hardware: counter_frequency
import meter: Metered, Overdrawn
import pl011: ByteSink
import print: print_u64

actor Tally: ByteSink, Overdrawn {
    mut bytes: u64
    mut told: u64

    new() {
        .bytes = 0
        .told = 0
    }

    lossy on byte(b: u8) {
        .bytes += 1
    }

    lossy on overdrawn() {
        .told += 1
    }

    pub lossy on show() {
        print_u64(.bytes)
        print_u64(.told)
    }
}

fn test_main() {
    tally: Tally = spawn Tally()
    proxy: Metered = spawn Metered(narrow(tally, ByteSink), narrow(tally, Overdrawn), 5, 3600 * counter_frequency())
    guest: ByteSink = narrow(proxy, ByteSink)
    flooding: loop i: u64 in 0..1000 {
        guest.byte(65)
    }
    run_until_idle()
    tally.show()
    run_until_idle()
}
