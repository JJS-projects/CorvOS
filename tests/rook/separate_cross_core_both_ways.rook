// (`retries: 3`: a handler here waits up to 5 ms for ring room, and on a loaded machine one can be held for longer than the
// 100 ms budget; the old deadlock hung every run, so three runs do not hide it.)
// Two cores flooding each other do not deadlock (decision 181 listed this as a limit; decision 186 closes it). The sender
// on core 0 sends 4000 messages to an actor on core 1 as fast as it can; the handler of each sends one on to a plain actor
// on core 0. The ring from core 0 to core 1 is full (32 records) while the ring from core 1 to core 0 fills with the
// answers; a core that only waited for room would wait for ever, each for the other.
// Worked out: the plain Sink keeps the largest number it has seen and the program prints 1 if the system settled with
// the Sink having heard from the other core at least once (messages are dropped in full mailboxes, so how many arrive is
// not fixed; that some arrive, and that the program returns at all, is the point).
// expect: 1
// retries: 3

import actors: run_until_idle
import print: print_u64

actor Sink {
    mut heard: u64

    new() {
        .heard = 0
    }

    lossy on take(n: u64) {
        .heard += 1
    }

    lossy on report() {
        if .heard >= 1 {
            print_u64(1)
        } else {
            print_u64(0)
        }
    }
}

separate actor Bounce {
    sink: Sink

    new(sink: Sink) {
        .sink = sink
    }

    lossy on bounce(n: u64) {
        .sink.take(n)
    }
}

fn test_main() {
    sink: Sink = spawn Sink()
    bounce: Bounce = spawn Bounce(sink)
    sending: loop i: u64 in 0..4000 {
        bounce.bounce(i)
    }
    run_until_idle()
    sink.report()
    run_until_idle()
}
