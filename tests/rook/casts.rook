// `as` truncates or extends, reinterpreting the sign like Rust.
// expect: 44
// expect: 255
// expect: -1
// expect: 18446744073709551615
// expect: 4294967295
// expect: -128
// expect: 1
// expect: 0
// expect: 65

extern fn print_u64(x: u64)
extern fn print_i64(x: i64)

fn test_main() {
    print_u64((300 as u8) as u64)
    a: i8 = -1
    print_u64((a as u8) as u64)
    print_i64(a as i64)
    print_u64(a as u64)
    print_u64((a as u32) as u64)
    b: u8 = 128
    print_i64((b as i8) as i64)
    print_u64(true as u64)
    print_u64(false as u64)
    print_u64('A' as u64)
}
