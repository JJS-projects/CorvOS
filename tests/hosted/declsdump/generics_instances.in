@@@ lib.rook
pub enum Option<T> {
    Some(value: T)
    None
}
pub struct Pair<Ax, Bx> {
    pub first: Ax
    pub second: Bx
    pub fn swap() -> Pair<Bx, Ax> {
        return Pair(first: .second, second: .first)
    }
    pub mut fn clear() {
    }
}
