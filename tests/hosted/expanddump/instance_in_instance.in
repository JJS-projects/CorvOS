pub struct Box<T> {
    pub item: T
    pub fn same() -> Box<T> {
        return copy(.)
    }
}
pub struct Wrapper<T> {
    pub inner: Box<T>
    pub list: Other<Box<T>>
}
pub struct Other<U> {
    u: U
}
